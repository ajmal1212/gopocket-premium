---
// CallToAction2.astro
---

<section class="call-to-action overflow-hidden">
  <div class="container">
    <div class="bg-theme-light relative grid grid-cols-1 overflow-hidden rounded-4xl lg:grid-cols-2">
      <div class="flex flex-col justify-between px-8 py-8 lg:px-16 lg:py-20">
        <div class="mb-10">
          <h2
            data-duration="0.6"
            data-delay="0.2"
            data-stagger="0.09"
            class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-6 leading-[1.15] text-gray-900 tracking-tight animated-text"
          >
            <span class="font-extrabold text-gray-900">Open your GoPocket Account within 5 minutes</span>
          </h2>
          <p data-aos="fade-down-sm" data-aos-delay="300" class="aos-init">
            Zero account opening charges. 100% online process.
          </p>
          <div class="mt-5 md:mt-10 aos-init" data-aos="fade-down-sm" data-aos-delay="400">
            <a class="btn btn-primary text-flip-hover-anim btn-primary" href="/open-account-call-back?src=Website&tag=CTA2"
              ><span class="text-flip-inner" data-content="OPEN AN ACCOUNT">OPEN AN ACCOUNT</span></a
            >
          </div>
        </div>
        <div class="mt-10 flex flex-wrap gap-4 lg:mt-24 aos-init" data-aos="reveal-anim-down">
          <h3 class="h2">500K+</h3>
          <div class="flex -space-x-3">
            <img
              src="/assets/images/cta-avatar-1.webp"
              alt="user"
              loading="lazy"
              decoding="async"
              data-astro-image="constrained"
              data-astro-image-fit="cover"
              data-astro-image-pos="center"
              width="144"
              height="144"
              class="h-14 w-14 rounded-full border-4 border-white object-cover"
            /><img
              src="/assets/images/cta-avatar-2.webp"
              alt="user"
              loading="lazy"
              decoding="async"
              data-astro-image="constrained"
              data-astro-image-fit="cover"
              data-astro-image-pos="center"
              width="144"
              height="144"
              class="h-14 w-14 rounded-full border-4 border-white object-cover"
            /><img
              src="/assets/images/cta-avatar-3.webp"
              alt="user"
              loading="lazy"
              decoding="async"
              data-astro-image="constrained"
              data-astro-image-fit="cover"
              data-astro-image-pos="center"
              width="144"
              height="144"
              class="h-14 w-14 rounded-full border-4 border-white object-cover"
            />
          </div>
          <p class="mt-2">Well-reviewed by <br /> customers</p>
        </div>
        <img
          src="/assets/images/cta-shape-949w.webp"
          alt=""
          loading="lazy"
          decoding="async"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="949"
          height="527"
          class="pointer-events-none absolute bottom-0 left-0 w-194 select-none"
        />
      </div>
      <div
        class="relative flex flex-col justify-end overflow-hidden pt-10 after:absolute after:bottom-0 after:left-0 after:z-30 after:h-full after:w-full after:bg-linear-to-b after:from-transparent after:from-70% after:to-white md:pt-20"
      >
        <img
          src="/assets/images/cta-bg-1332w.webp"
          alt=""
          loading="lazy"
          decoding="async"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="1332"
          height="749"
          class="absolute bottom-0 left-0 z-10 h-full w-auto"
        />
        <div
          data-aos="reveal-anim-up"
          class="relative z-20 mx-auto w-full max-w-72 overflow-hidden px-4 pt-4 text-center md:text-start lg:h-156.25 lg:max-w-90 aos-init"
        >
          <img
            src="/assets/images/mobile-app-preview.webp"
            alt=""
            loading="lazy"
            decoding="async"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
            width="477"
            height="913"
            class="mx-auto w-full lg:w-79.25"
          />
          <img
            src="/assets/images/mobile-frame.webp"
            alt=""
            loading="lazy"
            decoding="async"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
            width="531"
            height="938"
            class="translate-x-centered absolute top-0 h-auto w-full"
          />
        </div>
      </div>
    </div>
  </div>
</section>
