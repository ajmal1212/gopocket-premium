                  savingsOptions.map((option, index) => (
                    <tr
                      class={`${index % 2 === 1 ? "bg-gray-50/40 dark:bg-[#181b25]/50 " : ""}hover:bg-purple-50/50 dark:hover:bg-[#181b25] transition`}
                    >
                      <td class="px-6 py-4.5 font-bold text-dark">{option.name}</td>
                      <td class="px-6 py-4.5 opacity-85">{option.lockIn}</td>
                      <td class="px-6 py-4.5 text-center font-bold text-primary">{option.returns}</td>
                      <td class="px-6 py-4.5 opacity-85">{option.risk}</td>
                      <td class="px-6 py-4.5 opacity-85">{option.tax}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="text-sm text-text-default opacity-70">
            All the schemes above qualify for a Section 80C deduction under the old tax regime. Rates and tax rules
            change; check the current position before investing.
          </p>
        </div>
      </section>

      <FAQSection2 title="asked questions" titleBold="Frequently" categories={faqCategories} />
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .ppf-minimal-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 9999px;
    outline: none;
    cursor: pointer;
  }
  .ppf-minimal-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffffff;
    border: 2.5px solid #6b1aff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .ppf-minimal-slider::-webkit-slider-thumb:hover {
    transform: scale(1.25);
  }
  @media (prefers-reduced-motion: reduce) {
    .ppf-minimal-slider::-webkit-slider-thumb {
      transition: none;
    }
  }
</style>

<!-- Chart.js, loaded the same way as on the other calculator pages. -->
<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  let chartInstance: any = null;

  const fields = [
    ["deposit-input", "deposit-slider"],
    ["interest-rate-input", "interest-rate-slider"],
    ["time-period-input", "time-period-slider"],
  ] as const;

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  function formatCurrency(val: number): string {
    return new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(val);
  }

  function updateSliderTrack(slider: HTMLInputElement | null) {
    if (!slider) return;
    const min = parseFloat(slider.min) || 0;
    const max = parseFloat(slider.max) || 100;
    const val = parseFloat(slider.value) || 0;
    const pct = Math.min(100, Math.max(0, ((val - min) / (max - min)) * 100));
    const isDark = document.documentElement.classList.contains("dark");
    const trackBg = isDark ? "#262938" : "#e2e8f0";
    slider.style.background = `linear-gradient(to right, #6b1aff 0%, #6b1aff ${pct}%, ${trackBg} ${pct}%, ${trackBg} 100%)`;
  }

  // Reads an input clamped to its own min/max, so a half-typed value never
  // produces a nonsense projection.
  function readValue(inputId: string): number {
    const input = byId<HTMLInputElement>(inputId);
    if (!input) return 0;
    const min = parseFloat(input.min) || 0;
    const max = parseFloat(input.max) || Infinity;
    return Math.min(max, Math.max(min, parseFloat(input.value) || min));
  }

  interface YearRow {
    deposited: number;
    interest: number;
    balance: number;
  }

  // Deposit at the start of each year, interest credited at the end of it.
  function project(deposit: number, ratePa: number, years: number): YearRow[] {
    const i = ratePa / 100;
    let balance = 0;
    const rows: YearRow[] = [];
    for (let yr = 1; yr <= years; yr++) {
      balance += deposit;
      const interest = balance * i;
      balance += interest;
      rows.push({ deposited: deposit, interest, balance });
    }
    return rows;
  }

  function calculatePPF() {
    const deposit = readValue(fields[0][0]);
    const ratePa = readValue(fields[1][0]);
    const years = Math.round(readValue(fields[2][0]));

    const rows = project(deposit, ratePa, years);
    const invested = deposit * years;
    const maturity = rows.length ? rows[rows.length - 1].balance : 0;
    const interest = Math.max(0, maturity - invested);

    const set = (id: string, value: number) => {
      const el = byId(id);
      if (el) el.innerText = formatCurrency(Math.round(value));
    };
    set("output-invested", invested);
    set("output-interest", interest);
    set("output-maturity", maturity);

    fields.forEach(([, sliderId]) => updateSliderTrack(byId<HTMLInputElement>(sliderId)));
    updateChart(invested, interest);
    updateSchedule(rows);
  }

  function updateChart(invested: number, interest: number) {
    const canvas = byId<HTMLCanvasElement>("ppf-chart");
    if (!canvas) return;

    if (chartInstance) {
      chartInstance.data.datasets[0].data = [invested, interest];
      chartInstance.update();
      return;
    }

    const ChartClass = (window as any).Chart;
    if (!ChartClass) return;
    chartInstance = new ChartClass(canvas, {
      type: "doughnut",
      data: {
        labels: ["Total investment", "Total interest"],
        datasets: [
          {
            data: [invested, interest],
            backgroundColor: ["rgba(107, 26, 255, 0.2)", "#6b1aff"],
            borderWidth: 0,
            hoverOffset: 5,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: "78%",
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (context: any) => ` ${context.label || ""}: ${formatCurrency(context.parsed || 0)}`,
            },
          },
        },
        animation: { duration: 400, easing: "easeOutQuart" },
      },
    });
  }

  function updateSchedule(rows: YearRow[]) {
    const tbody = byId("ppf-schedule-body");
    if (!tbody) return;

    tbody.innerHTML = rows
      .map(
        (row, index) => `
        <tr class="hover:bg-gray-50 dark:hover:bg-[#181b25] transition">
          <td class="px-5 py-3.5 font-semibold">${index + 1} ${index === 0 ? "Year" : "Years"}</td>
          <td class="px-5 py-3.5">${formatCurrency(Math.round(row.deposited))}</td>
          <td class="px-5 py-3.5 text-primary font-semibold">${formatCurrency(Math.round(row.interest))}</td>
          <td class="px-5 py-3.5 text-right font-bold text-dark">${formatCurrency(Math.round(row.balance))}</td>
        </tr>
      `,
      )
      .join("");
  }

  function setupEventListeners() {
    // Each number box and its slider mirror one another.
    fields.forEach(([inputId, sliderId]) => {
      const input = byId<HTMLInputElement>(inputId);
      const slider = byId<HTMLInputElement>(sliderId);
      input?.addEventListener("input", () => {
        if (slider) slider.value = input.value;
        calculatePPF();
      });
      slider?.addEventListener("input", () => {
        if (input) input.value = slider.value;
        calculatePPF();
      });
    });
  }

  function initCalculator() {
    setupEventListeners();
    calculatePPF();
  }

  if (document.readyState !== "loading") {
    initCalculator();
  } else {
    document.addEventListener("DOMContentLoaded", initCalculator);
  }
</script>
