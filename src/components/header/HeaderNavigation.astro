---
import ThemeToggle from "../ThemeToggle.astro";
import NavLink from "./NavLink.astro";
import DropdownToggle from "./DropdownToggle.astro";
import LearnMenu from "./LearnMenu.astro";
import SignInMenu from "./SignInMenu.astro";
import MobileHeaderActions from "./MobileHeaderActions.astro";
import { headerLinks } from "./header-data";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const showPagesMenu = false;
---

<ul
  id="nav-menu"
  role="list"
  class="navbar hs-dropdown-menu hs-dropdown-open:flex hs-dropdown-open:mt-2! max-lg:absolute max-lg:transform-none! lg:transform-none!"
  tabindex="-1"
>
  <li class="nav-item">
    <NavLink {...headerLinks.products} {currentPath} />
  </li><LearnMenu />
  {
    showPagesMenu && (
      <li class="hs-dropdown nav-dropdown group [--auto-close:inside] [--offset:0px] nav-item relative lg:[--strategy:absolute]">
        <span class="nav-dropdown-toggle hs-dropdown-toggle flex items-center nav-link max-lg:flex! max-lg:justify-between">
          Pages{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-icon=""
            class="hs-dropdown-open:rotate-180 ml-2 h-4 w-4 transition duration-300"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </span>
        <ul
          class="nav-dropdown-list hs-dropdown-menu hs-dropdown-open:mt-2! hs-dropdown-open:pointer-events-auto hs-dropdown-open:opacity-100 pointer-events-none absolute lg:top-full lg:mt-2 top-0 mt-4 hidden opacity-0 transition-[opacity,margin] max-lg:m-0! max-lg:transform-none!"
          role="menu"
          tabindex="-1"
        >
          <>
            <li class="nav-dropdown-item">
              <a href="/about-us" class="nav-dropdown-link block">
                {" "}
                About Us{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/gopocket-api" class="nav-dropdown-link block">
                {" "}
                GoPocket API{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/pricing" class="nav-dropdown-link block">
                {" "}
                Pricing{" "}
              </a>
            </li>
            <li class="hs-dropdown nav-dropdown group [--auto-close:inside] [--offset:0px] nav-dropdown-item [--placement:right-start] relative lg:[--strategy:absolute]">
              <span class="nav-dropdown-toggle hs-dropdown-toggle flex items-center nav-dropdown-link justify-between">
                Nested Menu{" "}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  data-icon=""
                  class="hs-dropdown-open:rotate-180 ml-2 h-4 w-4 transition duration-300"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
              <ul
                class="nav-dropdown-list hs-dropdown-menu hs-dropdown-open:mt-2! hs-dropdown-open:pointer-events-auto hs-dropdown-open:opacity-100 pointer-events-none absolute top-0 mt-4 hidden opacity-0 transition-[opacity,margin] max-lg:m-0! max-lg:transform-none!"
                aria-orientation="vertical"
                role="menu"
                tabindex="-1"
              >
                <>
                  <li class="nav-dropdown-item">
                    <a href="/" class="nav-dropdown-link block">
                      {" "}
                      Menu 01{" "}
                    </a>
                  </li>
                  <li class="hs-dropdown nav-dropdown group [--auto-close:inside] [--offset:0px] nav-dropdown-item [--placement:right-start] relative lg:[--strategy:absolute]">
                    <span class="nav-dropdown-toggle hs-dropdown-toggle flex items-center nav-dropdown-link justify-between">
                      Nested Menu{" "}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        data-icon=""
                        class="hs-dropdown-open:rotate-180 ml-2 h-4 w-4 transition duration-300"
                      >
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </span>
                    <ul
                      class="nav-dropdown-list hs-dropdown-menu hs-dropdown-open:mt-2! hs-dropdown-open:pointer-events-auto hs-dropdown-open:opacity-100 pointer-events-none absolute top-0 mt-4 hidden opacity-0 transition-[opacity,margin] max-lg:m-0! max-lg:transform-none!"
                      aria-orientation="vertical"
                      role="menu"
                      tabindex="-1"
                    >
                      <>
                        <li class="nav-dropdown-item">
                          <a href="/" class="nav-dropdown-link block">
                            {" "}
                            Nested Menu Item{" "}
                          </a>
                        </li>
                        <li class="nav-dropdown-item">
                          <a href="/" class="nav-dropdown-link block">
                            {" "}
                            Nested Menu Item{" "}
                          </a>
                        </li>
                        <li class="nav-dropdown-item">
                          <a href="/" class="nav-dropdown-link block">
                            {" "}
                            Nested Menu Item{" "}
                          </a>
                        </li>
                        <li class="nav-dropdown-item">
                          <a href="/" class="nav-dropdown-link block">
                            {" "}
                            Nested Menu Item{" "}
                          </a>
                        </li>
                      </>
                    </ul>
                  </li>
                  <li class="nav-dropdown-item">
                    <a href="/" class="nav-dropdown-link block">
                      {" "}
                      Menu 02{" "}
                    </a>
                  </li>
                  <li class="nav-dropdown-item">
                    <a href="/" class="nav-dropdown-link block">
                      {" "}
                      Menu 03{" "}
                    </a>
                  </li>
                </>
              </ul>
            </li>
            <li class="nav-dropdown-item">
              <a href="/testimonial" class="nav-dropdown-link block">
                {" "}
                Testimonial{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/faq" class="nav-dropdown-link block">
                {" "}
                Faq{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/changelog" class="nav-dropdown-link block">
                {" "}
                Changelog{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/career" class="nav-dropdown-link block">
                {" "}
                Career{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/career/with-custom-slug" class="nav-dropdown-link block">
                {" "}
                Career Single{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/integration" class="nav-dropdown-link block">
                {" "}
                Integration{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/integration/discord" class="nav-dropdown-link block">
                {" "}
                Integration Single{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/blog" class="nav-dropdown-link block">
                {" "}
                Blog{" "}
              </a>
            </li>
            <li class="nav-dropdown-item">
              <a href="/terms-and-conditions" class="nav-dropdown-link block">
                {" "}
                Terms &amp; Conditions{" "}
              </a>
            </li>
          </>
        </ul>
      </li>
    )
  }
  <li class="nav-item">
    <a
      href="/partner-with-us"
      class={`nav-link whitespace-nowrap ${currentPath === "/partner-with-us" || currentPath === "/partner-with-us/" ? "nav-link-active" : ""}`}
      >Partner With Us<span class="badge badge-accent whitespace-nowrap">NEW</span></a
    >
  </li><li class="nav-item">
    <a href="/blog" class={`nav-link ${currentPath === "/blog" || currentPath === "/blog/" ? "nav-link-active" : ""}`}
      >Blogs</a
    >
  </li><SignInMenu />
  <MobileHeaderActions />
</ul>
