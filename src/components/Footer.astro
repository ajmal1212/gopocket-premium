<footer class="relative has-call-to-action">
  <div class="container space-y-8 md:space-y-16">
    <div class="grid gap-y-12 lg:grid-cols-2 xl:grid-cols-3">
      <!-- Brand & Newsletter -->
      <div class="space-y-8 xl:pe-12">
        <a href="/" class="logo-wrapper">
          <img
            src="/gopocket-logo.svg"
            alt="Brand logo of GoPocket"
            loading="lazy"
            decoding="async"
            width="134"
            height="32"
            style="width:134px;height:32px"
            class="logo"
          />
        </a>
        <p>Investing and trading is made simple, affordable and accessible for every Indian.</p>
        <!-- App download: QR + store badges -->
        <div>
          <p class="mb-4 text-sm font-medium">Scan to download the GoPocket app</p>
          <div class="flex items-center gap-5">
            <img
              src="/assets/images/gopocket/GoPocketAppQR.svg"
              alt="QR code to download the GoPocket app"
              loading="lazy"
              decoding="async"
              width="259"
              height="259"
              class="h-36 w-36 shrink-0 rounded-lg bg-white p-2"
            />
            <div class="flex flex-col gap-2.5">
              <a
                href="https://play.google.com/store/apps/details?id=com.codifi.gopocket"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block transition-opacity hover:opacity-80"
              >
                <img
                  src="/assets/images/play-store-badge.svg"
                  alt="Get GoPocket on Google Play"
                  loading="lazy"
                  decoding="async"
                  width="135"
                  height="45"
                  style="width:135px;height:45px"
                  class="block"
                />
              </a>
              <a
                href="https://apps.apple.com/in/app/gopocket-stocks-mf-ipo/id6465894786"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block transition-opacity hover:opacity-80"
              >
                <img
                  src="/assets/images/app-store-badge.svg"
                  alt="Download GoPocket on the App Store"
                  loading="lazy"
                  decoding="async"
                  width="135"
                  height="45"
                  style="width:135px;height:45px"
                  class="block"
                />
              </a>
            </div>
          </div>
        </div>
        <form action="#" id="mc-embedded-subscribe-form" method="post" class="relative mb-0">
          <div class="relative">
            <label for="mce-EMAIL" class="sr-only">Email</label>
            <input
              required=""
              type="email"
              name="EMAIL"
              id="mce-EMAIL"
              aria-required="true"
              placeholder="Email Address"
              class="border-border-light focus:ring-primary/4 size-full rounded-lg bg-white py-4 pl-5 shadow-none outline-0 placeholder:opacity-90 focus:ring-4"
            />
            <button
              type="submit"
              name="subscribe"
              id="mc-embedded-subscribe"
              class="absolute top-1 right-1 flex h-[calc(100%-0.5rem)] w-10 items-center justify-center rounded-lg"
            >
              <span class="sr-only">Subscribe</span>
              <svg
                class="text-2xl"
                stroke="currentColor"
                fill="currentColor"
                stroke-width="0"
                viewBox="0 0 448 512"
                height="1em"
                width="1em"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M446.7 98.6l-67.6 318.8c-5.1 22.5-18.4 28.1-37.3 17.5l-103-75.9-49.7 47.8c-5.5 5.5-10.1 10.1-20.7 10.1l7.4-104.9 190.9-172.5c8.3-7.4-1.8-11.5-12.9-4.1L117.8 284 16.2 252.2c-22.1-6.9-22.5-22.1 4.6-32.7L418.2 66.4c18.4-6.9 34.5 4.1 28.5 32.2z"
                ></path>
              </svg>
            </button>
          </div>
          <div class="form-check mt-4">
            <input class="form-checkbox" type="checkbox" required="" name="agree-privacy" id="agree-privacy" />
            <label for="agree-privacy">I agree with <a href="/privacy-policy">privacy policy</a></label>
          </div>
          <div id="mce-responses" class="clear absolute top-[105%] left-0 w-full text-sm opacity-60">
            <div class="message message-error" id="mce-error-response" style="display: none"></div>
            <div class="message message-success" id="mce-success-response" style="display: none"></div>
          </div>
          <div style="position: absolute; left: -312.5rem" aria-hidden="true">
            <input type="text" name="b_436cb8647d746fe81825f1efc_18a007239a" tabindex="-1" value="" />
          </div>
          <input type="hidden" name="EMAILTYPE" id="mce-EMAILTYPE-0" value="html" />
        </form>
        <script type="module" is:inline={true}>
          document.querySelector("#mc-embedded-subscribe-form")?.addEventListener("submit", async (n) => {
            n.preventDefault();
            const c = n.target,
              i = new FormData(c),
              a = c.getAttribute("action");
            if (!a) {
              console.error("Form action URL is missing.");
              return;
            }
            const l = new URLSearchParams(i).toString(),
              e = document.querySelector("#mce-error-response"),
              o = document.querySelector("#mce-success-response");
            if (!e || !o) {
              console.error("Error or success response containers are missing.");
              return;
            }
            ((e.style.display = "none"), (o.style.display = "none"));
            try {
              const r = document.createElement("script"),
                s = `jsonpCallback_${Date.now()}`;
              ((window[s] = (t) => {
                (t.result === "success"
                  ? ((o.textContent = t.msg || "Thank you for subscribing!"), (o.style.display = "block"))
                  : ((e.textContent = t.msg || "An error occurred. Please try again."), (e.style.display = "block")),
                  delete window[s],
                  r.remove());
              }),
                (r.src = `${a}&c=${s}&${l}`),
                (r.onerror = () => {
                  ((e.textContent = "There was an error processing your request. Please try again later."),
                    (e.style.display = "block"),
                    console.error("Error loading JSONP script."));
                }),
                document.body.appendChild(r));
            } catch (r) {
              ((e.textContent = "There was an error processing your request. Please try again later."),
                (e.style.display = "block"),
                console.error("Error:", r));
            }
          });
        </script>
