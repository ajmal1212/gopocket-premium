---

<section>
  <div class="container space-y-10 md:space-y-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="has-italic-text capitalize">
        <div
          class="animated-text is-ready"
          data-duration="0.6"
          data-delay="0.2"
          data-stagger="0.09"
          style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
        >
          <span class="word" style="--word-index:0">We’re</span>
          <span class="word" style="--word-index:1">
            <strong>available</strong>
          </span>
          <strong>
            <span class="word" style="--word-index:2">in</span>
          </strong>
          <span class="word" style="--word-index:3">over</span>
          <span class="word" style="--word-index:4">100+</span>
          <span class="word" style="--word-index:5">countries</span>
        </div>
      </h2>
    </div>
    <img
      src="/assets/images/location-4.webp"
      srcset="/assets/images/location-1.webp 640w, /assets/images/location-3.webp 750w, /assets/images/location-2.webp 828w, /assets/images/location-8.webp 1080w, /assets/images/location-7.webp 1280w, /assets/images/location-6.webp 1668w, /assets/images/location-9.webp 2048w, /assets/images/location-5.webp 2560w, /assets/images/location-4.webp 2640w"
      alt="We’re **available in** over 100+ countries"
      loading="lazy"
      decoding="async"
      data-aos="fade-up-sm"
      data-aos-delay="200"
      sizes="(min-width: 2640px) 2640px, 100vw"
      data-astro-image="constrained"
      data-astro-image-fit="cover"
      data-astro-image-pos="center"
      width="2640"
      height="1317"
      class="w-full aos-init"
    />
  </div>
</section>
