---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Discord - Multipurpose Saas & Startup Astro Js Theme"
  description="A customizable and multipurpose saas & startup astro theme built with Tailwind CSS and Astro Js"
>
  <Header currentPath="/integration/discord/" />
  <main class="has-section-spacing-lg">
    <div
      class="page-loader pointer-events-none fixed bottom-0 left-0 z-50 size-full bg-white transition duration-300 [.inactive]:opacity-0 inactive"
    >
      <script type="module" is:inline>
        const e = document.querySelector(".page-loader");
        document.addEventListener("DOMContentLoaded", () => {
          e &&
            setTimeout(() => {
              e.classList.add("inactive");
            }, 100);
        });
      </script>
    </div>
    <main class="has-section-spacing-lg">
      <section>
        <div class="container">
          <div class="has-video-modal grid grid-cols-1 gap-y-12 lg:grid-cols-7 lg:items-start">
