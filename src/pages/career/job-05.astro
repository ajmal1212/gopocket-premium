---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Content Marketing Strategist - Multipurpose Saas & Startup Astro Js Theme"
  description="A customizable and multipurpose saas & startup astro theme built with Tailwind CSS and Astro Js"
>
  <Header currentPath="/career/job-05" />
  <main class="has-section-spacing-lg">
    <div
      class="page-loader pointer-events-none fixed bottom-0 left-0 z-50 size-full bg-white transition duration-300 [.inactive]:opacity-0 inactive"
    >
      <script type="module" is:inline>
        const e = document.querySelector(".page-loader");
        document.addEventListener("DOMContentLoaded", () => {
          e &&
            setTimeout(() => {
              e.classList.add("inactive");
            }, 100);
        });
      </script>
    </div>
    <main class="has-section-spacing-lg">
      <section class="relative z-10 mt-0 py-14 md:pt-32 md:pb-24">
        <div class="container">
          <div class="flex max-w-6xl flex-wrap justify-between gap-5 md:gap-10 md:px-8 lg:px-12 ms-5 me-5 md:mx-auto">
            <h1 class="has-italic-text text-h2 max-w-lg capitalize">Content Marketing Strategist</h1>
            <p class="md:max-w-sm">
              We are looking a good suitable professional person for this very important role. Anyone can apply for...
            </p>
          </div>
        </div>
      </section>
      <section
        class="after:bg-theme-light pt-0 after:pointer-events-none after:absolute after:top-0 after:left-0 after:-z-10 after:h-250 after:w-full after:content-['']"
      >
        <div class="container">
          <div class="box-shadow-black mx-auto max-w-6xl space-y-16 rounded-xl bg-white p-8 md:p-12">
            <div class="bg-theme-light rounded-xl p-5 md:p-8">
              <h2 class="text-h6-sm md:text-h6">Job Overview</h2>
              <div class="mt-5 flex flex-wrap gap-6">
                <div class="flex flex-wrap gap-2 sm:flex-nowrap sm:items-center">
                  <p class="text-black/55 capitalize">type:</p>
                  <p class="text-black">Full-time</p>
                </div><div class="flex flex-wrap gap-2 sm:flex-nowrap sm:items-center">
                  <p class="text-black/55 capitalize">location:</p>
                  <p class="text-black">San Diego, CA</p>
                </div><div class="flex flex-wrap gap-2 sm:flex-nowrap sm:items-center">
                  <p class="text-black/55 capitalize">categories:</p>
                  <p class="text-black">Strategy &amp; Operations</p>
                </div><div class="flex flex-wrap gap-2 sm:flex-nowrap sm:items-center">
                  <p class="text-black/55 capitalize">Deadline:</p>
                  <p class="text-black">10 Aug, 2025</p>
                </div>
              </div>
              <div class="mt-8">
                <a
                  rel="noopener noreferrer"
                  target="_blank"
                  class="btn btn-primary text-flip-hover-anim btn-black"
                  href="https://astro.build"
                  ><span class="text-flip-inner" data-content="Apply Now">Apply Now</span><span
                    class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                    ><svg
                      class="gradient-shape"
                      width="150"
                      height="28"
                      viewBox="0 0 147 11"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      ><path
                        d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                        stroke="currentColor"
                        stroke-width="8"></path></svg
                    ></span
                  ></a
                >
              </div>
            </div>
            <div class="prose-styles content has-video-modal">
              <p>
                The Marketing Manager will be responsible for developing and executing strategic marketing plans to
                achieve company objectives. This role requires a blend of creativity, analytical prowess, and leadership
                skills to effectively drive marketing campaigns and initiatives. The ideal candidate will have a strong
                background in digital marketing, brand management, and a proven track record of generating leads and
                enhancing brand visibility.
              </p>
              <h2 id="responsibilities">Responsibilities</h2>
              <ul>
                <li>
                  <strong>Develop Marketing Strategy</strong>: Create and implement comprehensive marketing strategies
                  to enhance brand awareness and drive customer engagement.
                </li>
                <li>
                  <strong>Campaign Management</strong>: Oversee all marketing campaigns, from concept development to
                  execution and performance analysis, ensuring alignment with company goals and objectives.
                </li>
                <li>
                  <strong>Market Research</strong>: Conduct thorough market research and competitor analysis to identify
                  opportunities for growth and market positioning.
                </li>
                <li>
                  <strong>Digital Marketing</strong>: Manage digital marketing channels, including SEO, SEM, email
                  marketing, and social media, to optimize campaign performance and generate leads.
                </li>
                <li>
                  <strong>Budget Management</strong>: Develop and manage the marketing budget, allocating resources
                  effectively and ensuring cost-effective marketing initiatives.
                </li>
                <li>
                  <strong>Team Leadership</strong>: Lead and mentor a team of marketing professionals, fostering a
                  collaborative and high-performance culture within the department.
                </li>
                <li>
                  <strong>Collaboration</strong>: Work closely with the sales team to align marketing efforts with sales
                  objectives, supporting lead generation and conversion activities.
                </li>
              </ul>
              <h2 id="qualifications">Qualifications</h2>
              <ul>
                <li>
                  Bachelor’s degree in Marketing, Business Administration, or a related field; Master’s degree
                  preferred.
                </li>
                <li>
                  Proven experience as a Marketing Manager or similar role, with a minimum of 04 years in a corporate
                  environment.
                </li>
                <li>Demonstrable experience developing and implementing successful marketing campaigns.</li>
                <li>Strong leadership skills with the ability to inspire and motivate a team.</li>
                <li>
                  Exceptional communication and interpersonal skills, with the ability to build strong relationships
                  with internal teams and external stakeholders.
                </li>
                <li>Solid understanding of current marketing trends and digital platforms.</li>
                <li>Analytical mindset with proficiency in data analysis tools and techniques.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>
      <section class="call-to-action overflow-hidden">
        <div class="relative container py-20 md:py-40">
          <div class="mx-auto space-y-8 text-center lg:max-w-3xl">
            <h2
              class="has-italic-text text-display-3 md:text-display-2 mb-8 text-center leading-[1.15] font-normal capitalize"
            >
              <div
                class="animated-text is-ready"
                data-duration="0.6"
                data-delay="0.2"
                data-stagger="0.09"
                style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
              >
                <span class="word" style="--word-index:0">Get</span>
                <span class="word" style="--word-index:1">Started</span>
                <span class="word" style="--word-index:2">and</span>
                <span class="word" style="--word-index:3">Streamline</span>
                <span class="word" style="--word-index:4">Your</span>
                <span class="word" style="--word-index:5"><strong>Workflow</strong></span><strong>
                  <span class="word" style="--word-index:6">Today</span></strong>
              </div>
              <script type="module" is:inline>
                const r = document.querySelectorAll(".animated-text");
                if (window.matchMedia("(max-width: 767px)").matches)
                  r.forEach((t) => {
                    t.querySelectorAll(".word").forEach((e) => {
                      ((e.style.opacity = "1"), (e.style.filter = "none"), (e.style.transform = "none"));
                    });
                  });
                else {
                  const t = new IntersectionObserver(
                    (e, a) => {
                      e.forEach((s) => {
                        s.isIntersecting && (s.target.classList.add("is-animated"), a.unobserve(s.target));
                      });
                    },
                    { threshold: 0.1 },
                  );
                  r.forEach((e) => {
                    (e.classList.add("is-ready"), t.observe(e));
                  });
                }
              </script>
            </h2>
            <div
              data-aos="fade-down-sm"
              data-aos-delay="100"
              class="mx-auto max-w-2xl space-y-1 text-center *:first:text-lg *:first:font-medium *:last:opacity-80 aos-init"
            >
              <p>No credit card required. Cancel anytime</p>
              <p>Enjoy a 14-day free trial — experience every feature, risk-free.</p>
            </div>
            <div data-aos="fade-down-sm" data-aos-delay="200" class="aos-init">
              <a class="btn btn-primary text-flip-hover-anim btn-md btn-primary" href="/contact"
                ><span class="text-flip-inner" data-content="GET A FREE DEMO">GET A FREE DEMO</span><span
                  class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                  ><svg
                    class="gradient-shape"
                    width="150"
                    height="28"
                    viewBox="0 0 147 11"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    ><path
                      d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                      stroke="currentColor"
                      stroke-width="8"></path></svg
                  ></span
                ></a
              >
            </div>
          </div>
          <div
            class="pattern-shape pointer-events-none absolute top-0 left-0 -z-10 flex h-full w-[150%] opacity-40 select-none"
            style="transform: translateX(-1000px);"
          >
            <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div>
          </div>
        </div>
        <script
          type="module"
          is:inline></script>
      </section>
    </main>
    <script
      type="module"
      is:inline></script>
    <div
      id="action-buttons"
      class="pointer-events-none fixed right-0 bottom-5 z-100 flex flex-col space-y-2 rounded-lg bg-white p-2 text-center opacity-0 transition-all duration-300 [.scroll-down]:pointer-events-auto [.scroll-down]:right-5 [.scroll-down]:opacity-100"
    >
      <a
        rel="noopener noreferrer"
        target="_blank"
        class="btn btn-primary text-flip-hover-anim"
        href="https://getastrothemes.com/astro-themes/stella/?initiate-checkout=true&utm_source=direct"
        id="buy-now-stella"
        data-umami-event="buy-now-stella"
        ><span class="text-flip-inner" data-content="Buy Now">Buy Now</span><span
          class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
          ><svg
            class="gradient-shape"
            width="150"
            height="28"
            viewBox="0 0 147 11"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
              stroke="currentColor"
              stroke-width="8"></path></svg
          ></span
        ></a
      >
      <a
        rel="noopener noreferrer"
        target="_blank"
        class="btn btn-outline text-flip-hover-anim"
        href="https://getastrothemes.com/astro-themes/stella/?utm_source=direct"
        id="buy-now-stella"
        data-umami-event="buy-now-stella"
        ><span class="text-flip-inner" data-content="Theme Details">Theme Details</span><span
          class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
          ><svg
            class="gradient-shape"
            width="150"
            height="28"
            viewBox="0 0 147 11"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
              stroke="currentColor"
              stroke-width="8"></path></svg
          ></span
        ></a
      >
    </div>
    <script type="module" is:inline>
      function c() {
        try {
          return window.self !== window.top;
        } catch {
          return !0;
        }
      }
      if (!c()) {
        const t = document.getElementById("action-buttons");
        t &&
          (t.classList.remove("hidden"),
          window.addEventListener("scroll", () => {
            const o = window.scrollY,
              e = window.innerHeight,
              r = document.documentElement.scrollHeight - (o + e);
            (o >= 500 && t.classList.add("scroll-down"), (o <= 500 || r <= 100) && t.classList.remove("scroll-down"));
          }),
          (() => {
            const o = "checkout-ref";
            let e = localStorage.getItem(o);
            (e || ((e = document.referrer || "direct"), e && localStorage.setItem(o, e)),
              e &&
                t.querySelectorAll("a").forEach((n) => {
                  const r = n.href.includes("?") ? "&" : "?";
                  n.href += `${r}utm_source=${encodeURIComponent(e)}`;
                }));
          })());
      }
    </script>
  </main>
  <Footer />
</Layout>
