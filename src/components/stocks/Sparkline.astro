---
/**
 * A small trend line drawn as inline SVG on the server - no chart library and
 * no script, so ten of them cost a few hundred bytes of path each. Points are
 * spaced evenly rather than by clock time: at this size the shape is what
 * reads, not when each minute fell.
 *
 * `vector-effect` keeps the stroke 1.5px wide however the viewBox is stretched.
 */
interface Props {
  points: number[];
  up: boolean;
  class?: string;
}

const { points, up, class: className = "" } = Astro.props;

const WIDTH = 120;
const HEIGHT = 36;
const PAD = 2;

const min = Math.min(...points);
const max = Math.max(...points);
const span = max - min || 1;
const d = points
  .map((value, i) => {
    const x = points.length > 1 ? (i / (points.length - 1)) * WIDTH : WIDTH / 2;
    const y = PAD + (1 - (value - min) / span) * (HEIGHT - PAD * 2);
    return `${i === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`;
  })
  .join("");
---

{
  points.length > 1 && (
    <svg
      viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
      width={WIDTH}
      height={HEIGHT}
      preserveAspectRatio="none"
      aria-hidden="true"
      class:list={[up ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400", className]}
    >
      <path
        d={d}
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  )
}
