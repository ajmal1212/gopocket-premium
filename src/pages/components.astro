<span class="line"><span style="color:#800000">/&gt;</span></span>
<span class="line"><span style="color:#800000">&lt;</span><span style="color:#267F99">CustomButton</span><span style="color:#E50000"> variant</span><span style="color:#000000">=</span><span style="color:#A31515">"text"</span><span style="color:#E50000"> label</span><span style="color:#000000">=</span><span style="color:#A31515">"Example Button"</span><span style="color:#E50000"> url</span><span style="color:#000000">=</span><span style="color:#A31515">"/"</span><span style="color:#800000"> /&gt;</span></span></code></pre>
<a class="btn btn-primary text-flip-hover-anim" href="/"><span class="text-flip-inner" data-content="Example Button">Example Button</span><span class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"><svg class="gradient-shape" width="150" height="28" viewBox="0 0 147 11" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433" stroke="currentColor" stroke-width="8"></path></svg></span></a>
