---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Frequently asked questions - Multipurpose Saas & Startup Astro Js Theme"
  description="Everything you need to know — from what we do to how we do it — in one quick FAQ section."
