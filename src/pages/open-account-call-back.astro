---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PowerfulTools from "../components/PowerfulTools.astro";
import TradingJourney from "../components/TradingJourney.astro";
import SpecialBenefits from "../components/SpecialBenefits.astro";
import PricingSection from "../components/PricingSection.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import FinalCTA from "../components/FinalCTA.astro";

// Optional query parameters: src (default 'Website'), tag (default 'Menu')
const srcParam = Astro.url.searchParams.get("src") || "Website";
const tagParam = Astro.url.searchParams.get("tag") || "Menu";
---

<Layout
  title="Open your Free Demat Account with GoPocket"
  description="One account to invest in stocks, derivatives, commodities, mutual funds, IPOs, and more with GoPocket."
>
  <Header currentPath="/open-account-call-back" />

  <main class="has-section-spacing-lg">
    <!-- Hero Call-Back Section -->
    <section class="relative z-10 pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden">
      <div class="container max-w-6xl">
        <!-- Top Green Pill Badge -->
        <div class="flex justify-center mb-6">
          <span class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-emerald-100 text-emerald-800 text-sm font-semibold tracking-wide border border-emerald-300/60 shadow-2xs">
            Start your trading journey
          </span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-center text-dark tracking-tight leading-tight max-w-4xl mx-auto mb-10 sm:mb-14">
          Open your Free Demat Account with <span class="text-[#7c3aed]">GoPocket</span>
        </h1>

        <!-- 2-Column Hero Grid: Image on Left, Form on Right -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- LEFT SIDE: Image (open account call back.png) -->
          <div class="lg:col-span-6 flex justify-center items-center">
            <div class="relative w-full max-w-md lg:max-w-full">
              <img
                src="/assets/images/gopocket/open account call back.png"
                alt="GoPocket Mobile App Open Account"
                class="w-full h-auto object-contain mx-auto drop-shadow-xl"
                loading="eager"
              />
            </div>
          </div>

          <!-- RIGHT SIDE: Form -->
          <div class="lg:col-span-6 bg-white p-6 sm:p-10 rounded-3xl border border-border-light shadow-xl space-y-6">
            <div class="space-y-2">
              <h2 class="text-3xl sm:text-4xl font-bold text-dark tracking-tight">
                Signup now
              </h2>
              <p class="text-text-default opacity-85 text-base sm:text-lg leading-relaxed font-normal">
                One account to invest in stocks, derivatives, commodities, mutual funds, IPOs, and more.
              </p>
            </div>

            <form class="space-y-5" onsubmit="event.preventDefault()">
              <!-- Hidden Query Parameters for Tracking -->
              <input type="hidden" name="src" value={srcParam} />
              <input type="hidden" name="tag" value={tagParam} />

              <div class="space-y-2">
                <label class="block text-sm font-semibold text-dark">
                  Mobile
                </label>
                <div class="relative flex items-center">
                  <!-- Indian Flag Icon -->
                  <div class="absolute left-3.5 flex items-center gap-1.5 pointer-events-none text-gray-700 font-medium text-sm">
                    <span class="text-xl">🇮🇳</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                  <input
                    type="tel"
                    placeholder="Your Mobile Number"
                    class="w-full pl-16 pr-4 py-4 bg-white border-2 border-[#f97316] focus:border-[#7c3aed] rounded-2xl text-dark placeholder-gray-400 text-base focus:outline-none transition-all shadow-2xs font-medium"
                    required
                  />
                </div>
              </div>

              <!-- Open Account Submit Button -->
              <button
                type="submit"
                class="w-full py-4 bg-[#7c3aed] hover:bg-[#6d28d9] text-white font-bold text-lg rounded-2xl transition duration-300 shadow-md hover:shadow-lg cursor-pointer flex items-center justify-center"
              >
                Open Account
              </button>
            </form>

            <!-- Disclaimer Note (Green Box from Screenshot) -->
            <div class="p-4 sm:p-5 rounded-2xl bg-[#dcfce7] border border-[#bbf7d0] text-emerald-900 text-xs sm:text-sm leading-relaxed font-medium">
              Note: By submitting above details, you are authorizing GoPocket / its sub-brokers / agents to call you send promotional communication even though you being registered under DND.
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Additional Index.astro Sections for Rich Aesthetics -->
    <PowerfulTools />
    <TradingJourney />
    <SpecialBenefits />
    <PricingSection />
    <TestimonialsSection />
    <FinalCTA />
  </main>

  <Footer />
</Layout>
