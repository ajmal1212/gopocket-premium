<script type="module" is:inline>
  (function () {
    const m = document.getElementById("global-search-modal");
    if (!m) return;
    const i = document.getElementById("global-search-input"),
      list = document.getElementById("global-search-list"),
      empty = document.getElementById("global-search-empty"),
      tabs = [...m.querySelectorAll(".global-search-tab")],
      items = [...list.querySelectorAll(".global-search-item")];
    let activeCategory = "all";
    function applyFilters() {
      const q = i.value.trim().toLowerCase();
      let visible = 0;
      items.forEach((li) => {
        const key = (li.dataset.key || "").toLowerCase(),
          name = (li.dataset.name || "").toLowerCase(),
          cat = li.dataset.category;
        const catOk = activeCategory === "all" || cat === activeCategory;
        const qOk = !q || key.includes(q) || name.includes(q);
        const ok = catOk && qOk;
        li.hidden = !ok;
        if (ok) visible++;
      });
      empty.hidden = visible !== 0;
    }

    function open() {
      m.classList.add("is-open");
      m.setAttribute("aria-hidden", "false");
      i.value = "";
      activeCategory = "all";
      tabs.forEach((t) => t.classList.toggle("is-active", t.dataset.category === "all"));
      applyFilters();
      setTimeout(() => i.focus(), 50);
    }
    function close() {
      m.classList.remove("is-open");
      m.setAttribute("aria-hidden", "true");
    }

    document.querySelectorAll(".search-toggle-btn").forEach((b) => b.addEventListener("click", open));
    m.querySelectorAll("[data-search-close]").forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && m.classList.contains("is-open")) close();
    });
    i.addEventListener("input", applyFilters);
    tabs.forEach((t) =>
      t.addEventListener("click", () => {
        activeCategory = t.dataset.category;
        tabs.forEach((x) => x.classList.toggle("is-active", x === t));
        applyFilters();
      }),
    );
  })();
</script>

<script>
  import { register, unregister, subscribe } from "@/lib/feed/client";
  import type { Tick } from "@/lib/feed/types";

  /**
   * Live prices and instrument search inside the header popup.
   *
   * Typing queries Contract Master through /api/contract-search - server-side,
   * because the Frappe token must not reach a browser. Every row on screen,
   * whether it came from a search, the trending list or the visitor's history,
   * subscribes to the feed, so a name always arrives with a price beside it.
   *
   * Rows are ordinary links to /stocks/<slug>; clicking one records it as recent
   * and navigates. The feed client is a module singleton, so all of this shares
   * one socket with anything else on the page that wants prices.
   */

  const DEBOUNCE_MS = 300;
  const MIN_QUERY = 2;
  const RECENT_KEY = "gopocket_recent_searches";
  const RECENT_LIMIT = 3;

  interface Scrip {
    key: string;
    symbol: string;
    exchange: string;
    name: string;
    slug: string;
  }

  const escapeHtml = (value: string): string =>
    value.replace(
      /[&<>"']/g,
      (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] as string,
    );

  const modal = document.getElementById("global-search-modal");
  const input = document.getElementById("global-search-input") as HTMLInputElement | null;
  const marketSection = document.getElementById("gs-market-section");
  const marketList = document.getElementById("gs-market-list");
  const marketLabel = document.getElementById("gs-market-label");
  const recentSection = document.getElementById("global-search-recent-section");
  const recentList = document.getElementById("global-search-recent-list");
  const trendingList = document.getElementById("global-search-list");

  if (modal && input && marketSection && marketList && marketLabel && recentSection && recentList) {
    let results: Scrip[] = [];
    let debounce: ReturnType<typeof setTimeout> | null = null;
    let inFlight: AbortController | null = null;
    /** token -> teardown, so a re-render never leaks a listener. */
    const bound = new Map<string, () => void>();

    function loadRecent(): Scrip[] {
      try {
        const raw = localStorage.getItem(RECENT_KEY);
        const parsed = raw ? (JSON.parse(raw) as Scrip[]) : [];
        // Anything stored by an older version of this popup lacked a feed token
        // and a slug, so it can neither be priced nor linked. Entries without a
        // symbol came from trending rows that were missing data-symbol - they
        // would render as a blank title, so they are dropped too.
        return parsed.filter((scrip) => scrip && scrip.key && scrip.slug && scrip.symbol).slice(0, RECENT_LIMIT);
      } catch {
        return [];
      }
    }

    function rememberRecent(scrip: Scrip) {
      try {
        const next = [scrip, ...loadRecent().filter((r) => r.key !== scrip.key)].slice(0, RECENT_LIMIT);
        localStorage.setItem(RECENT_KEY, JSON.stringify(next));
      } catch {
        // A private window with storage blocked still gets a working search.
      }
    }

    const num = (value: string | undefined) => {
      if (!value) return null;
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : null;
    };

    const money = (value: number) =>
      "₹" + value.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    function row(scrip: Scrip): HTMLLIElement {
      const li = document.createElement("li");
      li.className = "global-search-item";
      li.dataset.token = scrip.key;
      li.dataset.slug = scrip.slug;
      li.dataset.symbol = scrip.symbol;
      li.dataset.name = scrip.name;
      li.dataset.exchange = scrip.exchange;
      li.innerHTML = [
        '<a href="/stocks/' + encodeURIComponent(scrip.slug) + '" class="w-full justify-between gap-3">',
        '<span class="min-w-0">',
        '<span class="text-dark block truncate text-sm font-semibold">',
        escapeHtml(scrip.symbol),
        '<span class="border-border-light text-text-default/70 ml-1.5 rounded border px-1 py-0.5 text-[10px] font-semibold uppercase">',
        escapeHtml(scrip.exchange),
        "</span></span>",
        '<span class="text-text-default/70 block truncate text-[11px]">',
        escapeHtml(scrip.name),
        "</span></span>",
        '<span class="shrink-0 text-right">',
        '<span class="text-dark block text-sm font-semibold tabular-nums" data-gs-price>—</span>',
        '<span class="block text-[11px] font-medium tabular-nums" data-gs-change></span>',
        "</span></a>",
      ].join("");
      return li;
    }

    function paint(li: HTMLElement, tick: Tick) {
      const last = num(tick.lp);
      const percent = num(tick.pc);
      const previousClose = num(tick.c);

      const price = li.querySelector<HTMLElement>("[data-gs-price]");
      if (price && last !== null) price.textContent = money(last);

      const change = li.querySelector<HTMLElement>("[data-gs-change]");
      if (change && last !== null && percent !== null && previousClose !== null) {
        const delta = last - previousClose;
        const up = percent >= 0;
        const sign = up ? "+" : "";
        change.textContent = sign + delta.toFixed(2) + " (" + sign + percent.toFixed(2) + "%)";
        change.classList.toggle("text-emerald-600", up);
        change.classList.toggle("text-red-600", !up);
      }
    }

    /** Every row on screen, whichever list it belongs to. */
    const visibleRows = (): HTMLElement[] => [
      ...(recentList.children as HTMLCollectionOf<HTMLElement>),
      ...(marketList.children as HTMLCollectionOf<HTMLElement>),
      ...(trendingList
        ? (trendingList.querySelectorAll<HTMLElement>("li[data-token]") as unknown as HTMLElement[])
        : []),
    ];

    function bindPrices() {
      for (const teardown of bound.values()) teardown();
      bound.clear();

      const tokens: string[] = [];
      for (const li of visibleRows()) {
        const token = li.dataset.token;
        if (!token) continue;
        tokens.push(token);
        bound.set(
          token + ":" + tokens.length,
          subscribe(token, (tick) => paint(li, tick)),
        );
      }

      register("gs-popup", [...new Set(tokens)]);
    }

    function renderRecent() {
      const recent = loadRecent();
      recentSection.hidden = recent.length === 0;
      recentList.replaceChildren(...recent.map(row));
    }

    function renderResults() {
      marketSection.hidden = results.length === 0;
      marketLabel.textContent = "Instruments · " + results.length;
      marketList.replaceChildren(...results.map(row));
    }

    async function search(term: string) {
      inFlight?.abort();

      if (term.length < MIN_QUERY) {
        results = [];
        renderResults();
        bindPrices();
        return;
      }

      inFlight = new AbortController();
      try {
        const response = await fetch("/api/contract-search?q=" + encodeURIComponent(term), {
          signal: inFlight.signal,
        });
        const body = (await response.json()) as { results?: Scrip[] };
        results = body.results ?? [];
        renderResults();
        bindPrices();
      } catch {
        // An aborted request is the common case: the user kept typing.
      }
    }

    input.addEventListener("input", () => {
      if (debounce) clearTimeout(debounce);
      const term = input.value.trim();
      debounce = setTimeout(() => search(term), DEBOUNCE_MS);
    });

    // Recording happens on the way out, without preventDefault, so the browser
    // still follows the link to the stock page.
    modal.addEventListener("click", (event) => {
      const li = (event.target as HTMLElement).closest<HTMLElement>("li[data-token]");
      if (!li?.dataset.token || !li.dataset.slug) return;
      rememberRecent({
        key: li.dataset.token,
        slug: li.dataset.slug,
        symbol: li.dataset.symbol || "",
        name: li.dataset.name || "",
        exchange: li.dataset.exchange || "",
      });
    });

    new MutationObserver(() => {
      if (modal.getAttribute("aria-hidden") === "true") {
        // Nothing is on screen, so nothing needs a price. The hub drops a token
        // upstream once nobody anywhere is watching it.
        unregister("gs-popup");
        for (const teardown of bound.values()) teardown();
        bound.clear();
      } else {
        renderRecent();
        bindPrices();
      }
    }).observe(modal, { attributes: true, attributeFilter: ["aria-hidden"] });

    renderRecent();
  }
</script>
