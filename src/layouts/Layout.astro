---
import "../styles/global.css";
// Must come after global.css: the dark overrides are unlayered and rely on
// following Tailwind's layers in source order.
import "../styles/dark-theme.css";
import "../styles/accessibility.css";
import GlobalSearch from "../components/GlobalSearch.astro";
import GlobalScripts from "../components/GlobalScripts.astro";
import AccessibilityWidget from "../components/AccessibilityWidget.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title = "GoPocket - Open a Free Demat Account | Online Stock Trading App",
  description = "GoPocket is a SEBI-registered online trading and demat account platform. Trade stocks, F&O, mutual funds, commodities and IPOs at flat ₹20 per order or 0.03%, whichever is lower.",
  keywords = "demat account, online trading, stock broker India, discount broker, GoPocket, F&O trading, mutual funds, IPO",
  canonical = "https://gopocket.in/",
  ogImage = "https://gopocket.in/favicon.png",
  ogType = "website",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Language" content="en" />
    <meta name="theme" content="gopocket" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="GoPocket" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} item-prop="url" />
    <link rel="alternate" hreflang="en" href={canonical} />
    {/* Replaced by the theme script below once the resolved theme is known. */}
    <meta name="theme-color" content="#ffffff" />

    {/*
      Resolves the theme and accessibility settings before first paint so the page
      never flashes incorrect styles.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("gp-theme");
          var isDark =
            stored === "dark" ||
            (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (isDark) {
            document.documentElement.classList.add("dark");
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute("content", "#0b0d13");
          }

          var a11yStored = localStorage.getItem("gp-a11y-settings");
          if (a11yStored) {
            var a11y = JSON.parse(a11yStored);
            var html = document.documentElement;
            if (a11y.contrast === "high") html.setAttribute("data-a11y-contrast", "high");
            else if (a11y.contrast === "invert") html.setAttribute("data-a11y-contrast", "invert");
            if (a11y.fontScale && a11y.fontScale !== "normal") html.setAttribute("data-a11y-font-scale", a11y.fontScale);
            if (a11y.theme && a11y.theme !== "none") html.setAttribute("data-a11y-theme", a11y.theme);
            if (a11y.hideImages) html.setAttribute("data-a11y-hide-images", "true");
            if (a11y.grayscale) html.setAttribute("data-a11y-grayscale", "true");
            if (a11y.bluelight) html.setAttribute("data-a11y-bluelight", "true");
            if (a11y.adhd) html.setAttribute("data-a11y-adhd", "true");
            if (a11y.dyslexia) html.setAttribute("data-a11y-dyslexia", "true");
            if (a11y.highlightLinks) html.setAttribute("data-a11y-highlight-links", "true");
            if (a11y.focusIndicator) html.setAttribute("data-a11y-focus-indicator", "true");

            var isAnyActive =
              a11y.speech ||
              (a11y.contrast && a11y.contrast !== "normal") ||
              (a11y.fontScale && a11y.fontScale !== "normal") ||
              (a11y.theme && a11y.theme !== "none") ||
              a11y.hideImages ||
              a11y.grayscale ||
              a11y.bluelight ||
              a11y.adhd ||
              a11y.dyslexia ||
              a11y.highlightLinks ||
              a11y.focusIndicator;

            if (isAnyActive) html.setAttribute("data-a11y-active", "true");
          }
        } catch (e) {
          /* Storage blocked - fall through to light default. */
        }
      })();
    </script>

    <meta property="og:image" content={ogImage} />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="GoPocket" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <meta name="msapplication-TileColor" content="#2b5797" />
    <meta name="apple-mobile-web-app-title" content="GoPocket" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        description: description,
        image: ogImage,
        url: canonical,
        inLanguage: "en",
        isPartOf: {
          "@type": "WebSite",
          name: "GoPocket",
          description:
            "GoPocket is a SEBI-registered online trading and demat account platform for stocks, F&O, mutual funds, commodities and IPOs.",
          url: "https://gopocket.in/",
        },
        publisher: {
          "@type": "Organization",
          name: "GoPocket",
          url: "https://gopocket.in/",
          sameAs: [
            "https://www.facebook.com",
            "https://twitter.com",
            "https://www.instagram.com",
            "https://www.linkedin.com",
          ],
          logo: { "@type": "ImageObject", url: "https://gopocket.in/gopocket-logo.svg" },
        },
      })}
    />

    {/*
      Figtree and Instrument Serif are self-hosted from /public/fonts and declared
      via @font-face in global.css. Preload them here so the browser can start the
      download immediately instead of waiting for the stylesheet to parse - the
      @font-face rules sit inside a large CSS bundle, so discovery is otherwise late.
    */}
    <link rel="preload" href="/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Per-page head extras (article meta, JSON-LD, etc.) -->
    <slot name="head" />

  </head>

  <body>
    <slot />
    <GlobalSearch />
    <GlobalScripts />
    <AccessibilityWidget />
  </body>
</html>
