  <script type="module" is:inline={true}>
    const r = document.querySelector(".cta-section"),
      a = document.querySelector("footer");
    r || a.classList.add("has-call-to-action");
    // Scales the oversized brand wordmark to its container. The probe has to be
    // maxSize: the wordmark is a single block-level word, so at any size that
    // fits, scrollWidth collapses to clientWidth and the ratio reads as 1.
    // The measurement itself is unavoidable, but it now runs after first paint
    // and is debounced on resize rather than thrashing layout during load.
    function fitBrandText(el, { minSize = 12, maxSize = 500 } = {}) {
      const parent = el.parentElement;
      if (!parent) return;
      el.style.fontSize = `${maxSize}px`;
      const textWidth = el.scrollWidth;
      if (!textWidth) return;
      const size = Math.max(minSize, Math.min(maxSize, (parent.clientWidth / textWidth) * maxSize));
      el.style.fontSize = `${size}px`;
    }

    const brandTexts = document.querySelectorAll(".responsive-brand-text");
    const fitAllBrandText = () => brandTexts.forEach((el) => fitBrandText(el, { minSize: 20, maxSize: 800 }));
    if (brandTexts.length) {
      let brandResizeTimer;
      window.addEventListener("resize", () => {
        clearTimeout(brandResizeTimer);
        brandResizeTimer = window.setTimeout(fitAllBrandText, 100);
      });
      requestAnimationFrame(fitAllBrandText);
    }
  </script>
