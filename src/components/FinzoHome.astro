---
import Header from "./Header.astro";
import Hero2 from "./Hero2.astro";
import FinancialFuture2 from "./FinancialFuture2.astro";
import FinancialJourney2 from "./FinancialJourney2.astro";
import KeyInsights2 from "./KeyInsights2.astro";
import FinancesControl2 from "./FinancesControl2.astro";
import SmartManagement2 from "./SmartManagement2.astro";
import AppIntegration2 from "./AppIntegration2.astro";
import Pricing2 from "./Pricing2.astro";
import Testimonials2 from "./Testimonials2.astro";
import BlogInsights2 from "./BlogInsights2.astro";
import CallToAction2 from "./CallToAction2.astro";
import Footer2 from "./Footer2.astro";
import Footer from "./Footer.astro";
---

<link rel="stylesheet" href="/assets/finzo-astro.pages.dev/CallToAction.BIPTfcXz-f32c85d6.css" />
<link rel="stylesheet" href="/assets/finzo-astro.pages.dev/TestimonialSection.vGUScjdh-0f4ce9dd.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Inter:ital,wght@0,100..900;1,100..900&display=swap"
  rel="stylesheet"
/>

<div class="finzo-home-component">
  <Header currentPath="/finzo" />
  <main class="has-section-spacing-lg">
    <Hero2 />
    <FinancialFuture2 />
    <FinancialJourney2 />
    <KeyInsights2 />
    <FinancesControl2 />
    <SmartManagement2 />
    <AppIntegration2 />
    <Pricing2 />
    <Testimonials2 />
    <BlogInsights2 />
    <CallToAction2 />
  </main>
  <Footer />
