---
// AppIntegration2 Component
---

<section class="overflow-hidden">
  <div class="container space-y-10 md:space-y-16">
    <div class="space-y-4 text-center">
      <h3
        data-duration="0.6"
        data-delay="0.2"
        data-stagger="0.09"
        class="has-italic-text capitalize animated-text is-ready"
        style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
      >
        <span class="word" style="--word-index:0">Connect</span>
        <span class="word" style="--word-index:1">GoPocket</span>
        <span class="word" style="--word-index:2">To</span>
        <strong
          ><span class="word" style="--word-index:3">Your</span>
          <span class="word" style="--word-index:4">Own</span>
          <span class="word" style="--word-index:5">Tools</span></strong
        >
        <p class="mx-auto max-w-xl text-base normal-case opacity-80">
          Our open APIs let you plug your GoPocket account into the dashboards, bots and alerting tools you already use.
        </p>
      </h3>
      <div class="space-y-16 text-center">
        <div
          data-aos="fade-up-sm"
          data-aos-delay="300"
          class="mx-auto grid max-w-4xl grid-cols-4 grid-rows-2 place-items-center gap-x-14 gap-y-10 sm:grid-cols-6 aos-init"
        >
          <img
            src="/assets/images/integration-discord.webp"
            alt="Discord"
            loading="lazy"
            decoding="async"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
            width="150"
            height="150"
            class="h-auto w-16 justify-items-center overflow-hidden rounded-xl bg-white drop-shadow-2xl drop-shadow-black/5 lg:w-[calc(100%-2.5rem)] lg:translate-x-20"
          /><img
            src="/assets/images/integration-discord.webp"
            alt="Discord"
            loading="lazy"
            decoding="async"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
            width="150"
            height="150"
            class="h-auto w-16 justify-items-center overflow-hidden rounded-xl bg-white drop-shadow-2xl drop-shadow-black/5 lg:w-[calc(100%-2.5rem)] lg:translate-x-20"
          /><img
            src="/assets/images/integration-email.webp"
            alt="Email"
            loading="lazy"
            decoding="async"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
            width="150"
            height="151"
            class="h-auto w-16 justify-items-center overflow-hidden rounded-xl bg-white drop-shadow-2xl drop-shadow-black/5 lg:w-[calc(100%-2.5rem)] lg:translate-x-20"
          /><img
            src="/assets/images/integration-fivetran.webp"
            alt="Fivetran"
            loading="lazy"
            decoding="async"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
            width="147"
            height="151"
            class="h-auto w-16 justify-items-center overflow-hidden rounded-xl bg-white drop-shadow-2xl drop-shadow-black/5 lg:w-[calc(100%-2.5rem)] lg:translate-x-20"
          /><img
            src="/assets/images/integration-jira.svg"
            alt="Jira Connector"
            loading="lazy"
            decoding="async"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
            width="83"
            height="83"
            class="h-auto w-16 justify-items-center overflow-hidden rounded-xl bg-white drop-shadow-2xl drop-shadow-black/5 lg:w-[calc(100%-2.5rem)] lg:translate-x-20"
