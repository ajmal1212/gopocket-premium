---
/**
 * EducationStack
 * -----------------------------------------------------------------------------
 * The "GoPocket simplifies Online Trading for you" section, built as a deck of
 * cards that stack as the page scrolls.
 *
 * LOOK
 * Deliberately borrows TradingJourney's shell — a tinted band holding
 * rounded-4xl cards — so the deck reads as the same family as the rest of the
 * homepage. Type and the eyebrow use Tailwind utilities that dark-theme.css
 * already remaps; the two things this file colours itself, the band and the
 * per-card wash, each carry an explicit dark pair below.
 *
 * The per-card tints are wayfinding, not decoration: a buried card shows only
 * its top strip, so giving each one a different wash is what tells the reader
 * how many cards are stacked up behind the one they are reading.
 *
 * HOW THE STACK WORKS
 * Every card is `position: sticky` with a `top` one peek-height further down
 * than the card before it, so each one pins in turn and the next scrolls up
 * over it, leaving a thin strip of the covered card showing. That much is pure
 * CSS and works with JavaScript off.
 *
 * The script only adds the polish: it measures how far the *next* card has
 * travelled over each card and writes that 0..1 progress to `--p`, which the
 * inner panel uses to shrink and dim as it is buried. The transform sits on
 * `.edu-card-inner` and never on the sticky element itself — measuring a
 * transformed box would feed the scaling back into its own input.
 *
 * A card taller than the viewport can never pin cleanly, so the script falls
 * back to a plain vertical list (`is-flat`) when that happens, as does
 * prefers-reduced-motion.
 */

interface Card {
  title: string;
  body: string;
  /**
   * Saturated seed for the card's wash. Never painted at full strength — the
   * CSS mixes ~10% of it into the card colour, so what lands on screen is a
   * pale tint. One value covers light and dark; see the `.edu-card-inner`
   * rules for how each theme derives from it.
   */
  tint: string;
  img: string;
  /**
   * Each artwork already renders the card's headline inside it, so the alt
   * text describes the illustration instead of repeating the <h3> next to it —
   * otherwise a screen reader announces the same sentence twice per card.
   */
  alt: string;
}

const cards: Card[] = [
  {
    title: "Become Financially Aware by learning basics.",
    body: "With easy-to-understand modules, explore the basics of Trading.",
    tint: "#6b1aff",
    img: "/assets/images/gopocket/1",
    alt: "A person stepping through a doorway onto steps marked Learn, Understand, Apply and Grow, beside panels listing the financial basics: income and expense, budgeting, debt management, investing, risk and returns.",
  },
  {
    title: "Financial Experts are one call away!",
    body: "Our experts help you every step of the way, from start to finish.",
    tint: "#14b8a6",
    img: "/assets/images/gopocket/2",
    alt: "A phone showing a call icon above steps marked Connect, Consult, Plan and Prosper, flanked by panels for certified experts, personalised advice and long-term support across investments, insurance, tax and retirement planning.",
  },
  {
    title: "Everyone can Learn and Earn effectively.",
    body: "Not just investing, but creating Smart Investors.",
    tint: "#f5a524",
    img: "/assets/images/gopocket/3",
    alt: "A Learn panel and an Earn panel either side of a rising progress chart, with steps marked Study, Understand, Apply and Earn leading up to it.",
  },
  {
    // Fourth card: the live side of Research & Learn, so the deck ends on
    // something the reader can act on today rather than another promise.
    title: "Live workshops, whenever you are ready.",
    body: "Join weekly masterclasses and webinars, or download the material from any session you missed.",
    tint: "#f43f5e",
    img: "/assets/images/gopocket/4",
    alt: "A mentor presenting a live session to seated attendees, beside panels for flexible scheduling, live interaction, session recordings and a certificate of participation.",
  },
];
---

<!-- No padding utilities on the section: `main.has-section-spacing-lg > section`
     in global.css already sets the lead-in. The band below carries its own
     padding, exactly as TradingJourney's does. -->
<section>
  <div class="edu-band py-20 md:py-32">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-xs font-semibold tracking-wider text-primary uppercase"
        >
          Education
        </span>
        <h2 class="has-italic-text">
          <div
            class="animated-text is-ready"
            data-duration="0.6"
            data-delay="0.2"
            data-stagger="0.09"
            style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
          >
            <span class="word" style="--word-index:0">GoPocket</span>
            <span class="word" style="--word-index:1">simplifies</span>
            <strong>
              <span class="word" style="--word-index:2">Online</span>
              <span class="word" style="--word-index:3">Trading</span>
            </strong>
            <span class="word" style="--word-index:4">for</span>
            <span class="word" style="--word-index:5">you.</span>
          </div>
        </h2>
      </div>

      <div class="edu-stack" data-edu-stack>
        {
          cards.map((card, i) => (
            <article
              class="edu-card"
              data-edu-card
              style={`--i:${i};--edu-tint:${card.tint}`}
            >
              <div class="edu-card-inner rounded-4xl">
                <div class="edu-main">
                  <div
                    class="edu-num text-h3-sm md:text-h3 text-dark/70 font-medium"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, "0")}
                  </div>
                  <div class="edu-copy">
                    <h3 class="text-h4-sm md:text-h4 text-dark font-medium">
                      {card.title}
                    </h3>
                    <p class="text-text-default opacity-80 md:text-lg/relaxed">
                      {card.body}
                    </p>
                  </div>
                </div>

                <img
                  class="edu-figure"
                  src={`${card.img}-840.webp`}
                  srcset={`${card.img}-420.webp 420w, ${card.img}-840.webp 840w`}
                  sizes="(min-width: 768px) 420px, 100vw"
                  alt={card.alt}
                  width="840"
                  height="840"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* A cooler ground than the theme-light grey the other bands use, so the deck
     reads as its own beat between DiversifyShowcase and SmartManagement2. It
     starts at full tint and washes out to the page colour at the foot, so the
     band closes into the white section below it instead of ending on a seam —
     the crisp edge stays at the top, where a section boundary belongs.

     Hardcoded rather than bg-theme-light, so it needs its own dark pair:
     surface-2 is what theme-light resolves to there, and surface-0 is the dark
     page canvas, so the same wash-out holds. */
  .edu-band {
    background-image: linear-gradient(to bottom, #f3f7fa 0%, #ffffff 100%);
  }

  :global(html.dark) .edu-band {
    background-image: linear-gradient(
      to bottom,
      var(--surface-2) 0%,
      var(--surface-0) 100%
    );
  }

  .edu-stack {
    /* Clears the sticky header (top: 1.25rem plus roughly 4rem of nav) with a
       little air above the pinned card. */
    --edu-top: 7rem;
    /* Strip of each covered card left showing above the one on top of it. */
    --edu-peek: 1.1rem;

    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2.5rem;

    /* Narrower than the container the rest of the page uses, so the square
       artwork keeps a near-even share of the card rather than reading as a
       picture tacked onto a wide text panel. Widened from 60rem to buy the
       headline the room it needs to sit on one line. */
    max-width: 68rem;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .edu-stack {
      --edu-peek: 1.5rem;
      gap: 2rem;
      margin-top: 4rem;
    }
  }

  .edu-card {
    position: sticky;
    top: calc(var(--edu-top) + var(--i) * var(--edu-peek));
    /* Later cards must paint over earlier ones as they ride up. */
    z-index: calc(var(--i) + 1);
  }

  .edu-card-inner {
    /* 0 while the card is the top of the deck, 1 once the next card has fully
       covered it. Written by the script; without it this stays 0 and the deck
       still stacks, just without the shrink. */
    --p: 0;

    display: flex;
    flex-direction: column;

    /* The artwork runs flush to three edges, so the card's own radius is what
       rounds it — nothing else clips here. */
    overflow: hidden;

    /* Each card washes its own tint down into white. The strip left showing
       once a card is buried is its top ~1.5rem — exactly where this gradient
       is at full strength — so the deck accumulates four distinguishable
       bands as you scroll, and you can see how deep the pile is. The tint is
       mixed at 10%, which is a wash rather than a colour; the cards still read
       as the white panels the rest of the homepage uses. */
    background-image: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--edu-tint) 10%, #ffffff) 0%,
      #ffffff 100%
    );

    /* These slide over one another, so a hairline of lift is what separates
       the card on top from the one it is burying. */
    box-shadow: 0 10px 30px -24px var(--shadow-strong);

    /* Scaling from the top edge keeps the peek strip exactly where the sticky
       offset put it, so a covered card narrows rather than slides. */
    transform-origin: 50% 0;
    transform: scale(calc(1 - var(--p) * 0.05));
    opacity: calc(1 - var(--p) * 0.25);

    /* No `will-change` here, deliberately. It reads as the obvious win for a
       scroll-driven transform, but it pins all four cards into permanent
       compositor layers — each one a rounded, clipped surface holding a large
       image, re-rastered in tiles every time --p changes. Tiles that lose the
       race show up as blocks of stale or half-decoded pixels across the
       artwork. The scale is 5% on four elements; the browser handles it fine
       promoting on its own terms, and the image stays crisp. */
  }

  /* surface-1 is what bg-white resolves to in dark. The tint has to be mixed
     harder there — 10% of a hue in a near-black is invisible. */
  :global(html.dark) .edu-card-inner {
    background-image: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--edu-tint) 20%, var(--surface-1)) 0%,
      var(--surface-1) 100%
    );
  }

  @media (min-width: 768px) {
    .edu-card-inner {
      /* Card height and artwork edge are the same number: the image is square
         and runs the full height of the card, so its width is the height. This
         is the one value to turn to resize the artwork.

         It cannot grow much past this — a card taller than the viewport can
         never pin, and the script flattens the deck. At 420px the last card
         sits at 420 + its 184px sticky offset, which still clears a laptop. */
      /* 34vw rather than 40vw: unchanged at the 420px ceiling on a wide screen,
         but it stops the artwork from eating the headline's one-line room on a
         1024–1200px desktop. */
      --edu-h: clamp(320px, 34vw, 420px);

      flex-direction: row;
      align-items: stretch;
      min-height: var(--edu-h);
    }
  }

  /* Numeral and copy travel together as the left half, so the artwork is the
     card's only right-hand column. This is also the only padded box in the
     card — the image itself gets none. */
  .edu-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .edu-main {
      flex: 1;
      /* Centred against the artwork rather than top-aligned to it. */
      align-self: center;
      min-width: 0;
      padding: 3rem 2.5rem;
    }
  }

  /* The numeral sits above the copy rather than in a column beside it. That
     column cost about 6rem of width, which is most of what the headline needed
     to fit on one line. */
  .edu-num {
    line-height: 1;
  }

  .edu-copy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  /* Deliberately no `white-space: nowrap` here. These headlines are full
     sentences — the longest is 44 characters — and the copy column beside a
     420px artwork is about 590px wide, which only fits that on one line at
     roughly 19px. That is barely above body size and reads as bold body copy,
     not a heading. Forcing nowrap instead pushes the text under the artwork,
     where the card's overflow:hidden clips it mid-word.

     So the type is sized to be read, and wrapping is left to the browser:
     balance splits the two lines evenly rather than leaving one orphan. A
     short headline (2-4 words) would sit on one line here on its own, without
     any nowrap needed. */
  .edu-copy h3 {
    line-height: 1.25;
    text-wrap: balance;
  }

  .edu-copy p {
    max-width: 46ch;
  }

  /* Flush to the card edge on every side it touches: no padding, no radius and
     no border of its own — the card's overflow does the rounding. */
  .edu-figure {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .edu-figure {
      flex: none;
      /* aspect-ratio would make the height definite, which blocks the stretch.
         Width is set from --edu-h instead, and the stretch makes it square
         against the card's matching min-height. If the copy ever runs long
         enough to push the card taller, cover crops rather than letting a gap
         open under the artwork. */
      aspect-ratio: auto;
      align-self: stretch;
      width: var(--edu-h);
      height: auto;
    }
  }

  /* ---- fallback ------------------------------------------------------- */

  /* Set by the script when a card is too tall to pin. The deck degrades to the
     plain vertical list it already is in the DOM. */
  .edu-stack.is-flat .edu-card {
    position: static;
  }

  .edu-stack.is-flat .edu-card-inner {
    transform: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .edu-card {
      position: static;
    }

    .edu-card-inner {
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  function initEduStack(stack: HTMLElement) {
    const cards = Array.from(
      stack.querySelectorAll<HTMLElement>("[data-edu-card]"),
    );
    if (cards.length < 2) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;

    /** A card that cannot clear the viewport once pinned never unpins. */
    function checkFits() {
      const tallest = cards.reduce((max, card) => {
        const top = parseFloat(getComputedStyle(card).top) || 0;
        return Math.max(max, card.offsetHeight + top);
      }, 0);
      stack.classList.toggle("is-flat", tallest > window.innerHeight);
    }

    function update() {
      frame = 0;
      if (stack.classList.contains("is-flat") || reduce.matches) return;

      // The last card is never covered, so it keeps --p at 0.
      for (let i = 0; i < cards.length - 1; i++) {
        const card = cards[i];
        const next = cards[i + 1];
        const inner = card.firstElementChild as HTMLElement | null;
        if (!inner) continue;

        // Distance between the two cards' top edges: `rest` in normal flow,
        // shrinking to `pinned` once both have stuck. offsetTop is the layout
        // position, so it holds still while sticky moves the painted box.
        const rest = next.offsetTop - card.offsetTop;
        const pinned =
          (parseFloat(getComputedStyle(next).top) || 0) -
          (parseFloat(getComputedStyle(card).top) || 0);
        const span = rest - pinned;
        if (span <= 0) continue;

        const live =
          next.getBoundingClientRect().top - card.getBoundingClientRect().top;
        const p = Math.min(1, Math.max(0, (rest - live) / span));

        inner.style.setProperty("--p", p.toFixed(3));
      }
    }

    function schedule() {
      if (frame === 0) frame = requestAnimationFrame(update);
    }

    // Don't burn frames on a section nobody is looking at.
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          window.addEventListener("scroll", schedule, { passive: true });
          schedule();
        } else {
          window.removeEventListener("scroll", schedule);
        }
      },
      { rootMargin: "20% 0px" },
    );
    observer.observe(stack);

    const onResize = () => {
      checkFits();
      schedule();
    };
    window.addEventListener("resize", onResize, { passive: true });
    reduce.addEventListener("change", onResize);

    checkFits();
    update();
  }

  document
    .querySelectorAll<HTMLElement>("[data-edu-stack]")
    .forEach((stack) => initEduStack(stack));
</script>
