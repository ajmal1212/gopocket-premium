---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero3 from "../components/Hero3.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import FAQSection from "../components/FAQSection.astro";
import { getSeminars } from "../lib/frappe";

// Fetch live seminars from Frappe Doctype 'Seminar'
const seminars = await getSeminars();
---

<Layout
  title="Research & Learn - GoPocket Trading Masterclasses & Webinars"
  description="Join live free stock market webinars, options trading workshops, commodity research sessions, and interactive trading masterclasses with GoPocket experts."
>
  <Header currentPath="/research-learn" />

  <main class="has-section-spacing-lg">
    <!-- Hero3 Component -->
    <Hero3 />

    <!-- Webinars Section (Restructured using Frappe JS SDK Live Data) -->
    <section id="webinars">
      <div class="container space-y-10 md:space-y-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="has-italic-text capitalize">
            <div
              class="animated-text is-ready"
              data-duration="0.6"
              data-delay="0.2"
              data-stagger="0.09"
              style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
            >
              <span class="word" style="--word-index:0">Featured</span>
              <span class="word" style="--word-index:1"><strong>Trading</strong></span><strong>
                <span class="word" style="--word-index:2">Webinars</span></strong
              >
            </div>
          </h2>
          <p class="text-text-default opacity-80 mt-3">Register for live upcoming workshops or download materials from completed sessions.</p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:gap-10 max-w-5xl mx-auto">
          {seminars.length === 0 ? (
            <div class="text-center py-12 text-gray-500 bg-theme-light rounded-3xl border border-border-light">
              <p class="text-lg font-medium">No upcoming seminars found at the moment.</p>
              <p class="text-sm mt-1">Please check back soon for live masterclasses & webinars.</p>
            </div>
          ) : (
            seminars.map((item, index) => (
              <div
                data-aos="fade-up-sm"
                data-aos-delay={100 + index * 100}
                class="bg-theme-light flex flex-col md:flex-row rounded-4xl p-6 md:p-8 gap-6 md:gap-10 items-center md:items-start border border-border-light hover:border-black/20 transition-all duration-300 shadow-xs"
              >
                <div
                  class="rounded-3xl overflow-hidden bg-white border border-border-light shadow-sm shrink-0"
                  style="width: 310px; max-width: 100%; aspect-ratio: 500 / 625; flex: 0 0 310px;"
                >
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-cover rounded-3xl"
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-col justify-between space-y-6 w-full h-full" style="flex: 1 1 0%; min-width: 0;">
                  <div class="space-y-5">
                    <div class="flex flex-wrap items-center gap-2.5">
                      <span class="bg-white text-emerald-700 px-3.5 py-1 rounded-full text-xs font-semibold border border-border-light uppercase">{item.type}</span>
                      <span class="bg-primary/10 text-primary px-3.5 py-1 rounded-full text-xs font-semibold uppercase">{item.cost}</span>
                      <span class="text-xs text-text-default opacity-70 font-semibold">| {item.language}</span>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-bold text-dark leading-snug">
                      {item.title}
                    </h3>
                    <div class="flex items-center gap-2.5 text-sm md:text-base font-mono text-text-default opacity-90 font-medium my-4 py-2 border-y border-border-light/60 max-w-fit">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                        <line x1="16" x2="16" y1="2" y2="6"></line>
                        <line x1="8" x2="8" y1="2" y2="6"></line>
                        <line x1="3" x2="21" y1="10" y2="10"></line>
                      </svg>
                      <span>{item.date_and_time || item.formattedDate}</span>
                    </div>
                    <p class="text-text-default opacity-85 text-base md:text-lg/relaxed pt-1 whitespace-pre-line">
                      {item.description}
                    </p>
                  </div>

                  <div class="flex items-center gap-3 pt-4">
                    <a class="btn btn-primary text-flip-hover-anim cursor-pointer" href={`/research-learn/${item.slug}`}>
                      <span class="text-flip-inner" data-content="Register">Register</span>
                      <span class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]">
                        <svg class="gradient-shape" width="150" height="28" viewBox="0 0 147 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433" stroke="currentColor" stroke-width="8"></path>
                        </svg>
                      </span>
                    </a>
                    <button class="p-3 bg-white border border-border-light rounded-full hover:bg-gray-50 text-dark transition-colors cursor-pointer shadow-xs" title="Download Material">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" x2="12" y1="15" y2="3"></line>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            ))
          )}

        </div>
      </div>
    </section>

    <!-- SEO Section 1: Special Benefits / Learning Pillars (Using SpecialBenefits.astro structure) -->
    <section>
      <div class="container space-y-10 md:space-y-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="has-italic-text capitalize">
            <div
              class="animated-text is-ready"
              data-duration="0.6"
              data-delay="0.2"
              data-stagger="0.09"
              style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
            >
              <span class="word" style="--word-index:0">Stock</span>
              <span class="word" style="--word-index:1">Market</span>
              <span class="word" style="--word-index:2">
                <strong>Research</strong>
              </span>
              <strong>
                <span class="word" style="--word-index:3">Pillars</span>
              </strong>
            </div>
          </h2>
          <p class="text-text-default opacity-80 mt-3">Comprehensive educational modules designed to sharpen your trading performance.</p>
        </div>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Card 1 -->
          <div
            data-aos="fade-up-sm"
            data-aos-delay="50"
            data-aos-duration="900"
            class="flex flex-col gap-4 border border-border-light p-6 md:p-8 rounded-3xl bg-theme-light aos-init"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
            <div class="mt-4 space-y-3">
              <h3 class="text-h5-sm md:text-h5 text-dark font-medium">Equity &amp; Stock Analysis</h3>
              <p class="text-text-default opacity-80 text-sm/relaxed">Deep dive into fundamental balance sheet analysis, quarterly earnings reports, and sectorial growth trends.</p>
            </div>
          </div>

          <!-- Card 2 -->
          <div
            data-aos="fade-up-sm"
            data-aos-delay="100"
            data-aos-duration="900"
            class="flex flex-col gap-4 border border-border-light p-6 md:p-8 rounded-3xl bg-theme-light aos-init"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
              <line x1="12" y1="2" x2="12" y2="22"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
            <div class="mt-4 space-y-3">
              <h3 class="text-h5-sm md:text-h5 text-dark font-medium">Options Trading Strategies</h3>
              <p class="text-text-default opacity-80 text-sm/relaxed">Master non-directional option selling, Iron Condors, Short Straddles, and Delta decay hedging techniques.</p>
            </div>
          </div>

          <!-- Card 3 -->
          <div
            data-aos="fade-up-sm"
            data-aos-delay="150"
            data-aos-duration="900"
            class="flex flex-col gap-4 border border-border-light p-6 md:p-8 rounded-3xl bg-theme-light aos-init"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            <div class="mt-4 space-y-3">
              <h3 class="text-h5-sm md:text-h5 text-dark font-medium">Commodity &amp; MCX Insights</h3>
              <p class="text-text-default opacity-80 text-sm/relaxed">Learn Crude Oil, Natural Gas, Gold, and Silver futures and options trading with macroeconomic event tracking.</p>
            </div>
          </div>

          <!-- Card 4 -->
          <div
            data-aos="fade-up-sm"
            data-aos-delay="200"
            data-aos-duration="900"
            class="flex flex-col gap-4 border border-border-light p-6 md:p-8 rounded-3xl bg-theme-light aos-init"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
            <div class="mt-4 space-y-3">
              <h3 class="text-h5-sm md:text-h5 text-dark font-medium">Price Action Candlesticks</h3>
              <p class="text-text-default opacity-80 text-sm/relaxed">Identify high-probability breakout patterns, Hikkaki candlestick setups, and dynamic support &amp; resistance.</p>
            </div>
          </div>

          <!-- Card 5 -->
          <div
            data-aos="fade-up-sm"
            data-aos-delay="250"
            data-aos-duration="900"
            class="flex flex-col gap-4 border border-border-light p-6 md:p-8 rounded-3xl bg-theme-light aos-init"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <div class="mt-4 space-y-3">
              <h3 class="text-h5-sm md:text-h5 text-dark font-medium">Risk &amp; Portfolio Management</h3>
              <p class="text-text-default opacity-80 text-sm/relaxed">Protect your account capital with strict stop-loss rules, position sizing, and risk-to-reward discipline.</p>
            </div>
          </div>

          <!-- Card 6 -->
          <div
            data-aos="fade-up-sm"
            data-aos-delay="300"
            data-aos-duration="900"
            class="flex flex-col gap-4 border border-border-light p-6 md:p-8 rounded-3xl bg-theme-light aos-init"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <div class="mt-4 space-y-3">
              <h3 class="text-h5-sm md:text-h5 text-dark font-medium">Live Q&amp;A Mentorship</h3>
              <p class="text-text-default opacity-80 text-sm/relaxed">Interact directly with certified research analysts and clear your doubts during live market sessions.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SEO Section 2: Split Feature Section (Matching PowerfulTools / SmartManagement2) -->
    <section>
      <div class="container space-y-20">
        <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2 lg:gap-32">
          <div
            data-aos="fade-left-sm"
            data-aos-delay="200"
            class="to-primary/5 flex items-center justify-center rounded-3xl bg-linear-to-b from-transparent py-8 border border-border-light"
          >
            <img
              src="/assets/images/feature-analytics-1.webp"
              alt="GoPocket Research Platform"
              loading="lazy"
              decoding="async"
              width="488"
              height="500"
              class="rounded-2xl"
            />
          </div>
          <div class="space-y-10">
            <div class="space-y-4">
              <h2 class="has-italic-text capitalize"><strong>Empowering Traders</strong> With Market Research</h2>
              <p class="text-text-default opacity-80">
                GoPocket provides institutional-grade market research, real-time data feeds, and actionable technical analysis to help you trade smarter and with confidence.
              </p>
            </div>
            <div class="space-y-6 divide-y divide-dashed border-border-light">
              <div class="space-y-2.5 odd:pb-6">
                <h3 class="text-xl font-medium text-dark">Real-Time Market Webinars</h3>
                <p class="text-text-default opacity-80 text-sm">Join live interactive webinars hosted by seasoned research analysts covering Nifty, Bank Nifty, and MCX commodities.</p>
              </div>
              <div class="space-y-2.5 odd:pb-6 pt-4">
                <h3 class="text-xl font-medium text-dark">Downloadable Study Materials</h3>
                <p class="text-text-default opacity-80 text-sm">Access comprehensive PDF strategy guides, candlestick cheat sheets, and webinar recordings anytime.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SEO Section 3: FAQ Section (Matching FinzoHome.astro / faq.astro style) -->
    <FAQSection />

    <!-- Final Call to Action Section (Imported directly from FinalCTA component) -->
    <FinalCTA />
  </main>

  <Footer />
</Layout>
