---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
---

<Layout
  title="Customer Testimonials - What GoPocket Traders Say"
  description="Real stories from GoPocket customers across Tamil Nadu about trading, investing and the support they get from our team."
>
  <Header currentPath="/testimonial" />
  <main class="has-section-spacing-lg">
    <div
      class="page-loader pointer-events-none fixed bottom-0 left-0 z-50 size-full bg-white transition duration-300 [.inactive]:opacity-0 inactive"
    >
      <script type="module" is:inline>
        const e = document.querySelector(".page-loader");
        document.addEventListener("DOMContentLoaded", () => {
          e &&
            setTimeout(() => {
              e.classList.add("inactive");
            }, 100);
        });
      </script>
    </div>
    <main class="has-section-spacing-lg">
      <section class="relative z-10 mt-0 py-14 md:pt-32 md:pb-24">
        <div class="container">
          <div class="flex max-w-6xl flex-wrap justify-between gap-5 md:gap-10 md:px-8 lg:px-12 ms-5 me-5 md:mx-auto">
            <h1 class="has-italic-text text-h2 max-w-lg capitalize">What our client says <strong>about Us</strong></h1>
            <p class="md:max-w-sm">
              Real stories and feedback from GoPocket customers who trade and invest with us every day, in their own
              words.
            </p>
          </div>
        </div>
      </section>
      <section
        class="after:bg-theme-light pt-0 after:pointer-events-none after:absolute after:top-0 after:left-0 after:-z-10 after:h-250 after:w-full after:content-['']"
      >
        <div class="container">
          <div class="box-shadow-black mx-auto max-w-6xl space-y-16 rounded-xl bg-white p-8 md:p-12">
            <div>
              <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                <div
                  class="bg-theme-light group relative flex w-full flex-col items-start rounded-xl border-4 border-white p-6"
                >
                  <div class="flex flex-col items-start space-y-4">
                    <blockquote class="text-lg leading-relaxed">
                      I aspired to engage in stock market trading for two decades but struggled to find the right platform.
                      Fortunately, a friend introduced me to GoPocket, and since then, I have been trading safely and find
                      the app easy to use. Overall, my experience with GoPocket has been highly satisfactory.
                    </blockquote>
