            .forEach((o) => {
              o.querySelectorAll("img").forEach((e) => {
                e.complete ? s(e) : e.addEventListener("load", () => s(e));
              });
              const a = o.scrollWidth;
              o.style.setProperty("--total-width", `${a / 2}px`);
            });
        }
        function s(t) {
          const o = getComputedStyle(t),
            i = parseFloat(o.height),
            a = t.naturalWidth / t.naturalHeight,
            e = i * a;
          t.setAttribute("height", i.toString()),
            t.setAttribute("width", e.toString());
        }
        let n;
        window.addEventListener("resize", () => {
          clearTimeout(n), (n = window.setTimeout(r, 100));
        });
        r();
