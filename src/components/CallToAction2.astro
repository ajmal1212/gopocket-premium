---
// CallToAction2.astro
---

<section class="call-to-action overflow-hidden">
  <div class="container">
    <div class="bg-theme-light relative grid grid-cols-1 overflow-hidden rounded-4xl lg:grid-cols-2">
      <div class="flex flex-col justify-between px-8 py-8 lg:px-16 lg:py-20">
        <div class="mb-10">
          <h2
            data-duration="0.6"
            data-delay="0.2"
            data-stagger="0.09"
            class="has-italic-text mb-8 leading-[1.15] font-normal capitalize animated-text has-italic-text mb-8 leading-[1.15] font-normal capitalize"
            data-astro-cid-3rbjsbju="true"
          >
            <span
              class="word"
              style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
              >Track</span
            >
            <span
              class="word"
              style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
              >your</span
            >
            <span
              class="word"
              style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
              >spending</span
            >
            <span
              class="word"
              style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
              >and</span
            >
            <span
              class="word"
              style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
              >invest</span
            >
            <span
              class="word"
              style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
              >wisely—all</span
            >
            <span
              class="word"
              style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
              >in</span
            >
            <span
              class="word"
              style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
              >one</span
            >
            <strong
              ><span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >easy-to-use</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >app</span
              ></strong>
          </h2>
          <p data-aos="fade-down-sm" data-aos-delay="300" class="aos-init">
            Take control of your money with Finzo. Track your spending, save smartly, and invest wisely—all in one
            easy-to-use app.
          </p>
          <div class="mt-5 md:mt-10 aos-init" data-aos="fade-down-sm" data-aos-delay="400">
            <a class="btn btn-primary text-flip-hover-anim btn-primary" href="/contact"
              ><span class="text-flip-inner" data-content="GET A FREE DEMO">GET A FREE DEMO</span></a
            >
          </div>
        </div>
        <div class="mt-10 flex flex-wrap gap-4 lg:mt-24 aos-init" data-aos="reveal-anim-down">
          <h3 class="h2">500K+</h3>
          <div class="flex -space-x-3">
            <img
              src="/assets/finzo-astro.pages.dev/1.nIy8sTuK_2vDfXj-be31caf9.webp"
              srcset="/assets/finzo-astro.pages.dev/1.nIy8sTuK_2vDfXj-be31caf9.webp 144w"
