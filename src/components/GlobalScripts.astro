<script>
  import AOS from "aos";
  // aos.css is already pulled in by global.css - importing it here too made Astro
  // emit a second, render-blocking copy of the same 26 kB stylesheet.
  import SmoothScroll from "smoothscroll-for-websites";
  import { initAnimatedNumbers } from "../scripts/counter";

  const initGlobalScripts = () => {
    // Initialize animated number counters
    initAnimatedNumbers();

    // Resolve relative blog post body image URLs (/private/files/... and /files/...)
    const fixProseImages = () => {
      document.querySelectorAll<HTMLImageElement>(".prose-styles img, .content img, article img").forEach((img) => {
        const src = img.getAttribute("src");
        if (src && (src.startsWith("/private/files/") || src.startsWith("/files/"))) {
          img.src = `https://hrms.gopocket.in${src}`;
        }
        img.addEventListener("error", () => {
          const currentSrc = img.getAttribute("src");
          if (currentSrc && !currentSrc.startsWith("http") && !img.dataset.fallbackTried) {
            img.dataset.fallbackTried = "true";
            img.src = `https://hrms.gopocket.in${currentSrc.startsWith("/") ? "" : "/"}${currentSrc}`;
          }
        });
      });
    };
    fixProseImages();
    // Initialize smooth scrolling (kinetic momentum scroll)
    try {
      SmoothScroll({
        animationTime: 800,
        stepSize: 80,
        accelerationDelta: 50,
        accelerationMax: 3,
        pulseAlgorithm: true,
        pulseScale: 4,
        pulseNormalize: 1,
        keyboardSupport: true,
        arrowScroll: 50,
      });
    } catch (err) {
      console.error("SmoothScroll init error:", err);
    }

    // Strip hardcoded static pre-rendered AOS classes so AOS can observe them dynamically
    document.querySelectorAll("[data-aos]").forEach((el) => {
      el.classList.remove("aos-init", "aos-animate");
    });

    // Initialize AOS animations.
    //
    // AOS caches each element's Y offset once, at refresh time. refreshHard()
    // re-collects and re-measures, and the MutationObserver does the same when
    // [data-aos] nodes come and go - both are needed, because the offsets taken
    // at DOMContentLoaded are computed before images and fonts have settled the
    // layout, and stale offsets leave sections stuck at opacity 0.
    AOS.init({
      duration: 700,
      easing: "ease-out",
      once: true,
      offset: 40,
    });
    AOS.refreshHard();

    // Once images and webfonts are in, every cached offset is out of date.
    // refresh() re-measures the elements AOS already knows about, which is what
    // keeps below-the-fold sections appearing on the way back up the page.
    window.addEventListener("load", () => AOS.refresh(), { once: true });

    // Intersection Observer for heading word reveal animations (.animated-text)
    const textElements = document.querySelectorAll<HTMLElement>(".animated-text");
    if (textElements.length > 0) {
      const textObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-animated");
              textObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 },
      );

      textElements.forEach((el) => {
        el.classList.add("is-ready");
        textObserver.observe(el);
      });
    }

    // Shift+wheel scrolls horizontally overflowing containers.
    //
    // The listener has to be non-passive to call preventDefault, and a
    // non-passive wheel listener on document would take the whole page off the
    // compositor scrolling path - every wheel event would have to reach a busy
    // main thread before the page could move. So it is attached per element,
    // and only to elements that genuinely scroll horizontally.
    //
    // Discovery happens on hover instead of by walking the entire document at
    // load: the geometry read only happens for something the cursor is actually
    // over, and each container is wired up at most once.
    const wheelBound = new WeakSet<HTMLElement>();

    const onHorizontalWheel = function (this: HTMLElement, event: WheelEvent) {
      if (!event.shiftKey) return;
      if (this.scrollWidth <= this.clientWidth) return;
      event.preventDefault();
      this.scrollBy({ left: event.deltaY * 3, behavior: "smooth" });
    };

    document.addEventListener(
      "pointerover",
      (event) => {
        let node = event.target instanceof HTMLElement ? event.target : null;
        while (node && node !== document.body) {
          if (!wheelBound.has(node) && node.scrollWidth > node.clientWidth) {
            wheelBound.add(node);
            node.addEventListener("wheel", onHorizontalWheel, { passive: false });
          }
          node = node.parentElement;
        }
      },
      { passive: true },
    );

    // Creative hover background effect
    document.addEventListener("mouseover", (e) => {
      const target = (e.target as HTMLElement)?.closest(".creative-hover-anim");
      if (target) {
        const hoverBg = target.querySelector<HTMLElement>(".hover-bg");
        if (hoverBg) {
          const rect = target.getBoundingClientRect();
          const top = e.clientY - rect.top;
          const left = e.clientX - rect.left;
          hoverBg.style.setProperty("--creative-hover-top", `${top}px`);
          hoverBg.style.setProperty("--creative-hover-left", `${left}px`);
        }
      }
    });

    // Magnetic hover animation
    let animationFrameId: number;

    const clamp = (val: number, max: number) => Math.max(-max, Math.min(val, max));

    const applyMagneticHover = (el: HTMLElement) => {
      let isHovered = false;

      const onMouseMove = (e: MouseEvent) => {
        if (!isHovered) return;
        const rect = el.getBoundingClientRect();
        const deltaX = (e.clientX - rect.left - rect.width / 2) * 0.3;
        const deltaY = (e.clientY - rect.top - rect.height / 2) * 0.3;

        cancelAnimationFrame(animationFrameId);
        animationFrameId = requestAnimationFrame(() => {
          el.style.transform = `translate(${clamp(deltaX, 30)}px, ${clamp(deltaY, 30)}px)`;
        });
      };

      const onMouseLeave = () => {
        isHovered = false;
        cancelAnimationFrame(animationFrameId);
        el.style.transition = "transform 0.2s ease-out";
        el.style.transform = "translate(0, 0)";
      };

      el.style.willChange = "transform";
      el.addEventListener("mouseenter", () => {
        isHovered = true;
        el.style.transition = "transform 0.2s ease-out";
      });
      el.addEventListener("mousemove", onMouseMove);
      el.addEventListener("mouseleave", onMouseLeave);
    };

    document.querySelectorAll<HTMLElement>(".magnetic-hover-anim").forEach(applyMagneticHover);

    window.addEventListener("mouseout", (e) => {
      if (!e.relatedTarget && !(e as any).toElement) {
        document.querySelectorAll<HTMLElement>(".magnetic-hover-anim").forEach((el) => {
          el.style.transition = "transform 0.2s ease-out";
          el.style.transform = "translate(0, 0)";
        });
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGlobalScripts);
  } else {
    initGlobalScripts();
  }
</script>
