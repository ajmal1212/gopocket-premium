---

<Layout
  title="Contact Us - GoPocket"
  description="Get in touch with GoPocket. Reach our support, dealing, banking and compliance teams, or visit any of our branches across India."
  canonical="https://www.gopocket.in/contact"
>
  <Header currentPath="/contact" />

  <main class="has-section-spacing-lg py-12 md:py-20">
    <!-- Office Locations Section -->
    <section>
      <div class="container mx-auto px-4">
        <h1 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-12">
          Discover the <span class="font-normal italic">Office Location</span>
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <!-- Registered Office -->
          <div class="space-y-4 bg-gray-50/60 p-6 rounded-3xl border border-gray-100">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d19439.395236464505!2d76.94645925936987!3d11.0058480787738!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba8590251815095%3A0x7c7f146f65865076!2sSky%20Broking%20(Head%20Office)!5e0!3m2!1sen!2sin!4v1788162440283!5m2!1sen!2sin"
              title="Map showing GoPocket Registered Office, IG Towers, Devangapet Street No 3, Coimbatore"
              class="w-full h-72 md:h-80 rounded-2xl mb-4 border-0"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen></iframe>
            <h3 class="text-xl font-semibold text-gray-900">Registered Office</h3>
            <div class="text-sm text-gray-600 space-y-1">
              <p>II Floor, 40-49, Shop S1, IG Towers, Devangapet Street No 3, Coimbatore – 641001</p>
              <p>Phone: <a href="tel:+914223525900" class="text-primary hover:underline">0422 – 3525900</a></p>
              <p>
                Email: <a href="mailto:support@gopocket.in" class="text-primary hover:underline">support@gopocket.in</a>
              </p>
            </div>
          </div>

          <!-- Corporate Office -->
          <div class="space-y-4 bg-gray-50/60 p-6 rounded-3xl border border-gray-100">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4859.632357680786!2d76.9910233!3d11.0189615!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba859ea4dfcec35%3A0xd635f90b0d910445!2sGoPocket%20by%20Sky!5e0!3m2!1sen!2sin!4v1788162192379!5m2!1sen!2sin"
              title="Map showing GoPocket Corporate Office, May Flower Valencia, Nava India, Avinashi Road, Coimbatore"
              class="w-full h-72 md:h-80 rounded-2xl mb-4 border-0"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen></iframe>
            <h3 class="text-xl font-semibold text-gray-900">Corporate Office</h3>
            <div class="text-sm text-gray-600 space-y-1">
              <p>May Flower Valencia, 3rd Floor, Office No 3, Nava India, Avinashi Road, Coimbatore – 641004</p>
              <p>Phone: <a href="tel:+914223525900" class="text-primary hover:underline">0422 – 3525900</a></p>
              <p>
                Email: <a href="mailto:support@gopocket.in" class="text-primary hover:underline">support@gopocket.in</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Department-wise Contact Section -->
    <section class="mt-20 md:mt-32 border-t border-gray-100 pt-16 md:pt-24">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-12">
          Reach the <span class="font-normal italic">Right Team</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            departments.map((dept) => (
              <div class="space-y-3 bg-gray-50/60 p-6 rounded-3xl border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900">{dept.name}</h3>
                <div class="text-sm text-gray-600 space-y-1">
                  {dept.phone && (
                    <p>
                      <a href={telHref(dept.phone)} class="hover:text-primary">
                        {dept.phone}
                      </a>
                    </p>
                  )}
                  <p>
                    <a href={`mailto:${dept.email}`} class="text-primary hover:underline">
                      {dept.email}
                    </a>
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Branch Offices Section -->
    <section class="mt-20 md:mt-32 border-t border-gray-100 pt-16 md:pt-24">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-4">
          Our <span class="font-normal italic">Branches</span>
        </h2>
        <p class="text-gray-600 text-base/relaxed max-w-2xl mb-10">
          Walk in to any of our {totalBranches} branches across {branchesByState.length} states. Pick a state to see the
          offices near you.
        </p>

        <!-- State filter pills -->
        <div class="flex flex-wrap gap-3 mb-12" role="group" aria-label="Filter branches by state">
          {
            branchesByState.map((group) => (
              <button
                type="button"
                class="state-pill cursor-pointer rounded-full border px-5 py-2.5 text-sm font-medium transition-all duration-200 hover:-translate-y-0.5 border-gray-200 bg-white text-gray-700 hover:border-primary/40 hover:text-primary"
                data-filter={group.state}
                aria-pressed={group.state === defaultState ? "true" : "false"}
              >
                {group.state}
                <span class="ms-1.5 text-xs opacity-50">{group.branches.length}</span>
              </button>
            ))
          }
        </div>

        <!-- Branch cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            branchesByState.map((group) =>
              group.branches.map((branch) => (
                <article
                  class="branch-card group flex flex-col overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/20 hover:shadow-xl hover:shadow-primary/5"
                  data-state={group.state}
                  hidden={group.state !== defaultState}
                >
                  <div class="relative flex min-h-[84px] items-end overflow-hidden bg-primary px-6 py-4">
                    <svg
                      class="pointer-events-none absolute right-5 top-5 h-5 w-5 text-white/30 transition-transform duration-300 group-hover:scale-110"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                      />
                    </svg>
                    <h3 class="branch-title relative font-semibold uppercase tracking-wide text-white">
                      {branch.city}
                      {branch.area && <span class="block font-medium text-white/85">{branch.area}</span>}
                    </h3>
                  </div>

                  <div class="flex-1 bg-gray-50/60 px-6 py-5">
                    <address class="not-italic text-sm leading-relaxed text-gray-600">
                      {branch.lines.map((line) => (
                        <span class="block">{line}</span>
                      ))}
                    </address>
                  </div>
                </article>
              )),
            )
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Global unlayered `h3` rules in global.css override Tailwind utilities (color and
     font-size), so set both here where the scoped selector wins on specificity. */
  .branch-card .branch-title {
    font-size: 0.9375rem;
    color: #fff;
    line-height: 1.4;
  }

  .branch-card:not([hidden]) {
    animation: branch-fade-in 0.35s ease both;
  }

  @keyframes branch-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .branch-card:not([hidden]) {
      animation: none;
    }
    .branch-card,
    .state-pill {
      transition: none;
    }
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>(".state-pill");
  const cards = document.querySelectorAll<HTMLElement>(".branch-card");

  const activeClasses = ["border-primary", "text-primary", "bg-primary/5"];
  const idleClasses = ["border-gray-200", "bg-white", "text-gray-700"];

  const applyState = (state: string) => {
    pills.forEach((pill) => {
      const on = pill.dataset.filter === state;
      pill.setAttribute("aria-pressed", String(on));
      activeClasses.forEach((cls) => pill.classList.toggle(cls, on));
      idleClasses.forEach((cls) => pill.classList.toggle(cls, !on));
    });

    cards.forEach((card) => {
      const show = card.dataset.state === state;
      if (show && card.hidden) {
        card.hidden = false;
        card.style.animation = "none";
        void card.offsetWidth;
        card.style.animation = "";
      } else {
        card.hidden = !show;
      }
    });
  };

  pills.forEach((pill) => {
    pill.addEventListener("click", () => applyState(pill.dataset.filter ?? ""));
  });

  const initial = document.querySelector<HTMLButtonElement>('.state-pill[aria-pressed="true"]');
  if (initial) applyState(initial.dataset.filter ?? "");
</script>
