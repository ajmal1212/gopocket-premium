---
/**
 * /blog/page/N - the older posts, as a plain grid. Page 1 is /blog itself, with
 * the featured layout, so /blog/page/1 permanently redirects there rather than
 * serving the same posts at a second address.
 *
 * Each page canonicalises to itself, not to /blog: the posts listed here are
 * different, and pointing them all at page 1 would hide them from crawlers.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FinalCTA from "@/components/FinalCTA.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import BlogPagination from "@/components/blog/BlogPagination.astro";
import { PAGE_SIZE, blogPageCount, blogPageHref, blogPageStart } from "@/components/blog/blog-pages";
import { getBlogCount, getBlogPosts } from "@/lib/frappe";

const raw = Astro.params.page ?? "";
const page = /^\d+$/.test(raw) ? Number(raw) : NaN;

if (page === 1) {
  return Astro.redirect("/blog", 301);
}
if (!Number.isInteger(page) || page < 1 || String(page) !== raw) {
  return new Response(null, { status: 404, statusText: "Page not found" });
}

const [posts, totalPosts] = await Promise.all([getBlogPosts(PAGE_SIZE, true, blogPageStart(page)), getBlogCount()]);

// Past the last page there is nothing to list. If the count is unavailable the
// page is still served as long as it has posts, just without later page links.
if (posts.length === 0) {
  return new Response(null, { status: 404, statusText: "Page not found" });
}

const pageCount = totalPosts === null ? page : Math.max(page, blogPageCount(totalPosts));
const pageTitle = `GoPocket Blog - Page ${page}`;

const SITE = Astro.site?.origin ?? Astro.url.origin;
const blogUrl = `${SITE}/blog`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: blogUrl },
    { "@type": "ListItem", position: 3, name: `Page ${page}`, item: `${SITE}${blogPageHref(page)}` },
  ],
};
---

<Layout
  title={`${pageTitle} | Trading Insights & Market News`}
  description={`Page ${page} of the GoPocket blog: practical tips, algo trading insights, options strategies and market news to help you trade smarter.`}
  canonical={blogPageHref(page)}
>
  <Fragment slot="head">
    <link rel="prev" href={`${SITE}${blogPageHref(page - 1)}`} />
    {page < pageCount && <link rel="next" href={`${SITE}${blogPageHref(page + 1)}`} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <Header currentPath="/blog" />
  <main class="has-section-spacing-lg pt-8 md:pt-16">
    <section class="container pt-0!">
      <div class="mx-auto max-w-6xl">
        <h1 class="text-black! dark:text-white! text-h4 font-bold tracking-tight md:text-h3">All Blogs</h1>
        <div class="mt-8 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:gap-x-12 lg:gap-y-16 lg:grid-cols-3 md:mt-10">
          {posts.map((post) => <BlogCard post={post} as="h2" />)}
        </div>
        <BlogPagination class="mt-16 md:mt-24" current={page} total={pageCount} />
      </div>
    </section>

    <!-- Final Call to Action -->
    <FinalCTA />
  </main>
  <Footer />
</Layout>
