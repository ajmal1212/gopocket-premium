---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TurnstileWidget from "../../components/TurnstileWidget.astro";
import FAQSection from "../../components/FAQSection.astro";
import CallToAction2 from "../../components/CallToAction2.astro";
import UserCheck from "@lucide/astro/icons/user-check";
import CalendarIcon from "@lucide/astro/icons/calendar";
import Clock from "@lucide/astro/icons/clock";
import Video from "@lucide/astro/icons/video";
import Languages from "@lucide/astro/icons/languages";
import { getSeminarBySlugOrId, type FormattedSeminar } from "../../lib/frappe";
import Testimonials2 from "@/components/Testimonials2.astro";

const { id } = Astro.params;

// Fetch seminar details from Frappe Doctype 'Seminar'
const seminar = id ? await getSeminarBySlugOrId(id) : null;

// Typed as FormattedSeminar so the page can read every field either way; the
// course-detail fields are simply empty here, and each section tests for its
// own content before rendering.
const webinar: FormattedSeminar = seminar || {
  id: id || "default",
  slug: id || "default",
  title: "Stock Market & Options Trading Masterclass",
  language: "Tamil",
  date_and_time: "Upcoming",
  formattedDate: "Upcoming",
  formattedTime: "08:30 PM",
  type: "Online",
  cost: "Free",
  image: "/assets/images/learn1.jpeg",
  websiteImage: "/assets/images/learn1.jpeg",
  description:
    "Join live stock market trading masterclasses, commodity research, and options hedging step-by-step with GoPocket experts.",
  aboutCourse: "",
  learningOutcomes: [],
  mentorImage: "",
  mentorName: "",
  mentorDesignation: "",
  mentorExperience: "",
  aboutMentor: "",
  faqs: [],
};

// formattedDate first: date_and_time is the raw Frappe stamp
// ("2026-09-23 17:30:00"), which is not something to print on a page.
const displayDate = webinar.formattedDate || webinar.date_and_time;

// "Sep 23, 2026" for the fact chip - the long form wraps onto two lines in a
// box that narrow. Falls back to the long one if the stamp will not parse.
const chipDate = (() => {
  const dt = new Date((webinar.date_and_time || "").replace(" ", "T"));
  if (isNaN(dt.getTime())) return displayDate;
  return dt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
})();

// Referral links look like ?refer=SKY1101&mode=Instagram. The code and source
// are posted separately (Frappe keeps them in `refer` and `mode`); the visitor
// sees them together, read-only, as "SKY1101 - Instagram".
const referParam = Astro.url.searchParams.get("refer")?.trim() || "";
const modeParam = Astro.url.searchParams.get("mode")?.trim() || "";
const referDisplay = modeParam ? `${referParam} - ${modeParam}` : referParam;

// about_this_course / about_mentor are plain textareas in Frappe: blank lines
// separate paragraphs, so that is what they are split on. learning_outcomes is
// a Quill field, already reduced to plain strings by formatSeminar.
const paragraphs = (text: string) =>
  text
    .split(/\n{2,}/)
    .map((para) => para.trim())
    .filter(Boolean);

const aboutParagraphs = paragraphs(webinar.aboutCourse || webinar.description || "");
const mentorParagraphs = paragraphs(webinar.aboutMentor);
const hasMentor = Boolean(webinar.mentorName || webinar.aboutMentor);

// The in-page tab strip only lists sections this seminar actually filled in.
const tabs = [
  ...(aboutParagraphs.length ? [{ id: "about", label: "About" }] : []),
  ...(webinar.learningOutcomes.length ? [{ id: "outcomes", label: "Learning Outcome" }] : []),
  ...(hasMentor ? [{ id: "mentor", label: "Meet the Mentor" }] : []),
];
---

<Layout
  title={`${webinar.title} - GoPocket Webinar Registration`}
  description={`Register for ${webinar.title} on ${displayDate}. Free stock market & options trading masterclass.`}
>
  <Header currentPath="/research-learn" />

  <main class="pt-20 md:pt-32 pb-16 md:pb-24 bg-gradient-to-b from-gray-50/50 via-white to-gray-50/30 min-h-screen">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 space-y-8 md:space-y-12">
      {
        /*
          Three grid items, in reading order: the heading and fact chips, the
          register card, then the tabs and sections. A phone stacks them that
          way, so the form comes straight after the facts instead of under the
          whole write-up. From lg the grid places them back into two columns -
          heading and sections on the left, the form spanning both rows on the
          right - and the second row takes any spare height (auto_1fr), so a tall
          form never opens a gap between the heading and the tabs.
        */
      }
      <div
        class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_500px] lg:grid-rows-[auto_1fr] lg:gap-x-14 lg:gap-y-10"
      >
        <!-- Heading and fact chips -->
        <div class="min-w-0 space-y-4 lg:col-start-1 lg:row-start-1">
          <h1 class="text-3xl font-bold leading-tight tracking-tight text-dark sm:text-4xl">{webinar.title}</h1>
          {webinar.mentorName && <p class="text-lg font-semibold text-primary">{webinar.mentorName}</p>}

          <!-- Fact chips: the four facts the Seminar doctype actually carries. -->
          <dl class="grid grid-cols-2 gap-3 pt-2 sm:grid-cols-4">
            <div class="rounded-2xl border border-border-light bg-white p-3.5">
              <CalendarIcon class="h-4 w-4 text-dark" stroke-width={1.8} aria-hidden="true" />
              <dt class="mt-2 text-xs text-text-default opacity-70">Date</dt>
              <dd class="text-sm font-semibold text-primary">{chipDate}</dd>
            </div>
            <div class="rounded-2xl border border-border-light bg-white p-3.5">
              <Clock class="h-4 w-4 text-dark" stroke-width={1.8} aria-hidden="true" />
              <dt class="mt-2 text-xs text-text-default opacity-70">Time</dt>
              <dd class="text-sm font-semibold text-primary">{webinar.formattedTime || "To be announced"}</dd>
            </div>
            <div class="rounded-2xl border border-border-light bg-white p-3.5">
              <Video class="h-4 w-4 text-dark" stroke-width={1.8} aria-hidden="true" />
              <dt class="mt-2 text-xs text-text-default opacity-70">Mode</dt>
              <dd class="text-sm font-semibold text-primary">{webinar.type}</dd>
            </div>
            <div class="rounded-2xl border border-border-light bg-white p-3.5">
              <Languages class="h-4 w-4 text-dark" stroke-width={1.8} aria-hidden="true" />
              <dt class="mt-2 text-xs text-text-default opacity-70">Language</dt>
              <dd class="text-sm font-semibold text-primary">{webinar.language}</dd>
            </div>
          </dl>
        </div>

        <!-- Register card and poster: after the facts on a phone, the right-hand column from lg -->
        <div class="min-w-0 lg:col-start-2 lg:row-start-1 lg:row-span-2">
          <div
            id="register"
            class="scroll-mt-28 overflow-hidden rounded-3xl border border-border-light bg-white shadow-sm"
          >
            <h2 class="border-border-light border-b px-6 pt-6 pb-4 text-2xl! font-bold text-dark">Register Now</h2>

            <form id="webinar-register-form" class="space-y-4 p-6">
              <input type="hidden" name="seminar" value={seminar?.id ?? ""} />
              <input type="hidden" name="refer" value={referParam} />
              <input type="hidden" name="mode" value={modeParam} />
              <!-- Field 1: Client Code / New -->
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-dark uppercase tracking-wider">
                  Client Code / New
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                      <path d="M7 7h10"></path>
                      <path d="M7 12h10"></path>
                      <path d="M7 17h6"></path>
                    </svg>
                  </div>
                  <input
                    type="text"
                    name="clientCode"
                    placeholder="Client Code / New"
                    class="w-full pl-11 pr-4 py-3.5 bg-white border border-border-light rounded-xl text-dark placeholder-gray-400 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
                  />
                </div>
              </div>

              <!-- Field 2: Name -->
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-dark uppercase tracking-wider">
                  Full Name <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  </div>
                  <input
                    type="text"
                    name="fullName"
                    required
                    placeholder="Enter your full name"
                    class="w-full pl-11 pr-4 py-3.5 bg-white border border-border-light rounded-xl text-dark placeholder-gray-400 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
                  />
                </div>
              </div>

              <!-- Field 3: Mobile Number -->
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-dark uppercase tracking-wider">
                  Mobile Number <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                      ></path>
                    </svg>
                  </div>
                  <input
                    type="tel"
                    name="mobile"
                    required
                    placeholder="Enter 10-digit mobile number"
                    pattern="[0-9]{10}"
                    inputmode="numeric"
                    maxlength="10"
                    minlength="10"
                    autocomplete="tel-national"
                    title="Enter exactly 10 digits, numbers only."
                    class="w-full pl-11 pr-4 py-3.5 bg-white border border-border-light rounded-xl text-dark placeholder-gray-400 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
                  />
                </div>
              </div>

              <!-- Field 4: City -->
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-dark uppercase tracking-wider">
                  City <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </div>
                  <input
                    type="text"
                    name="city"
                    required
                    placeholder="Enter your city"
                    class="w-full pl-11 pr-4 py-3.5 bg-white border border-border-light rounded-xl text-dark placeholder-gray-400 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-xs"
                  />
                </div>
              </div>

              {
                referParam && (
                  <div class="space-y-1.5">
                    <label for="refer-display" class="block text-xs font-semibold text-dark uppercase tracking-wider">
                      Referred By
                    </label>
                    <div class="relative">
                      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                        <UserCheck class="h-[18px] w-[18px]" stroke-width={2} aria-hidden="true" />
                      </div>
                      {/* No `name`: display only. The values are posted from the hidden
                      refer/mode inputs above, so the combined label never reaches Frappe. */}
                      <input
                        id="refer-display"
                        type="text"
                        value={referDisplay}
                        readonly
                        tabindex="-1"
                        class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-border-light rounded-xl text-dark text-sm md:text-base font-medium cursor-default focus:outline-none shadow-xs"
                      />
                    </div>
                  </div>
                )
              }

              <!-- Field 5: Cloudflare Turnstile bot check -->
              <TurnstileWidget action="seminar-register" />

              <!-- Submit Button (Website UI/UX Flip CTA Button) -->
              <button
                type="submit"
                class="btn btn-primary text-flip-hover-anim w-full py-4 text-base font-semibold justify-center shadow-lg cursor-pointer mt-2"
              >
                <span class="text-flip-inner" data-content="Submit">Submit</span>
                <span
                  class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                >
                  <svg
                    class="gradient-shape"
                    width="150"
                    height="28"
                    viewBox="0 0 147 11"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                      stroke="currentColor"
                      stroke-width="8"></path>
                  </svg>
                </span>
              </button>

              <!-- DND Disclaimer Box -->
              <div
                class="p-3.5 rounded-2xl bg-emerald-50/80 border border-emerald-200/80 text-emerald-900 text-xs leading-relaxed mt-4"
              >
                <strong>Note:</strong> By submitting above details, you are authorizing GoPocket / its sub-brokers / agents
                to call you, send promotional communication even though you being registered under DND.
              </div>
            </form>
          </div>

          {
            /*
              The seminar's portrait poster (the doc's `image` field), in its own
              card under the form. Shown whole - `h-auto` with the poster's own
              4:5 width/height - so nothing is cropped and the box is reserved
              before it loads. Tested on rawImage because `image` falls back to a
              stock photo when the field is empty, and that has no place here.
            */
          }
          {
            webinar.rawImage && (
              <div class="mt-6 overflow-hidden rounded-3xl border border-border-light bg-white shadow-sm">
                <img
                  src={webinar.image}
                  alt={`${webinar.title} - class poster`}
                  width="614"
                  height="768"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full"
                />
              </div>
            )
          }
        </div>

        <!-- Section tabs and the course write-up -->
        <div class="min-w-0 space-y-10 lg:col-start-1 lg:row-start-2">
          {
            tabs.length > 1 && (
              /* Real anchors rather than JS tab panels: every section stays in the
                 page for search engines and for anyone without JS, and the links
                 simply jump to it. */
              <nav
                aria-label="Sections on this page"
                class="flex flex-wrap gap-x-8 gap-y-2 border-b border-border-light"
              >
                {tabs.map((tab) => (
                  <a
                    href={`#${tab.id}`}
                    data-section-link={tab.id}
                    class="-mb-px border-b-2 border-transparent pb-3 text-sm font-medium text-text-default opacity-70 transition-colors hover:text-primary hover:opacity-100 aria-[current=true]:border-primary aria-[current=true]:text-primary aria-[current=true]:opacity-100"
                  >
                    {tab.label}
                  </a>
                ))}
              </nav>
            )
          }

          {
            aboutParagraphs.length > 0 && (
              <section id="about" class="scroll-mt-28 space-y-4">
                <h2 class="text-xl font-bold text-dark md:text-2xl">About this class</h2>
                {aboutParagraphs.map((para) => (
                  <p class="text-base leading-relaxed text-text-default opacity-85">{para}</p>
                ))}
              </section>
            )
          }

          {
            webinar.learningOutcomes.length > 0 && (
              <section id="outcomes" class="scroll-mt-28 space-y-4">
                <h2 class="text-xl font-bold text-dark md:text-2xl">You will learn</h2>
                <ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {webinar.learningOutcomes.map((outcome, index) => (
                    <li class="rounded-2xl border border-border-light bg-white p-5">
                      <span
                        class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-sm font-bold text-primary"
                        aria-hidden="true"
                      >
                        {index + 1}
                      </span>
                      <p class="mt-3 text-sm leading-relaxed text-text-default">{outcome}</p>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            hasMentor && (
              <section id="mentor" class="scroll-mt-28 space-y-4">
                <h2 class="text-xl font-bold text-dark md:text-2xl">Meet your mentor</h2>
                <div class="flex items-center gap-4">
                  {webinar.mentorImage && (
                    <img
                      src={webinar.mentorImage}
                      alt={webinar.mentorName || "Mentor"}
                      width="72"
                      height="72"
                      loading="lazy"
                      decoding="async"
                      class="h-18 w-18 shrink-0 rounded-full border border-border-light object-cover"
                    />
                  )}
                  <div class="space-y-0.5">
                    {webinar.mentorName && <p class="text-lg font-bold text-dark">{webinar.mentorName}</p>}
                    {webinar.mentorDesignation && (
                      <p class="text-sm font-medium text-primary">{webinar.mentorDesignation}</p>
                    )}
                    {webinar.mentorExperience && (
                      <p class="text-xs font-medium text-text-default opacity-70">{webinar.mentorExperience}</p>
                    )}
                  </div>
                </div>
                {mentorParagraphs.map((para) => (
                  <p class="text-base leading-relaxed text-text-default opacity-85">{para}</p>
                ))}
              </section>
            )
          }
        </div>
      </div>
    </div>

    <Testimonials2 />

    {
      /* The seminar's own faq child table when it has one; FAQSection falls back
         to the site-wide questions otherwise. */
      webinar.faqs.length > 0 ? (
        <FAQSection
          faqs={webinar.faqs}
          eyebrow="Questions?"
          title="Frequently asked questions"
          description={`Common questions about ${webinar.title} and how to attend.`}
        />
      ) : (
        <FAQSection />
      )
    }

    <CallToAction2 />
  </main>
  <Footer />
</Layout>

<script>
  import { toast } from "@/lib/toast";
  import { mountTurnstile } from "@/lib/turnstile-client";

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("webinar-register-form") as HTMLFormElement | null;
    if (!form) return;

    const captcha = mountTurnstile(form);

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonLabel = submitButton ? submitButton.querySelector(".text-flip-inner") : null;
    const originalLabel = buttonLabel ? buttonLabel.textContent : "";

    // type="tel" still accepts letters and symbols, and maxlength caps length
    // without filtering characters - so strip anything non-numeric as it is
    // typed or pasted, and hard-cap the value at 10 digits.
    const mobileInput = form.querySelector<HTMLInputElement>('input[name="mobile"]');
    if (mobileInput) {
      mobileInput.addEventListener("input", () => {
        const digitsOnly = mobileInput.value.replace(/\D/g, "").slice(0, 10);
        if (mobileInput.value !== digitsOnly) mobileInput.value = digitsOnly;
      });
    }

    function setBusy(busy: boolean) {
      if (submitButton) submitButton.disabled = busy;
      if (!buttonLabel) return;
      const label = busy ? "Submitting..." : originalLabel;
      buttonLabel.textContent = label;
      buttonLabel.setAttribute("data-content", label);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const turnstileToken = captcha.getToken();
      if (!turnstileToken) {
        toast({
          title: "Verification needed",
          message: "Please wait for the verification check to finish, then try again.",
          variant: "error",
        });
        return;
      }

      const data = new FormData(form);
      const payload = {
        seminar: data.get("seminar") || "",
        fullName: data.get("fullName") || "",
        mobile: data.get("mobile") || "",
        city: data.get("city") || "",
        clientCode: data.get("clientCode") || "",
        refer: data.get("refer") || "",
        mode: data.get("mode") || "",
        turnstileToken,
      };

      setBusy(true);

      try {
        const res = await fetch("/api/seminar-register", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const result = await res.json().catch(() => ({
          ok: false,
          title: "Something went wrong",
          message: "Unexpected response from the server. Please try again.",
        }));

        toast({
          title: result.title || (result.ok ? "Registration Successful!" : "Registration Failed"),
          message: result.message || "",
          variant: result.ok ? "success" : "error",
        });

        if (result.ok) form.reset();
      } catch (error) {
        toast({ title: "Network error", message: "Please check your connection and try again.", variant: "error" });
      } finally {
        // The token is spent whether or not the registration went through.
        captcha.reset();
        setBusy(false);
      }
    });

    // Underline whichever section is on screen in the tab strip. Purely a
    // highlight - the links are plain anchors and work without this.
    const sectionLinks = document.querySelectorAll<HTMLAnchorElement>("[data-section-link]");
    if (sectionLinks.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.find((entry) => entry.isIntersecting);
          if (!visible) return;
          sectionLinks.forEach((link) =>
            link.setAttribute("aria-current", String(link.dataset.sectionLink === visible.target.id)),
          );
        },
        // Top third of the viewport: the section the reader is actually on,
        // rather than whatever is peeking in at the bottom.
        { rootMargin: "-80px 0px -66% 0px" },
      );

      sectionLinks.forEach((link) => {
        const section = document.getElementById(link.dataset.sectionLink || "");
        if (section) observer.observe(section);
      });
    }
  });
</script>
