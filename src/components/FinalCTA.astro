---

---

<section class="call-to-action overflow-hidden">
  <div class="relative container py-20 md:py-40">
    <div class="mx-auto space-y-8 text-center lg:max-w-3xl">
      <h2
        class="has-italic-text text-display-3 md:text-display-2 mb-8 text-center leading-[1.15] font-normal capitalize"
      >
        <div
          class="animated-text is-ready"
          data-duration="0.6"
          data-delay="0.2"
          data-stagger="0.09"
          style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
        >
          <span class="word" style="--word-index:0">Download</span>
          <span class="word" style="--word-index:1">
            <strong>GoPocket</strong>
          </span>
          <span class="word" style="--word-index:2">
            <strong>App</strong>
          </span>
          <span class="word" style="--word-index:3">-</span>
          <span class="word" style="--word-index:4">Swift,</span>
          <span class="word" style="--word-index:5">Secure</span>
          <span class="word" style="--word-index:6">and</span>
          <span class="word" style="--word-index:7">Smooth.</span>
          <span class="word" style="--word-index:8">Perfect</span>
          <span class="word" style="--word-index:9">for</span>
          <span class="word" style="--word-index:10">your</span>
          <span class="word" style="--word-index:11">
            <strong>Online</strong>
          </span>
          <span class="word" style="--word-index:12">
            <strong>Stock</strong>
          </span>
          <span class="word" style="--word-index:13">
            <strong>Trading</strong>
          </span>
          <span class="word" style="--word-index:14">journey.</span>
        </div>
      </h2>
      <div
        data-aos="fade-down-sm"
        data-aos-delay="100"
        class="mx-auto max-w-2xl space-y-1 text-center *:first:text-lg *:first:font-medium *:last:opacity-80 aos-init"
      >
        <p>Using our lightning speed mobile app</p>
      </div>
      <div
        data-aos="fade-down-sm"
        data-aos-delay="200"
        class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 pt-4 aos-init"
      >
        <a
          href="https://play.google.com/store/apps/details?id=com.codifi.gopocket"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block"
        >
          <img
            src="/assets/images/play-store-badge.svg"
            alt="download"
            loading="lazy"
            decoding="async"
            sizes="(min-width: 150px) 150px, 100vw"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
            width="150"
            height="48"
            class="z-10 h-12 w-auto"
          />
        </a>
        <a
          href="https://apps.apple.com/in/app/gopocket-stocks-mf-ipo/id6465894786"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block"
        >
          <img
            src="/assets/images/app-store-badge.svg"
            alt="download"
            loading="lazy"
            decoding="async"
            sizes="(min-width: 150px) 150px, 100vw"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
            width="150"
            height="48"
            class="z-10 h-12 w-auto"
          />
        </a>
        <!-- <div class="inline-flex items-center justify-center p-1 bg-white rounded-lg border border-gray-200 shadow-sm h-12 w-12">
          <img
            src="/assets/images/gopocket/gopocket-qr.svg"
            alt="QR code"
            loading="lazy"
            decoding="async"
            width="40"
            height="40"
            class="h-10 w-10 object-contain"
          />
        </div> -->
      </div>
    </div>
    <div
      class="pattern-shape pointer-events-none absolute top-0 left-0 -z-10 flex h-full w-[150%] opacity-40 select-none"
      style="transform: translateX(-1000px);"
    >
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"></div>
      <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"></div>
    </div>
  </div>
  <script>
    const pattern = document.querySelector<HTMLElement>(".call-to-action .pattern-shape");
    if (pattern) {
      const updatePattern = () => {
        const rect = pattern.parentElement?.getBoundingClientRect();
        if (rect && rect.top < window.innerHeight && rect.bottom > 0) {
          const progress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
          pattern.style.transform = `translateX(${-1000 + progress * 200}px)`;
        }
      };
      window.addEventListener("scroll", updatePattern, { passive: true });
      updatePattern();
    }
  </script>
</section>
