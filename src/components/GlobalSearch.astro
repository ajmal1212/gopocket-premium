---
import { TRENDING } from "@/data/trending";
import { SEARCH_SEGMENTS } from "@/lib/contracts";
---

<div id="global-search-modal" class="global-search-modal" aria-hidden="true">
  <div class="global-search-backdrop" data-search-close></div>
  <div class="global-search-panel" role="dialog" aria-modal="true" aria-label="Search">
    <div class="global-search-input-row">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-5"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
      >
      <input
        type="text"
        id="global-search-input"
        placeholder={`Search ${SEARCH_SEGMENTS[0].hint}`}
        autocomplete="off"
        aria-label="Search instruments"
      />
      <button type="button" class="global-search-close" data-search-close aria-label="Close search"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        ></button
      >
    </div>
    {
      /*
      Each tab is a set of Contract Master exchanges (see SEARCH_SEGMENTS). The
      search sends the tab's id and the server applies the exchange filter; the
      list here only narrows the recent and trending rows already on screen.
    */
    }
    <div class="global-search-tabs" role="group" aria-label="Search in">
      {
        SEARCH_SEGMENTS.map((segment, index) => (
          <button
            type="button"
            class:list={["global-search-tab", { "is-active": index === 0 }]}
            aria-pressed={index === 0 ? "true" : "false"}
            data-segment={segment.id}
            data-exchanges={segment.exchanges.join(",")}
            data-hint={segment.hint}
          >
            {segment.label}
          </button>
        ))
      }
    </div>
    <div class="global-search-results">
      <div id="global-search-recent-section" class="global-search-section" hidden>
        <p class="global-search-label">Recent</p>
        <ul id="global-search-recent-list"></ul>
      </div>
      <div id="gs-market-section" class="global-search-section" hidden>
        <p class="global-search-label">Top matches</p>
        <ul id="gs-market-list"></ul>
      </div>
      <div id="global-search-trending-section" class="global-search-section">
        <p class="global-search-label">Trending Searches</p>
        <ul id="global-search-list">
          {
            TRENDING.map((scrip) => (
              <li
                class="global-search-item"
                data-token={scrip.key}
                data-slug={scrip.slug}
                data-symbol={scrip.symbol}
                data-name={scrip.name}
                data-exchange={scrip.exchange}
              >
                <a href={`/stocks/${scrip.slug}`} class="w-full justify-between gap-3">
                  <span class="min-w-0">
                    <span class="text-dark block truncate text-sm font-semibold">
                      {scrip.symbol}
                      <span class="border-border-light text-text-default/70 ml-1.5 rounded border px-1 py-0.5 text-[10px] font-semibold uppercase">
                        {scrip.exchange}
                      </span>
                    </span>
                    <span class="text-text-default/70 block truncate text-[11px]">{scrip.name}</span>
                  </span>
                  <span class="shrink-0 text-right">
                    <span class="text-dark block text-sm font-semibold tabular-nums" data-gs-price>
                      —
                    </span>
                    <span class="block text-[11px] font-medium tabular-nums" data-gs-change />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <p id="global-search-empty" class="global-search-empty" hidden>No results found</p>
    </div>
  </div>
</div>

<script>
  import { register, unregister, subscribe } from "@/lib/feed/client";
  import type { Tick } from "@/lib/feed/types";

  /**
   * The header search popup: tabs, instrument search and live prices.
   *
   * Typing queries Contract Master through /api/contract-search - server-side,
   * because the Frappe token must not reach a browser - within the active tab,
   * which the server turns into a filter on the `exchange` field. With nothing
   * typed the popup shows the visitor's recent picks and the trending list,
   * narrowed to the tab.
   *
   * Every row on screen subscribes to the feed, so a name always arrives with a
   * price beside it. Rows are ordinary links to /stocks/<slug>; clicking one
   * records it as recent and navigates. The feed client is a module singleton,
   * so all of this shares one socket with anything else on the page.
   */

  const DEBOUNCE_MS = 300;
  const MIN_QUERY = 2;
  const RECENT_KEY = "gopocket_recent_searches";
  const RECENT_LIMIT = 3;
  /**
   * Rows under Recent, typed results and trending alike. Every row on screen
   * is a live feed subscription, so the popup shows the best few rather than a
   * page of them: at most eight tokens, with the recent three.
   */
  const LIST_LIMIT = 5;
  /** A row from these is a contract - "NIFTY 29th SEP FUT" - so that is its title, not the bare symbol. */
  const DERIVATIVES = new Set(["NFO", "BFO", "MCX"]);

  interface Scrip {
    key: string;
    symbol: string;
    exchange: string;
    name: string;
    slug: string;
  }

  const escapeHtml = (value: string): string =>
    value.replace(
      /[&<>"']/g,
      (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] as string,
    );

  const modal = document.getElementById("global-search-modal");
  const input = document.getElementById("global-search-input") as HTMLInputElement | null;
  const marketSection = document.getElementById("gs-market-section");
  const marketList = document.getElementById("gs-market-list");
  const recentSection = document.getElementById("global-search-recent-section");
  const recentList = document.getElementById("global-search-recent-list");
  const trendingSection = document.getElementById("global-search-trending-section");
  const trendingList = document.getElementById("global-search-list");
  const empty = document.getElementById("global-search-empty");
  const tabs = [...(modal?.querySelectorAll<HTMLButtonElement>("[data-segment]") ?? [])];

  if (
    modal &&
    input &&
    marketSection &&
    marketList &&
    recentSection &&
    recentList &&
    trendingSection &&
    trendingList &&
    empty &&
    tabs.length > 0
  ) {
    let active = tabs[0];
    let results: Scrip[] = [];
    let debounce: ReturnType<typeof setTimeout> | null = null;
    let inFlight: AbortController | null = null;
    /** token -> teardown, so a re-render never leaks a listener. */
    const bound = new Map<string, () => void>();

    /** Whether the active tab covers this exchange. */
    const inTab = (exchange: string) => (active.dataset.exchanges ?? "").split(",").includes(exchange);

    function loadRecent(): Scrip[] {
      try {
        const raw = localStorage.getItem(RECENT_KEY);
        const parsed = raw ? (JSON.parse(raw) as Scrip[]) : [];
        // Anything stored by an older version of this popup lacked a feed token
        // and a slug, so it can neither be priced nor linked. Entries without a
        // symbol came from trending rows that were missing data-symbol - they
        // would render as a blank title, so they are dropped too.
        return parsed.filter((scrip) => scrip && scrip.key && scrip.slug && scrip.symbol).slice(0, RECENT_LIMIT);
      } catch {
        return [];
      }
    }

    function rememberRecent(scrip: Scrip) {
      try {
        const next = [scrip, ...loadRecent().filter((r) => r.key !== scrip.key)].slice(0, RECENT_LIMIT);
        localStorage.setItem(RECENT_KEY, JSON.stringify(next));
      } catch {
        // A private window with storage blocked still gets a working search.
      }
    }

    const num = (value: string | undefined) => {
      if (!value) return null;
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : null;
    };

    const money = (value: number) =>
      "₹" + value.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    /** "NIFTY 29th SEP 25000 CE" -> "Call option". */
    const contractKind = (name: string) =>
      / FUT$/i.test(name) ? "Futures" : / CE$/i.test(name) ? "Call option" : / PE$/i.test(name) ? "Put option" : "";

    function row(scrip: Scrip): HTMLLIElement {
      const contract = DERIVATIVES.has(scrip.exchange);
      const title = contract ? scrip.name : scrip.symbol;
      const subtitle = contract ? [scrip.symbol, contractKind(scrip.name)].filter(Boolean).join(" · ") : scrip.name;

      const li = document.createElement("li");
      li.className = "global-search-item";
      li.dataset.token = scrip.key;
      li.dataset.slug = scrip.slug;
      li.dataset.symbol = scrip.symbol;
      li.dataset.name = scrip.name;
      li.dataset.exchange = scrip.exchange;
      li.innerHTML = [
        '<a href="/stocks/' + encodeURIComponent(scrip.slug) + '" class="w-full justify-between gap-3">',
        '<span class="min-w-0">',
        '<span class="text-dark block truncate text-sm font-semibold">',
        escapeHtml(title),
        '<span class="border-border-light text-text-default/70 ml-1.5 rounded border px-1 py-0.5 text-[10px] font-semibold uppercase">',
        escapeHtml(scrip.exchange),
        "</span></span>",
        '<span class="text-text-default/70 block truncate text-[11px]">',
        escapeHtml(subtitle),
        "</span></span>",
        '<span class="shrink-0 text-right">',
        '<span class="text-dark block text-sm font-semibold tabular-nums" data-gs-price>—</span>',
        '<span class="block text-[11px] font-medium tabular-nums" data-gs-change></span>',
        "</span></a>",
      ].join("");
      return li;
    }

    function paint(li: HTMLElement, tick: Tick) {
      const last = num(tick.lp);
      const percent = num(tick.pc);
      const previousClose = num(tick.c);

      const price = li.querySelector<HTMLElement>("[data-gs-price]");
      if (price && last !== null) price.textContent = money(last);

      const change = li.querySelector<HTMLElement>("[data-gs-change]");
      if (change && last !== null && percent !== null && previousClose !== null) {
        const delta = last - previousClose;
        const up = percent >= 0;
        const sign = up ? "+" : "";
        change.textContent = sign + delta.toFixed(2) + " (" + sign + percent.toFixed(2) + "%)";
        change.classList.toggle("text-emerald-600", up);
        change.classList.toggle("text-red-600", !up);
      }
    }

    /** The rows actually on screen; one in a hidden section, or filtered out by the tab, needs no price. */
    const shownRows = (): HTMLElement[] =>
      [recentSection, marketSection, trendingSection]
        .filter((section) => !section.hidden)
        .flatMap((section) => [...section.querySelectorAll<HTMLElement>("li[data-token]")])
        .filter((li) => !li.hidden);

    function unbindPrices() {
      for (const teardown of bound.values()) teardown();
      bound.clear();
    }

    function bindPrices() {
      unbindPrices();

      const tokens: string[] = [];
      for (const li of shownRows()) {
        const token = li.dataset.token;
        if (!token) continue;
        tokens.push(token);
        bound.set(
          token + ":" + tokens.length,
          subscribe(token, (tick) => paint(li, tick)),
        );
      }

      // Registering the new set releases whatever the last one had that this
      // doesn't - the NFO rows, say, after switching back to Stocks.
      register("gs-popup", [...new Set(tokens)]);
    }

    // Arrow functions from here: a hoisted function declaration doesn't keep
    // the null checks above, an arrow created after them does.

    /** Recent picks in the active tab, which head the popup whether or not anything is typed. */
    const showRecent = () => {
      const recent = loadRecent().filter((scrip) => inTab(scrip.exchange));
      recentList.replaceChildren(...recent.map(row));
      recentSection.hidden = recent.length === 0;
      return recent.length;
    };

    /**
     * Nothing typed: recent picks, then the first few trending rows in the
     * tab. The derivatives tabs have no trending rows, so they say what to
     * type instead.
     */
    const showIdle = () => {
      marketSection.hidden = true;
      const recent = showRecent();

      let trending = 0;
      for (const li of trendingList.querySelectorAll<HTMLElement>("li[data-token]")) {
        li.hidden = !inTab(li.dataset.exchange || "") || trending >= LIST_LIMIT;
        if (!li.hidden) trending++;
      }
      trendingSection.hidden = trending === 0;

      empty.textContent = "Type a symbol to search " + active.dataset.hint + ".";
      empty.hidden = recent + trending > 0;
    };

    /** Something typed: recent picks, then the best few matches in place of the trending list. */
    const showResults = () => {
      showRecent();
      trendingSection.hidden = true;

      marketList.replaceChildren(...results.slice(0, LIST_LIMIT).map(row));
      marketSection.hidden = results.length === 0;

      empty.textContent = "No results found";
      empty.hidden = results.length > 0;
    };

    const search = async () => {
      if (debounce) clearTimeout(debounce);
      debounce = null;
      inFlight?.abort();
      inFlight = null;

      const term = input.value.trim();
      if (term.length < MIN_QUERY) {
        results = [];
        showIdle();
        bindPrices();
        return;
      }

      const controller = new AbortController();
      inFlight = controller;
      try {
        const response = await fetch(
          "/api/contract-search?q=" + encodeURIComponent(term) + "&segment=" + (active.dataset.segment ?? "all"),
          { signal: controller.signal },
        );
        const body = (await response.json()) as { results?: Scrip[] };
        results = body.results ?? [];
        showResults();
        bindPrices();
      } catch {
        // An aborted request is the common case: the user kept typing, or
        // switched tabs.
      }
    };

    const selectTab = (tab: HTMLButtonElement) => {
      active = tab;
      for (const other of tabs) {
        other.classList.toggle("is-active", other === tab);
        other.setAttribute("aria-pressed", String(other === tab));
      }
      input.placeholder = "Search " + tab.dataset.hint;
    };

    const open = () => {
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      input.value = "";
      selectTab(tabs[0]);
      void search();
      setTimeout(() => input.focus(), 50);
    };

    const close = () => {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      if (debounce) clearTimeout(debounce);
      inFlight?.abort();
      // Nothing is on screen, so nothing needs a price. The hub drops a token
      // upstream once nobody anywhere is watching it.
      unregister("gs-popup");
      unbindPrices();
    };

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        if (tab === active) return;
        selectTab(tab);
        // On a phone the tab row scrolls sideways; keep the chosen one in view.
        tab.scrollIntoView({ block: "nearest", inline: "nearest" });
        void search();
        input.focus();
      });
    }

    input.addEventListener("input", () => {
      if (debounce) clearTimeout(debounce);
      debounce = setTimeout(search, DEBOUNCE_MS);
    });

    document.querySelectorAll(".search-toggle-btn").forEach((button) => button.addEventListener("click", open));
    modal.querySelectorAll("[data-search-close]").forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && modal.classList.contains("is-open")) close();
    });

    // Recording happens on the way out, without preventDefault, so the browser
    // still follows the link to the stock page.
    modal.addEventListener("click", (event) => {
      const li = (event.target as HTMLElement).closest<HTMLElement>("li[data-token]");
      if (!li?.dataset.token || !li.dataset.slug) return;
      rememberRecent({
        key: li.dataset.token,
        slug: li.dataset.slug,
        symbol: li.dataset.symbol || "",
        name: li.dataset.name || "",
        exchange: li.dataset.exchange || "",
      });
    });
  }
</script>
