---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import FAQSection2 from "../../components/FAQSection2.astro";
import ArticleCtaSidebar from "@/components/blog/ArticleCtaSidebar.astro";
import ProseEnhancements from "@/components/blog/ProseEnhancements.astro";
import NewsCover from "@/components/news/NewsCover.astro";
import ListIcon from "@lucide/astro/icons/list";
import ShareButtons from "@/components/news/ShareButtons.astro";
import PreferredSourceCard from "@/components/news/PreferredSourceCard.astro";
import { getNewsBySlugOrId } from "../../lib/frappe";
import { swr } from "@/lib/edge-cache";

const { slug } = Astro.params;

// The lookup is two sequential CMS round trips (slug -> id, then the record),
// which put the page's first byte at 1-2 s. That delay is what a WhatsApp share
// waits on: the preview card is built from this HTML, and a slow response gets
// the small thumbnail - or no image - instead of the large banner. Cached
// stale-while-revalidate, an edit shows up within a minute; an unpublished
// article can linger for up to the stale hour.
const waitUntil = Astro.locals.runtime?.ctx?.waitUntil?.bind(Astro.locals.runtime.ctx);
const post = slug
  ? await swr(`news:${slug}`, () => getNewsBySlugOrId(slug), { freshSeconds: 60, staleSeconds: 3600, waitUntil })
  : null;

if (!post) {
  return Astro.redirect("/news");
}

// FAQSection2 renders its FAQs grouped under category tabs, but a post's FAQ
// rows are a flat list, so present them as one group labelled with the post's
// primary category. The tab bar hides itself when there is only one group.
const faqCategories = post.faqs.length
  ? [
      {
        id: "article",
        label: post.categories[0] || "General",
        items: post.faqs.map(({ question, answer }) => ({ question, answer })),
      },
    ]
  : [];

const SITE = Astro.site?.origin ?? Astro.url.origin;
const postUrl = `${SITE}/news/${post.slug}`;

/*
 * Google Discover is image-led: it wants one large image (1200px+ wide - the
 * CMS standard is 1280x720) declared as the article's image in three places
 * that all agree - og:image, the NewsArticle schema's `image`, and the cover on
 * the page. Built through URL so a CMS filename with spaces is percent-encoded.
 * Articles without a main image fall back to the site card, which Discover
 * will not show; the fix for those is an image in Frappe.
 */
const imageUrl = post.mainImage ? new URL(post.mainImage, SITE).href : null;

/*
 * The byline's timestamps, to the minute and in IST like a newsroom's, rather
 * than the listing's date alone. "Updated" only shows when the record changed
 * more than an hour after it went out, so publishing-day touch-ups don't read
 * as a revision.
 */
const istFormat = new Intl.DateTimeFormat("en-US", {
  timeZone: "Asia/Kolkata",
  month: "short",
  day: "numeric",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
});
const stamp = (iso: string) => {
  const date = new Date(iso);
  return Number.isNaN(date.getTime()) ? null : `${istFormat.format(date)} IST`;
};
const publishedStamp = post.publishedISO ? stamp(post.publishedISO) : null;
const HOUR = 60 * 60 * 1000;
const updatedStamp =
  post.modifiedISO && post.publishedISO && Date.parse(post.modifiedISO) - Date.parse(post.publishedISO) > HOUR
    ? stamp(post.modifiedISO)
    : null;
const publisher = { "@type": "Organization", name: "GoPocket", url: `${SITE}/` };

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.title,
  description: post.description || post.summary,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  datePublished: post.publishedISO,
  dateModified: post.modifiedISO || post.publishedISO,
  articleSection: post.categories,
  keywords: post.categories.join(", "),
  inLanguage: "en",
  ...(imageUrl ? { image: [imageUrl] } : {}),
  author: { ...publisher, url: `${SITE}/about-us` },
  publisher: { ...publisher, logo: { "@type": "ImageObject", url: `${SITE}/gopocket-logo.svg` } },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "News", item: `${SITE}/news` },
    { "@type": "ListItem", position: 3, name: post.title, item: postUrl },
  ],
};

// Only emit FAQPage when the post actually carries FAQ rows - an empty
// mainEntity is invalid and Google flags it.
const faqSchema = post.faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: post.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    }
  : null;
---

<Layout
  title={`${post.title} - GoPocket News`}
  description={post.description || post.summary}
  canonical={`/news/${post.slug}`}
  ogType="article"
  ogImage={imageUrl ?? undefined}
  ogImageAlt={imageUrl ? post.title : undefined}
  ogImageSize={imageUrl ? { width: 1280, height: 720 } : undefined}
  largeImagePreview
>
  <Fragment slot="head">
    {/* The news RSS feed, for Discover's Follow button and feed readers. */}
    <link rel="alternate" type="application/rss+xml" title="GoPocket News" href={`${SITE}/news/rss.xml`} />
    {
      /*
      The cover is the LCP element and lives on the CMS origin. Preloading it
      starts the cross-origin connection and the download from <head> instead
      of waiting for the parser to reach the <img> in the body.
    */
    }
    {imageUrl && <link rel="preload" as="image" href={imageUrl} fetchpriority="high" />}
    <meta property="article:published_time" content={post.publishedISO} />
    <meta property="article:modified_time" content={post.modifiedISO || post.publishedISO} />
    <meta property="article:publisher" content={`${SITE}/`} />
    {post.categories[0] && <meta property="article:section" content={post.categories[0]} />}
    {post.categories.map((category) => <meta property="article:tag" content={category} />)}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>
  <Header currentPath="/news" />

  <main class="has-section-spacing-lg pt-6 md:pt-10">
    {
      /*
      Hero, after the news-site pattern Google Discover favours: the 16:9 cover
      at the full content width, the headline over its lower edge on a dark
      gradient. On a phone a long headline over a small image is unreadable, so
      the same <h1> drops below the image there and only overlays from md up.
      The cover is the LCP element, so it loads eagerly at high priority;
      width/height supply the 1280x720 ratio and the box sizes it.
    */
    }
    <section class="relative z-10 pt-0!">
      <div class="container max-w-7xl">
        <div class="relative">
          <div class="relative aspect-video overflow-hidden rounded-2xl bg-dark shadow-lg md:rounded-3xl">
            {
              imageUrl ? (
                <img
                  src={imageUrl}
                  alt={post.title}
                  width="1280"
                  height="720"
                  class="h-full w-full object-cover"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              ) : (
                <NewsCover slug={post.slug} size="lg" class="h-full w-full border-0" />
              )
            }
            <span
              class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-1/2 bg-gradient-to-t from-black/95 via-black/60 to-transparent md:block"
              aria-hidden="true"></span>
          </div>

          <h1
            class="text-black! dark:text-white! md:text-white! mt-5 text-[28px]! leading-tight! font-bold tracking-tight sm:text-[34px]! md:absolute md:inset-x-0 md:bottom-0 md:mt-0 md:p-8 md:text-[40px]! lg:p-12 lg:text-[52px]! md:[text-shadow:0_2px_12px_rgb(0_0_0/0.45)]"
          >
            {post.title}
          </h1>
        </div>
      </div>
    </section>

    <!-- Article Content & Always Sticky Right Sidebar CTA -->
    <section class="py-6 md:py-10">
      <div class="container max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          <!-- LEFT COLUMN: Byline, summary and post body (9 columns) -->
          <div class="lg:col-span-9 w-full space-y-8">
            {
              /*
              A visible byline: Discover weighs who wrote a story, not only the schema's author.
              On phones the date line drops to its own row (the dash only separates it on one
              line) and the newsroom blurb is hidden, so the byline stays two short lines
              instead of five ragged ones above the summary.
            */
            }
            <div class="flex items-start gap-3 md:gap-4">
              <span
                class="border-border-light flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-white md:h-14 md:w-14"
              >
                <img
                  src="/favicon.png"
                  alt=""
                  width="256"
                  height="256"
                  class="h-6 w-6 md:h-9 md:w-9"
                  aria-hidden="true"
                />
              </span>
              <div class="min-w-0">
                <p class="text-text-default flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                  <span class="text-dark font-semibold">
                    By <a href="/about-us" class="text-dark! underline underline-offset-2 hover:text-primary!"
                      >GoPocket</a
                    >
                  </span>
                  {
                    post.categories[0] && (
                      <span class="bg-primary/10 text-primary rounded-full px-2.5 py-0.5 text-xs font-semibold">
                        {post.categories[0]}
                      </span>
                    )
                  }
                  <span class="flex basis-full flex-wrap items-center gap-x-2 text-xs md:basis-auto md:text-sm">
                    {
                      publishedStamp && (
                        <>
                          <span class="hidden opacity-40 md:inline" aria-hidden="true">
                            —
                          </span>
                          <span class="font-medium">
                            Published <time datetime={post.publishedISO}>{publishedStamp}</time>
                          </span>
                        </>
                      )
                    }
                    {
                      updatedStamp && (
                        <span>
                          · Updated <time datetime={post.modifiedISO}>{updatedStamp}</time>
                        </span>
                      )
                    }
                    {post.readingMinutes > 0 && <span>· {post.readingMinutes} min read</span>}
                  </span>
                </p>
                <p class="text-text-default mt-1 line-clamp-2 hidden text-xs opacity-80 md:block md:text-sm">
                  GoPocket's newsroom explains Indian market news - company updates, quarterly results, IPOs and the
                  economy - for investors and traders.
                </p>
              </div>
            </div>

            {/* Below 1440px there's no margin to hang the rail in, so the share buttons sit in a row here. */}
            <ShareButtons url={postUrl} title={post.title} variant="row" class="min-[1440px]:hidden" />

            {
              /*
              From 1440px the share rail hangs in the page margin to the left of
              this column - absolutely positioned, so it takes no width from the
              summary and body. The wrapper spans the column's full height, so
              the sticky rail inside it stays in view all the way down.
            */
            }
            <div class="relative">
              <div class="absolute top-0 right-full bottom-0 mr-8 hidden min-[1440px]:block min-[1600px]:mr-12">
                <ShareButtons url={postUrl} title={post.title} variant="rail" />
              </div>
              <div class="space-y-8">
                {
                  post.description && (
                    <section aria-labelledby="article-summary">
                      <h2
                        id="article-summary"
                        class="text-dark! flex items-center gap-2 text-base! font-bold tracking-wide uppercase"
                      >
                        <ListIcon class="text-primary h-5 w-5" stroke-width={2} aria-hidden="true" />
                        Summary
                      </h2>
                      <div class="bg-theme-light border-primary mt-3 rounded-2xl border-l-4 p-5 md:p-6">
                        <p class="text-dark text-base leading-relaxed font-semibold md:text-lg">{post.description}</p>
                      </div>
                    </section>
                  )
                }

                <article
                  class="bg-theme-light px-3 py-6 sm:px-5 sm:py-10 md:px-7 md:py-12 rounded-3xl border border-border-light shadow-xs w-full overflow-hidden"
                >
                  {
                    post.postBody ? (
                      <div class="ql-editor read-mode w-full" set:html={post.postBody} />
                    ) : (
                      <div class="text-center py-12 text-gray-500">
                        <p>No content available for this article.</p>
                      </div>
                    )
                  }

                  <!-- Back to Blog Button -->
                  <div class="pt-8 mt-10 border-t border-border-light/80 flex items-center justify-between">
                    <a href="/news" class="btn btn-outline text-flip-hover-anim btn-sm cursor-pointer">
                      <span class="text-flip-inner" data-content="← Back to All News">← Back to All News</span>
                      <span
                        class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                      >
                        <svg
                          class="gradient-shape"
                          width="150"
                          height="28"
                          viewBox="0 0 147 11"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                            stroke="currentColor"
                            stroke-width="8"></path>
                        </svg>
                      </span>
                    </a>
                  </div>
                </article>
              </div>
            </div>
          </div>

          <ArticleCtaSidebar tag="News">
            <PreferredSourceCard />
          </ArticleCtaSidebar>
        </div>
      </div>
    </section>

    {
      post.faqs.length > 0 && (
        <FAQSection2
          titleBold="Frequently"
          title="asked questions"
          description="Quick answers to the most common questions about this story."
          categories={faqCategories}
        />
      )
    }

    <FinalCTA />
  </main>

  <Footer />
</Layout>

<ProseEnhancements />
