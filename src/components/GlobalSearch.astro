<script type="module" is:inline>(function(){
const m=document.getElementById("global-search-modal");
if(!m)return;
const i=document.getElementById("global-search-input"),
  list=document.getElementById("global-search-list"),
  empty=document.getElementById("global-search-empty"),
  tabs=[...m.querySelectorAll(".global-search-tab")],
  recentSection=document.getElementById("global-search-recent-section"),
  recentList=document.getElementById("global-search-recent-list"),
  items=[...list.querySelectorAll(".global-search-item")];
let activeCategory="all";
const ICON_HISTORY='<svg class="item-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg>';

function getRecent(){try{return JSON.parse(localStorage.getItem("gopocket_recent_searches")||"[]")}catch{return[]}}
function saveRecent(arr){try{localStorage.setItem("gopocket_recent_searches",JSON.stringify(arr))}catch{}}
function addRecent(key,name,category){
  let arr=getRecent().filter(r=>r.key!==key);
  arr.unshift({key,name,category});
  arr=arr.slice(0,5);
  saveRecent(arr);
  renderRecent();
}
function renderRecent(){
  const arr=getRecent();
  if(!arr.length){recentSection.hidden=true;recentList.innerHTML="";return}
  recentSection.hidden=false;
  recentList.innerHTML=arr.map(r=>'<li class="global-search-item" data-key="'+r.key+'" data-name="'+r.name+'" data-category="'+r.category+'"><a href="#">'+ICON_HISTORY+'<span class="item-name">'+r.name+'</span></a></li>').join("");
}

function applyFilters(){
  const q=i.value.trim().toLowerCase();
  let visible=0;
  items.forEach(li=>{
    const key=(li.dataset.key||"").toLowerCase(),name=(li.dataset.name||"").toLowerCase(),cat=li.dataset.category;
    const catOk=activeCategory==="all"||cat===activeCategory;
    const qOk=!q||key.includes(q)||name.includes(q);
    const ok=catOk&&qOk;
    li.hidden=!ok;
    if(ok)visible++;
  });
  empty.hidden=visible!==0;
}

function open(){m.classList.add("is-open");m.setAttribute("aria-hidden","false");document.body.style.overflow="hidden";i.value="";activeCategory="all";tabs.forEach(t=>t.classList.toggle("is-active",t.dataset.category==="all"));renderRecent();applyFilters();setTimeout(()=>i.focus(),50)}
function close(){m.classList.remove("is-open");m.setAttribute("aria-hidden","true");document.body.style.overflow=""}

document.querySelectorAll(".search-toggle-btn").forEach(b=>b.addEventListener("click",open));
m.querySelectorAll("[data-search-close]").forEach(el=>el.addEventListener("click",close));
document.addEventListener("keydown",ev=>{if(ev.key==="Escape"&&m.classList.contains("is-open"))close()});
i.addEventListener("input",applyFilters);
tabs.forEach(t=>t.addEventListener("click",()=>{activeCategory=t.dataset.category;tabs.forEach(x=>x.classList.toggle("is-active",x===t));applyFilters()}));
m.addEventListener("click",ev=>{
  const a=ev.target.closest(".global-search-item a");
  if(!a)return;
  ev.preventDefault();
  const li=a.closest(".global-search-item");
  addRecent(li.dataset.key,li.dataset.name,li.dataset.category);
  close();
});
})();</script>

