                    srcset="/assets/discord.C13X63ML_ZtzDFo-38fde012.webp 125w"
                    alt="About discord
"
                    loading="lazy"
                    decoding="async"
                    sizes="(min-width: 125px) 125px, 100vw"
                    data-astro-image="constrained"
                    data-astro-image-fit="cover"
                    data-astro-image-pos="center"
                    width="125"
                    height="125"
                    class="h-full w-full rounded-xl object-contain"
                  />
                </div>
                <a
                  rel="noopener noreferrer"
                  target="_blank"
                  class="btn btn-primary text-flip-hover-anim w-full text-center"
                  href="https://example.com/"
