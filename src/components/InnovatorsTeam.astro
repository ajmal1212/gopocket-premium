---

<section>
  <div class="container space-y-10 md:space-y-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="has-italic-text capitalize">
        <div
          class="animated-text is-ready"
          data-duration="0.6"
          data-delay="0.2"
          data-stagger="0.09"
          style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
        >
          <span class="word" style="--word-index:0">Built</span>
          <span class="word" style="--word-index:1">by</span>
          <span class="word" style="--word-index:2">Innovators,</span>
          <span class="word" style="--word-index:3">
            <strong>for</strong>
          </span>
          <strong>
            <span class="word" style="--word-index:4">Innovators</span>
          </strong>
        </div>
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-x-8 gap-y-4 lg:grid-cols-4">
      <div
        data-aos="fade-left-sm"
        data-aos-delay="100"
        class="from-theme-light mx-auto flex w-fit flex-col justify-between space-y-4 rounded-2xl bg-linear-to-b to-white p-4 aos-init"
      >
        <img
          src="/assets/images/team-avatar-1.webp"
          srcset="/assets/images/team-avatar-1.webp 274w"
          alt="Micheal Moore"
          loading="lazy"
          decoding="async"
          sizes="(min-width: 274px) 274px, 100vw"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="274"
          height="273"
          class="w-full max-w-72 rounded-xl"
        />
        <div>
          <h3 class="md:text-h6 text-h6-sm text-black">Micheal Moore</h3>
          <p>Customer Representative</p>
        </div>
      </div>
