---
import ChartArea from "@lucide/astro/icons/chart-area";
import ChartCandlestick from "@lucide/astro/icons/chart-candlestick";
import type { Candle } from "@/lib/feed/candles";
import { RANGES, INTRADAY_CANDLE_SECONDS, isDaily, downsample, toCandlesticks } from "@/lib/feed/candles";

interface Props {
  candles: Candle[];
  /**
   * The reference line, also used to colour the series: the previous close on
   * 1D, the range's first close on anything longer.
   */
  previousClose: number | null;
  token: string;
  /** Contract Master's exchange - decides the session hours the live chart grows within. */
  exchange: string;
  activeRange: string;
  slug: string;
  /** Daily history is equity-only upstream, so an index offers no long ranges. */
  dailyAvailable?: boolean;
  /** Open/close of the trading session, when the x-axis should span it. */
  session?: { start: number; end: number } | null;
  /** Live last price. Decides the colour, so the chart agrees with the header. */
  lastPrice?: number | null;
  /** Which chart to show first. The area chart is the default; `?chart=candles` asks for candlesticks. */
  view?: "area" | "candles";
}

const {
  candles,
  previousClose,
  token,
  exchange,
  activeRange,
  slug,
  dailyAvailable = true,
  session = null,
  lastPrice = null,
  view = "area",
} = Astro.props;

const ranges = RANGES.filter((range) => dailyAvailable || !isDaily(range));

/**
 * An inline SVG line-and-area chart, rendered on the server.
 *
 * No charting library: this is a path, a fill and a dashed reference line, and
 * a dependency for that would be bytes on every stock page for markup we can
 * emit directly. The viewBox is a fixed coordinate space that scales to any
 * width, so the same path is correct at every breakpoint - and because the
 * points are computed here, the chart is in the HTML before any script runs.
 */
const WIDTH = 720;
const HEIGHT = 260;
const PAD_Y = 12;

const points = downsample(candles);
const closes = points.map((candle) => candle.c);
const baseline = previousClose ?? (closes.length > 0 ? closes[0] : 0);

// The reference line has to be inside the plotted range, or a session that
// never crosses it would push it off the chart.
const low = Math.min(...closes, baseline);
const high = Math.max(...closes, baseline);
const span = high - low || 1;

/**
 * With a session the x-axis is time, so a chart drawn at noon fills half the
 * width and stops - the same as every broker's intraday chart. Without one
 * (the multi-day ranges) points are spaced evenly, since the gaps between
 * sessions would otherwise leave the line hanging over empty nights.
 */
const xs = points.map((candle, index) => {
  if (session) {
    const fraction = (candle.t - session.start) / (session.end - session.start);
    return Math.min(WIDTH, Math.max(0, fraction * WIDTH));
  }
  return points.length < 2 ? 0 : (index / (points.length - 1)) * WIDTH;
});

const y = (value: number) => PAD_Y + (1 - (value - low) / span) * (HEIGHT - PAD_Y * 2);

const line = points.map((candle, index) => `${xs[index].toFixed(2)},${y(candle.c).toFixed(2)}`);
const linePath = line.length > 0 ? `M${line.join(" L")}` : "";
// Closed under the line's own extent, not the full width, or the fill would
// run on past where trading has actually reached.
const areaPath =
  line.length > 0 ? `${linePath} L${xs[xs.length - 1].toFixed(2)},${HEIGHT} L${xs[0].toFixed(2)},${HEIGHT} Z` : "";

const last = closes.length > 0 ? closes[closes.length - 1] : null;
/*
 * Coloured by the live price rather than the last candle's close. The two
 * disagree while a stock hovers at its previous close - a candle can close a
 * paisa below it as the ticker reads a paisa above - and a red chart under a
 * green price is the kind of detail that costs trust.
 */
const current = lastPrice ?? last;
const isUp = current !== null && current >= baseline;
const baselineY = y(baseline).toFixed(2);
const hasChart = points.length > 1;

/*
 * The intraday chart keeps its SVG even with nothing to draw yet. Right at
 * the open the hub has one pre-open candle for the day, if that, so the server
 * has no line - but ticks are already flowing, and the script below builds the
 * line from them and swaps it in for the empty message.
 */
const intraday = activeRange === "1D";

/*
 * The candlestick view. Both views are in the HTML and the switch only toggles
 * which is shown, so changing it is instant and a `?chart=candles` link comes
 * back already drawn. The candles get their own vertical scale - they reach to
 * each high and low, which the closes never do - so the reference line, which
 * belongs to the area chart's scale, is not drawn over them.
 *
 * The same geometry is repeated in the script below, which redraws the last
 * candle as ticks arrive.
 */
const sticks = toCandlesticks(candles, intraday);
const stickLow = Math.min(...sticks.map((stick) => stick.l));
const stickSpan = Math.max(...sticks.map((stick) => stick.h)) - stickLow || 1;
const stickY = (value: number) => PAD_Y + (1 - (value - stickLow) / stickSpan) * (HEIGHT - PAD_Y * 2);
// On the intraday chart a candle is five minutes of the session's time axis;
// otherwise the candles share the width evenly.
const slot = session
  ? (INTRADAY_CANDLE_SECONDS / (session.end - session.start)) * WIDTH
  : WIDTH / Math.max(sticks.length, 1);
const stickX = (stick: Candle, index: number) =>
  session ? ((stick.t - session.start) / (session.end - session.start)) * WIDTH + slot / 2 : (index + 0.5) * slot;

const stickPaths = { up: { body: "", wick: "" }, down: { body: "", wick: "" } };
sticks.forEach((stick, index) => {
  const x = stickX(stick, index);
  const half = slot * 0.35;
  const top = stickY(Math.max(stick.o, stick.c));
  // A flat candle still gets a hairline body, or it would vanish.
  const height = Math.max(stickY(Math.min(stick.o, stick.c)) - top, 0.8);
  const paths = stick.c >= stick.o ? stickPaths.up : stickPaths.down;
  paths.body += `M${(x - half).toFixed(2)},${top.toFixed(2)}h${(half * 2).toFixed(2)}v${height.toFixed(2)}h${(-half * 2).toFixed(2)}Z`;
  paths.wick += `M${x.toFixed(2)},${stickY(stick.h).toFixed(2)}V${stickY(stick.l).toFixed(2)}`;
});

const candleView = view === "candles";
const chartHref = (range: string, chart: "area" | "candles") =>
  `/stocks/${slug}?range=${range}${chart === "candles" ? "&chart=candles" : ""}`;
---

<section
  class="flex flex-col gap-4"
  data-price-chart
  data-token={token}
  data-exchange={exchange}
  data-slug={slug}
  data-range={activeRange}
  data-baseline={previousClose ?? undefined}
  data-session-start={session?.start}
  data-session-end={session?.end}
  data-width={WIDTH}
  data-height={HEIGHT}
  data-pad={PAD_Y}
  data-closes={closes.join(",")}
  data-xs={xs.map((value) => value.toFixed(2)).join(",")}
  data-times={points.map((candle) => candle.t).join(",")}
  data-view={view}
  data-bucket={INTRADAY_CANDLE_SECONDS}
  data-sticks={sticks.map((stick) => [stick.t, stick.o, stick.h, stick.l, stick.c].join(",")).join(";")}
>
  <h2 class="sr-only">Price chart</h2>

  {
    (hasChart || intraday) && (
      <div class="relative w-full touch-pan-y" data-chart-surface hidden={!hasChart}>
        <svg
          viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
          preserveAspectRatio="none"
          class="h-56 w-full lg:h-72"
          role="img"
          aria-label="Price movement"
        >
          {/*
            The views are shown and hidden with the `hidden` class rather than
            the attribute: SVG elements have no `hidden` property to script, and
            Astro's SVG types don't accept the attribute either.
          */}
          <g
            class:list={[
              isUp ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400",
              "origin-bottom [transform-box:fill-box]",
              candleView && "hidden",
            ]}
            data-area-view
          >
            {/*
              The gradient lives inside this group on purpose: `currentColor` in
              a stop resolves against the stop's own inherited colour, so a
              <defs> at the root would paint the fill in the page's text colour
              - a grey wash under a green line - however the group is classed.
            */}
            <defs>
              <linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="currentColor" stop-opacity="0.20" />
                <stop offset="100%" stop-color="currentColor" stop-opacity="0.01" />
              </linearGradient>
            </defs>

            <line
              x1="0"
              x2={WIDTH}
              y1={baselineY}
              y2={baselineY}
              stroke="currentColor"
              stroke-width="1"
              stroke-dasharray="4 4"
              stroke-opacity="0.35"
              data-chart-baseline
            />
            <path d={areaPath} fill="url(#chart-fill)" data-chart-area />
            <path
              d={linePath}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
              data-chart-line
            />
          </g>

          <g class:list={["origin-bottom [transform-box:fill-box]", !candleView && "hidden"]} data-candle-view>
            {(["up", "down"] as const).map((side) => (
              <g
                class={side === "up" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"}
                data-candles={side}
              >
                <path
                  d={stickPaths[side].wick}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1"
                  vector-effect="non-scaling-stroke"
                  data-candle-wick
                />
                <path d={stickPaths[side].body} fill="currentColor" data-candle-body />
              </g>
            ))}
          </g>
        </svg>

        {/*
          Crosshair, marker and tooltip are HTML rather than SVG on purpose. The
          viewBox uses preserveAspectRatio="none" so the chart fills any width,
          which stretches the coordinate space horizontally - an SVG circle
          would render as an ellipse and text would come out condensed. HTML
          positioned by percentage is immune to that.
        */}
        <div class="pointer-events-none absolute inset-0 hidden" data-hover>
          <div class="border-border-light absolute top-0 bottom-0 border-l border-dashed" data-hover-line />
          <div
            class="absolute h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white shadow-sm dark:border-[#1c202e]"
            data-hover-dot
          />
          <div
            class="border-border-light absolute min-w-[104px] rounded-xl border bg-white px-3 py-2 text-center shadow-lg dark:bg-[#1c202e]"
            data-hover-card
          >
            <span class="text-dark block text-sm font-semibold tabular-nums" data-hover-price />
            <span
              class="text-text-default/80 block text-[11px] whitespace-nowrap tabular-nums"
              data-hover-ohlc
              hidden
            />
            <span class="text-text-default/70 block text-[11px] whitespace-nowrap" data-hover-time />
          </div>
        </div>
      </div>
    )
  }

  <p
    class="text-text-default/75 flex h-56 items-center justify-center text-sm lg:h-72"
    data-chart-empty
    hidden={hasChart}
  >
    No chart data available for this instrument.
  </p>

  <div class="flex flex-wrap items-center gap-2">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Chart range">
      {
        ranges.map((range) => (
          <a
            href={chartHref(range.id, view)}
            data-range-link={range.id}
            class:list={[
              "rounded-full border px-3 py-1 text-xs font-semibold transition-colors",
              range.id === activeRange
                ? "border-primary text-primary"
                : "border-border-light text-text-default/70 hover:text-text-default",
            ]}
            aria-current={range.id === activeRange ? "true" : undefined}
          >
            {range.label}
          </a>
        ))
      }
    </div>

    {
      /*
      Links rather than buttons, so the choice works without the script and
      survives into the range links. With the script the switch is instant and
      the address is updated in place instead of reloading the page.
    */
    }
    <span class="bg-border-light mx-1 h-5 w-px" aria-hidden="true"></span>
    <div class="border-border-light relative flex rounded-full border p-0.5" role="group" aria-label="Chart type">
      {
        /*
        The active fill is one pill that slides between the two icons, rather
        than each link painting its own background - the movement is what
        makes the switch read as a switch.
      */
      }
      <span
        class:list={[
          "bg-primary shadow-primary/30 absolute top-0.5 left-0.5 h-8 w-[104px] rounded-full shadow-md",
          "transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none",
          view === "candles" && "translate-x-full",
        ]}
        aria-hidden="true"
        data-view-thumb></span>
      {
        (
          [
            { id: "area", label: "Area", Icon: ChartArea },
            { id: "candles", label: "Candles", Icon: ChartCandlestick },
          ] as const
        ).map(({ id, label, Icon }) => (
          <a
            href={chartHref(activeRange, id)}
            class:list={[
              "relative z-10 flex h-8 w-[104px] items-center justify-center gap-1.5 rounded-full text-xs font-semibold transition-colors duration-300",
              id === view ? "text-white!" : "text-text-default/70 hover:text-text-default",
            ]}
            aria-current={id === view ? "true" : undefined}
            data-view-link={id}
          >
            <Icon class="h-4 w-4" stroke-width={1.8} aria-hidden="true" />
            {label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { register, subscribe } from "@/lib/feed/client";
  import { sessionAt, type Session } from "@/lib/feed/session";
  import type { Tick } from "@/lib/feed/types";

  /**
   * Keep the server-rendered chart moving with the live price.
   *
   * The closing values are carried in a data attribute rather than re-derived
   * from the SVG path, because a tick can move the price outside the plotted
   * range - and rescaling needs the real numbers, not screen coordinates. Each
   * tick recomputes the whole path, which is a handful of arithmetic on a few
   * hundred points and cheaper than it sounds.
   *
   * The longer ranges only move their last point: a tick is the candle still
   * forming. The intraday chart also grows, a point a minute on the session's
   * time axis, so a page open at 9:15 - when the hub has no candles for the day
   * yet - draws the session as it trades instead of sitting empty.
   */
  const chart = document.querySelector<HTMLElement>("[data-price-chart]");
  const token = chart?.dataset.token;
  const surface = chart?.querySelector<HTMLElement>("[data-chart-surface]");
  const line = chart?.querySelector<SVGPathElement>("[data-chart-line]");
  const area = chart?.querySelector<SVGPathElement>("[data-chart-area]");
  const base = chart?.querySelector<SVGLineElement>("[data-chart-baseline]");
  const empty = chart?.querySelector<HTMLElement>("[data-chart-empty]");
  const group = line?.parentElement;
  const candleView = chart?.querySelector<SVGGElement>("[data-candle-view]");

  if (chart && token && surface && line && area && base && empty && group && candleView) {
    const width = Number(chart.dataset.width);
    const height = Number(chart.dataset.height);
    const pad = Number(chart.dataset.pad);
    const intraday = chart.dataset.range === "1D";
    // MCX trades into the night; everything else keeps equity hours.
    const sessionOf = (epoch: number) => sessionAt(epoch, chart.dataset.exchange);

    const num = (value: string | undefined) => {
      if (!value) return null;
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : null;
    };
    // An empty attribute must give an empty list: "".split(",") is [""], which
    // Number() would turn into a phantom point at zero.
    const list = (value: string | undefined) => (value ? value.split(",").map(Number) : []);

    let closes = list(chart.dataset.closes);
    let times = list(chart.dataset.times);
    // The multi-day ranges are spaced evenly by the server and never gain a
    // point, so their x positions are used as sent.
    const evenXs = list(chart.dataset.xs);
    let baseline = num(chart.dataset.baseline);
    const start = num(chart.dataset.sessionStart);
    const end = num(chart.dataset.sessionEnd);
    let session: Session | null = start !== null && end !== null ? { start, end } : null;

    type Stick = { t: number; o: number; h: number; l: number; c: number };
    const toStick = ([t, o, h, l, c]: number[]): Stick => ({ t, o, h, l, c });
    let sticks: Stick[] = (chart.dataset.sticks ? chart.dataset.sticks.split(";") : []).map((row) =>
      toStick(row.split(",").map(Number)),
    );
    const bucket = Number(chart.dataset.bucket);
    let view = chart.dataset.view === "candles" ? "candles" : "area";

    // The vertical scale changes whenever a tick moves the price outside the
    // plotted range, and the hover marker has to sit on the line as drawn - so
    // the scale lives out here, where both halves read it.
    let low = 0;
    let high = 0;

    const xAt = (index: number) => {
      if (!session) return evenXs[index] ?? 0;
      const fraction = (times[index] - session.start) / (session.end - session.start);
      return Math.min(width, Math.max(0, fraction * width));
    };

    const yOf = (value: number) => {
      const span = high - low || 1;
      return pad + (1 - (value - low) / span) * (height - pad * 2);
    };

    // Same rule as the server: the previous close, else the first point.
    const reference = () => baseline ?? closes[0];

    const draw = () => {
      if (closes.length < 2) return;

      const ref = reference();
      low = Math.min(...closes, ref);
      high = Math.max(...closes, ref);

      const xs = closes.map((_, index) => xAt(index).toFixed(2));
      const path = `M${closes.map((value, index) => `${xs[index]},${yOf(value).toFixed(2)}`).join(" L")}`;

      line.setAttribute("d", path);
      area.setAttribute("d", `${path} L${xs[xs.length - 1]},${height} L${xs[0]},${height} Z`);
      const baseY = yOf(ref).toFixed(2);
      base.setAttribute("y1", baseY);
      base.setAttribute("y2", baseY);

      const up = closes[closes.length - 1] >= ref;
      group.classList.toggle("text-emerald-600", up);
      group.classList.toggle("dark:text-emerald-400", up);
      group.classList.toggle("text-red-600", !up);
      group.classList.toggle("dark:text-red-400", !up);

      surface.hidden = false;
      empty.hidden = true;
    };

    // The candles' own scale, read by the hover as well as the drawing.
    let stickLow = 0;
    let stickHigh = 0;
    const stickY = (value: number) => {
      const span = stickHigh - stickLow || 1;
      return pad + (1 - (value - stickLow) / span) * (height - pad * 2);
    };
    const slot = () =>
      session ? (bucket / (session.end - session.start)) * width : width / Math.max(sticks.length, 1);
    const stickX = (index: number) =>
      session
        ? ((sticks[index].t - session.start) / (session.end - session.start)) * width + slot() / 2
        : (index + 0.5) * slot();

    // Same geometry as the server render.
    const drawCandles = () => {
      if (sticks.length === 0) return;
      stickLow = Math.min(...sticks.map((stick) => stick.l));
      stickHigh = Math.max(...sticks.map((stick) => stick.h));
      const half = slot() * 0.35;
      const paths = { up: { body: "", wick: "" }, down: { body: "", wick: "" } };
      sticks.forEach((stick, index) => {
        const x = stickX(index);
        const top = stickY(Math.max(stick.o, stick.c));
        const tall = Math.max(stickY(Math.min(stick.o, stick.c)) - top, 0.8);
        const side = stick.c >= stick.o ? paths.up : paths.down;
        side.body += `M${(x - half).toFixed(2)},${top.toFixed(2)}h${(half * 2).toFixed(2)}v${tall.toFixed(2)}h${(-half * 2).toFixed(2)}Z`;
        side.wick += `M${x.toFixed(2)},${stickY(stick.h).toFixed(2)}V${stickY(stick.l).toFixed(2)}`;
      });
      for (const side of ["up", "down"] as const) {
        const node = candleView.querySelector(`[data-candles="${side}"]`);
        node?.querySelector("[data-candle-body]")?.setAttribute("d", paths[side].body);
        node?.querySelector("[data-candle-wick]")?.setAttribute("d", paths[side].wick);
      }
    };
    if (sticks.length > 0) {
      stickLow = Math.min(...sticks.map((stick) => stick.l));
      stickHigh = Math.max(...sticks.map((stick) => stick.h));
    }

    /**
     * Fold a price into the candles. The longer ranges only move their last
     * candle; the intraday chart opens a new one every five minutes of trading,
     * and starts over when a new session does - the same rules as `extend`.
     */
    const foldCandle = (price: number, time: number, open: number | null = null) => {
      let last: Stick | undefined = sticks[sticks.length - 1];
      if (intraday) {
        if (!session) return;
        if (last && last.t < session.start) {
          sticks = [];
          last = undefined;
        }
        if (sessionOf(time).start !== session.start) return;
        const trading = time >= session.start && time <= session.end;
        const at = Math.floor(time / bucket) * bucket;
        if (trading && (!last || at > last.t)) {
          const o = last ? price : (open ?? price);
          sticks.push({ t: at, o, h: Math.max(o, price), l: Math.min(o, price), c: price });
          return;
        }
      }
      if (!last) return;
      last.c = price;
      last.h = Math.max(last.h, price);
      last.l = Math.min(last.l, price);
    };

    /**
     * Fold one tick into the intraday series.
     *
     * Points sit a minute apart, like the hub's one-minute candles: a tick in
     * the same minute as the last point moves it, a tick in a new minute adds
     * one. Appending every tick would stack hundreds of points a minute during
     * a busy open, for a line that looks the same.
     */
    const extend = (price: number, tick: Tick) => {
      // `ft` is the exchange's feed time in epoch seconds. The local clock is
      // only the fallback, since a visitor's clock can be minutes out.
      const time = num(tick.ft) ?? Math.floor(Date.now() / 1000);
      const day = sessionOf(time);
      const trading = time >= day.start && time <= day.end;

      if (trading && (!session || day.start > session.start)) {
        // The first trade of a new session. Whatever the server drew belongs
        // to an earlier day, so the line starts over - from the 9:15 open, so
        // the very first tick already makes a segment worth drawing.
        session = day;
        closes = [];
        times = [];
        const open = num(tick.o);
        if (open !== null) {
          closes.push(open);
          times.push(day.start);
        }
        closes.push(price);
        times.push(time);
        return;
      }

      // Pre-open and post-close ticks only correct the last point, and only
      // on the day the chart is showing.
      const last = closes.length - 1;
      if (last < 0 || !session || day.start !== session.start) return;

      if (trading && Math.floor(time / 60) > Math.floor(times[last] / 60)) {
        closes.push(price);
        times.push(time);
      } else {
        closes[last] = price;
        if (trading) times[last] = Math.max(times[last], time);
      }
    };

    // What the line was last drawn from, so a tick that leaves it unchanged
    // costs no repaint. The forming point's time is left out on purpose; it
    // drifts under two pixels a minute and catches up on the next price change.
    let drawn = "";
    const drawnFrom = () =>
      `${closes.length}|${closes[closes.length - 1]}|${baseline}|${session?.start}|${sticks.length}`;

    const render = (tick: Tick) => {
      const price = num(tick.lp);
      if (price === null) return;
      // The header measures the day's change from the feed's previous close, so
      // the intraday reference line follows the same number. A longer range is
      // measured from its own first close, which a tick never changes.
      if (intraday) baseline = num(tick.c) ?? baseline;

      if (intraday) extend(price, tick);
      else if (closes.length > 0) closes[closes.length - 1] = price;
      foldCandle(price, num(tick.ft) ?? Math.floor(Date.now() / 1000), num(tick.o));

      /*
       * Most ticks don't move the line: the feed prints a new volume or bid
       * several times for every change in last price. Rewriting the path
       * anyway repaints the chart - while the visitor is scrolling past it -
       * for pixels that come out identical.
       */
      const state = drawnFrom();
      if (state === drawn) return;
      drawn = state;
      draw();
      drawCandles();
    };

    /**
     * Filling in what a hidden tab missed.
     *
     * The feed is let go of while the tab is hidden (see client.ts), so the
     * line gets no points for that stretch, and the first tick back would join
     * the last point before it to the first after with one straight segment.
     * So the session's candles are fetched again and the line rebuilt from
     * them, keeping any live points newer than the last candle.
     */
    // A tab opened in the background has been missing ticks since it loaded.
    let hiddenAt: number | null = document.hidden ? Date.now() / 1000 : null;

    const catchUp = async () => {
      if (hiddenAt === null) return;
      const since = hiddenAt;
      hiddenAt = null;

      // Nothing to fill unless the tab was away for over a minute that could
      // have traded: an evening off-screen misses no candles.
      const now = Date.now() / 1000;
      const day = sessionOf(now);
      const quiet = sessionOf(since).start === day.start && (since >= day.end || now <= day.start);
      if (now - since < 60 || quiet) return;

      let fetched: { t?: unknown; c?: unknown; k?: unknown };
      try {
        const response = await fetch(`/api/intraday-candles?token=${encodeURIComponent(token)}`);
        if (!response.ok) return;
        fetched = await response.json();
      } catch {
        return;
      }
      const { t, c, k } = fetched;
      if (!Array.isArray(t) || !Array.isArray(c) || t.length < 2 || t.length !== c.length) return;

      const lastCandle = t[t.length - 1] as number;
      const candleSession = sessionOf(lastCandle);
      // The live ticks have already started a later session than the hub has
      // candles for - the first minutes after the open - so the line stays.
      if (session && candleSession.start < session.start) return;

      // Read now, not before the fetch: ticks kept arriving while it ran.
      const minute = Math.floor(lastCandle / 60);
      const live = session?.start === candleSession.start ? times.map((time, index) => [time, closes[index]]) : [];
      const newer = live.filter(([time]) => Math.floor(time / 60) > minute);
      const latest = live[live.length - 1];

      session = candleSession;
      times = [...(t as number[]), ...newer.map(([time]) => time)];
      closes = [...(c as number[]), ...newer.map(([, close]) => close)];
      // The candle still forming can be half a minute old; a tick in that
      // same minute is newer.
      if (newer.length === 0 && latest && Math.floor(latest[0] / 60) === minute) {
        closes[closes.length - 1] = latest[1];
      }

      // The candles are rebuilt from the same answer, then the live points
      // newer than it are folded back in.
      if (Array.isArray(k) && k.length > 0) {
        sticks = (k as number[][]).map(toStick);
        for (const [time, close] of newer) foldCandle(close, time);
        if (newer.length === 0 && latest && Math.floor(latest[0] / 60) === minute) foldCandle(latest[1], latest[0]);
      }

      drawn = drawnFrom();
      draw();
      drawCandles();
    };

    if (intraday) {
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) hiddenAt ??= Date.now() / 1000;
        else void catchUp();
      });
      // Back from the back/forward cache, which may not count as becoming visible.
      window.addEventListener("pageshow", (event) => {
        if (event.persisted && !document.hidden) void catchUp();
      });
    }

    /**
     * Crosshair and tooltip.
     *
     * The series and its scale are read on every move rather than captured,
     * because a tick can rescale the chart - or add a point - under the cursor,
     * and the marker must land on the line as it is drawn now.
     */
    const hover = () => {
      const layer = chart.querySelector<HTMLElement>("[data-hover]");
      const rule = chart.querySelector<HTMLElement>("[data-hover-line]");
      const dot = chart.querySelector<HTMLElement>("[data-hover-dot]");
      const card = chart.querySelector<HTMLElement>("[data-hover-card]");
      const priceEl = chart.querySelector<HTMLElement>("[data-hover-price]");
      const timeEl = chart.querySelector<HTMLElement>("[data-hover-time]");
      const ohlcEl = chart.querySelector<HTMLElement>("[data-hover-ohlc]");

      if (!layer || !rule || !dot || !card || !priceEl || !timeEl || !ohlcEl) return;

      const money = (value: number) =>
        "₹" + value.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      const label = (epoch: number) => {
        const date = new Date(epoch * 1000);
        return intraday
          ? date.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: true })
          : date.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
      };

      const move = (event: PointerEvent) => {
        const box = surface.getBoundingClientRect();
        if (box.width === 0) return;

        const cursor = { x: event.clientX - box.left, y: event.clientY - box.top };

        // Pointer position in the viewBox's own coordinates. The mapping is a
        // plain ratio because preserveAspectRatio is none - the chart is
        // stretched to the box, never letterboxed.
        const cursorX = ((event.clientX - box.left) / box.width) * width;

        // Over candles the card reads the whole candle, and the dot - which
        // marks a point on the line - is left out.
        const candles = view === "candles";
        dot.hidden = candles;
        ohlcEl.hidden = !candles;
        if (candles) {
          let nearest = 0;
          let gap = Infinity;
          for (let i = 0; i < sticks.length; i++) {
            const distance = Math.abs(stickX(i) - cursorX);
            if (distance < gap) {
              gap = distance;
              nearest = i;
            }
          }
          const stick = sticks[nearest];
          if (!stick) return;
          rule.style.left = (Math.min(stickX(nearest), width) / width) * 100 + "%";
          priceEl.textContent = money(stick.c);
          ohlcEl.textContent = `O ${stick.o.toFixed(2)}  H ${stick.h.toFixed(2)}  L ${stick.l.toFixed(2)}`;
          timeEl.textContent = label(stick.t);
        }

        let index = 0;
        let best = Infinity;
        for (let i = 0; !candles && i < closes.length; i++) {
          const distance = Math.abs(xAt(i) - cursorX);
          if (distance < best) {
            best = distance;
            index = i;
          }
        }

        if (!candles) {
          const value = closes[index];
          if (value === undefined) return;

          const xPercent = (xAt(index) / width) * 100;
          const yPercent = (yOf(value) / height) * 100;
          const up = value >= reference();

          rule.style.left = xPercent + "%";
          dot.style.left = xPercent + "%";
          dot.style.top = yPercent + "%";
          dot.classList.toggle("bg-emerald-600", up);
          dot.classList.toggle("bg-red-600", !up);

          priceEl.textContent = money(value);
          timeEl.textContent = label(times[index] ?? 0);
        }

        /*
         * The card rides just above and to the right of the cursor, the way a
         * native tooltip does, so it never sits on the part of the line being
         * pointed at. Near an edge it flips to whichever side has room rather
         * than being clipped.
         */
        // Wider to the side than above: the crosshair runs vertically through
        // the cursor, so a small horizontal gap still leaves the card sitting
        // on it.
        const GAP_X = 36;
        const GAP_Y = 26;
        const cardWidth = card.offsetWidth;
        const cardHeight = card.offsetHeight;

        const roomRight = cursor.x + GAP_X + cardWidth <= box.width - 4;
        const left = roomRight ? cursor.x + GAP_X : cursor.x - GAP_X - cardWidth;

        const roomAbove = cursor.y - GAP_Y - cardHeight >= 4;
        const top = roomAbove ? cursor.y - GAP_Y - cardHeight : cursor.y + GAP_Y;

        card.style.left = Math.min(Math.max(left, 4), box.width - cardWidth - 4) + "px";
        card.style.top = Math.min(Math.max(top, 4), box.height - cardHeight - 4) + "px";

        layer.classList.remove("hidden");
      };

      const leave = () => layer.classList.add("hidden");

      surface.addEventListener("pointermove", move);
      surface.addEventListener("pointerleave", leave);
      surface.addEventListener("pointercancel", leave);
    };

    /**
     * Area / candlestick switch. Both views are already drawn, so this only
     * swaps which is shown, then carries the choice into the address and the
     * range links - a reload or a new range keeps it.
     */
    const viewLinks = chart.querySelectorAll<HTMLAnchorElement>("[data-view-link]");
    const areaView = chart.querySelector<SVGGElement>("[data-area-view]");
    const thumb = chart.querySelector<HTMLElement>("[data-view-thumb]");
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

    /*
     * A crossfade: the outgoing view fades while the incoming one fades in and
     * rises a little from the baseline. Opacity and transform only, so it runs
     * on the compositor, and a second click mid-animation cancels the first
     * rather than queueing behind it.
     */
    const swap = (show: SVGGElement, hide: SVGGElement) => {
      for (const el of [show, hide]) for (const running of el.getAnimations()) running.cancel();
      show.classList.remove("hidden");
      if (calm.matches) {
        hide.classList.add("hidden");
        return;
      }
      show.animate(
        [
          { opacity: 0, transform: "scaleY(0.9)" },
          { opacity: 1, transform: "scaleY(1)" },
        ],
        { duration: 450, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
      );
      const fade = hide.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: 200,
        easing: "ease-out",
        fill: "forwards",
      });
      // Hidden once faded, then the held opacity is dropped so the view is
      // whole again the next time it is shown.
      fade.onfinish = () => {
        hide.classList.add("hidden");
        fade.cancel();
      };
    };

    const setView = (next: string) => {
      if (next === view) return;
      view = next;
      if (areaView) {
        if (next === "candles") swap(candleView, areaView);
        else swap(areaView, candleView);
      }
      thumb?.classList.toggle("translate-x-full", next === "candles");

      for (const link of viewLinks) {
        const active = link.dataset.viewLink === next;
        link.classList.toggle("text-white!", active);
        link.classList.toggle("text-text-default/70", !active);
        link.classList.toggle("hover:text-text-default", !active);
        if (active) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }

      const withView = (href: string) => {
        const url = new URL(href, location.href);
        if (next === "candles") url.searchParams.set("chart", "candles");
        else url.searchParams.delete("chart");
        return url.pathname + url.search;
      };
      for (const link of chart.querySelectorAll<HTMLAnchorElement>("[data-range-link]")) {
        link.href = withView(link.href);
      }
      history.replaceState(history.state, "", withView(location.href));
    };

    for (const link of viewLinks) {
      link.addEventListener("click", (event) => {
        // A modified click still opens the link as a link.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        setView(link.dataset.viewLink ?? "area");
      });
    }

    hover();
    register("stock-chart", [token]);
    subscribe(token, render);
  }
</script>
