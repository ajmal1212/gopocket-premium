          <h1>
            <div
              class="animated-text has-italic-text lg:text-display-1 text-display-3 md:text-display-2 mb-8 text-center leading-[1.15] font-normal capitalize md:mb-10 is-ready is-animated"
              data-duration="0.6"
              data-delay="0.1"
              data-stagger="0.1"
              style="--animated-text-duration:0.6s;--animated-text-delay:0.1s;--animated-text-stagger:0.1s;"
            >
              <span class="word" style="--word-index:0">The</span>
              <span class="word" style="--word-index:1"
                ><strong>Smartest</strong></span
              ><strong>
                <span class="word" style="--word-index:2">Way</span></strong
              >
              <span class="word" style="--word-index:3">to</span>
              <span class="word" style="--word-index:4">Trade,</span>
              <span class="word" style="--word-index:5">Invest</span>
              <span class="word" style="--word-index:6">&amp;</span>
              <span class="word" style="--word-index:7">Grow</span>
            </div>
            <script type="module" is:inline={true}>
              const r = document.querySelectorAll(".animated-text");
              if (window.matchMedia("(max-width: 767px)").matches)
                r.forEach((t) => {
                  t.querySelectorAll(".word").forEach((e) => {
                    (e.style.opacity = "1"),
                      (e.style.filter = "none"),
                      (e.style.transform = "none");
                  });
                });
              else {
                const t = new IntersectionObserver(
                  (e, a) => {
                    e.forEach((s) => {
                      s.isIntersecting &&
                        (s.target.classList.add("is-animated"),
                        a.unobserve(s.target));
                    });
                  },
                  { threshold: 0.1 },
                );
                r.forEach((e) => {
                  e.classList.add("is-ready"), t.observe(e);
                });
              }
            </script>
          </h1>
