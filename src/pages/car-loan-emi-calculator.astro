<!-- Chart.js, loaded the same way as on the other calculator pages. -->
<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  interface Range {
    min: number;
    max: number;
    step: number;
    value: number;
  }

  interface CarType {
    id: string;
    price: Range;
    down: number;
    rate: Range;
    tenure: Range;
  }

  // The loan must be at least this much, so the down payment can never reach
  // the full price.
  const MIN_LOAN = 10000;

  let chartInstance: any = null;

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const formatCurrency = (val: number) =>
    new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(
      Math.round(val),
    );

  function updateSliderTrack(slider: HTMLInputElement | null) {
    if (!slider) return;
    const min = parseFloat(slider.min) || 0;
    const max = parseFloat(slider.max) || 100;
    const val = parseFloat(slider.value) || 0;
    const pct = Math.min(100, Math.max(0, ((val - min) / (max - min)) * 100));
    const trackBg = document.documentElement.classList.contains("dark") ? "#262938" : "#e2e8f0";
    slider.style.background = `linear-gradient(to right, #6b1aff 0%, #6b1aff ${pct}%, ${trackBg} ${pct}%, ${trackBg} 100%)`;
  }

  // Reads an input clamped to its own min/max.
  function read(id: string): number {
    const input = byId<HTMLInputElement>(`${id}-input`);
    if (!input) return 0;
    const min = parseFloat(input.min) || 0;
    const max = parseFloat(input.max) || Infinity;
    const value = parseFloat(input.value);
    return Math.min(max, Math.max(min, Number.isFinite(value) ? value : min));
  }

  function monthlyEmi(principal: number, ratePa: number, months: number): number {
    const r = ratePa / 12 / 100;
    if (r === 0) return principal / months;
    const growth = Math.pow(1 + r, months);
    return (principal * r * growth) / (growth - 1);
  }

  // The down payment's ceiling follows the price, so a cheaper car can never
  // be left with a down payment larger than itself.
  function syncDownPaymentLimit() {
    const price = read("price");
    const cap = Math.max(0, price - MIN_LOAN);
    ["down-input", "down-slider"].forEach((id) => {
      const el = byId<HTMLInputElement>(id);
      if (!el) return;
      el.max = String(cap);
      if (parseFloat(el.value) > cap) el.value = String(cap);
    });
  }

  function calculate() {
    syncDownPaymentLimit();

    const price = read("price");
    const down = read("down");
    const rate = read("rate");
    const years = Math.round(read("tenure"));
    const months = years * 12;

    const loan = Math.max(0, price - down);
    const emi = monthlyEmi(loan, rate, months);
    const repayment = emi * months;
    const interest = Math.max(0, repayment - loan);

    const set = (id: string, text: string) => {
      const el = byId(id);
      if (el) el.innerText = text;
    };
    set("output-emi", formatCurrency(emi));
    set("output-emi-note", `for ${months} months`);
    set("output-loan", formatCurrency(loan));
    set("output-interest", formatCurrency(interest));
    set("output-repayment", formatCurrency(repayment));
    set("output-cost", formatCurrency(repayment + down));
    set("down-percent", `(${Math.round((down / price) * 100)}%)`);

    ["price", "down", "rate", "tenure"].forEach((id) => updateSliderTrack(byId<HTMLInputElement>(`${id}-slider`)));
    updateChart(loan, interest);
    updateSchedule(loan, rate, years, emi);
  }

  function updateChart(loan: number, interest: number) {
    const canvas = byId<HTMLCanvasElement>("car-chart");
    if (!canvas) return;
    if (chartInstance) {
      chartInstance.data.datasets[0].data = [loan, interest];
      chartInstance.update();
      return;
    }
    const Chart = (window as any).Chart;
    if (!Chart) return;
    chartInstance = new Chart(canvas, {
      type: "doughnut",
      data: {
        labels: ["Loan amount", "Total interest"],
        datasets: [
          {
            data: [loan, interest],
            backgroundColor: ["rgba(107, 26, 255, 0.2)", "#6b1aff"],
            borderWidth: 0,
            hoverOffset: 5,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: "80%",
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: { label: (context: any) => ` ${context.label}: ${formatCurrency(context.parsed || 0)}` },
          },
        },
        animation: { duration: 400, easing: "easeOutQuart" },
      },
    });
  }

  // Walks the loan month by month and rolls the split up per year.
  function updateSchedule(loan: number, rate: number, years: number, emi: number) {
    const tbody = byId("car-schedule-body");
    if (!tbody) return;
    const r = rate / 12 / 100;
    let balance = loan;
    let rows = "";
    for (let yr = 1; yr <= years; yr++) {
      let principalPaid = 0;
      let interestPaid = 0;
      for (let m = 0; m < 12; m++) {
        const interest = balance * r;
        const towardsPrincipal = Math.min(balance, emi - interest);
        interestPaid += interest;
        principalPaid += towardsPrincipal;
        balance -= towardsPrincipal;
      }
      // Floating-point drift leaves a few paise on the last row; show zero.
      const shownBalance = yr === years ? 0 : Math.max(0, balance);
      rows += `
        <tr class="hover:bg-gray-50 dark:hover:bg-[#181b25] transition">
          <td class="px-5 py-3.5 font-semibold">${yr} ${yr === 1 ? "Year" : "Years"}</td>
          <td class="px-5 py-3.5">${formatCurrency(principalPaid)}</td>
          <td class="px-5 py-3.5 text-primary font-semibold">${formatCurrency(interestPaid)}</td>
          <td class="px-5 py-3.5 text-right font-bold text-dark">${formatCurrency(shownBalance)}</td>
        </tr>
      `;
    }
    tbody.innerHTML = rows;
  }

  function applyRange(id: string, range: Range) {
    [byId<HTMLInputElement>(`${id}-input`), byId<HTMLInputElement>(`${id}-slider`)].forEach((el) => {
      if (!el) return;
      el.min = String(range.min);
      el.max = String(range.max);
      el.step = String(range.step);
      el.value = String(range.value);
    });
  }

  function setupEventListeners() {
    // Each number box and its slider mirror one another.
    ["price", "down", "rate", "tenure"].forEach((id) => {
      const input = byId<HTMLInputElement>(`${id}-input`);
      const slider = byId<HTMLInputElement>(`${id}-slider`);
      input?.addEventListener("input", () => {
        if (slider) slider.value = input.value;
        calculate();
      });
      slider?.addEventListener("input", () => {
        if (input) input.value = slider.value;
        calculate();
      });
    });

    // New / Used tabs swap in that car type's ranges and starting values.
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-car-tab]");
    const group = tabs[0]?.parentElement;
    const activeClass = group?.dataset.activeClass || "";
    const idleClass = group?.dataset.idleClass || "";
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        const car = JSON.parse(tab.dataset.car || "{}") as CarType;
        tabs.forEach((other) => {
          const isActive = other === tab;
          other.className = isActive ? activeClass : idleClass;
          other.setAttribute("aria-pressed", String(isActive));
        });
        applyRange("price", car.price);
        applyRange("rate", car.rate);
        applyRange("tenure", car.tenure);
        ["down-input", "down-slider"].forEach((id) => {
          const el = byId<HTMLInputElement>(id);
          if (el) {
            el.max = String(car.price.value - MIN_LOAN);
            el.value = String(car.down);
          }
        });
        calculate();
      }),
    );
  }

  function initCalculator() {
    setupEventListeners();
    calculate();
  }

  if (document.readyState !== "loading") {
    initCalculator();
  } else {
    document.addEventListener("DOMContentLoaded", initCalculator);
  }
</script>
