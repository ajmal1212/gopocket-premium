---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PowerfulTools from "../components/PowerfulTools.astro";
import TradingJourney from "../components/TradingJourney.astro";
import SpecialBenefits from "../components/SpecialBenefits.astro";
import PricingSection from "../components/PricingSection.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import FinalCTA from "../components/FinalCTA.astro";
import LeadCapture from "../components/LeadCapture.astro";

// Optional query parameters: src (default 'Website'), tag (default 'Menu').
// `refer` is a partner code and has no default - it is passed through to Frappe
// as an empty string when absent, and appended to the signup redirect when set.
const srcParam = Astro.url.searchParams.get("src") || "Website";
const tagParam = Astro.url.searchParams.get("tag") || "Menu";
const referParam = Astro.url.searchParams.get("refer") || "";
---

<Layout
  title="Open your Free Demat Account with GoPocket"
  description="One account to invest in stocks, derivatives, commodities, mutual funds, IPOs, and more with GoPocket."
>
  <Header currentPath="/open-account-call-back" />

  <main class="has-section-spacing-lg">
    <!-- Hero Call-Back Section with Smooth Entrance Animations -->
    <section class="relative z-10 pt-8 pb-16 md:pt-14 md:pb-24 overflow-hidden">
      <div class="container max-w-7xl">
        
        <!-- Top Animated Badge Pill -->
        <div
          data-aos="fade-up-sm"
          data-aos-delay="100"
          class="group relative mx-auto mb-6 max-w-fit overflow-hidden rounded-full border border-border-light p-px transition-transform duration-300 hover:scale-105"
        >
          <div
            class="translate-y-centered to-primary absolute left-1/2 -z-10 h-6 w-1/2 origin-left rotate-90 animate-spin rounded-full bg-linear-to-b from-white [animation-duration:10000ms]"
          ></div>
          <div class="flex items-center rounded-full bg-white px-1.5 py-1">
            <span class="bg-[#7c3aed] inline-block rounded-full px-3 py-0.5 text-xs font-semibold text-white">Start</span>
            <div class="text-text-default ms-2.5 flex items-center rounded-full py-px text-sm font-medium pr-3">
              Start your trading journey
            </div>
          </div>
        </div>

        <!-- Main Title with Smooth Entrance -->
        <h1
          data-aos="fade-up-sm"
          data-aos-delay="200"
          class="has-italic-text text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-center text-dark tracking-tight leading-tight max-w-4xl mx-auto mb-10 sm:mb-16"
        >
          Open your Free Demat Account with <span class="text-[#7c3aed]">GoPocket</span>
        </h1>

        <!-- 2-Column Hero Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- LEFT SIDE: Mobile App Image with Smooth Floating Entrance -->
          <div
            data-aos="fade-up-sm"
            data-aos-delay="300"
            class="lg:col-span-6 flex justify-center items-center"
          >
            <img
              src="/assets/images/gopocket/open account call back.png"
              alt="GoPocket Mobile App Open Account"
              class="w-full h-auto max-w-md lg:max-w-lg object-contain mx-auto transition-all duration-700 ease-out hover:scale-105 hover:-translate-y-1"
              loading="eager"
            />
          </div>

          <!-- RIGHT SIDE: Standalone Signup Form Card with Smooth Entrance -->
          <div
            data-aos="fade-up-sm"
            data-aos-delay="400"
            class="lg:col-span-6 w-full"
          >
            <div class="bg-white p-6 sm:p-10 rounded-3xl border border-border-light space-y-6 transition-all duration-300">
              <div class="space-y-2">
                <h2 class="text-3xl sm:text-4xl font-bold text-dark tracking-tight">
                  Signup now
                </h2>
                <p class="text-text-default opacity-85 text-base sm:text-lg leading-relaxed font-normal">
                  One account to invest in stocks, derivatives, commodities, mutual funds, IPOs, and more.
                </p>
              </div>

              <form data-lead-form class="space-y-5" novalidate>
                <!-- Hidden Tracking Query Parameters -->
                <input type="hidden" name="src" value={srcParam} />
                <input type="hidden" name="tag" value={tagParam} />
                <input type="hidden" name="refer" value={referParam} />

                <div class="space-y-2">
                  <label class="block text-sm font-semibold text-dark">
                    Mobile
                  </label>
                  <div class="relative flex items-center">
                    <!-- Indian Flag Badge -->
                    <div class="absolute left-3.5 flex items-center gap-1.5 pointer-events-none text-dark font-medium text-sm z-10">
                      <span class="text-base">🇮🇳</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                    <input
                      data-lead-mobile
                      type="tel"
                      name="mobile"
                      inputmode="numeric"
                      autocomplete="tel"
                      maxlength="10"
                      pattern="[0-9]{10}"
                      placeholder="Your Mobile Number"
                      class="w-full pl-16 pr-4 py-4 bg-white border border-border-light focus:border-[#7c3aed] focus:ring-4 focus:ring-[#7c3aed]/10 rounded-2xl text-dark placeholder-gray-400 text-base focus:outline-none transition-all duration-300 font-medium"
                      required
                    />
                  </div>
                </div>

                <!-- Open Account Submit Button with Smooth Micro-Interaction -->
                <button
                  data-lead-submit
                  type="submit"
                  class="w-full py-4 bg-[#7c3aed] hover:bg-[#6d28d9] text-white font-bold text-lg rounded-2xl transition-all duration-300 ease-in-out transform hover:-translate-y-0.5 active:scale-[0.98] cursor-pointer flex items-center justify-center disabled:cursor-not-allowed disabled:opacity-70 disabled:transform-none"
                >
                  <span data-lead-label>Open Account</span>
                </button>
              </form>

              <!-- Disclaimer Note (Green Box matching Screenshot) -->
              <div class="p-4 sm:p-5 rounded-2xl bg-[#dcfce7] border border-[#bbf7d0] text-emerald-900 text-xs sm:text-sm leading-relaxed font-medium transition-all duration-300">
                Note: By submitting above details, you are authorizing GoPocket / its sub-brokers / agents to call you send promotional communication even though you being registered under DND.
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Additional Index.astro Sections for Seamless Page UI/UX -->
    <PowerfulTools />
    <TradingJourney />
    <SpecialBenefits />
    <PricingSection />
    <TestimonialsSection />
    <FinalCTA />
  </main>

  <Footer />

  <LeadCapture />
</Layout>
