          srcset="/assets/collaboration.VmFiQa2V_1YRGFU-23505c83.webp 559w, /assets/collaboration.VmFiQa2V_Z2eWlRu-d3fd4b4e.webp 640w, /assets/collaboration.VmFiQa2V_sAyVI-0bab2163.webp 750w, /assets/collaboration.VmFiQa2V_Z1h4skU-da1a296f.webp 828w, /assets/collaboration.VmFiQa2V_1m3vOS-4368016a.webp 1080w, /assets/collaboration.VmFiQa2V_1Mg7t-86178e8a.webp 1118w"
