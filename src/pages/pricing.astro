---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Pricing - Multipurpose Saas & Startup Astro Js Theme" description="This is a example description">
  <Header currentPath="/pricing/" />
  <main class="has-section-spacing-lg">
    <div
      class="page-loader pointer-events-none fixed bottom-0 left-0 z-50 size-full bg-white transition duration-300 [.inactive]:opacity-0 inactive"
    >
      <script type="module" is:inline>
        const e = document.querySelector(".page-loader");
        document.addEventListener("DOMContentLoaded", () => {
          e &&
            setTimeout(() => {
              e.classList.add("inactive");
            }, 100);
        });
      </script>
    </div>
    <main class="has-section-spacing-lg">
      <section>
        <div class="container space-y-12 md:space-y-16">
          <div class="flex flex-wrap items-center justify-center gap-y-4 md:justify-between">
            <div class="text-center md:max-w-sm md:text-start">
              <h2 class="has-italic-text capitalize">
                <div
                  class="animated-text is-ready is-animated"
                  data-duration="0.6"
                  data-delay="0.2"
                  data-stagger="0.09"
                  style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
                >
                  <span class="word" style="--word-index:0"><strong>Choose</strong></span><strong>
                    <span class="word" style="--word-index:1">the</span>
                    <span class="word" style="--word-index:2">Plan</span></strong
                  >
                  <span class="word" style="--word-index:3">That</span>
                  <span class="word" style="--word-index:4">Fits</span>
                  <span class="word" style="--word-index:5">You</span>
                  <span class="word" style="--word-index:6">Best</span>
                </div>
                <script type="module" is:inline>
                  const r = document.querySelectorAll(".animated-text");
                  if (window.matchMedia("(max-width: 767px)").matches)
                    r.forEach((t) => {
                      t.querySelectorAll(".word").forEach((e) => {
                        ((e.style.opacity = "1"), (e.style.filter = "none"), (e.style.transform = "none"));
                      });
                    });
                  else {
                    const t = new IntersectionObserver(
                      (e, a) => {
                        e.forEach((s) => {
                          s.isIntersecting && (s.target.classList.add("is-animated"), a.unobserve(s.target));
                        });
                      },
                      { threshold: 0.1 },
                    );
                    r.forEach((e) => {
                      (e.classList.add("is-ready"), t.observe(e));
                    });
                  }
                </script>
              </h2>
            </div>
            <div
              data-aos="fade-right-sm"
              data-aos-delay="200"
              class="bg-theme-light relative flex w-fit flex-wrap rounded-full p-1 aos-init aos-animate"
            >
              <span
                class="pricing-plan-highlighter absolute top-0 left-0 h-full w-1/2 rounded-full border bg-white transition-all duration-300"
                aria-hidden="true"
                style="left: 4px; top: 4px; width: 103.438px; height: 32px; display: block;"></span>
              <button
                data-plan-btn="per month"
                class="pricing-plan-btn [.active]:text-primary text-dark relative rounded-full px-4 py-1.5 text-sm font-medium tracking-wider transition delay-100 active"
                >Per Month</button
