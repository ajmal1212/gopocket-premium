---
/**
 * The three platforms a partner's clients get, in the tinted bento cards
 * PowerfulTools uses. Two wide over one full-width, so the row always divides
 * evenly - no per-card column spans.
 */

interface Platform {
  name: string;
  description: string;
  href: string;
  linkLabel: string;
  icon: string;
}

const platforms: Platform[] = [
  {
    name: "GoPocket App",
    description:
      "Swift, secure and easy to use, packed with analytical tools and charts your clients can trade from.",
    href: "/products",
    linkLabel: "Explore the app",
    icon: "phone",
  },
  {
    name: "GoPocket Web",
    description:
      "Advanced where it counts, and still friendly enough that nobody needs a manual to place an order.",
    href: "/products",
    linkLabel: "Explore web",
    icon: "monitor",
  },
  {
    name: "GoPocket API",
    description:
      "Let the developers among your clients build their own platform on our REST and WebSocket APIs.",
    href: "/gopocket-api",
    linkLabel: "Read the API page",
    icon: "code",
  },
];
---

<section>
  <div class="container space-y-10 md:space-y-16">
    <div class="mx-auto max-w-2xl space-y-4 text-center">
      <h2 class="has-italic-text capitalize">
        <div
          class="animated-text is-ready"
          data-duration="0.6"
          data-delay="0.2"
          data-stagger="0.09"
          style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
        >
          <span class="word" style="--word-index:0">The</span>
          <span class="word" style="--word-index:1">
            <strong>Technology</strong>
          </span>
          <span class="word" style="--word-index:2">Behind</span>
          <span class="word" style="--word-index:3">You</span>
        </div>
      </h2>
      <p class="opacity-80">Three ways your clients can trade, all built and maintained by us.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
      {
        platforms.map((platform, index) => (
          <div
            data-aos="fade-up-sm"
            data-aos-delay={200 + index * 100}
            class="bg-theme-light flex flex-col justify-between gap-8 rounded-4xl p-6 lg:p-10 aos-init"
          >
            <span class="text-primary bg-white inline-flex h-12 w-12 items-center justify-center rounded-2xl">
              {platform.icon === "phone" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="14" height="20" x="5" y="2" rx="2" ry="2" />
                  <path d="M12 18h.01" />
                </svg>
              )}
              {platform.icon === "monitor" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="3" rx="2" />
                  <path d="M8 21h8" />
                  <path d="M12 17v4" />
                </svg>
              )}
              {platform.icon === "code" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
              )}
            </span>
            <div class="space-y-3">
              <h3 class="h4">{platform.name}</h3>
              <p class="opacity-80">{platform.description}</p>
              <a
                class="text-primary inline-flex items-center gap-1.5 pt-1 text-sm font-medium"
                href={platform.href}
              >
                {platform.linkLabel}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
