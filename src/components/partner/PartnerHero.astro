---
import IndianRupee from "@lucide/astro/icons/indian-rupee";
import CalendarDays from "@lucide/astro/icons/calendar-days";
// PartnerHero - Hero section for the Partner With Us page.
//
// Structurally identical to ResearchLearnHero: same masked rounded-cell grid,
// laurel-flanked rating pill, per-word headline reveal, pill CTA whose arrow
// badge expands on hover, and the two floating stat cards that appear only at
// >= 1440px. Class names carry a pw- prefix so the two can diverge later
// without one page's tweak leaking into the other.
//
// The enquiry form that used to sit in this hero now lives in PartnerEnquiry,
// directly below - the CTA scrolls to it. A centred hero has nowhere to put a
// five-field form without breaking the layout it is copying.
interface Props {
  ratingText?: string;
  title?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  leftStat?: string;
  leftStatLabel?: string;
  leftImage?: string;
  leftImageAlt?: string;
  rightStat?: string;
  rightStatLabel?: string;
  rightImage?: string;
  rightImageAlt?: string;
}

const {
  ratingText = "Highest revenue sharing in the industry",
  title = "Grow your business. Partner with GoPocket.",
  description = "Build your own broking business on industry-leading revenue sharing, with a dedicated relationship manager, zero deposit charges, and a CRM that tracks every client you onboard.",
  ctaText = "Become a Partner",
  ctaHref = "#partner-enquiry",
  leftStat = "Industry-best",
  leftStatLabel = "Revenue Sharing",
  leftImage = "/assets/images/career-gallery-2.webp",
  leftImageAlt = "GoPocket partnership team meeting a business partner",
  rightStat = "By 5th",
  rightStatLabel = "Payout Every Month",
  rightImage = "/assets/images/group-photo-1.webp",
  rightImageAlt = "The GoPocket team supporting its partner network",
} = Astro.props as Props;

// Split for the per-word reveal, same as the Hero 1 headline and paragraph.
// A "\n" in the title forces a line break there; the newline is kept as its
// own token so the markup below can render it as a <br />.
const titleWords: string[] = title
  .trim()
  .split(/[^\S\n]+|(?=\n)|(?<=\n)/)
  .filter(Boolean);
const descriptionWords: string[] = description.trim().split(/\s+/);
---

<section class="pw-hero">
  <!--
    Grid background. The reference ships this as a PNG of rounded-square cells
    (~80px pitch on a 1440px band) with a handful of tinted accent cells, masked
    to fade out at the left and right edges. Rebuilt here as an SVG pattern so
    it stays crisp and needs no external asset; the cells are scaled up to a
    120px pitch. Change the pattern/rect width+height together to resize them.
  -->
  <div class="pw-hero__grid" aria-hidden="true">
    <svg width="100%" height="100%" preserveAspectRatio="xMidYMin slice" viewBox="0 0 1440 960" fill="none">
      <defs>
        <pattern id="pw-hero-grid-cells" width="120" height="120" patternUnits="userSpaceOnUse">
          <!-- Full-tile rect: adjacent strokes coincide, so shared edges stay 1px
               and the rounded corners leave the diamond gaps at intersections. -->
          <rect
            x="0"
            y="0"
            width="120"
            height="120"
            rx="18"
            ry="18"
            fill="none"
            stroke="var(--pw-grid-line)"
            stroke-width="1"></rect>
        </pattern>
      </defs>

      <rect width="1440" height="960" fill="url(#pw-hero-grid-cells)"></rect>

      <!-- Tinted accent cells, scattered on the same 120px lattice -->
      <g fill="var(--pw-grid-accent)">
        <rect x="120" y="120" width="120" height="120" rx="18"></rect>
        <rect x="1080" y="240" width="120" height="120" rx="18"></rect>
        <rect x="720" y="480" width="120" height="120" rx="18"></rect>
        <rect x="1080" y="600" width="120" height="120" rx="18"></rect>
        <rect x="360" y="720" width="120" height="120" rx="18"></rect>
        <rect x="720" y="840" width="120" height="120" rx="18"></rect>
      </g>
    </svg>
  </div>

  <div class="pw-hero__container">
    <!-- No AOS on this wrapper: a block-level fade-up would slide the headline
         bottom-to-top and drown out the per-word reveal. Hero 1 keeps AOS on
         the badge only and lets the heading animate purely word by word. -->
    <div class="pw-hero__top">
      <div class="pw-hero__intro">
        <!-- Rating pill: laurel, stars + label, laurel. Same word reveal as the
             headline, and first in the sequence: pill -> heading -> paragraph.
             The leaves are wrapped so the reveal animates the wrapper's opacity
             0 -> 1 while the image keeps its own 30% tint. -->
        <div
          class="pw-hero__tag animated-text is-ready is-animated"
          data-duration="0.6"
          data-delay="0.1"
          data-stagger="0.06"
          style="--animated-text-duration:0.6s;--animated-text-delay:0.1s;--animated-text-stagger:0.06s;"
        >
          <span class="word pw-hero__leaf-wrap" style="--word-index:0">
            <img
              src="/assets/right.avif"
              alt=""
              aria-hidden="true"
              width="224"
              height="224"
              loading="eager"
              decoding="async"
              class="pw-hero__leaf"
            />
          </span>
          <div class="pw-hero__reviews">
            <svg class="pw-hero__stars word" style="--word-index:1" viewBox="0 0 96 16" fill="none" aria-hidden="true">
              <path
                d="M 6.731 1.764 C 7.128 0.532 8.871 0.532 9.269 1.764 L 10.374 5.191 L 13.961 5.191 C 15.25 5.191 15.789 6.839 14.748 7.6 L 11.838 9.731 L 12.947 13.172 C 13.344 14.402 11.934 15.421 10.891 14.657 L 8 12.541 L 5.109 14.657 C 4.066 15.421 2.656 14.402 3.052 13.172 L 4.162 9.731 L 1.251 7.6 C 0.211 6.839 0.75 5.191 2.039 5.191 L 5.626 5.191 Z"
                fill="currentColor"></path>
              <path
                d="M 26.731 1.764 C 27.128 0.532 28.872 0.532 29.269 1.764 L 30.374 5.191 L 33.961 5.191 C 35.25 5.191 35.788 6.839 34.748 7.6 L 31.838 9.731 L 32.947 13.172 C 33.344 14.402 31.934 15.421 30.891 14.657 L 28 12.541 L 25.109 14.657 C 24.066 15.421 22.656 14.402 23.052 13.172 L 24.162 9.731 L 21.251 7.6 C 20.211 6.839 20.75 5.191 22.039 5.191 L 25.626 5.191 Z"
                fill="currentColor"></path>
              <path
                d="M 46.731 1.764 C 47.128 0.532 48.871 0.532 49.269 1.764 L 50.374 5.191 L 53.961 5.191 C 55.25 5.191 55.788 6.839 54.748 7.6 L 51.838 9.731 L 52.947 13.172 C 53.344 14.402 51.934 15.421 50.891 14.657 L 48 12.541 L 45.109 14.657 C 44.066 15.421 42.656 14.402 43.052 13.172 L 44.162 9.731 L 41.251 7.6 C 40.211 6.839 40.75 5.191 42.039 5.191 L 45.626 5.191 Z"
                fill="currentColor"></path>
              <path
                d="M 66.731 1.764 C 67.128 0.532 68.871 0.532 69.269 1.764 L 70.374 5.191 L 73.961 5.191 C 75.25 5.191 75.788 6.839 74.748 7.6 L 71.838 9.731 L 72.947 13.172 C 73.344 14.402 71.934 15.421 70.891 14.657 L 68 12.541 L 65.109 14.657 C 64.066 15.421 62.656 14.402 63.052 13.172 L 64.162 9.731 L 61.251 7.6 C 60.211 6.839 60.75 5.191 62.039 5.191 L 65.626 5.191 Z"
                fill="currentColor"></path>
              <path
                d="M 86.731 1.764 C 87.128 0.532 88.871 0.532 89.269 1.764 L 90.374 5.191 L 93.961 5.191 C 95.25 5.191 95.788 6.839 94.748 7.6 L 91.838 9.731 L 92.947 13.172 C 93.344 14.402 91.934 15.421 90.891 14.657 L 88 12.541 L 85.109 14.657 C 84.066 15.421 82.656 14.402 83.052 13.172 L 84.162 9.731 L 81.251 7.6 C 80.211 6.839 80.75 5.191 82.039 5.191 L 85.626 5.191 Z"
                fill="currentColor"></path>
            </svg>
            <p class="pw-hero__rating-label word" style="--word-index:2">{ratingText}</p>
          </div>
          <span class="word pw-hero__leaf-wrap" style="--word-index:3">
            <img
              src="/assets/left.avif"
              alt=""
              aria-hidden="true"
              width="224"
              height="224"
              loading="eager"
              decoding="async"
              class="pw-hero__leaf"
            />
          </span>
        </div>

        <!-- Title + description -->
        <div class="pw-hero__title-block">
          <h1 class="pw-hero__title">
            <div
              class="animated-text text-display-3 lg:text-display-2 pw-hero__title-text is-ready is-animated"
              data-duration="0.6"
              data-delay="0.4"
              data-stagger="0.1"
              style="font-weight: 600; --animated-text-duration:0.6s;--animated-text-delay:0.4s;--animated-text-stagger:0.1s;"
            >
              {/* prettier-ignore */}
              {
                titleWords.map((word, i) =>
                  word === "\n" ? (
                    <br />
                  ) : (
                    <>
                      <span class="word" style={`--word-index:${i}`}>
                        {word}
                      </span>
                      {i < titleWords.length - 1 && titleWords[i + 1] !== "\n" ? " " : ""}
                    </>
                  ),
                )
              }
            </div>
          </h1>
          <!-- Same word reveal as the Hero 1 paragraph: 0.6s duration, 0.9s
               delay so it follows the headline, 0.03s stagger. -->
          <p
            class="pw-hero__description animated-text is-ready is-animated"
            data-duration="0.6"
            data-delay="1.2"
            data-stagger="0.03"
            style="--animated-text-duration:0.6s;--animated-text-delay:1.2s;--animated-text-stagger:0.03s;"
          >
            {/* prettier-ignore */}
            {
              descriptionWords.map((word, i) => (
                <>
                  <span class="word" style={`--word-index:${i}`}>
                    {word}
                  </span>
                  {i < descriptionWords.length - 1 ? " " : ""}
                </>
              ))
            }
          </p>
        </div>
      </div>

      <!-- CTA -->
      <a class="pw-hero__cta" href={ctaHref}>
        <span class="pw-hero__cta-text">{ctaText}</span>
        <span class="pw-hero__cta-badge" aria-hidden="true">
          <span class="pw-hero__cta-arrows">
            <svg class="pw-hero__cta-arrow pw-hero__cta-arrow--1" viewBox="0 0 20 20" fill="none">
              <path
                d="M4 10h11M10.5 5.5 15 10l-4.5 4.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <svg class="pw-hero__cta-arrow pw-hero__cta-arrow--2" viewBox="0 0 20 20" fill="none">
              <path
                d="M4 10h11M10.5 5.5 15 10l-4.5 4.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </span>
      </a>
    </div>

    <!-- Floating card, left of the container -->
    <div class="pw-hero__float pw-hero__float--left" data-aos="fade-right" data-aos-delay="250">
      <div class="pw-hero__stat">
        <span class="pw-hero__stat-icon" aria-hidden="true">
          <IndianRupee class="pw-hero__stat-svg" stroke-width={1.6} />
        </span>
        <span class="pw-hero__stat-text">
          <span class="pw-hero__stat-value">{leftStat}</span>
          <span class="pw-hero__stat-label">{leftStatLabel}</span>
        </span>
      </div>
      <div class="pw-hero__float-image">
        <img src={leftImage} alt={leftImageAlt} width="148" height="180" loading="lazy" decoding="async" />
      </div>
    </div>

    <!-- Floating card, right of the container -->
    <div class="pw-hero__float pw-hero__float--right" data-aos="fade-left" data-aos-delay="250">
      <div class="pw-hero__stat">
        <span class="pw-hero__stat-icon" aria-hidden="true">
          <CalendarDays class="pw-hero__stat-svg" stroke-width={1.6} />
        </span>
        <span class="pw-hero__stat-text">
          <span class="pw-hero__stat-value">{rightStat}</span>
          <span class="pw-hero__stat-label">{rightStatLabel}</span>
        </span>
      </div>
      <div class="pw-hero__float-image">
        <img src={rightImage} alt={rightImageAlt} width="148" height="180" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<style>
  /* Every colour below is read through a local variable so the dark theme only
     has to repoint the variables (see the html.dark block further down). */
  .pw-hero {
    --pw-surface: #fff;
    --pw-card: #fff;
    --pw-ink-strong: #000;
    --pw-ink: #1d1d1d;
    --pw-ink-muted: #575757;
    --pw-line: #e7e6e6;
    --pw-tile: #f4f4f4;
    --pw-cta-surface: #000;
    --pw-cta-on-surface: #fff;
    --pw-grid-line: rgba(0, 0, 0, 0.062);
    --pw-grid-accent: rgba(0, 0, 0, 0.032);

    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    place-content: center;
    width: 100%;
    padding: 120px 80px 160px;
    overflow: clip;
    background-color: var(--pw-surface);
  }

  /* Dark theme. The site toggles `html.dark` on the root and publishes semantic
     tokens from src/styles/dark-theme.css, so only the locals change here. */
  :global(html.dark) .pw-hero {
    --pw-surface: var(--surface-0);
    --pw-card: var(--surface-1);
    --pw-ink-strong: var(--fg-strong);
    --pw-ink: var(--fg-strong);
    --pw-ink-muted: var(--fg-muted);
    --pw-line: var(--line);
    --pw-tile: var(--surface-3);
    /* The pill has to invert - a black button vanishes on the dark canvas. */
    --pw-cta-surface: var(--fg-strong);
    --pw-cta-on-surface: var(--surface-0);
    --pw-grid-line: rgba(255, 255, 255, 0.055);
    --pw-grid-accent: rgba(255, 255, 255, 0.03);
  }

  /* The laurels are solid black artwork; flip them so they read on dark. */
  :global(html.dark) .pw-hero__leaf {
    filter: invert(1);
    opacity: 0.38;
  }

  /* ===== Grid background ===== */
  .pw-hero__grid {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 720px);
    z-index: 0;
    width: 1440px;
    pointer-events: none;
    user-select: none;
    /* Same edge fade as the reference, plus a bottom fade so the grid dies out
       before the section ends. */
    -webkit-mask-image:
      linear-gradient(270deg, transparent 0%, #000 14.6187%, #000 85%, transparent 100%),
      linear-gradient(180deg, #000 0%, #000 58%, transparent 100%);
    mask-image:
      linear-gradient(270deg, transparent 0%, #000 14.6187%, #000 85%, transparent 100%),
      linear-gradient(180deg, #000 0%, #000 58%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .pw-hero__grid svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ===== Layout ===== */
  .pw-hero__container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    place-content: center;
    gap: 96px;
    width: 100%;
    max-width: 1280px;
  }

  .pw-hero__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    place-content: center;
    gap: 56px;
    width: 100%;
  }

  .pw-hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    place-content: center;
    gap: 24px;
    width: 100%;
  }

  /* ===== Rating pill ===== */
  .pw-hero__tag {
    display: flex;
    flex-direction: row;
    align-items: center;
    place-content: center;
    width: min-content;
  }

  /* Reveal wrapper. The .word animation drives this element's opacity 0 -> 1,
     so the leaf's own 30% tint has to live on the image inside it. */
  .pw-hero__leaf-wrap {
    flex: none;
    line-height: 0;
  }

  .pw-hero__leaf {
    display: block;
    width: 56px;
    height: 56px;
    aspect-ratio: 1;
    object-fit: contain;
    opacity: 0.3;
  }

  .pw-hero__reviews {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: min-content;
  }

  .pw-hero__stars {
    flex: none;
    width: 96px;
    height: 16px;
    color: var(--pw-ink-strong);
  }

  .pw-hero__rating-label {
    margin: 0;
    white-space: pre;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--pw-ink);
  }

  /* ===== Title block ===== */
  .pw-hero__title-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    place-content: center;
    gap: 32px;
    width: 100%;
    max-width: 1026px;
  }

  /* Weight, leading and size scale match the Hero 1 headline. No italic,
     no secondary/serif face - project font only. */
  .pw-hero__title {
    width: 100%;
    margin: 0;
    font-weight: 550;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-align: center;
    color: var(--pw-ink-strong);
  }

  /* The reveal wrapper is the element that lays out the text, so line
     balancing has to live here rather than on the h1. */
  .pw-hero__title-text {
    text-wrap: balance;
  }

  .pw-hero__description {
    width: 100%;
    max-width: 580px;
    margin: 0;
    font-size: 20px;
    line-height: 30px;
    font-weight: 400;
    text-align: center;
    text-wrap: balance;
    color: var(--pw-ink-muted);
  }

  /* ===== CTA button ===== */
  .pw-hero__cta {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    place-content: center space-between;
    width: min-content;
    height: 48px;
    padding: 14px 4px 14px 20px;
    border-radius: 40px;
    background-color: var(--pw-cta-surface);
    text-decoration: none;
    cursor: pointer;
    isolation: isolate;
  }

  .pw-hero__cta-text {
    position: relative;
    z-index: 2;
    padding-right: 64px;
    white-space: pre;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--pw-cta-on-surface);
    transition: color 0.3s ease;
  }

  /* Sized with four length insets (never `auto`) so the expand animates. */
  .pw-hero__cta-badge {
    position: absolute;
    z-index: 0;
    top: 4px;
    right: 4px;
    bottom: 4px;
    left: calc(100% - 44px);
    display: flex;
    flex-direction: row;
    align-items: center;
    place-content: center flex-end;
    padding: 0 10.5px 0 0;
    border-radius: 999px;
    background-color: var(--pw-cta-on-surface);
    transition:
      top 0.35s cubic-bezier(0.44, 0, 0.56, 1),
      right 0.35s cubic-bezier(0.44, 0, 0.56, 1),
      bottom 0.35s cubic-bezier(0.44, 0, 0.56, 1),
      left 0.35s cubic-bezier(0.44, 0, 0.56, 1),
      padding 0.35s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .pw-hero__cta-arrows {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    place-content: center;
    width: 19px;
    height: 19px;
    overflow: hidden;
  }

  .pw-hero__cta-arrow {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 19px;
    height: 19px;
    aspect-ratio: 1;
    color: var(--pw-cta-surface);
    transition: transform 0.35s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .pw-hero__cta-arrow--1 {
    left: 0;
    transform: translateX(0);
  }

  .pw-hero__cta-arrow--2 {
    left: 0;
    transform: translateX(-42px);
  }

  /* Hover: the white badge expands across the button, arrows slide right */
  .pw-hero__cta:hover .pw-hero__cta-badge,
  .pw-hero__cta:focus-visible .pw-hero__cta-badge {
    top: 2px;
    right: 2px;
    bottom: 2px;
    left: 2px;
    padding: 0 20px 0 0;
  }

  .pw-hero__cta:hover .pw-hero__cta-text,
  .pw-hero__cta:focus-visible .pw-hero__cta-text {
    color: var(--pw-cta-surface);
  }

  .pw-hero__cta:hover .pw-hero__cta-arrow--1,
  .pw-hero__cta:focus-visible .pw-hero__cta-arrow--1 {
    transform: translateX(42px);
  }

  .pw-hero__cta:hover .pw-hero__cta-arrow--2,
  .pw-hero__cta:focus-visible .pw-hero__cta-arrow--2 {
    transform: translateX(0);
  }

  .pw-hero__cta:focus-visible {
    outline: 2px solid var(--pw-ink-strong);
    outline-offset: 3px;
  }

  /* ===== Floating side cards ===== */
  .pw-hero__float {
    position: absolute;
    z-index: 1;
    display: none;
    flex-direction: row;
    align-items: center;
    place-content: center;
    gap: 10px;
    width: min-content;
  }

  .pw-hero__float--left {
    top: 59px;
    left: 40px;
  }

  .pw-hero__float--right {
    top: 121px;
    right: -40px;
  }

  .pw-hero__stat {
    position: absolute;
    z-index: 2;
    bottom: 20px;
    left: -75px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    width: 163px;
    padding: 8px;
    border: 1px solid var(--pw-line);
    border-radius: 12px;
    background-color: var(--pw-card);
  }

  .pw-hero__stat-icon {
    flex: none;
    display: flex;
    align-items: center;
    place-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background-color: var(--pw-tile);
    color: var(--pw-ink-muted);
  }

  .pw-hero__stat-svg {
    width: 24px;
    height: 24px;
  }

  .pw-hero__stat-text {
    display: flex;
    flex-direction: column;
    flex: 1 0 0;
    width: 1px;
  }

  .pw-hero__stat-value {
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--pw-ink-strong);
  }

  .pw-hero__stat-label {
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    overflow-wrap: break-word;
    color: var(--pw-ink-muted);
  }

  .pw-hero__float-image {
    position: relative;
    z-index: 1;
    flex: none;
    width: 148px;
    height: 180px;
    border-radius: 12px;
    overflow: hidden;
  }

  .pw-hero__float-image img {
    display: block;
    width: 100%;
    height: 100%;
