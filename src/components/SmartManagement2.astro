---
// SmartManagement2 Component
---

<section class="overflow-hidden py-12 md:py-20">
  <div class="container space-y-8 md:space-y-12">
    <!-- Header Text Block -->
    <div class="mx-auto space-y-4 text-center max-lg:max-w-lg">
      <h2 class="has-italic-text capitalize text-3xl md:text-5xl lg:text-6xl font-semibold">
        <div
          data-duration="0.6"
          data-delay="0.2"
          data-stagger="0.09"
          data-astro-cid-3rbjsbju="true"
          class="animated-text"
        >
          <span
            class="word"
            style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
            >Tools</span
          >
          <span
            class="word"
            style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
            >Built</span
          >
          <span
            class="word"
            style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
            >For</span
          >
          <strong
            ><span
              class="word"
              style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
              >Traders</span
            ></strong
          >
        </div>
      </h2>
      <p
        data-duration="0.7"
        data-delay="0.5"
        data-stagger="0.0009"
        data-astro-cid-3rbjsbju="true"
        class="animated-text text-base md:text-lg lg:text-xl max-w-2xl mx-auto opacity-90"
      >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >Everything</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >that</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >matters</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >as</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >a</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >Trader</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >and</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >Investor</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >comes</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >together</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >on</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >one</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >seamless,</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >feature-rich</span
        >
        <span
          class="word"
          style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
          >app.</span
        >
      </p>
    </div>

    <!-- Graphic Canvas Wrapper -->
    <div class="relative flex flex-col items-center justify-center min-h-[550px] xl:min-h-[700px] mt-6">
      <!-- 6 Node Feature Cards -->
      <div
        class="w-full flex flex-wrap justify-center gap-6 max-xl:order-2 max-xl:mt-10 xl:absolute xl:inset-0 xl:pointer-events-none"
      >
        <!-- 1. Real-Time Alerts (Top Left) -->
        <div
          data-aos="fade-up-sm"
          data-aos-duration="900"
          data-aos-delay="100"
          data-aos-offset="0"
          class="z-20 flex w-full max-w-[360px] items-center gap-10 xl:absolute xl:right-[calc(50%+260px)] xl:top-[12%] flex-row-reverse text-end xl:pointer-events-auto"
        >
          <span
            class="inline-block h-4 w-4 min-w-4 rounded-full border border-green-400 bg-green-100 xl:border-black/10 xl:bg-white shrink-0"
          ></span>
          <div class="space-y-1 pr-3">
            <h3 class="text-sm md:text-lg font-semibold text-black whitespace-nowrap">Password-less Login</h3>
            <p class="text-sm opacity-80">Log in with your fingerprint, in a fraction of a second</p>
          </div>
        </div>

        <!-- 2. Spending Habits (Top Right) -->
        <div
          data-aos="fade-up-sm"
          data-aos-duration="900"
          data-aos-delay="0"
          data-aos-offset="0"
          class="z-20 flex w-full max-w-[360px] items-center gap-10 xl:absolute xl:left-[calc(50%+260px)] xl:top-[12%] xl:pointer-events-auto"
        >
          <span
            class="inline-block h-4 w-4 min-w-4 rounded-full border border-green-400 bg-green-100 xl:border-black/10 xl:bg-white shrink-0"
          ></span>
          <div class="space-y-1 pl-3">
            <h3 class="text-base md:text-lg font-semibold text-black whitespace-nowrap">Multiple Languages</h3>
            <p class="text-sm opacity-80">Use the app in the language you are most comfortable with</p>
          </div>
        </div>

        <!-- 3. Financial Confidence (Mid Left) -->
        <div
          data-aos="fade-up-sm"
          data-aos-duration="900"
          data-aos-delay="200"
          data-aos-offset="0"
          class="z-20 flex w-full max-w-[360px] items-center gap-10 xl:absolute xl:right-[calc(50%+350px)] xl:top-1/2 xl:-translate-y-1/2 flex-row-reverse text-end xl:pointer-events-auto"
        >
          <span
            class="inline-block h-4 w-4 min-w-4 rounded-full border border-green-400 bg-green-100 xl:border-black/10 xl:bg-white shrink-0"
          ></span>
          <div class="space-y-1 pr-3">
            <h3 class="text-base md:text-lg font-semibold text-black whitespace-nowrap">Multiple Orders</h3>
            <p class="text-sm opacity-80">Execute several orders from a single screen at the same time</p>
          </div>
        </div>

        <!-- 4. Stress-Free Budgeting (Mid Right) -->
        <div
          data-aos="fade-up-sm"
          data-aos-duration="900"
          data-aos-delay="300"
          data-aos-offset="0"
          class="z-20 flex w-full max-w-[360px] items-center gap-10 xl:absolute xl:left-[calc(50%+350px)] xl:top-1/2 xl:-translate-y-1/2 xl:pointer-events-auto"
        >
          <span
            class="inline-block h-4 w-4 min-w-4 rounded-full border border-green-400 bg-green-100 xl:border-black/10 xl:bg-white shrink-0"
          ></span>
          <div class="space-y-1 pl-3">
            <h3 class="text-base md:text-lg font-semibold text-black whitespace-nowrap">Sector Watchlists</h3>
            <p class="text-sm opacity-80">Sector-wise watchlists to track opportunities as they move</p>
          </div>
        </div>

        <!-- 5. Goal Achievement (Bottom Left) -->
        <div
          data-aos="fade-up-sm"
          data-aos-duration="900"
          data-aos-delay="400"
          data-aos-offset="0"
          class="z-20 flex w-full max-w-[360px] items-center gap-10 xl:absolute xl:right-[calc(50%+260px)] xl:bottom-[12%] flex-row-reverse text-end xl:pointer-events-auto"
        >
          <span
            class="inline-block h-4 w-4 min-w-4 rounded-full border border-green-400 bg-green-100 xl:border-black/10 xl:bg-white shrink-0"
          ></span>
          <div class="space-y-1 pr-3">
            <h3 class="text-base md:text-lg font-semibold text-black whitespace-nowrap">Live Option Chain</h3>
            <p class="text-sm opacity-80">Last price, volume and best bid and offer, by expiry</p>
          </div>
        </div>

        <!-- 6. Financial Anxiety (Bottom Right) -->
        <div
          data-aos="fade-up-sm"
          data-aos-duration="900"
          data-aos-delay="500"
          data-aos-offset="0"
          class="z-20 flex w-full max-w-[360px] items-center gap-10 xl:absolute xl:left-[calc(50%+260px)] xl:bottom-[12%] xl:pointer-events-auto"
        >
          <span
            class="inline-block h-4 w-4 min-w-4 rounded-full border border-green-400 bg-green-100 xl:border-black/10 xl:bg-white shrink-0"
          ></span>
          <div class="space-y-1 pl-3">
            <h3 class="text-base md:text-lg font-semibold text-black whitespace-nowrap">Quick Order Entry</h3>
            <p class="text-sm opacity-80">Respond to market moves and place orders in a couple of taps</p>
          </div>
        </div>
      </div>

      <!-- Animated Rotating Dashed Circle Background -->
      <svg
        class="translate-x-centered absolute top-1/2 -translate-y-1/2 hidden animate-spin rounded-full [animation-duration:8s] lg:size-[550px] xl:block xl:size-[700px] pointer-events-none z-0"
        width="725"
        height="725"
        viewBox="0 0 725 725"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle
          opacity="0.5"
          cx="362.5"
          cy="362.5"
          r="362"
          transform="rotate(180 362.5 362.5)"
          stroke="url(#paint0_linear_16887_2802)"
          stroke-miterlimit="3.07467"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-dasharray="8 8"></circle>
        <defs>
          <linearGradient
            id="paint0_linear_16887_2802"
            x1="362.5"
            y1="0.5"
            x2="362.5"
            y2="724.5"
            gradientUnits="userSpaceOnUse"
          >
            <stop stop-color="#686882"></stop>
            <stop offset="1" stop-color="#16161C" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
      </svg>

      <!-- Central Mobile Phone Preview -->
      <div
        data-aos="reveal-anim-down"
        class="relative z-10 mx-auto w-full max-w-72 overflow-hidden px-4 pt-2 text-center after:absolute after:inset-x-0 after:top-0 after:size-full after:bg-linear-to-b after:from-transparent after:from-70% after:to-white after:to-95% max-xl:order-1 md:text-start lg:h-156.25 lg:max-w-90 after:lg:from-80% after:lg:to-95% aos-init"
      >
        <img
          src="/assets/images/mobile-app-preview.webp"
          srcset="/assets/images/mobile-app-preview.webp 477w"
          alt="Finzo Mobile App Preview"
          loading="lazy"
          decoding="async"
          sizes="(min-width: 477px) 477px, 100vw"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="477"
          height="913"
          class="mx-auto w-full lg:w-79.25"
        />
        <img
          src="/assets/images/mobile-frame.webp"
          srcset="/assets/images/mobile-frame.webp 531w"
          alt="Mobile Device Frame"
          loading="lazy"
          decoding="async"
          sizes="(min-width: 531px) 531px, 100vw"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="531"
          height="938"
          class="translate-x-centered absolute top-0 h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>
