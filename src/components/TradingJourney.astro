---

---

<section>
  <div class="bg-theme-light py-20 md:py-32">
    <div class="container space-y-10 md:space-y-16">
      <div class="mx-auto max-w-lg text-center">
        <h2 class="has-italic-text capitalize">
          <div
            class="animated-text is-ready is-animated"
            data-duration="0.6"
            data-delay="0.2"
            data-stagger="0.09"
            style="font-weight: 600; --animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
          >
            <span class="word" style="--word-index:0">Start</span>
            <span class="word" style="--word-index:1">Trading</span>
            <span class="word" style="--word-index:2">In</span>
            <span class="word" style="--word-index:3">
              <strong>Three</strong>
            </span>
            <span class="word" style="--word-index:4">
              <strong>Steps</strong>
            </span>
          </div>
        </h2>
      </div>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div
          data-aos="fade-right-sm"
          data-aos-delay="250"
          class="space-y-16 rounded-4xl bg-white p-8 md:space-y-32 aos-init aos-animate"
        >
          <div
            class="prose-em:not-italic prose-em:text-dark/80 flex flex-wrap items-center justify-between gap-y-4 font-medium text-black"
          >
            <div class="md:text-h3 text-h3-sm">Step <em>01</em></div>
            <a
              class="text-text-default rounded-full border px-9 py-1.5 text-sm! capitalize transition-colors duration-300 hover:border-black/50"
              href="/open-account-call-back?src=Website&tag=Workflow">Start KYC</a
            >
          </div>
          <div class="space-y-4">
            <h3 class="md:text-h5 text-h5-sm text-black">Complete Your KYC</h3>
            <p class="border-t pt-4 text-gray-600">
              PAN, Aadhaar and bank proof, e-signed online. Fully digital, fully paperless.
            </p>
          </div>
        </div>
        <div
          data-aos="fade-right-sm"
          data-aos-delay="350"
          class="space-y-16 rounded-4xl bg-white p-8 md:space-y-32 aos-init aos-animate"
        >
          <div
            class="prose-em:not-italic prose-em:text-dark/80 flex flex-wrap items-center justify-between gap-y-4 font-medium text-black"
          >
            <div class="md:text-h3 text-h3-sm">Step <em>02</em></div>
            <a
              class="text-text-default rounded-full border px-9 py-1.5 text-sm! capitalize transition-colors duration-300 hover:border-black/50"
              href="/faq">Learn More</a
            >
          </div>
          <div class="space-y-4">
            <h3 class="md:text-h5 text-h5-sm text-black">Fund Your Account</h3>
            <p class="border-t pt-4 text-gray-600">
              Activated in a few hours. Add money instantly by UPI, IMPS or net banking.
            </p>
          </div>
        </div>
        <div
          data-aos="fade-right-sm"
          data-aos-delay="450"
          class="space-y-16 rounded-4xl bg-white p-8 md:space-y-32 aos-init aos-animate"
        >
          <div
            class="prose-em:not-italic prose-em:text-dark/80 flex flex-wrap items-center justify-between gap-y-4 font-medium text-black"
          >
            <div class="md:text-h3 text-h3-sm">Step <em>03</em></div>
            <a
              class="text-text-default rounded-full border px-9 py-1.5 text-sm! capitalize transition-colors duration-300 hover:border-black/50"
              href="/products">Explore</a
            >
          </div>
          <div class="space-y-4">
            <h3 class="md:text-h5 text-h5-sm text-black">Place Your First Trade</h3>
            <p class="border-t pt-4 text-gray-600">
              Equity, F&amp;O, currency, commodities, mutual funds and IPOs — from one app.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
