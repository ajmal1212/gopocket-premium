---
// Testimonials2 Component - Dual Row Marquee (Row 1 Left-to-Right, Row 2 Right-to-Left)
---

<section class="testimonial-section overflow-hidden py-10">
  <div class="container mb-10">
    <div class="flex flex-wrap items-end justify-between gap-y-6">
      <h2
        data-duration="0.6"
        data-delay="0.2"
        data-stagger="0.09"
        class="has-italic-text capitalize max-w-lg animated-text text-4xl md:text-5xl font-medium"
      >
        <span>Trusted</span>
        <span>by</span>
        <span>Customers</span>
        <strong><span>Worldwide</span></strong>
      </h2>
      <div class="space-y-4 max-w-md">
        <p class="text-gray-600 text-base md:text-lg">
          Join thousands of users who trust us to simplify their finances. Read their success stories and see the impact for yourself.
        </p>
        <div>
          <a class="btn btn-text has-icon-moving-animation no-underline text-flip-hover-anim inline-flex items-center font-medium text-primary" href="/testimonial">
            See All Testimonials
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ml-2 h-4 w-4"
            >
              <path d="M7 7h10v10"></path>
              <path d="M7 17 17 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee Container -->
  <div class="relative w-full space-y-6 overflow-hidden border-y border-border-light py-8">
    
    <!-- ROW 1: Moves Left to Right -->
    <div class="relative overflow-hidden mask-[linear-gradient(to_right,rgba(0,0,0,0)_0%,rgb(0,0,0)_5%,rgb(0,0,0)_95%,rgba(0,0,0,0)_100%)]">
      <div class="marquee marquee-pause-on-hover" style="--marquee-duration:50s;--marquee-reverse:reverse;">
        <div class="marquee-content flex items-center gap-6 marquee-element-width-auto">
          
          <!-- Card 1 -->
          <div class="w-[340px] md:w-[420px] shrink-0">
            <div class="flex h-full flex-col justify-between rounded-2xl border border-border-light bg-theme-light p-6 space-y-6 shadow-xs">
              <div class="space-y-4">
