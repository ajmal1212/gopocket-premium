---
import HeaderActions from "./header/HeaderActions.astro";
import BrandLogo from "./header/BrandLogo.astro";
import HeaderNavigation from "./header/HeaderNavigation.astro";
import MobileMenuToggle from "./header/MobileMenuToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="header group/header mt-5 sticky-header">
  <div class="relative container">
    <nav class="hs-dropdown relative flex items-center justify-between px-2 py-2.5 [--auto-close:inside] [--gpu-acceleration:false] [--strategy:absolute] lg:[--strategy:static]">
      <BrandLogo />
      <HeaderNavigation {currentPath} />
      <HeaderActions />
      <MobileMenuToggle />
    </nav>
  </div>
  <script src="./header/header-interactions.ts"></script>
</header>
