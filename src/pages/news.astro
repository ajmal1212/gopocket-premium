---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import NewsCover from "@/components/news/NewsCover.astro";
import BlogThumb from "@/components/blog/BlogThumb.astro";
import BlogMeta from "@/components/blog/BlogMeta.astro";
import BlogReadMore from "@/components/blog/BlogReadMore.astro";
import { getNewsList } from "../lib/frappe";

// The four newest articles fill a 2x2 "Recent News" grid of large cards, and
// the rest a two-column "More News" grid. Every card shows the article's 23:10
// main image (the generated cover when there is none) with its text underneath.
// Only the first image is eager: it is the LCP element on every viewport.
const articles = await getNewsList(20, true);
const recentArticles = articles.slice(0, 4);
const gridArticles = articles.slice(4);

const SITE = Astro.site?.origin ?? Astro.url.origin;
const newsUrl = `${SITE}/news`;

const newsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "GoPocket News",
  description: "IPO updates, market moves and regulatory changes, explained for Indian investors.",
  url: newsUrl,
  inLanguage: "en",
  publisher: {
    "@type": "Organization",
    name: "GoPocket",
    url: `${SITE}/`,
    logo: { "@type": "ImageObject", url: `${SITE}/gopocket-logo.svg` },
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: articles.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${newsUrl}/${article.slug}`,
      name: article.title,
    })),
  },
};

const newsBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "News", item: newsUrl },
  ],
};
---

<Layout
  title="Stock Market News Today - IPO, Market & Regulatory Updates | GoPocket"
  description="Today's stock market news for Indian investors: IPO price bands and GMP, listing updates, market moves and regulatory changes, explained simply by GoPocket."
  canonical="/news"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(newsSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(newsBreadcrumbSchema)} />
  </Fragment>
  <Header currentPath="/news" />
  <main class="has-section-spacing-lg pt-8 md:pt-16">
    <h1 class="sr-only">GoPocket News - IPO, Market &amp; Regulatory Updates</h1>

    {
      articles.length === 0 && (
        <section class="container pt-0!">
          <div class="bg-theme-light border-border-light rounded-3xl border py-16 text-center text-gray-500">
            <p class="text-lg font-medium">No news articles found at the moment.</p>
            <p class="mt-1 text-sm">Please check back soon for the latest market updates.</p>
          </div>
        </section>
      )
    }

    {
      recentArticles.length > 0 && (
        <section class="container pt-0!">
          <div class="mx-auto max-w-6xl">
            <h2 class="text-black! dark:text-white! text-h4 font-bold tracking-tight md:text-h3">Recent News</h2>
            <div class="mt-8 grid gap-x-16 gap-y-14 md:mt-10 lg:grid-cols-2 xl:gap-x-20">
              {recentArticles.map((article, index) => (
                <article class="flex flex-col">
                  {article.mainImage ? (
                    <BlogThumb
                      href={`/news/${article.slug}`}
                      src={article.mainImage}
                      width={1150}
                      height={500}
                      eager={index === 0}
                      class="aspect-[23/10] rounded-3xl"
                    />
                  ) : (
                    <NewsCover
                      href={`/news/${article.slug}`}
                      slug={article.slug}
                      size="lg"
                      class="aspect-[23/10] rounded-3xl"
                    />
                  )}
                  <h3 class="text-black! dark:text-white! mt-6 line-clamp-2 text-[26px]! leading-snug font-bold tracking-tight md:text-[32px]!">
                    <a href={`/news/${article.slug}`} class="text-inherit! hover:text-primary! transition-colors">
                      {article.title}
                    </a>
                  </h3>
                  <BlogMeta
                    class="mt-4"
                    author="GoPocket"
                    date={article.formattedDate}
                    datetime={article.publishedISO}
                    readingMinutes={article.readingMinutes}
                  />
                  <BlogReadMore
                    class="mt-7 self-start"
                    variant="solid"
                    href={`/news/${article.slug}`}
                    title={article.title}
                  />
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      gridArticles.length > 0 && (
        <section class="container mt-16 md:mt-24">
          <div class="mx-auto max-w-6xl">
            <h2 class="text-black! dark:text-white! text-h4 font-bold tracking-tight md:text-h3">More News</h2>
            <div class="mt-8 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:gap-x-16 lg:gap-y-16 md:mt-10">
              {gridArticles.map((article) => (
                <article class="flex flex-col">
                  {article.mainImage ? (
                    <BlogThumb
                      href={`/news/${article.slug}`}
                      src={article.mainImage}
                      width={1150}
                      height={500}
                      class="aspect-[23/10] rounded-2xl"
                    />
                  ) : (
                    <NewsCover href={`/news/${article.slug}`} slug={article.slug} class="aspect-[23/10] rounded-2xl" />
                  )}
                  <h3 class="text-black! dark:text-white! mt-4 line-clamp-2 text-[26px]! leading-snug md:text-[32px]! font-bold tracking-tight">
                    <a href={`/news/${article.slug}`} class="text-inherit! hover:text-primary! transition-colors">
                      {article.title}
                    </a>
                  </h3>
                  <BlogMeta
                    class="mt-3"
                    date={article.formattedDate}
                    datetime={article.publishedISO}
                    readingMinutes={article.readingMinutes}
                  />
                  <BlogReadMore class="mt-5 self-start" href={`/news/${article.slug}`} title={article.title} />
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Final Call to Action -->
    <FinalCTA />
  </main>
  <Footer />
</Layout>
