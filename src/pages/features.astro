                <span class="word" style="--word-index:0">Powerful</span>
                <span class="word" style="--word-index:1">Features</span>
                <span class="word" style="--word-index:2">To</span>
                <span class="word" style="--word-index:3">Grow</span>
                <span class="word" style="--word-index:4"><strong>Your</strong></span><strong>
                  <span class="word" style="--word-index:5">Business</span></strong>
              </div>
              <script type="module" is:inline>
                const r = document.querySelectorAll(".animated-text");
                if (window.matchMedia("(max-width: 767px)").matches)
                  r.forEach((t) => {
                    t.querySelectorAll(".word").forEach((e) => {
                      ((e.style.opacity = "1"), (e.style.filter = "none"), (e.style.transform = "none"));
                    });
                  });
                else {
                  const t = new IntersectionObserver(
                    (e, a) => {
                      e.forEach((s) => {
                        s.isIntersecting && (s.target.classList.add("is-animated"), a.unobserve(s.target));
                      });
                    },
                    { threshold: 0.1 },
                  );
                  r.forEach((e) => {
                    (e.classList.add("is-ready"), t.observe(e));
                  });
                }
              </script>
