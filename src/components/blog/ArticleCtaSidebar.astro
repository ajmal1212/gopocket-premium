---
/**
 * The sticky "Open Account" panel beside an article body, shared by the blog
 * and news article pages. `tag` is passed through to the lead form so the
 * source of a sign-up stays distinguishable between the two.
 */
interface Props {
  tag?: string;
  class?: string;
}

const { tag = "Blog", class: className = "" } = Astro.props;
---

<aside class:list={["lg:col-span-3 lg:sticky lg:top-28 space-y-6 w-full max-w-[340px] mx-auto lg:mx-0", className]}>
  <div class="relative overflow-hidden rounded-3xl bg-primary p-6 sm:p-7 shadow-lg shadow-primary/30 space-y-6">
    <!-- Texture: fine dot grid over two soft colour blooms -->
    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 14px 14px;"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -top-20 -right-16 h-56 w-56 rounded-full bg-white/25 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 -left-16 h-52 w-52 rounded-full bg-fuchsia-400/30 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative space-y-3">
      <!-- <div
        class="inline-flex items-center gap-1.5 bg-white/15 ring-1 ring-white/25 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase"
      >
        <span>GoPocket Trading</span>
      </div> -->
      <h3 class="article-cta-title font-bold text-center">Open Account in 5 min</h3>
      <p class="text-white/80 text-sm leading-relaxed text-center">Start trading & investing today</p>
    </div>

    <!-- Primary action -->
    <a
      href={`/open-account-call-back?src=Website&tag=${tag}`}
      class="relative flex w-full items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-bold uppercase tracking-wider text-primary shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl"
    >
      Open Account
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
      </svg>
    </a>

    <!-- Feature Bullets -->
    <div class="relative space-y-2.5 pt-5 border-t border-white/20 text-xs text-white/90 font-medium">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>Zero Account Opening &amp; AMC Charges</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>100% Digital 5-Minute Onboarding</span>
      </div>
      <!-- <div class="flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>Advanced Option Chain &amp; Charts</span>
      </div> -->
    </div>
  </div>
</aside>

<style>
  /* global.css styles bare h1-h6 unlayered (both colour and font-size), and
     unlayered CSS outranks every @layer -- Tailwind utilities included -- so
     `text-white` / `text-2xl` on this heading would silently lose. Set it here,
     where Astro's scoped [data-astro-cid] selector wins on specificity. */
  .article-cta-title {
    color: #fff;
    font-size: 1.5rem;
    line-height: 1.25;
  }

  @media (min-width: 640px) {
    .article-cta-title {
      font-size: 1.75rem;
    }
  }
</style>
