---
import Layout from "@/layouts/Layout.astro";
import OpenAccountCard from "@/components/OpenAccountCard.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FAQSection from "@/components/FAQSection.astro";
import PriceHeader from "@/components/stocks/PriceHeader.astro";
import MarketDepth from "@/components/stocks/MarketDepth.astro";
import Performance from "@/components/stocks/Performance.astro";
import StockNews from "@/components/stocks/StockNews.astro";
import FinancialPerformance from "@/components/stocks/FinancialPerformance.astro";
import Shareholding from "@/components/stocks/Shareholding.astro";
import ShareholdingBreakdown from "@/components/stocks/ShareholdingBreakdown.astro";
import { fetchShareholding } from "@/lib/shareholding";
import { buildStockOverview } from "@/lib/stock-overview";
import { stockFor } from "@/data/stocks";
import { findContractBySlug } from "@/lib/contracts";
import { fetchQuote } from "@/lib/feed/quote";
import { fetchCandles, fetchLatestSession, rangeById, sessionWindow } from "@/lib/feed/candles";
import PriceChart from "@/components/stocks/PriceChart.astro";
import StockOverview from "@/components/stocks/StockOverview.astro";

const { slug } = Astro.params;

// Slugs come from Contract Master's `formatted_ins_name`, so every instrument
// the search can find has a page - not just the handful with written copy.
const contract = slug ? await findContractBySlug(slug) : null;

if (!contract) {
  return Astro.redirect("/404", 404);
}

// One address per instrument. A share's old address ("reliance-eq") or its
// bare BSE symbol still finds it, and is sent on permanently to the company-
// name one, keeping any ?range - so links and bookmarks keep working and search
// engines move their ranking across rather than splitting it.
if (contract.slug !== slug) {
  return Astro.redirect(`/stocks/${contract.slug}${Astro.url.search}`, 301);
}

// Curated copy where it exists; otherwise the page stands on the live data.
const editorial = stockFor(contract.exchange, contract.symbol);
const displayName = editorial?.name ?? contract.name;
const sector = editorial?.sector ?? contract.symbol;
const token = contract.key;

// Rendered server-side so the price is in the HTML the crawler and the browser
// first see. The socket below takes over from there.
const range = rangeById(Astro.url.searchParams.get("range") || "1D");

// An index has no order book - nothing is bought or sold on it directly - and
// no shareholders to report.
const hasDepth = contract.exchange !== "INDICES";

// Run together, so the page's time-to-first-byte is the slowest of them rather
// than their sum. The shareholding lookup is capped well inside the candles'
// own timeout, so it never becomes the slowest. A 1D chart is the latest
// session - today's, or the last one that traded - which every range fetches,
// since it also carries the previous close to measure the day's change from.
const [feedQuote, latest, rangeCandles, shareholding] = await Promise.all([
  fetchQuote(token),
  fetchLatestSession(token),
  range.id === "1D" ? null : fetchCandles(token, range, contract.tradingSymbol),
  hasDepth ? fetchShareholding(contract.symbol) : null,
]);
const candles = rangeCandles ?? latest.candles;

/*
 * Between sessions the feed has already rolled its previous close forward to
 * the last session's own close, so Friday's move would read +0.00 (and green)
 * all weekend. When nothing has traded today, the change is measured from the
 * session before instead - as every broker shows it - and the page tells the
 * feed client to keep doing so until the price moves again (see client.ts).
 */
const feedPrice = feedQuote?.lp ? Number.parseFloat(feedQuote.lp) : null;
const heldClose = feedPrice !== null ? latest.previousClose : null;
const quote =
  feedQuote && feedPrice !== null && heldClose !== null
    ? { ...feedQuote, c: heldClose.toFixed(2), pc: (((feedPrice - heldClose) / heldClose) * 100).toFixed(2) }
    : feedQuote;
const previousClose = quote?.c ? Number.parseFloat(quote.c) : null;

// Only the intraday view is plotted against clock time; the longer ranges span
// many sessions, where evenly spaced points read better than real gaps.
const session = range.id === "1D" ? sessionWindow(candles, contract.exchange) : null;

const priceText = quote?.lp ? `₹${Number.parseFloat(quote.lp).toFixed(2)}` : null;
const title = `${displayName} (${contract.symbol}) Share Price Today | GoPocket`;
const description = priceText
  ? `${displayName} share price is ${priceText} on the ${contract.exchange}. Live ${contract.symbol} price, market depth, day high and low, 52-week range and volume.`
  : `Live ${displayName} (${contract.symbol}) share price on the ${contract.exchange}, with market depth, day high and low, 52-week range and volume.`;

/*
 * The page's written content, built from the data already fetched above - no
 * extra request, no added latency. Until this existed the only prose on a stock
 * page was the curated description, which covers three companies; every other
 * page was widgets, which is what kept them out of the index.
 */
const overview = buildStockOverview({
  contract,
  displayName,
  quote,
  shareholding,
  sector: editorial?.sector,
  editorialDescription: editorial?.description,
  previousClose,
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Corporation",
  name: displayName,
  tickerSymbol: `${contract.exchange}:${contract.symbol}`,
  ...(editorial ? { description: editorial.description } : {}),
  url: new URL(`/stocks/${contract.slug}`, Astro.url.origin).href,
};

// Only emitted when the answers are on the page - structured data has to match
// what the reader sees, and an empty mainEntity is invalid anyway.
const faqSchema =
  overview.worthShowing && overview.faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: overview.faqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      }
    : null;
---

<Layout title={title} description={description} canonical={`/stocks/${contract.slug}`}>
  <Header currentPath="/stocks" />

  <main class="mx-auto max-w-7xl px-4 py-10 md:px-8 lg:py-14">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-10">
      <div class="flex min-w-0 flex-col gap-8">
        <PriceHeader
          name={displayName}
          symbol={contract.symbol}
          exchange={contract.exchange}
          sector={sector}
          token={token}
          quote={quote}
          heldClose={heldClose}
        />

        <PriceChart
          candles={candles}
          previousClose={previousClose}
          token={token}
          exchange={contract.exchange}
          activeRange={range.id}
          slug={contract.slug}
          dailyAvailable={contract.exchange !== "INDICES"}
          session={session}
          lastPrice={quote?.lp ? Number.parseFloat(quote.lp) : null}
        />

        {hasDepth && <MarketDepth token={token} quote={quote} />}

        <Performance token={token} quote={quote} depth={hasDepth} />

        {
          /*
            The headline split renders with the page - it's one fast lookup,
            and the promoter figure is worth having in the HTML - and stands
            in for the full breakdown, a server island that reads the filing
            itself once the page has arrived.
          */
        }
        {
          shareholding && (
            <ShareholdingBreakdown server:defer symbol={contract.symbol} summary={shareholding}>
              <Shareholding slot="fallback" data={shareholding} />
            </ShareholdingBreakdown>
          )
        }

        {
          hasDepth && (
            <FinancialPerformance server:defer symbol={contract.symbol}>
              <div slot="fallback" class="flex flex-col gap-5" aria-busy="true">
                <span class="bg-theme-light h-6 w-52 rounded motion-safe:animate-pulse" />
                <span class="bg-theme-light h-9 w-44 rounded-full motion-safe:animate-pulse" />
                <div class="border-border-light h-[340px] rounded-2xl border" aria-hidden="true" />
              </div>
            </FinancialPerformance>
          )
        }

        {
          /*
            A server island: the page is sent without waiting on the news
            feeds, and the headlines are rendered in a request of their own
            once it has arrived. The fallback holds roughly the same space so
            the section filling in doesn't push the page about.
          */
        }
        <StockNews server:defer symbol={contract.symbol} name={editorial?.name}>
          <section slot="fallback" class="flex flex-col gap-4" aria-busy="true">
            <h2 class="text-h6! font-semibold">News</h2>
            <div class="border-border-light divide-border-light divide-y rounded-2xl border" aria-hidden="true">
              {
                [0, 1, 2, 3].map(() => (
                  <div class="flex flex-col gap-2 px-4 py-4 md:px-6">
                    <span class="bg-theme-light h-3 w-40 rounded motion-safe:animate-pulse" />
                    <span class="bg-theme-light h-4 w-full rounded motion-safe:animate-pulse" />
                  </div>
                ))
              }
            </div>
          </section>
        </StockNews>

        <!--
          The page's written content. Curated copy leads where it exists (three
          companies, in src/data/stocks.ts) and the generated overview carries
          every other page; see buildStockOverview.
        -->
        <StockOverview overview={overview} displayName={displayName} />

        <p class="text-text-default/75 text-xs leading-relaxed">
          Prices are sourced from the exchanges and shown for information only. They may be delayed and should not be
          relied on for trading decisions. Investments in securities are subject to market risk; read all related
          documents carefully before investing.
        </p>
      </div>

      {
        /*
        The conversion card rides alongside the chart on desktop and follows the
        reader down the page, which is the whole reason a stock page earns its
        place on a marketing site. On a phone it drops below the fold rather
        than pushing the price and chart off the first screen.
      */
      }
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <OpenAccountCard
          tag="Stock"
          heading={`Invest in ${contract.symbol}`}
          description={`Open a free demat account in minutes and start investing in ${displayName}.`}
        >
          Want to invest in<br />{contract.symbol}?
        </OpenAccountCard>
      </aside>
    </div>
  </main>

  {
    /*
      The generated Q&A, in the site's shared FAQ section. Placed outside <main>
      so its background band runs the full width of the page, as it does
      everywhere else - inside the max-w-7xl column it would read as a floating
      slab. The answers sit in the DOM even while collapsed, so a crawler reads
      them without running the accordion script.
    */
  }
  {
    overview.faqs.length > 0 && (
      <FAQSection
        eyebrow={`${contract.symbol} FAQs`}
        title={`${displayName} FAQs`}
        description={`Common questions about the ${displayName} share price, ownership and how to buy it.`}
        faqs={overview.faqs}
      />
    )
  }

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Layout>

<script>
  import { holdPreviousClose, register, subscribe } from "@/lib/feed/client";
  import type { Tick } from "@/lib/feed/types";

  const header = document.querySelector<HTMLElement>("[data-price-header]");
  const token = header?.dataset.token;

  if (header && token) {
    // Before anything subscribes: the first snapshot must already be measured
    // from the session before, not from the feed's rolled-forward close.
    const { heldClose, heldPrice } = header.dataset;
    if (heldClose && heldPrice) holdPreviousClose(token, Number(heldClose), Number(heldPrice));

    const root = header.closest("main") ?? document.body;
    const fields = new Map<string, HTMLElement>();
    for (const el of root.querySelectorAll<HTMLElement>("[data-field]")) {
      fields.set(el.dataset.field!, el);
    }

    const money = (value: number) =>
      `₹${value.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const signed = (value: number) => `${value >= 0 ? "+" : ""}${value.toFixed(2)}`;
    const num = (value: string | undefined) => {
      if (!value) return null;
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : null;
    };

    // Only writes on a real change. Ticks arrive several times a second and
    // most leave most fields as they were; an unconditional write still
    // invalidates the text and repaints it.
    const setText = (field: string, text: string) => {
      const el = fields.get(field);
      if (el && el.textContent !== text) el.textContent = text;
    };

    let isLive = false;

    const render = (tick: Tick) => {
      const last = num(tick.lp);
      const percent = num(tick.pc);
      const previousClose = num(tick.c);

      if (last !== null) setText("lp", money(last));

      const changeEl = fields.get("change");
      if (changeEl && last !== null && percent !== null && previousClose !== null) {
        const change = last - previousClose;
        setText("change", `${signed(change)} (${signed(percent)}%)`);
        const up = percent >= 0;
        changeEl.classList.toggle("text-emerald-600", up);
        changeEl.classList.toggle("dark:text-emerald-400", up);
        changeEl.classList.toggle("text-red-600", !up);
        changeEl.classList.toggle("dark:text-red-400", !up);
        changeEl.hidden = false;
      }

      // The feed only prints while the market is open, so the first tick after
      // load is what proves the page is live rather than showing yesterday.
      // Once is enough: re-setting an attribute to the value it already has
      // still counts as a DOM change.
      if (!isLive) {
        isLive = true;
        root.querySelector<HTMLElement>("[data-live]")?.removeAttribute("hidden");
        root.querySelector<HTMLElement>("[data-stale]")?.setAttribute("hidden", "");
      }
    };

    register("stock-page", [token]);
    subscribe(token, render);
  }
</script>
