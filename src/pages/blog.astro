---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import BlogThumb from "@/components/blog/BlogThumb.astro";
import NewsCover from "@/components/news/NewsCover.astro";
import BlogMeta from "@/components/blog/BlogMeta.astro";
import BlogReadMore from "@/components/blog/BlogReadMore.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import BlogPagination from "@/components/blog/BlogPagination.astro";
import { FIRST_PAGE_SIZE, blogPageCount } from "@/components/blog/blog-pages";
import { getBlogCount, getBlogPosts } from "../lib/frappe";

// Newest post leads, the next three stack beside it, and the rest fill the grid.
// Older posts continue at /blog/page/2 onwards.
const [posts, totalPosts] = await Promise.all([getBlogPosts(FIRST_PAGE_SIZE, true), getBlogCount()]);
const pageCount = totalPosts === null ? 1 : blogPageCount(totalPosts);
const featuredPost = posts[0] ?? null;
const sidePosts = posts.slice(1, 4);
const gridPosts = posts.slice(4);

const SITE = Astro.site?.origin ?? Astro.url.origin;
const blogUrl = `${SITE}/blog`;

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "GoPocket Blog",
  description: "Practical tips, algo trading insights, options strategies and market news to help you trade smarter.",
  url: blogUrl,
  inLanguage: "en",
  publisher: {
    "@type": "Organization",
    name: "GoPocket",
    url: `${SITE}/`,
    logo: { "@type": "ImageObject", url: `${SITE}/gopocket-logo.svg` },
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    description: post.description || post.summary,
    image: post.thumbnailImage || undefined,
    url: `${blogUrl}/${post.slug}`,
    mainEntityOfPage: { "@type": "WebPage", "@id": `${blogUrl}/${post.slug}` },
    datePublished: post.publishedISO,
    dateModified: post.modifiedISO || post.publishedISO,
    articleSection: post.categories,
    author: { "@type": "Organization", name: "GoPocket", url: `${SITE}/` },
  })),
};

const blogBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: blogUrl },
  ],
};
---

<Layout
  title="GoPocket Blog - Trading Insights, Algo Trading & Financial News"
  description="Discover practical tips, algo trading insights, options strategies, and market news designed to help you trade smarter."
  canonical={blogUrl}
  ogImage={featuredPost?.thumbnailImage || undefined}
  ogImageAlt={featuredPost ? featuredPost.title : undefined}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(blogBreadcrumbSchema)} />
    {pageCount > 1 && <link rel="next" href={`${SITE}/blog/page/2`} />}
  </Fragment>
  <Header currentPath="/blog" />
  <main class="has-section-spacing-lg pt-8 md:pt-16">
    <h1 class="sr-only">GoPocket Blog - Trading Insights, Algo Trading &amp; Financial News</h1>

    {
      posts.length === 0 && (
        <section class="container pt-0!">
          <div class="bg-theme-light border-border-light rounded-3xl border py-16 text-center text-gray-500">
            <p class="text-lg font-medium">No blog articles found at the moment.</p>
            <p class="mt-1 text-sm">Please check back soon for fresh market insights.</p>
          </div>
        </section>
      )
    }

    {
      featuredPost && (
        <section class="container pt-0!">
          <div class="mx-auto max-w-6xl">
            <h2 class="text-black! dark:text-white! text-h4 font-bold tracking-tight md:text-h3">Recent Blogs</h2>
            <div class="mt-8 grid gap-10 md:mt-10 lg:grid-cols-2 lg:gap-16 xl:gap-20">
              <article class="flex flex-col">
                {featuredPost.mainImage ? (
                  <BlogThumb
                    href={`/blog/${featuredPost.slug}`}
                    src={featuredPost.mainImage}
                    category={featuredPost.category}
                    width={1150}
                    height={500}
                    eager
                    class="aspect-[23/10] rounded-3xl"
                  />
                ) : (
                  <NewsCover
                    href={`/blog/${featuredPost.slug}`}
                    category={featuredPost.category}
                    slug={featuredPost.slug}
                    size="lg"
                    class="aspect-[23/10] rounded-3xl"
                  />
                )}
                <h2 class="text-black! dark:text-white! mt-6 text-[26px]! leading-tight font-bold tracking-tight md:text-[36px]!">
                  <a href={`/blog/${featuredPost.slug}`} class="text-inherit! hover:text-primary! transition-colors">
                    {featuredPost.title}
                  </a>
                </h2>
                <BlogMeta
                  class="mt-4"
                  author="GoPocket"
                  date={featuredPost.formattedDate}
                  datetime={featuredPost.publishedISO}
                  readingMinutes={featuredPost.readingMinutes}
                />
                <BlogReadMore
                  class="mt-7 self-start"
                  variant="solid"
                  href={`/blog/${featuredPost.slug}`}
                  title={featuredPost.title}
                />
              </article>

              {sidePosts.length > 0 && (
                <div class="flex flex-col gap-8 lg:gap-10">
                  {sidePosts.map((post) => (
                    <article class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] items-start gap-4 sm:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] sm:gap-7">
                      {post.thumbnailImage ? (
                        <BlogThumb
                          href={`/blog/${post.slug}`}
                          src={post.thumbnailImage}
                          category={post.category}
                          width={640}
                          height={550}
                          class="aspect-[64/55] rounded-2xl"
                        />
                      ) : (
                        <NewsCover
                          href={`/blog/${post.slug}`}
                          category={post.category}
                          slug={post.slug}
                          size="sm"
                          class="aspect-[64/55] rounded-2xl"
                        />
                      )}
                      <div class="flex flex-col">
                        <h2 class="text-black! dark:text-white! line-clamp-3 text-xl! leading-snug font-bold tracking-tight sm:text-2xl! xl:text-[28px]!">
                          <a href={`/blog/${post.slug}`} class="text-inherit! hover:text-primary! transition-colors">
                            {post.title}
                          </a>
                        </h2>
                        <BlogMeta
                          class="mt-3 sm:mt-4"
                          date={post.formattedDate}
                          datetime={post.publishedISO}
                          readingMinutes={post.readingMinutes}
                        />
                        <BlogReadMore class="mt-4 self-start sm:mt-6" href={`/blog/${post.slug}`} title={post.title} />
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    {
      gridPosts.length > 0 && (
        <section class="container mt-16 md:mt-24">
          <div class="mx-auto max-w-6xl">
            <h2 class="text-black! dark:text-white! text-h4 font-bold tracking-tight md:text-h3">Featured Blogs</h2>
            <div class="mt-8 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:gap-x-12 lg:gap-y-16 lg:grid-cols-3 md:mt-10">
              {gridPosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      pageCount > 1 && (
        <section class="container mt-16 md:mt-24">
          <BlogPagination current={1} total={pageCount} />
        </section>
      )
    }

    <!-- Final Call to Action -->
    <FinalCTA />
  </main>
  <Footer />
</Layout>
