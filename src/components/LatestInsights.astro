---
import { getBlogPosts } from "../lib/frappe";

// Latest three published blogs (limit_page_length = 3, newest first)
const posts = await getBlogPosts(3);
---

{
  posts.length > 0 && (
    <section>
      <div class="container space-y-10 md:space-y-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="has-italic-text capitalize">
            <div
              class="animated-text is-ready"
              data-duration="0.6"
              data-delay="0.2"
              data-stagger="0.09"
              style="font-weight: 600; --animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
            >
              {/* Inside a JSX expression Astro collapses the newlines between
                  these spans, so the word gaps must be explicit. */}
              <span class="word" style="--word-index:0">
                Latest
              </span>{" "}
              <span class="word" style="--word-index:1">
                Insights
              </span>{" "}
              <span class="word" style="--word-index:2">
                From
              </span>{" "}
              <span class="word" style="--word-index:3">
                <strong>Our</strong>
              </span>{" "}
              <strong>
                <span class="word" style="--word-index:4">
                  Expert
                </span>
              </strong>
            </div>
          </h2>
        </div>
        <div class="grid grid-cols-3 gap-x-2 gap-y-6 sm:gap-x-4 md:gap-x-6 md:gap-y-10">
          {posts.map((post, index) => (
            <article
              class="bg-theme-light rounded-lg p-2 sm:p-3 md:rounded-2xl md:p-6 aos-init"
              data-aos-delay={`${(index + 1) * 100}`}
              data-aos="fade-right-sm"
            >
              <div class="group after:from-theme-light relative flex items-center justify-center overflow-hidden rounded-xl via-20% after:pointer-events-none after:absolute after:inset-0 after:z-10 after:hidden after:bg-linear-to-t after:to-transparent after:transition-opacity after:duration-500 after:md:block after:md:opacity-0 hover:md:after:opacity-100">
                <span class="text-dark pointer-events-none absolute z-20 hidden h-16 w-16 items-center justify-center rounded-full bg-white transition duration-500 md:flex md:opacity-0 group-hover:md:opacity-100">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    data-lucide="ArrowUpRight"
                    class="text-2xl"
                  >
                    <path d="M7 7h10v10" />
                    <path d="M7 17 17 7" />
                  </svg>
                </span>
                <div class="w-full overflow-hidden rounded-lg border-2 border-white md:rounded-2xl md:border-4">
                  <img
                    src={post.thumbnailImage || post.mainImage}
                    alt={post.title}
                    loading="lazy"
                    decoding="async"
                    width="640"
                    height="550"
                    class="min-w-full aspect-[16/10] object-cover transition duration-500 group-hover:scale-105 md:aspect-[640/550]"
                  />
                </div>
                <a class="absolute inset-0 z-30" href={`/blog/${post.slug}`}>
                  <span class="sr-only">Learn more about {post.title}</span>
                </a>
              </div>
              <div class="space-y-1.5 mt-2 md:space-y-3 md:mt-4">
                <div class="font-primary text-text-default flex flex-wrap items-center gap-x-1.5 gap-y-px text-[10px] font-medium opacity-80 sm:gap-x-2.5 sm:text-xs">
                  <span>{post.formattedDate}</span>
                  <span class="bg-dark inline-block h-1 w-1 rounded-full" />
                  <span class="text-inherit">{post.category}</span>
                </div>
                {/* Three cards across at every width, so the title steps down with
                    the column and only returns to the section's heading size at
                    xl, where a third of the page is wide enough to carry it.

                    Sizes carry `!` because global.css styles `h1`-`h6` OUTSIDE a
                    cascade layer, and unlayered CSS beats Tailwind's layered
                    utilities whatever the specificity — a plain `text-base` here
                    is ignored. That is also why the xl step has to name
                    `text-h3` rather than simply stopping: with no utility in
                    play the unlayered rule is what sizes the title. */}
                <h3 class="text-[11px]! sm:text-sm! md:text-base! lg:text-lg! xl:text-h3! font-semibold leading-snug! line-clamp-3 mb-0 md:mb-3 text-gray-900 dark:text-white">
                  {post.title}
                </h3>
                {/* Below sm a third of the screen is narrower than the button.
                    The card is still reachable: the overlay anchor on the image
                    is a link with the post's title on it. Wrapped in a div
                    rather than given `hidden sm:inline-flex`, so it does not
                    depend on out-specifying `.btn`'s own display. */}
                <div class="hidden sm:block">
                  <a
                    class="btn btn-outline text-flip-hover-anim btn-sm btn-outline-white mt-3 capitalize"
                    href={`/blog/${post.slug}`}
                  >
                    <span class="text-flip-inner" data-content="Read More">
                      Read More
                    </span>
                    <span class="sr-only">Read more about {post.title}</span>
                    <span class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]">
                      <svg
                        class="gradient-shape"
                        width="150"
                        height="28"
                        viewBox="0 0 147 11"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                          stroke="currentColor"
                          stroke-width="8"
                        />
                      </svg>
                    </span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
