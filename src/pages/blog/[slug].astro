---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import FAQSection2 from "../../components/FAQSection2.astro";
import ArticleCtaSidebar from "@/components/blog/ArticleCtaSidebar.astro";
import LatestPosts from "@/components/blog/LatestPosts.astro";
import ProseEnhancements from "@/components/blog/ProseEnhancements.astro";
import { getBlogPostBySlugOrId, getBlogPosts } from "../../lib/frappe";

const { slug } = Astro.params;

// Sidebar shows this many recent posts. One extra is fetched because the post
// being read may be among the newest and is filtered out; the list request is
// capped at that count and carries no post bodies.
const LATEST_COUNT = 4;

// Both requests are independent, so they run side by side rather than adding
// the list's round trip to every article's response time.
const [post, recentPosts] = await Promise.all([
  slug ? getBlogPostBySlugOrId(slug) : Promise.resolve(null),
  getBlogPosts(LATEST_COUNT + 1),
]);

if (!post) {
  return Astro.redirect("/blog");
}

const latestPosts = recentPosts.filter((recent) => recent.slug !== post.slug).slice(0, LATEST_COUNT);

// FAQSection2 renders its FAQs grouped under category tabs, but a post's FAQ
// rows are a flat list, so present them as one group labelled with the post's
// primary category. The tab bar hides itself when there is only one group.
const faqCategories = post.faqs.length
  ? [
      {
        id: "article",
        label: post.categories[0] || "General",
        items: post.faqs.map(({ question, answer }) => ({ question, answer })),
      },
    ]
  : [];

const SITE = Astro.site?.origin ?? Astro.url.origin;
const postUrl = `${SITE}/blog/${post.slug}`;

// Both images point at the same file when a post only sets one of them, so
// de-duplicate before handing the list to schema.org.
const schemaImages = [...new Set([post.mainImage, post.thumbnailImage].filter(Boolean))];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description || post.summary,
  image: schemaImages,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  datePublished: post.publishedISO,
  dateModified: post.modifiedISO || post.publishedISO,
  articleSection: post.categories,
  keywords: post.categories.join(", "),
  inLanguage: "en",
  author: { "@type": "Organization", name: "GoPocket", url: `${SITE}/` },
  publisher: {
    "@type": "Organization",
    name: "GoPocket",
    url: `${SITE}/`,
    logo: { "@type": "ImageObject", url: `${SITE}/gopocket-logo.svg` },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog` },
    { "@type": "ListItem", position: 3, name: post.title, item: postUrl },
  ],
};

// Only emit FAQPage when the post actually carries FAQ rows - an empty
// mainEntity is invalid and Google flags it.
const faqSchema = post.faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: post.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    }
  : null;
---

<Layout
  title={`${post.title} - GoPocket Blog`}
  description={post.description || post.summary}
  canonical={postUrl}
  ogImage={post.thumbnailImage}
  ogImageAlt={post.title}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.publishedISO} />
    <meta property="article:modified_time" content={post.modifiedISO || post.publishedISO} />
    <meta property="article:publisher" content={`${SITE}/`} />
    {post.categories[0] && <meta property="article:section" content={post.categories[0]} />}
    {post.categories.map((category) => <meta property="article:tag" content={category} />)}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>
  <Header currentPath="/blog" />

  <main class="has-section-spacing-lg pt-8 md:pt-16">
    <!-- Article Header -->
    <section class="relative z-10 py-8 md:py-14">
      <div class="container max-w-7xl">
        <div class="max-w-4xl mx-auto text-center space-y-5">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-semibold tracking-wide uppercase"
          >
            {
              post.categories.map((category) => (
                <>
                  <span>{category}</span>
                  <span class="opacity-40">•</span>
                </>
              ))
            }
            <span>{post.formattedDate}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-dark tracking-tight leading-tight">
            {post.title}
          </h1>

          {
            post.description && (
              <p class="text-lg md:text-xl text-text-default opacity-80 max-w-3xl mx-auto leading-relaxed">
                {post.description}
              </p>
            )
          }
        </div>

        <!-- Main Featured Image -->
        {
          post.mainImage && (
            <div class="max-w-7xl mx-auto mt-8 md:mt-12 rounded-3xl overflow-hidden border border-border-light shadow-lg aspect-[1150/500] w-full bg-white">
              <img
                src={post.mainImage}
                alt={post.title}
                class="w-full h-full object-cover rounded-3xl"
                loading="eager"
              />
            </div>
          )
        }
      </div>
    </section>

    <!-- Article Content & Always Sticky Right Sidebar CTA -->
    <section class="py-6 md:py-10">
      <div class="container max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          <!-- LEFT COLUMN: Expanded Post Content Body (9 Columns) -->
          <article
            class="lg:col-span-9 bg-theme-light px-3 py-6 sm:px-5 sm:py-10 md:px-7 md:py-12 rounded-3xl border border-border-light shadow-xs w-full overflow-hidden"
          >
            {
              post.postBody ? (
                <div class="ql-editor read-mode w-full" set:html={post.postBody} />
              ) : (
                <div class="text-center py-12 text-gray-500">
                  <p>No content available for this article.</p>
                </div>
              )
            }

            <!-- Back to Blog Button -->
            <div class="pt-8 mt-10 border-t border-border-light/80 flex items-center justify-between">
              <a href="/blog" class="btn btn-outline text-flip-hover-anim btn-sm cursor-pointer">
                <span class="text-flip-inner" data-content="← Back to All Articles">← Back to All Articles</span>
                <span
                  class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                >
                  <svg
                    class="gradient-shape"
                    width="150"
                    height="28"
                    viewBox="0 0 147 11"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                      stroke="currentColor"
                      stroke-width="8"></path>
                  </svg>
                </span>
              </a>
            </div>
          </article>

          <ArticleCtaSidebar tag="Blog">
            <LatestPosts posts={latestPosts} />
          </ArticleCtaSidebar>
        </div>
      </div>
    </section>

    {
      post.faqs.length > 0 && (
        <FAQSection2
          titleBold="Frequently"
          title="asked questions"
          description="Quick answers to the most common questions about this topic."
          categories={faqCategories}
        />
      )
    }

    <FinalCTA />
  </main>

  <Footer />
</Layout>

<ProseEnhancements />
