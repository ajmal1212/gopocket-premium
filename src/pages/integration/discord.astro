                      height="400"
                      class="!h-72 w-full !max-w-full object-cover md:!h-96"
                    /><button
                      type="button"
                      title="Play Video"
                      aria-haspopup="dialog"
                      aria-expanded="false"
                      video-config='{"id":"rFVpSwgCkCo","src":"rFVpSwgCkCo","provider":"youtube"}'
                      aria-controls="#rFVpSwgCkCo"
                      data-hs-overlay="#rFVpSwgCkCo"
                      data-hs-overlay-options='{"emulateScrollbarSpace" : true}'
                      class="video-modal-toggle translate-centered has-animated-waves waves-white absolute flex h-20 w-20 items-center justify-center rounded-full transition-transform duration-300 hover:scale-110 lg:h-20 lg:w-20"
                      ><div class="relative z-10 flex h-20 w-20 items-center justify-center rounded-full">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          data-lucide="Play"
                          class="icon fill-theme-light text-dark"
                          ><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
                          ></path></svg>
                      </div></button
                    ><dialog
                      id="rFVpSwgCkCo"
                      class="video-modal m-auto w-[min(100%-2rem,72rem)] max-w-4xl rounded-2xl border-0 bg-transparent p-3 text-left shadow-2xl backdrop:bg-black/80"
                      data-video-modal=""
                      aria-label="Not Found"
                    >
                      <div class="pointer-events-auto flex flex-col">
                        <button
                          type="button"
                          aria-label="Not Found"
                          data-video-modal-close=""
                          class="mb-2 ml-auto flex h-10 w-10 items-center justify-center rounded-full bg-white ring-0 ring-white/50 duration-300 hover:rotate-90 hover:ring-4"
                          ><span class="sr-only">Not Found</span><svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            data-lucide="X"
                            class="text-text-default/80 h-6 w-6"
                            ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
                          ></button
                        ><div class="aspect-video w-full overflow-hidden rounded-2xl bg-black">
                          <iframe
                            class="hidden size-full"
                            title="Not Found"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen=""
                            data-video-embed=""
                            data-src="https://www.youtube-nocookie.com/embed/rFVpSwgCkCo?rel=0&playsinline=1&autoplay=1"
                            src="about:blank"></iframe>
                        </div>
                      </div>
                    </dialog><script type="module" is:inline>
                      function s(e) {
                        const t = e.querySelector("[data-video-embed]");
                        t && ((t.src = "about:blank"), t.classList.add("hidden"));
                        const o = e.querySelector("[data-video-player]");
                        o && o.pause();
                      }
                      function l(e) {
                        const t = e.querySelector("[data-video-embed]");
                        t && t.dataset.src && ((t.src = t.dataset.src), t.classList.remove("hidden"));
                        const o = e.querySelector("[data-video-player]");
                        (o?.dataset.autoplay === "true" && o.play().catch(() => {}), e.open || e.showModal());
                      }
                      function n(e) {
                        (s(e), e.open && e.close());
                      }
                      function d(e) {
                        const t = e?.getAttribute("data-hs-overlay");
                        if (!t?.startsWith("#")) return null;
                        const o = document.querySelector(t);
                        return o instanceof HTMLDialogElement && o.hasAttribute("data-video-modal") ? o : null;
                      }
                      document.addEventListener("click", (e) => {
                        const t = e.target,
                          o = t?.closest("[data-video-modal-close]");
                        if (o) {
                          const c = o.closest("dialog[data-video-modal]");
                          c instanceof HTMLDialogElement && (e.preventDefault(), n(c));
                          return;
                        }
                        const r = t ? t.closest("[data-hs-overlay]") : null,
                          a = d(r);
                        a && (e.preventDefault(), l(a));
                      });
                      document.querySelectorAll("dialog[data-video-modal]").forEach((e) => {
                        (e.addEventListener("click", (t) => {
                          t.target === e && n(e);
                        }),
                          e.addEventListener("close", () => {
                            s(e);
                          }));
                      });
                    </script>
