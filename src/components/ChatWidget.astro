---
/* src/components/ChatWidget.astro
   n8n chat bubble, bottom-right. The library is Vue-based and weighs a few
   hundred kB, so the page ships a look-alike button instead and loads the real
   widget only for a visitor who reaches for it - see the script below. */
---

<div id="n8n-chat">
  {
    /*
    The facade. It sits inside #n8n-chat so it inherits the same --chat--*
    variables as the real launcher - size, colour, position, and the smaller
    phone sizes from the media query below - and so the widget's own mount,
    which replaces this element's contents, swaps it out in the same frame.
    The glyph is n8n's own launcher icon (mdi "chat") rather than a Lucide one
    on purpose: anything else would visibly change the moment the real button
    takes its place.
  */
  }
  <button
    type="button"
    class="fixed right-(--chat--window--right) bottom-(--chat--window--bottom) z-(--chat--window--z-index) inline-flex size-(--chat--toggle--size) cursor-pointer items-center justify-center rounded-(--chat--toggle--border-radius) bg-(--chat--toggle--background) text-(color:--chat--toggle--color) shadow-[0_10px_26px_-8px_rgba(107,26,255,0.6)] transition-[transform,background-color] duration-200 hover:scale-105 hover:bg-(--chat--toggle--hover--background) focus-visible:scale-105 focus-visible:bg-(--chat--toggle--hover--background) active:scale-95 aria-busy:cursor-progress aria-busy:opacity-80 motion-reduce:transition-none"
    aria-label="Chat with GoPocket support"
    data-chat-facade
  >
    <svg viewBox="0 0 24 24" class="size-8 max-sm:size-[22px]" aria-hidden="true">
      <path
        fill="currentColor"
        d="M12 3c5.5 0 10 3.58 10 8s-4.5 8-10 8c-1.24 0-2.43-.18-3.53-.5C5.55 21 2 21 2 21c2.33-2.33 2.7-3.9 2.75-4.5C3.05 15.07 2 13.13 2 11c0-4.42 4.5-8 10-8"
      ></path>
    </svg>
  </button>
</div>

<style is:global>
  /* n8n renders its own DOM inside #n8n-chat at runtime, so the theme variables
     sit on the container and inherit down. Everything below tracks the site's
     own vocabulary: Figtree, violet #6b1aff, tight near-square corners, and
     text a step smaller than the library's 1rem default. */
  #n8n-chat {
    /* Palette */
    --chat--color--primary: #6b1aff;
    --chat--color--primary-shade-50: #5c14dd;
    --chat--color--primary--shade-100: #4e10bb;
    --chat--color--secondary: #6b1aff;
    --chat--color-secondary-shade-50: #5c14dd;
    --chat--color-white: #ffffff;
    --chat--color-light: #f8f8f8;
    --chat--color-light-shade-50: #eceef1;
    --chat--color-light-shade-100: #e4e7ec;
    --chat--color-medium: #d2d4d9;
    --chat--color-dark: #322b2b;
    --chat--color-typing: #6b1aff;
    --chat--color-disabled: #c8ccd4;

    --chat--font-family: "Figtree", ui-sans-serif, system-ui, -apple-system, sans-serif;
    --chat--spacing: 0.875rem;
    --chat--border-radius: 8px;
    --chat--transition-duration: 0.2s;

    /* Window */
    --chat--window--width: 372px;
    --chat--window--height: 548px;
    --chat--window--bottom: 24px;
    --chat--window--right: 24px;
    --chat--window--margin-bottom: 14px;
    --chat--window--z-index: 999880;
    --chat--window--border: 1px solid #eceef1;
    --chat--window--border-radius: 10px;

    /* Header - the violet gradient the site already uses on brand surfaces */
    --chat--header--padding: 1rem 1.125rem;
    --chat--header--background: linear-gradient(135deg, #6b1aff 0%, #8b48ff 55%, #a06bff 100%);
    --chat--header--color: #ffffff;
    --chat--heading--font-size: 0.9375rem;
    --chat--subtitle--font-size: 0.75rem;
    --chat--subtitle--line-height: 1.5;

    /* Conversation */
    --chat--body--background: #f8f9fb;
    --chat--messages-list--padding: 1rem;
    --chat--message--font-size: 0.8125rem;
    --chat--message-line-height: 1.6;
    --chat--message--padding: 0.625rem 0.875rem;
    --chat--message--border-radius: 8px;
    --chat--message--margin-bottom: 0.5rem;
    --chat--message--bot--background: #ffffff;
    --chat--message--bot--color: #3b3b3b;
    --chat--message--bot--border: 1px solid #eceef1;
    --chat--message--user--background: #6b1aff;
    --chat--message--user--color: #ffffff;
    --chat--message--user--border: none;
    --chat--message--pre--background: rgba(107, 26, 255, 0.06);

    /* Composer - squared-off container so a growing textarea keeps its shape */
    --chat--textarea--height: 40px;
    --chat--textarea--max-height: 8rem;
    --chat--input--font-size: 0.8125rem;
    --chat--input--line-height: 1.5;
    --chat--input--padding: 0.5rem 0.75rem;
    --chat--input--background: transparent;
    --chat--input--text-color: #3b3b3b;
    --chat--input--border: 0;
    --chat--input--border-active: 0;
    --chat--input--border-radius: 6px;
    --chat--input--container--background: #ffffff;
    --chat--input--container--border: 1px solid #eceef1;
    --chat--input--container--border-radius: 10px;
    --chat--input--container--padding: 5px;
    --chat--input--button--border-radius: 8px;
    --chat--input--send--button--background: #6b1aff;
    --chat--input--send--button--color: #ffffff;
    --chat--input--send--button--background-hover: #5c14dd;
    --chat--input--send--button--color-hover: #ffffff;
    --chat--input--file--button--background: transparent;
    --chat--input--file--button--color: #6b1aff;

    /* Footer + buttons */
    --chat--footer--background: #ffffff;
    --chat--footer--color: #667085;
    --chat--footer--border-top: 1px solid #eceef1;
    --chat--footer--padding: 0.75rem;
    --chat--button--border-radius: 8px;
    --chat--button--font-size: 0.8125rem;
    --chat--button--padding: 0.5rem 1rem;
    --chat--button--color--primary: #ffffff;
    --chat--button--background--primary: #6b1aff;
    --chat--button--background--primary--hover: #5c14dd;
    --chat--button--color--secondary: #3b3b3b;
    --chat--button--background--secondary: #f1f2f6;
    --chat--button--background--secondary--hover: #e6e8ee;

    /* Launcher. The width and height are re-declared here, not left to the
       library: its stylesheet sets them on :root as var(--chat--toggle--size),
       and a custom property is resolved where it is declared - so they froze
       at the library's 64px before ever inheriting down, and the size below
       (and the 44px phone size) never reached the button. */
    --chat--toggle--width: var(--chat--toggle--size);
    --chat--toggle--height: var(--chat--toggle--size);
    --chat--toggle--size: 58px;
    --chat--toggle--border-radius: 9999px;
    --chat--toggle--background: #6b1aff;
    --chat--toggle--hover--background: #5c14dd;
    --chat--toggle--active--background: #4e10bb;
    --chat--toggle--color: #ffffff;
  }

  /* Dark mode follows the site's own surface tokens. */
  html.dark #n8n-chat {
    --chat--color-light: var(--surface-2, #181b25);
    --chat--color-light-shade-50: var(--line, #262a36);
    --chat--color-light-shade-100: var(--line-strong, #333846);
    --chat--color-dark: var(--fg-strong, #f3f4f7);
    --chat--window--border: 1px solid var(--line, #262a36);
    --chat--body--background: var(--surface-0, #0b0d13);
    --chat--message--bot--background: var(--surface-1, #14161f);
    --chat--message--bot--color: var(--fg, #ced2dc);
    --chat--message--bot--border: 1px solid var(--line, #262a36);
    --chat--message--user--background: var(--accent, #7c3aff);
    --chat--input--container--background: var(--surface-1, #14161f);
    --chat--input--container--border: 1px solid var(--line, #262a36);
    --chat--input--text-color: var(--fg, #ced2dc);
    --chat--footer--background: var(--surface-1, #14161f);
    --chat--footer--color: var(--fg-muted, #9ba1b0);
    --chat--footer--border-top: 1px solid var(--line, #262a36);
    --chat--button--color--secondary: var(--fg, #ced2dc);
    --chat--button--background--secondary: var(--surface-3, #22252f);
    --chat--button--background--secondary--hover: #2b2f3c;
  }

  /* Rules the variables cannot reach. The id here outranks the library's own
     class + [data-v-*] selectors without needing !important. */
  #n8n-chat .chat-window {
    box-shadow:
      0 24px 56px -20px rgba(16, 18, 27, 0.4),
      0 8px 20px -12px rgba(16, 18, 27, 0.22);
  }
  html.dark #n8n-chat .chat-window {
    box-shadow: 0 24px 56px -20px rgba(0, 0, 0, 0.7);
  }

  #n8n-chat .chat-window-toggle {
    box-shadow: 0 10px 26px -8px rgba(107, 26, 255, 0.6);
  }

  #n8n-chat .chat-header {
    gap: 0.25em;
  }
  #n8n-chat .chat-header h1 {
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  #n8n-chat .chat-header p {
    margin: 0;
    opacity: 0.85;
  }

  /* Keep a hint of the library's message tail, and stop bubbles running the
     full width of the panel. */
  #n8n-chat .chat-message {
    max-width: 86%;
    box-shadow: 0 1px 2px rgba(16, 18, 27, 0.04);
  }
  #n8n-chat .chat-message.chat-message-from-bot {
    border-bottom-left-radius: 3px;
  }
  #n8n-chat .chat-message.chat-message-from-user {
    border-bottom-right-radius: 3px;
  }
  #n8n-chat .chat-message-markdown a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  #n8n-chat .chat-message.chat-message-from-bot .chat-message-markdown a {
    color: #6b1aff;
  }
  html.dark #n8n-chat .chat-message.chat-message-from-bot .chat-message-markdown a {
    color: var(--accent-ink, #b494ff);
  }
  #n8n-chat .chat-message-markdown pre,
  #n8n-chat .chat-message-markdown code {
    font-size: 0.75rem;
  }

  #n8n-chat .chat-inputs {
    box-shadow: 0 2px 8px rgba(16, 18, 27, 0.05);
  }
  #n8n-chat .chat-inputs textarea {
    border: 0;
    outline: none;
  }
  #n8n-chat .chat-input-send-button,
  #n8n-chat .chat-input-file-button {
    width: 40px;
    height: 40px;
  }
  #n8n-chat .chat-input-file-button {
    background: transparent;
  }
  #n8n-chat .chat-footer,
  #n8n-chat .chat-powered-by {
    font-size: 0.6875rem;
  }

  #n8n-chat .chat-messages-list {
    scrollbar-width: thin;
  }

  @media (max-width: 640px) {
    #n8n-chat {
      --chat--toggle--size: 44px;
      --chat--window--bottom: 16px;
      --chat--window--right: 16px;
      --chat--window--width: calc(100vw - 32px);
      --chat--window--height: calc(100dvh - 140px);
      --chat--window--border-radius: 10px;
    }
    /* The toggle's icon has its own intrinsic size, so scale it with the circle. */
    #n8n-chat .chat-window-toggle svg {
      width: 22px;
      height: 22px;
    }
  }

  @media print {
    #n8n-chat {
      display: none;
    }
  }
</style>

<script>
  const WEBHOOK_URL = "https://n8n.gopocket.in/webhook/ea143194-39cd-4653-a83b-a1b36e81e7fb/chat";

  /* The n8n bundle is ~500 KB over the wire, comfortably the largest single
     asset on the site, and evaluating it blocks the main thread for 100-400ms
     in one piece - it cannot be split. Every schedule for loading it anyway
     ended up freezing the page somewhere: on idle it competed with the LCP
     font, on the first scroll it froze the scroll, and after the visitor had
     been still for a moment it landed exactly where people pause to read (next
     to a stock page's market depth) and froze their next scroll instead.

     So it is not loaded for visitors who never open it - which is nearly all
     of them. The button above stands in for the launcher. Resting a pointer on
     it, or focusing it, fetches and evaluates the bundle: the visitor is aiming
     at a button then, not scrolling, and by the click it is usually ready. The
     click mounts the widget over the facade and opens it. */
  const facade = document.querySelector<HTMLButtonElement>("[data-chat-facade]");

  let chatModule: Promise<typeof import("@n8n/chat")> | null = null;

  const warm = () => {
    if (!chatModule) {
      chatModule = import("@n8n/chat/style.css").then(() => import("@n8n/chat"));
      // A failed fetch - offline, or a deploy mid-visit renaming the chunk -
      // is forgotten, so the next hover or click tries again.
      chatModule.catch(() => (chatModule = null));
    }
    return chatModule;
  };

  async function startChat() {
    const { createChat } = await warm();

    createChat({
      webhookUrl: WEBHOOK_URL,
      target: "#n8n-chat",
      mode: "window",
      showWelcomeScreen: false,
      loadPreviousSession: true,
      initialMessages: ["Hi there! 👋", "I'm the GoPocket assistant. How can I help you today?"],
      i18n: {
        en: {
          title: "GoPocket Support",
          subtitle: "We're here to help, 24/7.",
          footer: "",
          getStarted: "New Conversation",
          inputPlaceholder: "Type your question...",
          closeButtonTooltip: "Close chat",
        },
      },
    });
  }

  if (facade) {
    facade.addEventListener("pointerenter", warm, { once: true });
    facade.addEventListener("focus", warm, { once: true });

    let opening = false;

    facade.addEventListener("click", async () => {
      // A double click while the bundle loads must not mount two widgets.
      if (opening) return;
      opening = true;
      // A tap on a phone has no hover to warm it, so it can take a moment;
      // say so rather than look broken.
      facade.setAttribute("aria-busy", "true");
      try {
        await startChat();
      } catch {
        // Offline, or the bundle failed to load: leave the facade usable so a
        // second tap retries.
        facade.removeAttribute("aria-busy");
        opening = false;
        return;
      }
      // createChat mounts synchronously over the facade, taking this listener
      // with it. The visitor asked for the chat, not for a launcher, so open
      // the window for them.
      document.querySelector<HTMLElement>("#n8n-chat .chat-window-toggle")?.click();
    });
  }
</script>
