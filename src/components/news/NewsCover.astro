---
/**
 * Cover art for a news article.
 *
 * The News doctype carries no image fields, so instead of shipping a stock
 * placeholder this draws a branded panel: a tinted gradient behind the
 * GoPocket mark. It carries no headline, because one already sits directly
 * below it wherever it is used. A record that does have an image never reaches
 * this component - the caller renders the image instead.
 *
 * The palette is picked from the slug rather than at random so a given article
 * keeps the same colour on every render - server and client, listing and
 * article page - and neighbouring cards still differ from one another.
 */
interface Props {
  /** Omitted on the article page, where the cover links nowhere. */
  href?: string;
  category: string;
  /** Picks the palette; same slug always yields the same colours. */
  slug: string;
  /** Scales the mark to the card it sits on. */
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { href, category, slug, size = "md", class: className = "" } = Astro.props;

/**
 * Light and dark tints per palette. Both are declared as custom properties on
 * the element because the dark values cannot be expressed as `dark:` utilities
 * on a gradient that is itself per-instance.
 */
const PALETTES = [
  { from: "#efe7ff", to: "#fbf7ff", glow: "#a97bff", darkFrom: "#2a1d4d", darkTo: "#171526" },
  { from: "#fdeede", to: "#fffaf4", glow: "#f0a457", darkFrom: "#432a18", darkTo: "#241a14" },
  { from: "#e3f0ff", to: "#f6fbff", glow: "#5b9bf0", darkFrom: "#16304f", darkTo: "#141b26" },
  { from: "#e2f6ef", to: "#f5fdfa", glow: "#42b48c", darkFrom: "#123a30", darkTo: "#141f1d" },
  { from: "#ffe8ef", to: "#fff7f9", glow: "#ef6f95", darkFrom: "#45182a", darkTo: "#24161c" },
];

// Small deterministic string hash; only needs to spread slugs across the list.
let hash = 0;
for (let i = 0; i < slug.length; i++) {
  hash = (hash * 31 + slug.charCodeAt(i)) >>> 0;
}
const palette = PALETTES[hash % PALETTES.length];

const logoSize = {
  sm: "w-14",
  md: "w-20",
  lg: "w-24 md:w-32",
}[size];
---

<div
  class:list={["news-cover group border-border-light relative overflow-hidden border", className]}
  style={`--cover-from:${palette.from};--cover-to:${palette.to};--cover-glow:${palette.glow};--cover-from-dark:${palette.darkFrom};--cover-to-dark:${palette.darkTo}`}
>
  <!-- Colour bloom, then a fine dot grid over it. -->
  <span class="cover-glow pointer-events-none absolute -top-1/3 -right-1/4 h-2/3 w-2/3 rounded-full" aria-hidden="true"
  ></span>
  <span class="cover-dots pointer-events-none absolute inset-0" aria-hidden="true"></span>

  <div class="relative flex h-full items-start justify-end p-4 md:p-5">
    <img
      src="/gopocket-logo.svg"
      alt=""
      width="134"
      height="32"
      loading="lazy"
      decoding="async"
      class:list={[
        "h-auto opacity-90 transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100",
        logoSize,
      ]}
      aria-hidden="true"
    />
  </div>

  <span
    class="text-dark absolute top-3 left-3 z-10 rounded-md bg-white px-2.5 py-1 text-xs font-medium shadow-xs md:top-4 md:left-4 md:text-sm"
  >
    {category}
  </span>
  {href && <a href={href} class="absolute inset-0 z-20" tabindex="-1" aria-hidden="true" />}
</div>

<style>
  .news-cover {
    background-image: linear-gradient(135deg, var(--cover-from) 0%, var(--cover-to) 100%);
  }

  .cover-glow {
    background: var(--cover-glow);
    opacity: 0.28;
    filter: blur(56px);
  }

  .cover-dots {
    background-image: radial-gradient(currentColor 1px, transparent 1px);
    background-size: 16px 16px;
    color: #322b2b;
    opacity: 0.07;
  }

  /* The gradient is per-instance, so its dark variant is repointed here rather
     than through `dark:` utilities. */
  :global(html.dark) .news-cover {
    background-image: linear-gradient(135deg, var(--cover-from-dark) 0%, var(--cover-to-dark) 100%);
  }

  :global(html.dark) .cover-dots {
    color: #ffffff;
    opacity: 0.06;
  }

  :global(html.dark) .news-cover img {
    /* The mark is purple-on-transparent; lift it off the dark ground. */
    filter: brightness(1.25);
  }
</style>
