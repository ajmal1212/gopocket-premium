---
/**
 * Share buttons for a news article, in two layouts:
 *
 * - "rail": the vertical strip in the page margin left of the article on wide
 *   screens - a label then a round button per network, the buttons strung on
 *   a thin line, after the news-site pattern. It sits outside the content
 *   column and is sticky, so it stays in reach without narrowing the text.
 * - "row": the same buttons as a single line of icons, under the byline where
 *   the margin is too narrow for the rail. It adds the device's own share
 *   sheet where the browser offers one.
 *
 * Every network is a plain link to its share URL, so sharing works without
 * script; only "Copy link" and the share sheet need it. The page renders both
 * layouts and shows one per breakpoint.
 *
 * The first entry isn't a share at all: "Add us" makes GoPocket a preferred
 * source on Google (see lib/preferred-source.ts), as news sites put it first.
 *
 * Lucide carries no brand marks, so the network logos are inline SVG paths
 * (Simple Icons), as the footer's social links are. Lucide supplies the rest.
 */
import Link from "@lucide/astro/icons/link";
import Share2 from "@lucide/astro/icons/share-2";
import GoogleLogo from "@/components/news/GoogleLogo.astro";
import { preferredSourceUrl } from "@/lib/preferred-source";

interface Props {
  url: string;
  title: string;
  variant: "rail" | "row";
  class?: string;
}

const { url, title, variant, class: className = "" } = Astro.props;

const addOnGoogle = preferredSourceUrl(Astro.site ?? Astro.url);
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const networks = [
  {
    label: "WhatsApp",
    // The link alone: WhatsApp builds a preview card from the page's og tags,
    // title included, so sending the title as well printed it twice.
    href: `https://wa.me/?text=${u}`,
    color: "text-[#25D366]",
    path: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z",
  },
  {
    label: "X",
    href: `https://twitter.com/intent/tweet?text=${t}&url=${u}`,
    color: "text-dark",
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
  {
    label: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    color: "text-[#1877F2]",
    path: "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z",
  },
  {
    label: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    color: "text-[#0A66C2]",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "Telegram",
    // Link only, for the same reason - Telegram previews it like WhatsApp.
    href: `https://t.me/share/url?url=${u}`,
    color: "text-[#26A5E4]",
    path: "M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z",
  },
];

const isRail = variant === "rail";
// The round button. Its white fill sits over the rail's connecting line.
// The rail's buttons are a size up from the row's, which has to fit a phone:
// on one there, eight 36px buttons make a single line across a 375px screen
// rather than wrapping into two rows that push the article down.
const circleSize = isRail ? "h-11 w-11" : "h-9 w-9 sm:h-10 sm:w-10";
const iconSize = isRail ? "h-5 w-5" : "h-4 w-4 sm:h-[18px] sm:w-[18px]";
const circle =
  "border-border-light relative z-10 flex shrink-0 items-center justify-center rounded-full border bg-white transition-transform duration-200 group-hover:scale-110 group-hover:shadow-md motion-reduce:transition-none motion-reduce:group-hover:scale-100";
const item = isRail
  ? "group flex items-center justify-end gap-3"
  : "group flex items-center justify-center rounded-full";
// Rail labels only from 1680px: the rail hangs in the page margin, which below
// that is only wide enough for the round buttons.
// Each control carries its own aria-label, so the visible label is decorative.
const label = isRail
  ? "text-text-default group-hover:text-dark hidden text-[15px] whitespace-nowrap transition-colors min-[1680px]:inline"
  : "hidden";
---

<nav
  aria-label="Share this article"
  class:list={[isRail ? "share-rail" : "flex items-center gap-3", className]}
  data-share
  data-share-url={url}
  data-share-title={title}
>
  {!isRail && <span class="text-text-default hidden text-sm font-medium sm:inline">Share</span>}

  {/* Below sm the row never wraps; on the narrowest phones it scrolls a few pixels instead. */}
  <ul
    class:list={[
      "relative",
      isRail
        ? "flex flex-col gap-6"
        : "-m-1 flex min-w-0 flex-nowrap items-center gap-1.5 overflow-x-auto p-1 [scrollbar-width:none] sm:m-0 sm:flex-wrap sm:gap-2.5 sm:overflow-visible sm:p-0",
    ]}
  >
    {
      isRail && (
        <span
          class="bg-border-light pointer-events-none absolute top-[22px] right-[22px] bottom-[22px] w-px translate-x-1/2"
          aria-hidden="true"
        />
      )
    }

    <li>
      <a
        href={addOnGoogle}
        target="_blank"
        rel="noopener noreferrer"
        class={item}
        aria-label="Add GoPocket as a preferred source on Google"
        data-preferred-source
      >
        <span class={label} aria-hidden="true"> Add us </span>
        <span class:list={[circle, circleSize]}>
          <GoogleLogo class={iconSize} />
        </span>
      </a>
    </li>

    {
      networks.map((network) => (
        <li>
          <a
            href={network.href}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class={item}
            aria-label={`Share on ${network.label}`}
          >
            <span class={label} aria-hidden="true">
              {network.label}
            </span>
            <span class:list={[circle, circleSize]}>
              <svg class:list={["fill-current", iconSize, network.color]} viewBox="0 0 24 24" aria-hidden="true">
                <path d={network.path} />
              </svg>
            </span>
          </a>
        </li>
      ))
    }

    <li>
      <button
        type="button"
        class:list={[item, "cursor-pointer", isRail && "w-full"]}
        data-share-copy
        aria-label="Copy link"
      >
        <span class={label} aria-hidden="true"> Copy link </span>
        <span class:list={[circle, circleSize]}>
          <Link class:list={["text-dark", iconSize]} stroke-width={2} aria-hidden="true" />
        </span>
      </button>
    </li>

    {
      !isRail && (
        <li hidden data-share-native-item>
          <button
            type="button"
            class:list={[item, "cursor-pointer"]}
            data-share-native
            aria-label="More sharing options"
          >
            <span class:list={[circle, circleSize]}>
              <Share2 class:list={["text-dark", iconSize]} stroke-width={2} aria-hidden="true" />
            </span>
          </button>
        </li>
      )
    }
  </ul>
</nav>

<style>
  /* Sticky beside the article body, below the fixed site header - the same
     offset as the "Open Account" sidebar on the other side. */
  .share-rail {
    position: sticky;
    top: 7rem;
  }
</style>

<script>
  import { toast } from "@/lib/toast";
  import { bindPreferredSourceLinks } from "@/lib/preferred-source";

  bindPreferredSourceLinks();

  for (const nav of document.querySelectorAll<HTMLElement>("[data-share]")) {
    const url = nav.dataset.shareUrl ?? location.href;
    const title = nav.dataset.shareTitle ?? document.title;

    nav.querySelector("[data-share-copy]")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(url);
        toast({ title: "Link copied", message: "Paste it anywhere to share this article.", variant: "success" });
      } catch {
        toast({ title: "Couldn't copy the link", message: url, variant: "error" });
      }
    });

    // The device's own share sheet (phones, some desktops), offered only where it exists.
    const nativeItem = nav.querySelector<HTMLElement>("[data-share-native-item]");
    if (nativeItem && typeof navigator.share === "function") {
      nativeItem.hidden = false;
      nativeItem.querySelector("[data-share-native]")?.addEventListener("click", () => {
        navigator.share({ title, url }).catch(() => {
          // Dismissing the sheet rejects too; nothing to report.
        });
      });
    }
  }
</script>
