---
/**
 * DiversifyShowcase
 * -----------------------------------------------------------------------------
 * Coverflow carousel for the "don't put all your eggs in one basket" section.
 *
 * All six key visuals share one 16:9 ratio, so every slide uses the same card.
 * The active one sits square-on at full size; its neighbours scale down, rotate
 * away on a perspective stage and tuck partly behind it.
 *
 * It advances three ways, all of which coexist: a timer, the arrows and pills,
 * and scroll — walking the page past the section steps it on a product at a
 * time, and back again on the way up.
 *
 * ARTWORK
 * Sources live in public/Diversify/*.png (1672x941, ~2MB each). Those are far
 * too heavy to ship, so each one is mirrored as a 1280px WebP next to it — that
 * is what the page loads (11.3MB -> 0.72MB across the six). Regenerate with
 * sharp if the PNGs change, keeping the same names.
 */

interface Slide {
  label: string;
  blurb: string;
  img: string;
  alt: string;
}

const slides: Slide[] = [
  {
    label: "Equity",
    blurb: "Buy and hold shares across NSE and BSE with live market depth and instant order placement.",
    img: "/Diversify/equity.webp",
    alt: "Equity — own a part of tomorrow's growth, from large cap to sectoral stocks.",
  },
  {
    label: "Mutual Funds",
    blurb: "Start an SIP or invest a lump sum in direct plans — zero commission, every folio in one place.",
    img: "/Diversify/mutual-fund.webp",
    alt: "Mutual funds — direct plans, SIPs and goal-based investing on GoPocket.",
  },
  {
    label: "IPO",
    blurb: "Apply to mainboard and SME issues over UPI, then follow the allotment right through to listing.",
    img: "/Diversify/ipo.webp",
    alt: "IPO — apply to mainboard and SME public issues over UPI on GoPocket.",
  },
  {
    label: "Futures",
    blurb: "Hedge a holding or take a directional view on index and stock futures, with margins shown upfront.",
    img: "/Diversify/futures.webp",
    alt: "Futures — hedge or take a directional view on index and stock contracts.",
  },
  {
    label: "Options",
    blurb: "Read the full option chain, build multi-leg strategies and see the payoff before you place the order.",
    img: "/Diversify/options.webp",
    alt: "Options — option chain, multi-leg strategies and payoff analysis.",
  },
  {
    label: "Commodities",
    blurb: "Trade gold, silver, crude and agri contracts on MCX from the same funded account.",
    img: "/Diversify/commodity.webp",
    alt: "Commodities — gold, silver, crude and agri contracts on MCX.",
  },
];
---

<!-- No padding utilities: `main.has-section-spacing-lg > section` in global.css
     already sets the lead-in every other homepage section relies on. -->
<section class="dv-section">
  <!-- The track is the scroll length the pinned tableau is scrubbed over: one
       viewport for the tableau itself plus one step per product after the
       first, so the page does not move on until all six have had their turn.
       `--dv-steps` comes from the data, so adding a slide lengthens it. -->
  <div class="dv-track" data-dv-track style={`--dv-steps:${slides.length - 1}`}>
    <div class="dv-pin" data-dv-pin>
      <div class="container">
        <div class="mx-auto max-w-4xl text-center">
          <h2 class="has-italic-text">
            <div
              class="animated-text is-ready is-animated"
              data-duration="0.6"
              data-delay="0.2"
              data-stagger="0.09"
              style="font-weight: 600; --animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
            >
              <span class="word" style="--word-index:0">Never</span>
              <span class="word" style="--word-index:1">put</span>
              <span class="word" style="--word-index:2">all</span>
              <span class="word" style="--word-index:3">your</span>
              <span class="word" style="--word-index:4">eggs</span>
              <span class="word" style="--word-index:5">in</span><strong>
                <span class="word" style="--word-index:6">one</span>
                <span class="word" style="--word-index:7">basket!</span></strong
              >
            </div>
          </h2>
        </div>

        <div
          class="dv"
          data-dv
          data-aos="fade-up-sm"
          data-aos-delay="200"
          role="group"
          aria-roledescription="carousel"
          aria-label="GoPocket investment products"
        >
          <!-- Sits above the stage: this is the section's standfirst, and it swaps
           with the active slide. -->
          <div class="dv-captions" aria-live="polite">
            {
              slides.map((slide) => (
                <div class="dv-caption" data-dv-caption>
                  <h3 class="h5">{slide.label}</h3>
                  <p>{slide.blurb}</p>
                </div>
              ))
            }
          </div>

          <div class="dv-stage" data-dv-stage>
            {
              slides.map((slide, i) => (
                <div class="dv-slide" data-dv-slide data-pos="hidden">
                  <img
                    src={slide.img}
                    alt={slide.alt}
                    width="1280"
                    height="720"
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>

          <div class="dv-controls">
            <button type="button" class="dv-arrow" data-dv-prev aria-label="Previous product">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M15 5 8 12l7 7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>

            <div class="dv-pills">
              {
                slides.map((slide, i) => (
                  <button type="button" class="dv-pill" data-dv-pill data-index={i}>
                    {slide.label}
                  </button>
                ))
              }
            </div>

            <button type="button" class="dv-arrow" data-dv-next aria-label="Next product">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="m9 5 7 7-7 7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The flanking cards are meant to run past the container and off the edge of
     the screen. Clipping here (rather than on the stage) lets them bleed the
     full page width, while still keeping them out of the document's scroll
     width — without this the page scrolls sideways on narrow screens.
     `clip` rather than `hidden` so the y-axis stays visible for the shadows. */
  .dv-section {
    overflow-x: clip;
    overflow-y: visible;

    /* Sections on this site normally carry no bottom padding - the gap comes
       from the next section's padding-top. This one is the exception: its last
       element is the pill row, which otherwise sits flush on the boundary and
       reads as crowded against the heading below. Plain CSS rather than a
       utility class, so it cannot go missing if Tailwind's scanner misses this
       file. */
    padding-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .dv-section {
      padding-bottom: 5rem;
    }
  }

  /* ---- the pinned scrub ------------------------------------------------ */

  /* The tableau sticks to the viewport while the track scrolls past under it,
     and the script turns that travel into the active product. So a scroll down
     walks the six rather than skipping the section, and the page carries on to
     the next one only once the last is showing.

     `overflow-x: clip` on the section above is deliberate rather than
     `hidden`: clip does not make a scroll container, so it leaves this sticky
     working. Do not swap it back. */
  .dv-track {
    /* Clears the sticky header, and leaves a gap under it. */
    --dv-top: 6rem;
    /* Scroll distance per product. Tuned so a normal wheel notch does not skip
       one, but the whole section is still quick to get past. */
    --dv-step: 50vh;

    position: relative;
    height: calc(100svh - var(--dv-top) + var(--dv-steps) * var(--dv-step));
  }

  .dv-pin {
    position: sticky;
    top: var(--dv-top);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--dv-top));
    padding-block: 2rem;
  }

  /* No pin for anyone who asked for less motion: the track collapses to the
     tableau's own height and the pills and arrows are the way through. The
     script reads the collapsed track and stops driving from scroll. */
  @media (prefers-reduced-motion: reduce) {
    .dv-track {
      height: auto;
    }

    .dv-pin {
      position: static;
      min-height: 0;
      padding-block: 0;
    }
  }

  /* A laptop screen is short before it is narrow. Rather than let the height
     cap above shrink the card on every 1280x800 display, the tableau gives up
     its own slack first: less headroom, tighter margins, less padding. */
  @media (max-height: 860px) {
    .dv-track {
      --dv-top: 4.5rem;
    }

    .dv {
      --dv-chrome: 24rem;
    }

    .dv-pin {
      padding-block: 1rem;
    }

    .dv-captions {
      margin-block: 1rem 2rem;
    }

    .dv-controls {
      margin-top: 1.75rem;
    }
  }

  @media (max-width: 767px) {
    .dv-track {
      --dv-top: 4.5rem;
      /* Shorter steps: a phone's viewport is the unit here, and six 50vh steps
         is a long way to thumb past. */
      --dv-step: 38vh;
    }
  }

  .dv {
    /* What the page's width alone would allow. Breakpoints below set this and
       nothing else; the height cap underneath applies to whatever they pick. */
    --card-cap: clamp(260px, 46vw, 600px);

    /* Everything above the stage plus everything below it: the heading, the
       caption block, the pill row, and the padding the pin and the stage carry.
       An allowance, not a measurement — it only has to be close, because it
       decides when the card starts giving height back, not the layout itself.
       Retune it if the heading or the caption block changes shape. */
    --dv-chrome: 27rem;

    /* The card takes whichever runs out first — the page's width, or what is
       left of the viewport's height once the chrome has taken its share. The
       pin is a viewport tall, so without the second term a laptop screen runs
       the pill row off the bottom of the stage where nothing can scroll it back
       into view. The floor keeps it a card rather than a stamp on a very short
       window; a little overflow there is the better failure. */
    --card-w: max(260px, min(var(--card-cap), calc((100svh - var(--dv-top) - var(--dv-chrome)) * 1672 / 941)));

    /* Source ratio of the artwork — every size below is derived from it. */
    --card-h: calc(var(--card-w) * 941 / 1672);

    /* Scale of the first and second card out from centre. */
    --s1: 0.82;
    --s2: 0.66;

    /* Fractions of the centre card's width. Under half, so each neighbour
       tucks behind the active card rather than clearing it. */
    --x1: calc(var(--card-w) * 0.52);
    --x2: calc(var(--card-w) * 0.84);

    --dv-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --dv-speed: 0.7s;
  }

  /* Tablet up to a full-width desktop — the 1100 to 1300 band included. Here it
     is the flanking cards that run out of room first, not the centre one, so
     the centre gives a little back and the coverflow keeps its depth instead of
     being two slivers either side of a slab. */
  @media (min-width: 768px) and (max-width: 1399px) {
    .dv {
      --card-cap: clamp(320px, 42vw, 560px);
    }
  }

  /* ---- stage ---------------------------------------------------------- */

  .dv-stage {
    position: relative;
    height: calc(var(--card-h) + 2rem);
    perspective: 1600px;
    transform-style: preserve-3d;
  }

  .dv-slide {
    --tx: 0px;
    --sc: 1;
    --ry: 0deg;
    --op: 0;

    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--card-w);
    height: var(--card-h);
    z-index: 0;
    opacity: var(--op);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-1);
    box-shadow:
      0 2px 6px var(--shadow-soft),
      0 24px 60px -18px var(--shadow-strong);
    transform: translate(-50%, -50%) translateX(var(--tx)) rotateY(var(--ry)) scale(var(--sc));
    transition:
      transform var(--dv-speed) var(--dv-ease),
      opacity var(--dv-speed) var(--dv-ease);
    will-change: transform, opacity;
  }

  .dv-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dv-slide[data-pos="0"] {
    --tx: 0px;
    --sc: 1;
    --ry: 0deg;
    --op: 1;
    z-index: 40;
  }
  .dv-slide[data-pos="-1"] {
    --tx: calc(var(--x1) * -1);
    --sc: var(--s1);
    --ry: 16deg;
    --op: 0.85;
    z-index: 30;
  }
  .dv-slide[data-pos="1"] {
    --tx: var(--x1);
    --sc: var(--s1);
    --ry: -16deg;
    --op: 0.85;
    z-index: 30;
  }
  .dv-slide[data-pos="-2"] {
    --tx: calc(var(--x2) * -1);
    --sc: var(--s2);
    --ry: 22deg;
    --op: 0.5;
    z-index: 20;
  }
  .dv-slide[data-pos="2"] {
    --tx: var(--x2);
    --sc: var(--s2);
    --ry: -22deg;
    --op: 0.5;
    z-index: 20;
  }
  /* The odd one out — with six cards and five slots, exactly one is always
     parked behind the centre where it can't be seen. */
  .dv-slide[data-pos="hidden"] {
    --sc: 0.5;
    --op: 0;
    pointer-events: none;
  }

  /* Side cards are click-to-focus; the pills below carry the keyboard path. */
  .dv-slide:not([data-pos="0"]) {
    cursor: pointer;
  }

  /* ---- caption -------------------------------------------------------- */

  /* Stacking all six in one grid cell means the block is always as tall as the
     longest blurb, so swapping slides can't shunt the carousel up and down. */
  .dv-captions {
    display: grid;
    max-width: 38rem;
    margin: 1.25rem auto 2.75rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .dv-captions {
      margin-bottom: 3.5rem;
    }
  }

  .dv-caption {
    grid-area: 1 / 1;
    margin-inline: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--dv-ease),
      transform 0.4s var(--dv-ease),
      visibility 0.4s;
  }

  .dv-caption.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .dv-caption h3 {
    margin-bottom: 0.4rem;
    color: var(--accent-ink);
  }

  .dv-caption p {
    color: var(--fg-muted);
  }

  /* ---- controls ------------------------------------------------------- */

  .dv-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .dv-arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    border: 1px solid var(--line-strong);
    background: var(--surface-1);
    color: var(--fg);
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background-color 0.25s ease;
  }

  .dv-arrow svg {
    width: 18px;
    height: 18px;
  }

  .dv-arrow:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .dv-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .dv-pill {
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--line-strong);
    background: var(--surface-1);
    color: var(--fg-muted);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background-color 0.25s ease;
  }

  .dv-pill:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .dv-pill.is-active {
    border-color: transparent;
    background: var(--accent);
    color: var(--on-accent);
  }

  /* ---- responsive ----------------------------------------------------- */

  @media (max-width: 767px) {
    .dv {
      --card-cap: min(84vw, 440px);
      /* Less chrome to allow for: the heading is smaller, the caption margins
         are tighter and the pill row has taken the arrows onto its own line. */
      --dv-chrome: 22rem;
      /* Push the neighbours further out so they read as a peek at the screen
         edge rather than crowding a card that is already nearly full width. */
      --x1: calc(var(--card-w) * 0.66);
    }

    .dv-slide[data-pos="-2"],
    .dv-slide[data-pos="2"] {
      --op: 0;
      pointer-events: none;
    }

    .dv-captions {
      margin-bottom: 2rem;
    }

    .dv-controls {
      flex-wrap: wrap;
      margin-top: 2rem;
    }

    /* Six pills plus two arrows don't fit on one line at 360px. Give the pills
       the full width and drop the arrows underneath them. */
    .dv-pills {
      order: -1;
      width: 100%;
    }
  }

  /* Small phones. Six pills wrap to three rows here, which is most of what is
     left of the screen, so the row gets tighter type and the card gives up the
     width that buys. */
  @media (max-width: 479px) {
    .dv {
      --card-cap: min(88vw, 360px);
      --dv-chrome: 20rem;
    }

    .dv-pill {
      padding: 0.35rem 0.75rem;
      font-size: 0.8rem;
    }

    .dv-captions {
      margin-block: 0.75rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dv-slide,
    .dv-caption {
      transition-duration: 0.01ms;
    }

    /* Nothing is pinned here, so the section is as tall as it likes and the
       card has no reason to answer to the viewport's height. */
    .dv {
      --dv-chrome: 0px;
    }
  }
</style>

<script>
  type Carousel = {
    destroy: () => void;
  };

  function initDiversify(root: HTMLElement): Carousel {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-dv-slide]"));
    const captions = Array.from(root.querySelectorAll<HTMLElement>("[data-dv-caption]"));
    const pills = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dv-pill]"));
    const prev = root.querySelector<HTMLButtonElement>("[data-dv-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-dv-next]");
    const track = root.closest<HTMLElement>("[data-dv-track]");
    const pin = track?.querySelector<HTMLElement>("[data-dv-pin]") ?? null;

    const count = slides.length;

    /* Shortest gap between two slide changes. A hard flick covers several
       steps of the track at once; rather than landing on the third product and
       skipping the two in between, the carousel walks there at this pace so
       every one gets shown. A little under the 0.7s slide transition, so the
       run reads as continuous rather than stop-start. */
    const STEP_MS = 420;

    let active = 0;

    function render() {
      slides.forEach((slide, i) => {
        // Signed distance from the active slide, wrapped to the shorter way
        // round: 0 is centre, +/-1 and +/-2 are the visible flanks.
        let rel = (i - active + count) % count;
        if (rel > count / 2) rel -= count;

        const onStage = Math.abs(rel) <= 2;
        slide.dataset.pos = onStage ? String(rel) : "hidden";
        slide.setAttribute("aria-hidden", rel === 0 ? "false" : "true");
      });

      captions.forEach((caption, i) => {
        caption.classList.toggle("is-active", i === active);
      });

      pills.forEach((pill, i) => {
        const on = i === active;
        pill.classList.toggle("is-active", on);
        if (on) pill.setAttribute("aria-current", "true");
        else pill.removeAttribute("aria-current");
      });
    }

    function go(index: number) {
      const wrapped = ((index % count) + count) % count;
      if (wrapped === active) return;
      active = wrapped;
      render();
    }

    // ---- scroll scrub ----------------------------------------------------

    /* How far the tableau can travel while stuck. Zero when the pin is off —
       under prefers-reduced-motion, or before layout has settled — which is
       what every scroll-driven path below tests against. */
    function travel() {
      if (!track || !pin) return 0;
      return Math.max(0, track.offsetHeight - pin.offsetHeight);
    }

    /* The viewport offset the pin sticks at, read back from the stylesheet so
       the two cannot drift apart. */
    function stickyTop() {
      if (!pin) return 0;
      const top = parseFloat(window.getComputedStyle(pin).top);
      return Number.isFinite(top) ? top : 0;
    }

    let ticking = false;
    /* Where the track position says we should be, which is not always where we
       are — see settle(). */
    let target = 0;
    let lastStep = 0;
    let settleTimer: number | null = null;
    let primed = false;

    /* Walk to the target one product at a time, no faster than STEP_MS. This
       is what keeps a single hard scroll from changing three tabs: it still
       ends up on the third, but it plays the two in between on the way. */
    function settle() {
      if (settleTimer !== null) {
        window.clearTimeout(settleTimer);
        settleTimer = null;
      }
      if (target === active) return;

      const wait = STEP_MS - (performance.now() - lastStep);
      if (wait > 0) {
        settleTimer = window.setTimeout(settle, wait);
        return;
      }

      lastStep = performance.now();
      go(active + Math.sign(target - active));
      if (target !== active) settleTimer = window.setTimeout(settle, STEP_MS);
    }

    function readScroll() {
      ticking = false;

      const total = travel();
      if (!track || total === 0) return;

      // How far into its stuck travel the tableau is, 0 to 1.
      const scrolled = stickyTop() - track.getBoundingClientRect().top;
      const p = Math.min(1, Math.max(0, scrolled / total));

      // Even dwell per product: the last one holds the final 1/count of the
      // track, which is the stretch that runs on into the next section.
      target = Math.min(count - 1, Math.floor(p * count));

      // Landing mid-section — a reload part-way down, or a jump to an anchor
      // below it — should show that product, not animate up to it from the
      // first. Only scrolling from here on is paced.
      if (!primed) {
        primed = true;
        lastStep = performance.now();
        go(target);
        return;
      }

      settle();
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(readScroll);
    }

    /* Arrows, pills and the flanking cards drive the page rather than the
       carousel while it is pinned — moving the slide on its own would only be
       undone by the next scroll event. Off the pin they just switch slide. */
    function jump(index: number) {
      const wrapped = ((index % count) + count) % count;
      const total = travel();

      if (!track || total === 0) {
        target = wrapped;
        go(wrapped);
        return;
      }

      // Land in the middle of that product's stretch of the track.
      const trackTop = window.scrollY + track.getBoundingClientRect().top;
      window.scrollTo({
        top: trackTop - stickyTop() + (total * (wrapped + 0.5)) / count,
        behavior: "smooth",
      });
    }

    prev?.addEventListener("click", () => jump(active - 1));
    next?.addEventListener("click", () => jump(active + 1));
    pills.forEach((pill, i) => pill.addEventListener("click", () => jump(i)));
    slides.forEach((slide, i) =>
      slide.addEventListener("click", () => {
        if (slide.dataset.pos !== "0") jump(i);
      }),
    );

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    render();
    readScroll();

    return {
      destroy() {
        if (settleTimer !== null) window.clearTimeout(settleTimer);
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
      },
    };
  }

  document.querySelectorAll<HTMLElement>("[data-dv]").forEach((root) => initDiversify(root));
</script>
