---
// KeyInsights2 Component
---

<section>
  <div class="bg-theme-light py-20 md:py-32">
    <div class="container">
      <div class="grid-cols-1 space-y-10 md:grid lg:grid-cols-2 xl:grid-cols-3 xl:space-y-0">
        <div
          class="mx-auto flex justify-center text-center max-md:flex-wrap md:gap-x-20 md:text-start lg:mt-10 lg:block"
        >
          <h2 class="has-italic-text mb-4 capitalize">
            <div
              data-duration="0.6"
              data-delay="0.2"
              data-stagger="0.09"
              data-astro-cid-3rbjsbju="true"
              class="animated-text"
            >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Key</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Insights</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Track</span
              >
              <br />
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Your</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Financial</span
              >
              <strong
                ><span
                  class="word"
                  style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                  >System</span
                ></strong>
            </div>
          </h2>
          <div>
            <p
              data-duration="0.7"
              data-delay="0.5"
              data-stagger="0.0009"
              class="mb-11 lg:mb-11 animated-text mb-11 lg:mb-11"
              data-astro-cid-3rbjsbju="true"
            >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Effortlessly</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Manage,</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >and</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Optimize</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Your</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Personal</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >and</span
              >
              <br />
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Business</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Finances.</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Your</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Comprehensive</span
              >
              <span
                class="word"
                style="display: inline-block; will-change: transform; transform: translateY(10px); opacity: 0; filter: blur(10px);"
                >Companion.</span>
            </p>
            <div data-aos="fade-up-sm" data-aos-delay="300" class="aos-init">
              <a
                rel="noopener noreferrer"
                target="_blank"
                class="btn btn-primary text-flip-hover-anim"
                href="https://external.com"
                ><span class="text-flip-inner" data-content="GET THE APP NOW">GET THE APP NOW</span></a
              >
            </div>
          </div>
        </div>
        <div class="space-y-10 gap-x-8 md:grid md:grid-cols-2 *:even:md:mt-12 xl:col-span-2 xl:ps-48">
          <div
            data-aos-delay="400"
            data-aos="reveal-anim-down"
            class="flex flex-col space-y-4 rounded-t-4xl bg-linear-to-b from-white to-transparent px-8 pt-12 aos-init"
          >
            <div class="mb-10 flex items-center gap-3">
              <div class="bg-secondary/10 flex h-14 w-14 items-center justify-center rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  data-lucide="CircleDashed"
                  class="text-secondary mx-auto block h-6 w-6"
                  ><path d="M10.1 2.182a10 10 0 0 1 3.8 0"></path><path d="M13.9 21.818a10 10 0 0 1-3.8 0"></path><path
                    d="M17.609 3.721a10 10 0 0 1 2.69 2.7"></path><path d="M2.182 13.9a10 10 0 0 1 0-3.8"></path><path
                    d="M20.279 17.609a10 10 0 0 1-2.7 2.69"></path><path d="M21.818 10.1a10 10 0 0 1 0 3.8"></path><path
                    d="M3.721 6.391a10 10 0 0 1 2.7-2.69"></path><path d="M6.391 20.279a10 10 0 0 1-2.69-2.7"
                  ></path></svg
                >
              </div>
              <span>Satisfaction</span>
            </div>
            <h3 class="mb-4">
              <div class="inline-flex place-items-stretch leading-none has-animated-number text-dark h2">
                <span data-count="80" style="" class="odometer odometer-auto-theme"
                  ><div class="odometer-inside">
                    <span class="odometer-digit"
                      ><span class="odometer-digit-spacer">8</span><span class="odometer-digit-inner"
                        ><span class="odometer-ribbon"
                          ><span class="odometer-ribbon-inner"><span class="odometer-value">0</span></span></span
                        ></span
                      ></span>
                  </div></span
                >
                <span class="append">%</span>
              </div>
              <span class="h4 text-text-default">of Users</span>
            </h3>
            <p>Improved their savings within the first three months.</p>
          </div><div
            data-aos-delay="400"
            data-aos="reveal-anim-up"
            class="flex flex-col space-y-4 rounded-t-4xl bg-linear-to-b from-white to-transparent px-8 pt-12 aos-init"
          >
            <div class="mb-10 flex items-center gap-3">
              <div class="bg-secondary/10 flex h-14 w-14 items-center justify-center rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  data-lucide="MessagesSquare"
                  class="text-secondary mx-auto block h-6 w-6"
                  ><path
                    d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"
                  ></path><path
                    d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1"
                  ></path></svg
                >
              </div>
              <span>Feedbacks</span>
            </div>
            <h3 class="mb-4">
              <div class="inline-flex place-items-stretch leading-none has-animated-number text-dark h2">
                <span data-count="500" style="" class="odometer odometer-auto-theme"
                  ><div class="odometer-inside">
                    <span class="odometer-digit"
                      ><span class="odometer-digit-spacer">8</span><span class="odometer-digit-inner"
                        ><span class="odometer-ribbon"
                          ><span class="odometer-ribbon-inner"><span class="odometer-value">0</span></span></span
                        ></span
                      ></span>
                  </div></span
                >
                <span class="append">k</span>
              </div>
              <span class="h4 text-text-default">reviews</span>
            </h3>
            <p>Highlighting our app’s effectiveness and ease of use.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
