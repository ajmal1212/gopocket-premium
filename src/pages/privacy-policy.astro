---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Privacy Policy - Multipurpose Saas & Startup Astro Js Theme" description="This is a example description">
  <Header currentPath="/privacy-policy/" />
  <main class="has-section-spacing-lg">
    <div
      class="page-loader pointer-events-none fixed bottom-0 left-0 z-50 size-full bg-white transition duration-300 [.inactive]:opacity-0 inactive"
    >
      <script type="module" is:inline>
        const e = document.querySelector(".page-loader");
        document.addEventListener("DOMContentLoaded", () => {
          e &&
            setTimeout(() => {
              e.classList.add("inactive");
            }, 100);
        });
      </script>
    </div>
    <main class="has-section-spacing-lg">
      <section class="relative z-10 mt-0 py-14 md:pt-32 md:pb-24">
        <div class="container">
          <div class="flex max-w-6xl flex-wrap justify-between gap-5 md:gap-10 md:px-8 lg:px-12 ms-5 me-5 md:mx-auto">
            <h1 class="has-italic-text text-h2 max-w-lg capitalize">Privacy Policy</h1>
          </div>
        </div>
      </section>
      <section
        class="after:bg-theme-light pt-0 after:pointer-events-none after:absolute after:top-0 after:left-0 after:-z-10 after:h-250 after:w-full after:content-['']"
      >
        <div class="container">
          <div class="box-shadow-black mx-auto max-w-6xl space-y-16 rounded-xl bg-white p-8 md:p-12">
            <div class="prose-styles content has-video-modal">
              <p>Effective Date: July, 2022</p>
              <p>
                Welcome to Stella (“we,” “our,” or “us”). Your privacy is important to us, and we are committed to
                protecting the personal information you share with us. This Privacy Policy explains how we collect, use,
                and safeguard your information when you visit our website, <a
                  href="https://www.stella.com"
                  rel="noopener noreferrer nofollow"
                  target="_blank">https://www.stella.com</a
                > (“Website”).
              </p>
              <h3 id="information-we-collect">Information We Collect</h3>
              <p>We collect two types of information from you:</p>
              <ul>
                <li>
                  <p><strong>Personal Information:</strong></p>
                  <ul>
                    <li>Name</li>
                    <li>Email address</li>
                    <li>Billing information (e.g., credit card details)</li>
                    <li>Any information you provide voluntarily through forms, surveys, or account creation</li>
                  </ul>
                </li>
                <li>
                  <p><strong>Non-Personal Information:</strong></p>
                  <ul>
                    <li>IP address</li>
                    <li>Browser type</li>
                    <li>Operating system</li>
                    <li>Pages visited and time spent on our site</li>
                    <li>Referring website</li>
                  </ul>
                </li>
              </ul>
              <h3 id="how-we-use-your-information">How We Use Your Information</h3>
              <p>We use the information we collect for the following purposes:</p>
              <ul>
                <li>To provide and improve our services</li>
                <li>To process transactions and send receipts</li>
                <li>To send you updates, promotions, and service-related communications</li>
                <li>To personalize your experience on our Website</li>
                <li>To comply with legal obligations</li>
                <li>To detect and prevent fraudulent activity</li>
              </ul>
              <h3 id="cookies-and-tracking-technologies">Cookies and Tracking Technologies</h3>
              <p>
                We use cookies and similar tracking technologies to enhance your experience on our Website. These
                include:
              </p>
              <ul>
                <li><strong>Essential Cookies:</strong> Required for the operation of our Website.</li>
                <li><strong>Performance Cookies:</strong> Help us understand how you use our site.</li>
                <li><strong>Marketing Cookies:</strong> Track your browsing behavior for targeted advertising.</li>
              </ul>
              <p>You can control cookies through your browser settings.</p>
              <h3 id="sharing-of-information">Sharing of Information</h3>
              <p>
                We do not sell, rent, or trade your personal information. However, we may share your information with:
              </p>
              <ul>
                <li>
                  <strong>Service Providers:</strong> Third-party companies that help us operate our Website and provide services.
                </li>
                <li><strong>Legal Authorities:</strong> When required by law or to protect our rights and property.</li>
                <li><strong>Business Transfers:</strong> In case of a merger, acquisition, or sale of assets.</li>
              </ul>
              <h3 id="data-security">Data Security</h3>
              <p>
                We implement industry-standard security measures to protect your data. However, no method of
                transmission over the Internet or electronic storage is 100% secure. While we strive to use commercially
                acceptable means to protect your personal information, we cannot guarantee absolute security.
              </p>
              <h3 id="your-rights">Your Rights</h3>
              <p>Depending on your location, you may have the following rights regarding your personal information:</p>
              <ul>
                <li>Access your data</li>
                <li>Correct or update your data</li>
                <li>Request deletion of your data</li>
                <li>Restrict processing of your data</li>
                <li>Withdraw consent for data usage</li>
              </ul>
              <p>
                To exercise your rights, please contact us at <a href="mailto:privacy@stella.com">privacy@stella.com</a
                >.
              </p>
              <h3 id="third-party-links">Third-Party Links</h3>
              <p>
                Our Website may contain links to third-party websites. We are not responsible for the privacy practices
                of these websites. We encourage you to review their privacy policies before providing any personal
                information.
              </p>
              <h3 id="childrens-privacy">Children’s Privacy</h3>
              <p>
                Our Website is not intended for individuals under the age of 13. We do not knowingly collect personal
                information from children under 13. If you believe we have collected such information, please contact us
                immediately.
              </p>
              <h3 id="changes-to-this-privacy-policy">Changes to This Privacy Policy</h3>
              <p>
                We may update this Privacy Policy from time to time. Any changes will be posted on this page with an
                updated “Effective Date.” We encourage you to review this Privacy Policy periodically.
              </p>
              <h3 id="contact-us">Contact Us</h3>
              <p>If you have any questions or concerns about this Privacy Policy, please contact us at:</p>
              <p>
                Stella Email: <a href="mailto:privacy@stella.com">privacy@stella.com</a>
                Address: 123 Stella Lane, Imaginary City, IC 12345, USA
              </p>
              <p>Thank you for trusting Stella with your personal information!</p>
            </div>
          </div>
        </div>
      </section>
      <section class="call-to-action overflow-hidden">
        <div class="relative container py-20 md:py-40">
          <div class="mx-auto space-y-8 text-center lg:max-w-3xl">
            <h2
              class="has-italic-text text-display-3 md:text-display-2 mb-8 text-center leading-[1.15] font-normal capitalize"
            >
              <div
                class="animated-text is-ready"
                data-duration="0.6"
                data-delay="0.2"
                data-stagger="0.09"
                style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
              >
                <span class="word" style="--word-index:0">Get</span>
                <span class="word" style="--word-index:1">Started</span>
                <span class="word" style="--word-index:2">and</span>
                <span class="word" style="--word-index:3">Streamline</span>
                <span class="word" style="--word-index:4">Your</span>
                <span class="word" style="--word-index:5"><strong>Workflow</strong></span><strong>
                  <span class="word" style="--word-index:6">Today</span></strong>
              </div>
              <script type="module" is:inline>
                const r = document.querySelectorAll(".animated-text");
                if (window.matchMedia("(max-width: 767px)").matches)
                  r.forEach((t) => {
                    t.querySelectorAll(".word").forEach((e) => {
                      ((e.style.opacity = "1"), (e.style.filter = "none"), (e.style.transform = "none"));
                    });
                  });
                else {
                  const t = new IntersectionObserver(
                    (e, a) => {
                      e.forEach((s) => {
                        s.isIntersecting && (s.target.classList.add("is-animated"), a.unobserve(s.target));
                      });
                    },
                    { threshold: 0.1 },
                  );
                  r.forEach((e) => {
                    (e.classList.add("is-ready"), t.observe(e));
                  });
                }
              </script>
            </h2>
            <div
              data-aos="fade-down-sm"
              data-aos-delay="100"
              class="mx-auto max-w-2xl space-y-1 text-center *:first:text-lg *:first:font-medium *:last:opacity-80 aos-init"
            >
              <p>No credit card required. Cancel anytime</p>
              <p>Enjoy a 14-day free trial — experience every feature, risk-free.</p>
            </div>
            <div data-aos="fade-down-sm" data-aos-delay="200" class="aos-init">
              <a class="btn btn-primary text-flip-hover-anim btn-md btn-primary" href="/contact/"
                ><span class="text-flip-inner" data-content="GET A FREE DEMO">GET A FREE DEMO</span><span
                  class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                  ><svg
                    class="gradient-shape"
                    width="150"
                    height="28"
                    viewBox="0 0 147 11"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    ><path
                      d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                      stroke="currentColor"
                      stroke-width="8"></path></svg
                  ></span
                ></a
              >
            </div>
          </div>
          <div
            class="pattern-shape pointer-events-none absolute top-0 left-0 -z-10 flex h-full w-[150%] opacity-40 select-none"
            style="transform: translateX(-1000px);"
          >
            <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div>
          </div>
        </div>
        <div
          class="pattern-shape pointer-events-none absolute top-0 left-0 -z-10 flex h-full w-[150%] opacity-40 select-none"
          style="transform: translateX(-1000px);"
        >
          <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div>
        </div>
      </section>
    </main>
  </main>
  <div
    id="action-buttons"
    class="pointer-events-none fixed right-0 bottom-5 z-100 flex flex-col space-y-2 rounded-lg bg-white p-2 text-center opacity-0 transition-all duration-300 [.scroll-down]:pointer-events-auto [.scroll-down]:right-5 [.scroll-down]:opacity-100"
  >
    <a
      rel="noopener noreferrer"
      target="_blank"
      class="btn btn-primary text-flip-hover-anim"
      href="https://getastrothemes.com/astro-themes/stella/?initiate-checkout=true&utm_source=direct"
      id="buy-now-stella"
      data-umami-event="buy-now-stella"
      ><span class="text-flip-inner" data-content="Buy Now">Buy Now</span><span
        class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
        ><svg
          class="gradient-shape"
          width="150"
          height="28"
          viewBox="0 0 147 11"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
            stroke="currentColor"
            stroke-width="8"></path></svg
        ></span
      ></a
    >
    <a
      rel="noopener noreferrer"
      target="_blank"
      class="btn btn-outline text-flip-hover-anim"
      href="https://getastrothemes.com/astro-themes/stella/?utm_source=direct"
      id="buy-now-stella"
      data-umami-event="buy-now-stella"
      ><span class="text-flip-inner" data-content="Theme Details">Theme Details</span><span
        class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
        ><svg
          class="gradient-shape"
          width="150"
          height="28"
          viewBox="0 0 147 11"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
            stroke="currentColor"
            stroke-width="8"></path></svg
        ></span
      ></a
    >
  </div>
  <script type="module" is:inline>
    function c() {
      try {
        return window.self !== window.top;
      } catch {
        return !0;
      }
    }
    if (!c()) {
      const t = document.getElementById("action-buttons");
      t &&
        (t.classList.remove("hidden"),
        window.addEventListener("scroll", () => {
          const o = window.scrollY,
            e = window.innerHeight,
            r = document.documentElement.scrollHeight - (o + e);
          (o >= 500 && t.classList.add("scroll-down"), (o <= 500 || r <= 100) && t.classList.remove("scroll-down"));
        }),
        (() => {
          const o = "checkout-ref";
          let e = localStorage.getItem(o);
          (e || ((e = document.referrer || "direct"), e && localStorage.setItem(o, e)),
            e &&
              t.querySelectorAll("a").forEach((n) => {
                const r = n.href.includes("?") ? "&" : "?";
                n.href += `${r}utm_source=${encodeURIComponent(e)}`;
              }));
        })());
    }
  </script>
</Layout>
<Footer />
