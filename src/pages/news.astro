---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import NewsCover from "@/components/news/NewsCover.astro";
import BlogThumb from "@/components/blog/BlogThumb.astro";
import BlogMeta from "@/components/blog/BlogMeta.astro";
import BlogReadMore from "@/components/blog/BlogReadMore.astro";
import { getNewsList } from "../lib/frappe";

// Newest article leads, the next three stack beside it, and the rest fill the
// grid - the same shape as /blog, with generated covers instead of images.
const articles = await getNewsList(20, true);
const leadArticle = articles[0] ?? null;
const sideArticles = articles.slice(1, 4);
const gridArticles = articles.slice(4);

const SITE = Astro.site?.origin ?? Astro.url.origin;
const newsUrl = `${SITE}/news`;

const newsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "GoPocket News",
  description: "IPO updates, market moves and regulatory changes, explained for Indian investors.",
  url: newsUrl,
  inLanguage: "en",
  publisher: {
    "@type": "Organization",
    name: "GoPocket",
    url: `${SITE}/`,
    logo: { "@type": "ImageObject", url: `${SITE}/gopocket-logo.svg` },
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: articles.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${newsUrl}/${article.slug}`,
      name: article.title,
    })),
  },
};

const newsBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "News", item: newsUrl },
  ],
};
---

<Layout
  title="Stock Market News Today - IPO, Market & Regulatory Updates | GoPocket"
  description="Today's stock market news for Indian investors: IPO price bands and GMP, listing updates, market moves and regulatory changes, explained simply by GoPocket."
  canonical="/news"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(newsSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(newsBreadcrumbSchema)} />
  </Fragment>
  <Header currentPath="/news" />
  <main class="has-section-spacing-lg pt-8 md:pt-16">
    <h1 class="sr-only">GoPocket News - IPO, Market &amp; Regulatory Updates</h1>

    {
      articles.length === 0 && (
        <section class="container pt-0!">
          <div class="bg-theme-light border-border-light rounded-3xl border py-16 text-center text-gray-500">
            <p class="text-lg font-medium">No news articles found at the moment.</p>
            <p class="mt-1 text-sm">Please check back soon for the latest market updates.</p>
          </div>
        </section>
      )
    }

    {
      leadArticle && (
        <section class="container pt-0!">
          <div class="mx-auto max-w-6xl">
            <h2 class="text-black! dark:text-white! text-h4 font-bold tracking-tight md:text-h3">Recent News</h2>
            <div class="mt-8 grid gap-10 md:mt-10 lg:grid-cols-2 lg:gap-16 xl:gap-20">
              <article class="flex flex-col">
                {leadArticle.mainImage ? (
                  <BlogThumb
                    href={`/news/${leadArticle.slug}`}
                    src={leadArticle.mainImage}
                    category={leadArticle.category}
                    width={1150}
                    height={500}
                    eager
                    class="aspect-[23/10] rounded-3xl"
                  />
                ) : (
                  <NewsCover
                    href={`/news/${leadArticle.slug}`}
                    category={leadArticle.category}
                    slug={leadArticle.slug}
                    size="lg"
                    class="aspect-[23/10] rounded-3xl"
                  />
                )}
                <h2 class="text-black! dark:text-white! mt-6 text-[26px]! leading-tight font-bold tracking-tight md:text-[36px]!">
                  <a href={`/news/${leadArticle.slug}`} class="text-inherit! hover:text-primary! transition-colors">
                    {leadArticle.title}
                  </a>
                </h2>
                <BlogMeta
                  class="mt-4"
                  author="GoPocket"
                  date={leadArticle.formattedDate}
                  datetime={leadArticle.publishedISO}
                  readingMinutes={leadArticle.readingMinutes}
                />
                <BlogReadMore
                  class="mt-7 self-start"
                  variant="solid"
                  href={`/news/${leadArticle.slug}`}
                  title={leadArticle.title}
                />
              </article>

              {sideArticles.length > 0 && (
                <div class="flex flex-col gap-8 lg:gap-10">
                  {sideArticles.map((article) => (
                    <article class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] items-start gap-4 sm:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] sm:gap-7">
                      {article.thumbnailImage ? (
                        <BlogThumb
                          href={`/news/${article.slug}`}
                          src={article.thumbnailImage}
                          category={article.category}
                          width={640}
                          height={550}
                          class="aspect-[4/3] rounded-2xl"
                        />
                      ) : (
                        <NewsCover
                          href={`/news/${article.slug}`}
                          category={article.category}
                          slug={article.slug}
                          size="sm"
                          class="aspect-[4/3] rounded-2xl"
                        />
                      )}
                      <div class="flex flex-col">
                        <h2 class="text-black! dark:text-white! line-clamp-3 text-xl! leading-snug font-bold tracking-tight sm:text-2xl! xl:text-[28px]!">
                          <a href={`/news/${article.slug}`} class="text-inherit! hover:text-primary! transition-colors">
                            {article.title}
                          </a>
                        </h2>
                        <BlogMeta
                          class="mt-3 sm:mt-4"
                          date={article.formattedDate}
                          datetime={article.publishedISO}
                          readingMinutes={article.readingMinutes}
                        />
                        <BlogReadMore
                          class="mt-4 self-start sm:mt-6"
                          href={`/news/${article.slug}`}
                          title={article.title}
                        />
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    {
      gridArticles.length > 0 && (
        <section class="container mt-16 md:mt-24">
          <div class="mx-auto max-w-6xl">
            <h2 class="text-black! dark:text-white! text-h4 font-bold tracking-tight md:text-h3">More News</h2>
            <div class="mt-8 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:gap-x-12 lg:gap-y-16 lg:grid-cols-3 md:mt-10">
              {gridArticles.map((article) => (
                <article class="flex flex-col">
                  {article.thumbnailImage ? (
                    <BlogThumb
                      href={`/news/${article.slug}`}
                      src={article.thumbnailImage}
                      category={article.category}
                      width={640}
                      height={550}
                      class="aspect-[7/5] rounded-2xl"
                    />
                  ) : (
                    <NewsCover
                      href={`/news/${article.slug}`}
                      category={article.category}
                      slug={article.slug}
                      class="aspect-[7/5] rounded-2xl"
                    />
                  )}
                  <h3 class="text-black! dark:text-white! mt-4 line-clamp-2 text-[26px]! leading-snug md:text-[32px]! font-bold tracking-tight">
                    <a href={`/news/${article.slug}`} class="text-inherit! hover:text-primary! transition-colors">
                      {article.title}
                    </a>
                  </h3>
                  <BlogMeta
                    class="mt-3"
                    date={article.formattedDate}
                    datetime={article.publishedISO}
                    readingMinutes={article.readingMinutes}
                  />
                  <BlogReadMore class="mt-5 self-start" href={`/news/${article.slug}`} title={article.title} />
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Final Call to Action -->
    <FinalCTA />
  </main>
  <Footer />
</Layout>
