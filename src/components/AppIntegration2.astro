          /><img
            src="/assets/images/integration-microsoft-teams.webp"
            alt="Microsoft Teams"
            loading="lazy"
            decoding="async"
            data-astro-image="constrained"
            data-astro-image-fit="cover"
            data-astro-image-pos="center"
