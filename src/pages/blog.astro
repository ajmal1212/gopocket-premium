---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { getBlogPosts } from "../lib/frappe";

// Fetch blog collection from Frappe with limit = 20 (without post_body)
const posts = await getBlogPosts(20);
const featuredPost = posts.length > 0 ? posts[0] : null;
const regularPosts = posts.length > 1 ? posts.slice(1) : posts;
---

<Layout
  title="GoPocket Blog - Trading Insights, Algo Trading & Financial News"
  description="Discover practical tips, algo trading insights, options strategies, and market news designed to help you trade smarter."
>
  <Header currentPath="/blog/" />
  <main class="has-section-spacing-lg">
    <!-- Page Header Section -->
    <section class="relative z-10 mt-0 py-14 md:pt-32 md:pb-20">
      <div class="container">
        <div class="flex max-w-6xl flex-wrap justify-between gap-5 md:gap-10 md:px-8 lg:px-12 mx-auto">
          <h1 class="has-italic-text text-h2 max-w-lg capitalize">
            Learn, Trade &amp; Scale <br />
            <strong>Smarter</strong>
          </h1>
          <p class="md:max-w-sm text-text-default opacity-85 leading-relaxed">
            Discover practical tips, algo trading insights, options strategies, and market news designed to help you trade smarter.
          </p>
        </div>
      </div>
      <div class="bg-theme-light pointer-events-none absolute left-0 -z-10 h-250 w-full bottom-0"></div>
    </section>

    <!-- Featured Top Post -->
    {featuredPost && (
      <section>
        <div class="container">
          <article class="bg-theme-light rounded-4xl p-6 md:p-8 flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-10 border border-border-light shadow-xs hover:border-black/20 transition-all duration-300">
            <div class="group relative flex items-center justify-center overflow-hidden rounded-3xl w-full md:w-1/2 aspect-video shrink-0 border border-border-light bg-white">
              <img
                src={featuredPost.thumbnailImage}
                alt={featuredPost.title}
                loading="lazy"
                class="w-full h-full object-cover rounded-3xl transition duration-500 group-hover:scale-105"
              />
              <a class="absolute inset-0 z-30" href={`/blog/${featuredPost.slug}/`}>
                <span class="sr-only">Read {featuredPost.title}</span>
              </a>
            </div>
            <div class="space-y-4 w-full md:w-1/2">
              <div class="font-primary text-text-default flex flex-wrap items-center gap-x-2.5 gap-y-px text-sm font-medium">
                <span>{featuredPost.formattedDate}</span>
                <span class="bg-dark inline-block h-1.5 w-1.5 rounded-full"></span>
                <span class="text-primary font-semibold uppercase">{featuredPost.category}</span>
              </div>
              <h2 class="md:text-h3 text-2xl font-bold text-dark leading-snug">
                <a href={`/blog/${featuredPost.slug}/`} class="hover:text-primary transition-colors">
                  {featuredPost.title}
                </a>
              </h2>
              <p class="text-text-default opacity-85 text-base md:text-lg line-clamp-3">
                {featuredPost.description}
              </p>
              <a
                class="btn btn-outline text-flip-hover-anim btn-sm btn-outline-white mt-3 capitalize inline-flex cursor-pointer"
                href={`/blog/${featuredPost.slug}/`}
              >
                <span class="text-flip-inner" data-content="Read Article">Read Article</span>
                <span class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]">
                  <svg class="gradient-shape" width="150" height="28" viewBox="0 0 147 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433" stroke="currentColor" stroke-width="8"></path>
                  </svg>
                </span>
              </a>
            </div>
          </article>
        </div>
      </section>
    )}

    <!-- Blog Posts Grid -->
    <section class="mt-12 md:mt-16">
      <div class="container space-y-10 md:space-y-16">
        {posts.length === 0 ? (
          <div class="text-center py-16 bg-theme-light rounded-3xl border border-border-light text-gray-500">
            <p class="text-lg font-medium">No blog articles found at the moment.</p>
            <p class="text-sm mt-1">Please check back soon for fresh market insights.</p>
          </div>
        ) : (
          <div class="grid gap-x-6 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
            {regularPosts.map((post) => (
              <article class="bg-theme-light rounded-3xl p-6 border border-border-light hover:border-black/20 transition-all duration-300 shadow-xs flex flex-col justify-between">
                <div>
                  <div class="group relative flex items-center justify-center overflow-hidden rounded-2xl aspect-video bg-white border border-border-light">
                    <img
                      src={post.thumbnailImage}
                      alt={post.title}
                      loading="lazy"
                      class="w-full h-full object-cover rounded-2xl transition duration-500 group-hover:scale-105"
                    />
                    <a class="absolute inset-0 z-30" href={`/blog/${post.slug}/`}>
                      <span class="sr-only">Read {post.title}</span>
                    </a>
                  </div>
                  <div class="space-y-3 mt-5">
                    <div class="font-primary text-text-default flex flex-wrap items-center gap-x-2.5 gap-y-px text-xs font-medium">
                      <span>{post.formattedDate}</span>
                      <span class="bg-dark inline-block h-1 w-1 rounded-full"></span>
                      <span class="text-primary font-semibold uppercase">{post.category}</span>
                    </div>
                    <h3 class="text-xl font-bold text-dark leading-snug line-clamp-2">
                      <a href={`/blog/${post.slug}/`} class="hover:text-primary transition-colors">
                        {post.title}
                      </a>
                    </h3>
                    <p class="text-text-default opacity-80 text-sm line-clamp-3">
                      {post.description}
                    </p>
                  </div>
                </div>
                <div class="pt-5 mt-4 border-t border-border-light/60">
                  <a
                    class="btn btn-outline text-flip-hover-anim btn-sm btn-outline-white capitalize inline-flex cursor-pointer"
                    href={`/blog/${post.slug}/`}
                  >
                    <span class="text-flip-inner" data-content="Read Article">Read Article</span>
                    <span class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]">
                      <svg class="gradient-shape" width="150" height="28" viewBox="0 0 147 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433" stroke="currentColor" stroke-width="8"></path>
                      </svg>
                    </span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Final Call to Action -->
    <FinalCTA />
  </main>
  <Footer />
</Layout>
