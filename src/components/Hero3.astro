---
// Hero3 Component - Trading & Investment Hero Section with Dual Side-by-Side Mobile Mockups
---

<section class="relative overflow-hidden bg-linear-to-b from-gray-50/80 via-white to-gray-50/50 pt-6 md:pt-10 lg:pt-12 pb-12 md:pb-20 lg:pb-24">
  <!-- Line Background Shapes from finzo assets -->
  <img
    src="/assets/finzo-astro.pages.dev/line.DQ4BRe5A_DbJG7-1f4199dc.svg"
    alt="Background Vector"
    loading="lazy"
    decoding="async"
    width="937"
    height="1360"
    class="absolute top-[10%] -left-36 -z-10 hidden h-100 w-212.5 rotate-[-40deg] opacity-15 md:block md:h-300 md:opacity-5 pointer-events-none"
  />
  <img
    src="/assets/finzo-astro.pages.dev/line.DQ4BRe5A_DbJG7-1f4199dc.svg"
    alt="Background Vector"
    loading="lazy"
    decoding="async"
    width="937"
    height="1360"
    class="absolute top-[20%] -right-40 -z-10 hidden h-100 w-212.5 rotate-60 opacity-15 md:block md:h-280 md:opacity-5 pointer-events-none"
  />

  <!-- Banner Gradient Overlays from finzo assets -->
  <img
    src="/assets/finzo-astro.pages.dev/bannerGradient.BMr9_nty_Z1zpt0F-bf6a81a0.svg"
    alt=""
    loading="lazy"
    decoding="async"
    width="791"
    height="1006"
    class="absolute bottom-0 left-0 -z-10 h-128 opacity-60 pointer-events-none"
  />
  <img
    src="/assets/finzo-astro.pages.dev/bannerGradientTwo.DeSxnqjA_2ebFTO-36c2b18a.svg"
    alt=""
    loading="lazy"
    decoding="async"
    width="638"
    height="975"
    class="absolute right-0 top-0 -z-10 hidden h-175 w-auto opacity-50 md:block pointer-events-none"
  />

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      
      <!-- LEFT COLUMN: Content & Form -->
      <div class="space-y-8 lg:col-span-6 xl:col-span-6">
        
        <!-- Animated Badge: New | Open Account in 5 Min -->
        <div
          data-aos="fade-up"
          data-aos-delay="100"
          class="group relative max-w-fit overflow-hidden rounded-full border p-px"
        >
          <div
            class="translate-y-centered to-primary absolute left-1/2 -z-10 h-6 w-1/2 origin-left rotate-90 animate-spin rounded-full bg-linear-to-b from-white [animation-duration:10000ms]"
          >
          </div>
          <div class="flex items-center rounded-full bg-white px-1 py-0.5">
            <span class="bg-dark inline-block gap-1 rounded-full px-3 py-1 text-xs md:text-sm font-normal text-white">New</span>
            <div class="text-text-default ms-3 flex items-center rounded-full py-px text-xs md:text-sm font-normal pr-2">
              Open Account in 5 Min
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-4 h-4 ms-1 transition duration-300 group-hover:translate-x-0.5"
              >
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </div>
            <a title="Open Account in 5 Min" class="absolute inset-0 size-full" href="/contact"></a>
          </div>
        </div>

        <!-- Main Title -->
        <div data-aos="fade-up" data-aos-delay="200" class="space-y-3">
          <h1 class="has-italic-text text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-gray-900 leading-[1.12]">
            Built for every <strong class="text-primary font-serif italic">Trader.</strong><br />
            Designed for every investor.
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-gray-600 font-normal leading-relaxed max-w-xl pt-2">
            Powerful tools, seamless execution, and smarter insights for every market move.
          </p>
        </div>

        <!-- Phone Input & CTA Form -->
        <div data-aos="fade-up" data-aos-delay="300" class="pt-2">
          <form class="flex flex-col sm:flex-row items-stretch gap-3 max-w-lg" onsubmit="event.preventDefault()">
            <div class="relative flex-1">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
              </div>
              <input
                type="tel"
                placeholder="Enter your phone number"
                class="w-full pl-11 pr-4 py-3.5 bg-white border border-gray-300 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base transition-all shadow-xs"
                required
              />
            </div>
            <button
              type="submit"
              class="bg-black text-white hover:bg-gray-800 px-7 py-3.5 rounded-xl font-medium text-base flex items-center justify-center gap-2 whitespace-nowrap transition-all shadow-md cursor-pointer hover:shadow-lg active:scale-98"
            >
              <span>Start Trading Now</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
        </div>

        <!-- Trust Metrics Row -->
        <div data-aos="fade-up" data-aos-delay="400" class="grid grid-cols-3 gap-3 sm:gap-6 pt-6 border-t border-gray-200/80">
          <!-- Metric 1 -->
          <div class="flex items-center gap-2.5 sm:gap-3">
            <div class="flex h-10 w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-full bg-purple-100/80 text-primary shadow-2xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-sm sm:text-base font-bold text-gray-900 leading-tight">India's</h4>
              <p class="text-[11px] sm:text-xs text-gray-500 font-medium">Most Loved Broker</p>
            </div>
          </div>

          <!-- Metric 2 -->
          <div class="flex items-center gap-2.5 sm:gap-3">
            <div class="flex h-10 w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-full bg-purple-100/80 text-primary shadow-2xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-sm sm:text-base font-bold text-gray-900 leading-tight">1 Lakh+</h4>
              <p class="text-[11px] sm:text-xs text-gray-500 font-medium">Happy Users & Growing</p>
            </div>
          </div>

          <!-- Metric 3 -->
          <div class="flex items-center gap-2.5 sm:gap-3">
            <div class="flex h-10 w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-full bg-purple-100/80 text-primary shadow-2xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.93V17a1 1 0 0 1-2 0v-.07a3.86 3.86 0 0 1-1.63-.7 1 1 0 0 1 1.34-1.5 2.1 2.1 0 0 0 1.29.47 1.84 1.84 0 0 0 1.87-1.87c0-1.28-.77-1.74-2.48-2.16C7.57 10.7 6.4 9.68 6.4 7.9 6.4 6.3 7.6 5.16 9.3 4.93V4a1 1 0 0 1 2 0v.07a3.86 3.86 0 0 1 1.43.6 1 1 0 0 1-1.24 1.57 2 2 0 0 0-1.19-.4 1.64 1.64 0 0 0-1.7 1.66c0 1.15.68 1.6 2.37 2 2.1.52 3.43 1.4 3.43 3.32 0 1.76-1.3 3.01-3.4 3.11z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-sm sm:text-base font-bold text-gray-900 leading-tight">4.5</h4>
              <p class="text-[11px] sm:text-xs text-gray-500 font-medium">Play Store Rating</p>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: Two Mobile Images Side-by-Side (Using mobile-frame and finzo-mobile-preview) -->
      <div class="relative flex items-center justify-center lg:col-span-6 xl:col-span-6 pt-6 md:pt-10">
        
        <!-- Background Radial Ambient Glow -->
        <div class="absolute inset-0 bg-radial from-purple-300/40 via-purple-100/20 to-transparent blur-3xl -z-10 pointer-events-none"></div>

        <!-- Mobile Images Container with Bottom Opacity Mask -->
        <div class="relative flex items-center justify-center -space-x-12 sm:-space-x-16 lg:-space-x-20 pt-6 sm:pt-8 pb-4 [mask-image:linear-gradient(to_bottom,rgba(0,0,0,1)_0%,rgba(0,0,0,1)_65%,rgba(0,0,0,0)_100%)]">
          
          <!-- Bottom Gradient Fade Layer -->
          <div class="pointer-events-none absolute bottom-0 inset-x-0 h-32 bg-linear-to-b from-transparent via-white/40 to-white z-30"></div>
          
          <!-- MOBILE 1 (Left Phone - Lower Offset) -->
          <div
            data-aos="fade-right"
            data-aos-delay="200"
            class="relative z-0 w-[200px] sm:w-[250px] lg:w-[270px] shrink-0 translate-y-10 sm:translate-y-14 transition-transform duration-300 hover:scale-105 hover:z-20"
          >
            <img
              src="/assets/finzo-astro.pages.dev/finzo-mobile-preview.BvJmjtx3_ZCwuGJ-33b2cefc.webp"
              srcset="/assets/finzo-astro.pages.dev/finzo-mobile-preview.BvJmjtx3_ZCwuGJ-33b2cefc.webp 477w"
              alt="Finzo Mobile App Preview 1"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width="477"
              height="913"
              class="w-full h-auto rounded-[1.8rem] sm:rounded-[2.2rem] px-[4%] pt-[4%] block"
            />
            <img
              src="/assets/finzo-astro.pages.dev/mobile-frame.VoXnWza1_2tK6vD-198eea97.webp"
              srcset="/assets/finzo-astro.pages.dev/mobile-frame.VoXnWza1_2tK6vD-198eea97.webp 531w"
              alt="Mobile Frame 1"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width="531"
              height="938"
              class="absolute top-0 left-0 w-full h-auto pointer-events-none drop-shadow-xl"
            />
          </div>

          <!-- MOBILE 2 (Right Phone) -->
          <div
            data-aos="fade-left"
            data-aos-delay="350"
            class="relative z-10 w-[210px] sm:w-[260px] lg:w-[280px] shrink-0 translate-y-0 transition-transform duration-300 hover:scale-105 hover:z-20"
          >
            <img
              src="/assets/finzo-astro.pages.dev/finzo-mobile-preview.BvJmjtx3_ZCwuGJ-33b2cefc.webp"
              srcset="/assets/finzo-astro.pages.dev/finzo-mobile-preview.BvJmjtx3_ZCwuGJ-33b2cefc.webp 477w"
              alt="Finzo Mobile App Preview 2"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width="477"
              height="913"
              class="w-full h-auto rounded-[1.8rem] sm:rounded-[2.2rem] px-[4%] pt-[4%] block"
            />
            <img
              src="/assets/finzo-astro.pages.dev/mobile-frame.VoXnWza1_2tK6vD-198eea97.webp"
              srcset="/assets/finzo-astro.pages.dev/mobile-frame.VoXnWza1_2tK6vD-198eea97.webp 531w"
              alt="Mobile Frame 2"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width="531"
              height="938"
              class="absolute top-0 left-0 w-full h-auto pointer-events-none drop-shadow-2xl"
            />
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
