---
import CalendarDays from "@lucide/astro/icons/calendar-days";
import Clock from "@lucide/astro/icons/clock";
import User from "@lucide/astro/icons/user";

interface Props {
  date: string;
  /** Machine-readable publish date for the <time> element. */
  datetime?: string;
  /** 0 means the body wasn't available to count, so the item is omitted. */
  readingMinutes: number;
  author?: string;
  class?: string;
}

const { date, datetime, readingMinutes, author, class: className = "" } = Astro.props;
---

<div class:list={["text-text-default flex flex-wrap items-center gap-x-6 gap-y-1.5 text-xs md:text-sm", className]}>
  {
    author && (
      <span class="inline-flex items-center gap-1.5">
        <User class="h-4 w-4 shrink-0" stroke-width={1.6} aria-hidden="true" />
        {author}
      </span>
    )
  }
  <span class="inline-flex items-center gap-1.5">
    <CalendarDays class="h-4 w-4 shrink-0" stroke-width={1.6} aria-hidden="true" />
    <time datetime={datetime || undefined}>{date}</time>
  </span>
  {
    readingMinutes > 0 && (
      <span class="inline-flex items-center gap-1.5">
        <Clock class="h-4 w-4 shrink-0" stroke-width={1.6} aria-hidden="true" />
        {readingMinutes} min read
      </span>
    )
  }
</div>
