---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Terms & Conditions - Multipurpose Saas & Startup Astro Js Theme"
  description="We are living in the future of writing! Take a look at what our users have to say about it."
>
  <Header currentPath="/terms-conditions" />
  <main class="has-section-spacing-lg">
    <div
      class="page-loader pointer-events-none fixed bottom-0 left-0 z-50 size-full bg-white transition duration-300 [.inactive]:opacity-0 inactive"
    >
      <script type="module" is:inline>
        const e = document.querySelector(".page-loader");
        document.addEventListener("DOMContentLoaded", () => {
          e &&
            setTimeout(() => {
              e.classList.add("inactive");
            }, 100);
        });
      </script>
    </div>
    <main class="has-section-spacing-lg">
      <section class="relative z-10 mt-0 py-14 md:pt-32 md:pb-24">
        <div class="container">
          <div class="flex max-w-6xl flex-wrap justify-between gap-5 md:gap-10 md:px-8 lg:px-12 ms-5 me-5 md:mx-auto">
            <h1 class="has-italic-text text-h2 max-w-lg capitalize">Terms &amp; Conditions</h1>
            <p class="md:max-w-sm">
              We are living in the future of writing! Take a look at what our users have to say about it.
            </p>
          </div>
        </div>
      </section>
      <section
        class="after:bg-theme-light pt-0 after:pointer-events-none after:absolute after:top-0 after:left-0 after:-z-10 after:h-250 after:w-full after:content-['']"
      >
        <div class="container">
          <div class="box-shadow-black mx-auto max-w-6xl space-y-16 rounded-xl bg-white p-8 md:p-12">
            <div class="prose-styles content has-video-modal">
              <p>Effective Date: July, 2022</p>
              <p>
                Welcome to Stella (“we,” “our,” or “us”). By accessing or using our website, <a
                  href="https://www.stella.com"
                  rel="noopener noreferrer nofollow"
                  target="_blank">https://www.stella.com</a
                > (“Website”), you agree to comply with and be bound by the following Terms and Conditions (“Terms”). If you
                do not agree with these Terms, please do not use our Website.
              </p>
              <h3 id="acceptance-of-terms">Acceptance of Terms</h3>
              <p>
                By accessing or using the Website, you confirm that you are at least 18 years old or have the legal
                consent of a parent or guardian. Your continued use of the Website constitutes your agreement to these
                Terms.
              </p>
              <h3 id="use-of-the-website">Use of the Website</h3>
              <p>
                You agree to use the Website only for lawful purposes and in a manner that does not infringe on the
                rights of others or restrict their use of the Website. Prohibited uses include but are not limited to:
              </p>
              <ul>
                <li>Engaging in any unlawful activity.</li>
                <li>Attempting to gain unauthorized access to the Website or its servers.</li>
                <li>Introducing harmful software or code, such as viruses or malware.</li>
                <li>Misrepresenting your identity or affiliations.</li>
              </ul>
              <h3 id="user-accounts">User Accounts</h3>
              <p>
                If you create an account on our Website, you are responsible for maintaining the confidentiality of your
                login credentials. You agree to notify us immediately of any unauthorized use of your account. We
                reserve the right to terminate accounts that violate these Terms.
              </p>
              <h3 id="intellectual-property">Intellectual Property</h3>
              <p>
                All content on the Website, including but not limited to text, images, logos, and software, is the
                property of Stella or its licensors and is protected by copyright, trademark, and other intellectual
                property laws. You may not reproduce, distribute, or modify any content without prior written consent
                from Stella.
              </p>
              <h3 id="purchases-and-payments">Purchases and Payments</h3>
              <p>
                All purchases made on the Website are subject to our pricing and payment terms. You agree to provide
                accurate payment information and authorize us to charge your payment method for the agreed-upon amounts.
                Refunds, if applicable, will be processed according to our Refund Policy.
              </p>
              <h3 id="disclaimer-of-warranties">Disclaimer of Warranties</h3>
              <p>
                The Website and its content are provided “as is” without warranties of any kind, either express or
                implied. We do not guarantee that the Website will be error-free, secure, or available at all times.
              </p>
              <h3 id="limitation-of-liability">Limitation of Liability</h3>
              <p>
                To the fullest extent permitted by law, Stella shall not be liable for any indirect, incidental,
                special, or consequential damages arising from your use of the Website or inability to access it. Our
                total liability for any claims related to the Website shall not exceed the amount paid by you, if any,
                to Stella.
              </p>
              <h3 id="termination">Termination</h3>
              <p>
                We reserve the right to suspend or terminate your access to the Website at our sole discretion, without
                notice, if we believe you have violated these Terms or any applicable law.
              </p>
              <h3 id="third-party-links">Third-Party Links</h3>
              <p>
                Our Website may contain links to third-party websites. We are not responsible for the content or
                practices of these websites. Your use of third-party sites is at your own risk.
              </p>
              <h3 id="governing-law">Governing Law</h3>
              <p>
                These Terms are governed by and construed in accordance with the laws of the State of Imaginary, USA,
                without regard to its conflict of law principles. Any disputes arising under these Terms shall be
                resolved in the courts located in Imaginary City, USA.
              </p>
              <h3 id="changes-to-terms">Changes to Terms</h3>
              <p>
                We reserve the right to update or modify these Terms at any time without prior notice. Any changes will
                be effective immediately upon posting on this page. Your continued use of the Website constitutes
                acceptance of the revised Terms.
              </p>
              <h3 id="contact-us">Contact Us</h3>
              <p>If you have any questions or concerns about these Terms, please contact us at:</p>
              <p>Stella</p>
              <p>
                Email: <a href="mailto:support@stella.com">support@stella.com</a><br />
                Address: 123 Stella Lane, Imaginary City, IC 12345, USA
              </p>
              <p>Thank you for using Stella!</p>
            </div>
          </div>
        </div>
      </section>
      <section class="call-to-action overflow-hidden">
        <div class="relative container py-20 md:py-40">
          <div class="mx-auto space-y-8 text-center lg:max-w-3xl">
            <h2
              class="has-italic-text text-display-3 md:text-display-2 mb-8 text-center leading-[1.15] font-normal capitalize"
            >
              <div
                class="animated-text is-ready"
                data-duration="0.6"
                data-delay="0.2"
                data-stagger="0.09"
                style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
              >
                <span class="word" style="--word-index:0">Get</span>
                <span class="word" style="--word-index:1">Started</span>
                <span class="word" style="--word-index:2">and</span>
                <span class="word" style="--word-index:3">Streamline</span>
                <span class="word" style="--word-index:4">Your</span>
                <span class="word" style="--word-index:5"><strong>Workflow</strong></span><strong>
                  <span class="word" style="--word-index:6">Today</span></strong
                >
              </div>
              <script type="module" is:inline>
                const r = document.querySelectorAll(".animated-text");
                if (window.matchMedia("(max-width: 767px)").matches)
                  r.forEach((t) => {
                    t.querySelectorAll(".word").forEach((e) => {
                      ((e.style.opacity = "1"), (e.style.filter = "none"), (e.style.transform = "none"));
                    });
                  });
                else {
                  const t = new IntersectionObserver(
                    (e, a) => {
                      e.forEach((s) => {
                        s.isIntersecting && (s.target.classList.add("is-animated"), a.unobserve(s.target));
                      });
                    },
                    { threshold: 0.1 },
                  );
                  r.forEach((e) => {
                    (e.classList.add("is-ready"), t.observe(e));
                  });
                }
              </script>
            </h2>
            <div
              data-aos="fade-down-sm"
              data-aos-delay="100"
              class="mx-auto max-w-2xl space-y-1 text-center *:first:text-lg *:first:font-medium *:last:opacity-80 aos-init"
            >
              <p>No credit card required. Cancel anytime</p>
              <p>Enjoy a 14-day free trial — experience every feature, risk-free.</p>
            </div>
            <div data-aos="fade-down-sm" data-aos-delay="200" class="aos-init">
              <a class="btn btn-primary text-flip-hover-anim btn-md btn-primary" href="/contact"
                ><span class="text-flip-inner" data-content="GET A FREE DEMO">GET A FREE DEMO</span><span
                  class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                  ><svg
                    class="gradient-shape"
                    width="150"
                    height="28"
                    viewBox="0 0 147 11"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    ><path
                      d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                      stroke="currentColor"
                      stroke-width="8"></path></svg
                  ></span
                ></a
              >
            </div>
          </div>
          <div
            class="pattern-shape pointer-events-none absolute top-0 left-0 -z-10 flex h-full w-[150%] opacity-40 select-none"
            style="transform: translateX(-1000px);"
          >
            <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b"
            >
            </div><div
              class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t"
            >
            </div>
          </div>
        </div>
        <div
          class="pattern-shape pointer-events-none absolute top-0 left-0 -z-10 flex h-full w-[150%] opacity-40 select-none"
          style="transform: translateX(-1000px);"
        >
          <div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-b">
          </div><div class="from-primary/10 h-full w-1/12 border-2 border-white to-transparent md:w-1/5 bg-linear-to-t">
          </div>
        </div>
      </section>
    </main>
  </main>
  <div
    id="action-buttons"
    class="pointer-events-none fixed right-0 bottom-5 z-100 flex flex-col space-y-2 rounded-lg bg-white p-2 text-center opacity-0 transition-all duration-300 [.scroll-down]:pointer-events-auto [.scroll-down]:right-5 [.scroll-down]:opacity-100"
  >
    <a
      rel="noopener noreferrer"
      target="_blank"
      class="btn btn-primary text-flip-hover-anim"
      href="https://getastrothemes.com/astro-themes/stella/?initiate-checkout=true&utm_source=direct"
      id="buy-now-stella"
      data-umami-event="buy-now-stella"
      ><span class="text-flip-inner" data-content="Buy Now">Buy Now</span><span
        class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
        ><svg
          class="gradient-shape"
          width="150"
          height="28"
          viewBox="0 0 147 11"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
            stroke="currentColor"
            stroke-width="8"></path></svg
        ></span
      ></a
    >
    <a
      rel="noopener noreferrer"
      target="_blank"
      class="btn btn-outline text-flip-hover-anim"
      href="https://getastrothemes.com/astro-themes/stella/?utm_source=direct"
      id="buy-now-stella"
      data-umami-event="buy-now-stella"
      ><span class="text-flip-inner" data-content="Theme Details">Theme Details</span><span
        class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
        ><svg
          class="gradient-shape"
          width="150"
          height="28"
          viewBox="0 0 147 11"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
            stroke="currentColor"
            stroke-width="8"></path></svg
        ></span
      ></a
    >
  </div>
  <script type="module" is:inline>
    function c() {
      try {
        return window.self !== window.top;
      } catch {
        return !0;
      }
    }
    if (!c()) {
      const t = document.getElementById("action-buttons");
      t &&
        (t.classList.remove("hidden"),
        window.addEventListener("scroll", () => {
          const o = window.scrollY,
            e = window.innerHeight,
            r = document.documentElement.scrollHeight - (o + e);
          (o >= 500 && t.classList.add("scroll-down"), (o <= 500 || r <= 100) && t.classList.remove("scroll-down"));
        }),
        (() => {
          const o = "checkout-ref";
          let e = localStorage.getItem(o);
          (e || ((e = document.referrer || "direct"), e && localStorage.setItem(o, e)),
            e &&
              t.querySelectorAll("a").forEach((n) => {
                const r = n.href.includes("?") ? "&" : "?";
                n.href += `${r}utm_source=${encodeURIComponent(e)}`;
              }));
        })());
    }
  </script>
</Layout>
<Footer />
