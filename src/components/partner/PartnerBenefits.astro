---
/**
 * The four headline benefits, on the tinted band TradingJourney uses so the
 * page alternates surfaces the way the homepage does.
 */

interface Benefit {
  title: string;
  description: string;
  icon: string;
}

const benefits: Benefit[] = [
  {
    title: "High Revenue Sharing",
    description: "Among the best sharing in the industry, with payouts settled by the 5th of every month.",
    icon: "revenue",
  },
  {
    title: "Zero Deposit Charges",
    description: "No charge to get started. Put your capital into growing the business instead.",
    icon: "wallet",
  },
  {
    title: "Free RM & Dealing Support",
    description: "A dedicated relationship manager and a dealing desk, at no cost to you.",
    icon: "support",
  },
  {
    title: "CRM To Track Onboarding",
    description: "Watch every client you refer move through onboarding, in one dashboard.",
    icon: "crm",
  },
];
---

<section>
  <div class="bg-theme-light py-20 md:py-32">
    <div class="container space-y-10 md:space-y-16">
      <div class="mx-auto max-w-2xl space-y-4 text-center">
        <h2 class="has-italic-text capitalize">
          <div
            class="animated-text is-ready"
            data-duration="0.6"
            data-delay="0.2"
            data-stagger="0.09"
            style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
          >
            <span class="word" style="--word-index:0">Benefits</span>
            <span class="word" style="--word-index:1">Of</span>
            <span class="word" style="--word-index:2">
              <strong>Partnering</strong>
            </span>
            <span class="word" style="--word-index:3">With</span>
            <span class="word" style="--word-index:4">Us</span>
          </div>
        </h2>
        <p class="opacity-80">Design re-imagined, performance re-calibrated.</p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 md:gap-8">
        {
          benefits.map((benefit, index) => (
            <div
              data-aos="fade-up-sm"
              data-aos-delay={200 + index * 100}
              class="flex flex-col gap-5 rounded-4xl bg-white p-8 aos-init"
            >
              <span class="text-primary bg-theme-light inline-flex h-12 w-12 items-center justify-center rounded-2xl">
                {benefit.icon === "revenue" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3h12" />
                    <path d="M6 8h12" />
                    <path d="m6 13 8.5 8" />
                    <path d="M6 13h3" />
                    <path d="M9 13c6.667 0 6.667-10 0-10" />
                  </svg>
                )}
                {benefit.icon === "wallet" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1" />
                    <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4" />
                  </svg>
                )}
                {benefit.icon === "support" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6" />
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" />
                  </svg>
                )}
                {benefit.icon === "crm" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2" />
                    <path d="M3 9h18" />
                    <path d="M9 21V9" />
                  </svg>
                )}
              </span>
              <div class="space-y-3">
                <h3 class="text-h5-sm md:text-h5 text-black">{benefit.title}</h3>
                <p class="text-gray-600">{benefit.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
