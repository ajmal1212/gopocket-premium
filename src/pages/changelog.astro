                        const t = e?.getAttribute("data-hs-overlay");
                        if (!t?.startsWith("#")) return null;
                        const o = document.querySelector(t);
                        return o instanceof HTMLDialogElement && o.hasAttribute("data-video-modal") ? o : null;
                      }
                      document.addEventListener("click", (e) => {
                        const t = e.target,
                          o = t?.closest("[data-video-modal-close]");
                        if (o) {
                          const c = o.closest("dialog[data-video-modal]");
                          c instanceof HTMLDialogElement && (e.preventDefault(), n(c));
