---
import "../styles/global.css";
// Must come after global.css: the dark overrides are unlayered and rely on
// following Tailwind's layers in source order.
import "../styles/dark-theme.css";
import "../styles/accessibility.css";
// Brand cursor: must stay last so its unlayered rules beat Tailwind's
// `cursor-*` utilities.
import "../styles/cursor.css";
import GlobalSearch from "../components/GlobalSearch.astro";
import GlobalScripts from "../components/GlobalScripts.astro";
import AccessibilityWidget from "../components/AccessibilityWidget.astro";
import AppQRWidget from "../components/AppQRWidget.astro";
import ChatWidget from "../components/ChatWidget.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
}

// Site-wide share card. 512x512 - square rather than the 1200x630 that Facebook
// and X crop to, so it renders best on WhatsApp, LinkedIn and Slack.
// Site-relative on purpose - see toAbsoluteUrl below.
const DEFAULT_OG_IMAGE = "/og-image.png";
const DEFAULT_OG_IMAGE_SIZE = 512;

const {
  title = "GoPocket - Open a Free Demat Account | Online Stock Trading App",
  description = "GoPocket is a SEBI-registered online trading and demat account platform. Trade stocks, F&O, mutual funds, commodities and IPOs at flat ₹20 per order or 0.03%, whichever is lower.",
  keywords = "demat account, online trading, stock broker India, discount broker, GoPocket, F&O trading, mutual funds, IPO",
  canonical = Astro.url.href,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = "GoPocket - online trading and demat account app",
  ogType = "website",
} = Astro.props;

/**
 * Resolve a URL against the origin actually serving this request.
 *
 * Every route is SSR - there is no `prerender` anywhere - so Astro.url is the
 * real request URL rather than the build-time `site`. Hardcoding
 * https://gopocket.in here is what broke WhatsApp previews on the Workers
 * deployment: the card pointed at an origin that 301s to www.gopocket.in and
 * then 404s, so the scraper got an HTML error page where it expected a PNG and
 * dropped the thumbnail. Resolved off the request origin, the image is always
 * fetched from the same deployment that served the page - workers.dev,
 * staging and the live domain alike.
 *
 * Absolute inputs (Frappe blog thumbnails on hrms.gopocket.in) pass straight
 * through; site-relative ones (the default card, and getFullImageUrl's
 * no-thumbnail fallback) pick up the serving origin.
 */
const toAbsoluteUrl = (url: string): string => new URL(url, Astro.url.origin).href;

const absoluteOgImage = toAbsoluteUrl(ogImage);

/**
 * og:url has to sit on the serving origin too. Facebook and WhatsApp treat it
 * as the card's canonical address and re-scrape it, so pointing it at another
 * host hands them that host's tags instead of this page's. Only the path is
 * taken from `canonical`; the <link rel="canonical"> below still emits what
 * the page authored, since that one is for search engines.
 */
const ogUrl = toAbsoluteUrl(new URL(canonical, Astro.url.origin).pathname);

// Dimensions are only truthful for the site default; pages that pass their own
// artwork (blog thumbnails) omit them rather than advertise a wrong size.
const isDefaultOgImage = ogImage === DEFAULT_OG_IMAGE;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Language" content="en" />
    <meta name="theme" content="gopocket" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="GoPocket" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} item-prop="url" />
    <link rel="alternate" hreflang="en" href={canonical} />
    {/* Replaced by the theme script below once the resolved theme is known. */}
    <meta name="theme-color" content="#ffffff" />

    {/*
      Resolves the theme and accessibility settings before first paint so the page
      never flashes incorrect styles.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("gp-theme");
          var isDark =
            stored === "dark" ||
            (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (isDark) {
            document.documentElement.classList.add("dark");
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute("content", "#0b0d13");
          }

          var a11yStored = localStorage.getItem("gp-a11y-settings");
          if (a11yStored) {
            var a11y = JSON.parse(a11yStored);
            var html = document.documentElement;
            if (a11y.contrast === "high") html.setAttribute("data-a11y-contrast", "high");
            else if (a11y.contrast === "invert") html.setAttribute("data-a11y-contrast", "invert");
            if (a11y.fontScale && a11y.fontScale !== "normal") html.setAttribute("data-a11y-font-scale", a11y.fontScale);
            if (a11y.theme && a11y.theme !== "none") html.setAttribute("data-a11y-theme", a11y.theme);
            if (a11y.hideImages) html.setAttribute("data-a11y-hide-images", "true");
            if (a11y.grayscale) html.setAttribute("data-a11y-grayscale", "true");
            if (a11y.bluelight) html.setAttribute("data-a11y-bluelight", "true");
            if (a11y.adhd) html.setAttribute("data-a11y-adhd", "true");
            if (a11y.dyslexia) html.setAttribute("data-a11y-dyslexia", "true");
            if (a11y.highlightLinks) html.setAttribute("data-a11y-highlight-links", "true");
            if (a11y.focusIndicator) html.setAttribute("data-a11y-focus-indicator", "true");

            var isAnyActive =
              a11y.speech ||
              (a11y.contrast && a11y.contrast !== "normal") ||
              (a11y.fontScale && a11y.fontScale !== "normal") ||
              (a11y.theme && a11y.theme !== "none") ||
              a11y.hideImages ||
              a11y.grayscale ||
              a11y.bluelight ||
              a11y.adhd ||
              a11y.dyslexia ||
              a11y.highlightLinks ||
              a11y.focusIndicator;

            if (isAnyActive) html.setAttribute("data-a11y-active", "true");
          }
        } catch (e) {
          /* Storage blocked - fall through to light default. */
        }
      })();
    </script>

    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      isDefaultOgImage && (
        <>
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_SIZE)} />
          <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_SIZE)} />
        </>
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="GoPocket" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={ogUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <meta name="msapplication-TileColor" content="#2b5797" />
    <meta name="apple-mobile-web-app-title" content="GoPocket" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        description: description,
        image: absoluteOgImage,
        url: canonical,
        inLanguage: "en",
        isPartOf: {
          "@type": "WebSite",
          name: "GoPocket",
          description:
            "GoPocket is a SEBI-registered online trading and demat account platform for stocks, F&O, mutual funds, commodities and IPOs.",
          url: "https://gopocket.in/",
        },
        publisher: {
          "@type": "Organization",
          name: "GoPocket",
          url: "https://gopocket.in/",
          sameAs: [
            "https://www.facebook.com",
            "https://twitter.com",
            "https://www.instagram.com",
            "https://www.linkedin.com",
          ],
          logo: { "@type": "ImageObject", url: "https://gopocket.in/gopocket-logo.svg" },
        },
      })}
    />

    {/*
      Figtree and Instrument Serif are self-hosted from /public/fonts and declared
      via @font-face in global.css. Preload them here so the browser can start the
      download immediately instead of waiting for the stylesheet to parse - the
      @font-face rules sit inside a large CSS bundle, so discovery is otherwise late.
    */}
    <link rel="preload" href="/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Per-page head extras (article meta, JSON-LD, etc.) -->
    <slot name="head" />

  </head>

  <body>
    <slot />
    <GlobalSearch />
    <GlobalScripts />
    <AccessibilityWidget />
    <AppQRWidget />
    <ChatWidget />
  </body>
</html>
