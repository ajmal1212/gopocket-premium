---
import type { Shareholding } from "@/lib/shareholding";

interface Props {
  data: Shareholding;
}

const { data } = Astro.props;

/*
 * Who holds the company, from its latest quarterly filing. Employee trusts are
 * listed only when they hold anything - for most companies the row would be a
 * permanent 0.00%.
 */
const rows = [
  { label: "Promoter & Promoter Group", value: data.promoter, fill: "bg-[#9bb35f]" },
  { label: "Public", value: data.public, fill: "bg-[#f7932f]" },
  ...(data.employeeTrusts > 0 ? [{ label: "Employee trusts", value: data.employeeTrusts, fill: "bg-[#3ea3dc]" }] : []),
];

const percent = (value: number) => `${value.toFixed(2)}%`;
---

<section class="flex flex-col gap-4">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    {/* text-h6! - see MarketDepth.astro on the global h2 rule. */}
    <h2 class="text-h6! font-semibold">Shareholding pattern</h2>
    <p class="text-text-default/60 text-xs">Quarter ended {data.asOf}</p>
  </div>

  <div class="border-border-light rounded-2xl border bg-white p-4 md:p-6 dark:bg-transparent">
    <dl class="flex flex-col gap-5">
      {
        rows.map((row) => (
          <div class="grid grid-cols-[7.5rem_minmax(0,1fr)] items-center gap-x-4 md:grid-cols-[13rem_minmax(0,1fr)]">
            <dt class="text-text-default text-sm leading-snug">{row.label}</dt>
            <dd class="flex items-center gap-4">
              <span class="bg-theme-light h-2 flex-1 overflow-hidden rounded-full" aria-hidden="true">
                <span class:list={["block h-full rounded-full", row.fill]} style={`width: ${row.value}%`} />
              </span>
              <span class="text-dark w-16 text-right text-sm font-medium tabular-nums">{percent(row.value)}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <p class="text-text-default/60 text-xs">From the company's shareholding pattern filing with NSE.</p>
</section>
