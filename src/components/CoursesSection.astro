---
/**
 * "Free courses for you" - the course cards, shared by /courses and the
 * Research & Learn page.
 *
 * `heading` exists because the two callers need different levels: /courses
 * leads with this section, so it owns the page's <h1>, while on Research &
 * Learn it is one section among several and must be an <h2>.
 */
import Button from "@/components/Button.astro";
import BookOpen from "@lucide/astro/icons/book-open";
import { getCourses } from "@/lib/frappe";

interface Props {
  heading?: "h1" | "h2";
  class?: string;
}

const { heading: Heading = "h2", class: className = "" } = Astro.props;

const courses = await getCourses();
---

<section class:list={[className]}>
  <div class="container space-y-10 md:space-y-16">
    <div class="mx-auto max-w-2xl text-center">
      <Heading class="has-italic-text capitalize">
        <div
          class="animated-text is-ready"
          data-duration="0.6"
          data-delay="0.2"
          data-stagger="0.09"
          style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
        >
          <span class="word" style="--word-index:0">Free</span>
          <span class="word" style="--word-index:1"><strong>courses</strong></span>
          <span class="word" style="--word-index:2">for</span>
          <span class="word" style="--word-index:3">you</span>
        </div>
      </Heading>
      <p class="text-text-default opacity-80 mt-3">
        Start your journey towards financial independence with expert training.
      </p>
    </div>

    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 md:gap-8">
      {
        courses.length === 0 ? (
          <div class="sm:col-span-2 lg:col-span-3 rounded-3xl border border-border-light bg-theme-light py-12 text-center text-gray-500">
            <p class="text-lg font-medium">No courses published yet.</p>
            <p class="mt-1 text-sm">New lessons are added regularly - do check back.</p>
          </div>
        ) : (
          courses.map((course, index) => (
            <article
              data-aos="fade-up-sm"
              data-aos-delay={100 + index * 100}
              class="flex flex-col overflow-hidden rounded-3xl border border-border-light bg-white shadow-xs transition-colors duration-300 hover:border-black/20"
            >
              <div class="relative">
                {/* 16:9: the uploaded artwork has its title baked in, so a
                  squarer crop would cut the wording off. */}
                <img
                  src={course.image}
                  alt={course.title}
                  width="1024"
                  height="546"
                  loading="lazy"
                  decoding="async"
                  class="aspect-video w-full object-cover"
                />
                <span class="absolute right-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-dark shadow-xs">
                  {course.level}
                </span>
              </div>

              <div class="flex flex-1 flex-col gap-4 p-5 md:p-6">
                <h3 class="line-clamp-2 text-lg font-bold leading-snug text-dark md:text-xl">{course.title}</h3>

                <div class="mt-auto flex items-center justify-between gap-4">
                  <span class="flex items-center gap-2 text-sm text-text-default opacity-75">
                    <BookOpen class="h-4 w-4 text-primary" stroke-width={1.8} aria-hidden="true" />
                    {course.chapterCount} {course.chapterCount === 1 ? "chapter" : "chapters"}
                  </span>
                  {/* Fixed width so the button matches the Register button on the
                    webinar cards, whose label is a different length. */}
                  <Button
                    label="Start"
                    href={`/courses/${course.slug}/${course.firstChapterSlug}`}
                    variant="primary"
                    class="w-[162px] shrink-0 text-center"
                  />
                </div>
              </div>
            </article>
          ))
        )
      }
    </div>
  </div>
</section>
