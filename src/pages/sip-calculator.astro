<style>
  /* Custom Range Slider Styling */
  .sip-minimal-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 9999px;
    outline: none;
    cursor: pointer;
  }
  .sip-minimal-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffffff;
    border: 2.5px solid #6b1aff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .sip-minimal-slider::-webkit-slider-thumb:hover {
    transform: scale(1.25);
  }
</style>

<!-- Load Chart.js -->
<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  let chartInstance: any = null;
  let currentMode = "sip"; // 'sip' or 'lumpsum'

  function formatCurrency(val: number): string {
    return new Intl.NumberFormat("en-IN", {
      style: "currency",
      currency: "INR",
      maximumFractionDigits: 0,
    }).format(val);
  }

  function updateSliderTrack(slider: HTMLInputElement | null) {
    if (!slider) return;
    const min = parseFloat(slider.min) || 0;
    const max = parseFloat(slider.max) || 100;
    const val = parseFloat(slider.value) || 0;
    const pct = Math.min(100, Math.max(0, ((val - min) / (max - min)) * 100));
    const isDark = document.documentElement.classList.contains("dark");
    const trackBg = isDark ? "#262938" : "#e2e8f0";
    slider.style.background = `linear-gradient(to right, #6b1aff 0%, #6b1aff ${pct}%, ${trackBg} ${pct}%, ${trackBg} 100%)`;
  }

  function updateAllSliderTracks() {
    const monthlySlider = document.getElementById("monthly-investment-slider") as HTMLInputElement;
    const rateSlider = document.getElementById("return-rate-slider") as HTMLInputElement;
    const timeSlider = document.getElementById("time-period-slider") as HTMLInputElement;

    updateSliderTrack(monthlySlider);
    updateSliderTrack(rateSlider);
    updateSliderTrack(timeSlider);
  }

  function calculateSIP() {
    const monthlyInput = document.getElementById("monthly-investment-input") as HTMLInputElement;
    const rateInput = document.getElementById("return-rate-input") as HTMLInputElement;
    const yearsInput = document.getElementById("time-period-input") as HTMLInputElement;

    if (!monthlyInput || !rateInput || !yearsInput) return;

    const P = Math.max(500, parseFloat(monthlyInput.value) || 0);
    const ratePa = Math.max(1, parseFloat(rateInput.value) || 0);
    const years = Math.max(1, parseFloat(yearsInput.value) || 0);

    let totalInvested = 0;
    let futureValue = 0;

    if (currentMode === "sip") {
      const i = ratePa / 12 / 100;
      const n = years * 12;
      totalInvested = P * n;
      futureValue = Math.round(P * ((Math.pow(1 + i, n) - 1) / i) * (1 + i));
    } else {
      // Lumpsum calculation: FV = P * (1 + r)^n
      const r = ratePa / 100;
      totalInvested = P;
      futureValue = Math.round(P * Math.pow(1 + r, years));
    }

    const estReturns = Math.max(0, futureValue - totalInvested);

    // Update Output Elements
    const investedEl = document.getElementById("output-invested-amount");
    const returnsEl = document.getElementById("output-est-returns");
    const totalEl = document.getElementById("output-total-value");

    if (investedEl) investedEl.innerText = formatCurrency(totalInvested);
    if (returnsEl) returnsEl.innerText = formatCurrency(estReturns);
    if (totalEl) totalEl.innerText = formatCurrency(futureValue);

    // Update Slider Progress Tracks
    updateAllSliderTracks();

    // Update Chart & Breakdown
    updateChart(totalInvested, estReturns);
    updateBreakdownTable(P, ratePa, years);
  }

  function updateChart(invested: number, returns: number) {
    const canvas = document.getElementById("sip-chart") as HTMLCanvasElement;
    if (!canvas) return;

    const investedColor = "rgba(107, 26, 255, 0.2)"; // Light purple
    const returnsColor = "#6b1aff"; // Vibrant brand purple

    if (chartInstance) {
      chartInstance.data.datasets[0].data = [invested, returns];
      chartInstance.update();
    } else if ((window as any).Chart) {
      const ChartClass = (window as any).Chart;
      chartInstance = new ChartClass(canvas, {
        type: "doughnut",
        data: {
          labels: ["Invested amount", "Est. returns"],
          datasets: [
            {
              data: [invested, returns],
              backgroundColor: [investedColor, returnsColor],
              borderWidth: 0,
              hoverOffset: 5,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: "78%",
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function (context: any) {
                  const label = context.label || "";
                  const value = context.parsed || 0;
                  return ` ${label}: ${formatCurrency(value)}`;
                },
              },
            },
          },
          animation: {
            duration: 400,
            easing: "easeOutQuart",
          },
        },
      });
    }
  }

  function updateBreakdownTable(P: number, ratePa: number, maxYears: number) {
    const tbody = document.getElementById("sip-breakdown-body");
    if (!tbody) return;

    let rowsHtml = "";

    for (let yr = 1; yr <= maxYears; yr++) {
      let invested = 0;
      let fv = 0;

      if (currentMode === "sip") {
        const i = ratePa / 12 / 100;
        const n = yr * 12;
        invested = P * n;
        fv = Math.round(P * ((Math.pow(1 + i, n) - 1) / i) * (1 + i));
      } else {
        const r = ratePa / 100;
        invested = P;
        fv = Math.round(P * Math.pow(1 + r, yr));
      }

      const returns = Math.max(0, fv - invested);

      rowsHtml += `
        <tr class="hover:bg-gray-50 dark:hover:bg-[#181b25] transition">
          <td class="px-5 py-3.5 font-semibold">${yr} ${yr === 1 ? "Year" : "Years"}</td>
          <td class="px-5 py-3.5">${formatCurrency(invested)}</td>
          <td class="px-5 py-3.5 text-primary font-semibold">${formatCurrency(returns)}</td>
          <td class="px-5 py-3.5 text-right font-bold text-dark">${formatCurrency(fv)}</td>
        </tr>
      `;
    }

    tbody.innerHTML = rowsHtml;
  }

  function setupEventListeners() {
    const monthlyInput = document.getElementById("monthly-investment-input") as HTMLInputElement;
    const monthlySlider = document.getElementById("monthly-investment-slider") as HTMLInputElement;

    const rateInput = document.getElementById("return-rate-input") as HTMLInputElement;
    const rateSlider = document.getElementById("return-rate-slider") as HTMLInputElement;

    const timeInput = document.getElementById("time-period-input") as HTMLInputElement;
    const timeSlider = document.getElementById("time-period-slider") as HTMLInputElement;

    const modeSipBtn = document.getElementById("mode-sip-btn");
    const modeLumpsumBtn = document.getElementById("mode-lumpsum-btn");
    const investmentLabel = document.getElementById("investment-label");

    // Mode Toggle
    modeSipBtn?.addEventListener("click", () => {
      currentMode = "sip";
      modeSipBtn.className =
        "calc-mode-tab active px-5 py-2 text-sm sm:text-base font-bold rounded-full border border-primary bg-primary/10 text-primary transition-all";
      modeLumpsumBtn!.className =
        "calc-mode-tab px-5 py-2 text-sm sm:text-base font-bold rounded-full border border-transparent text-text-default opacity-70 hover:opacity-100 transition-all";
      if (investmentLabel) investmentLabel.innerText = "Monthly investment";
      calculateSIP();
    });

    modeLumpsumBtn?.addEventListener("click", () => {
      currentMode = "lumpsum";
      modeLumpsumBtn.className =
        "calc-mode-tab active px-5 py-2 text-sm sm:text-base font-bold rounded-full border border-primary bg-primary/10 text-primary transition-all";
      modeSipBtn!.className =
        "calc-mode-tab px-5 py-2 text-sm sm:text-base font-bold rounded-full border border-transparent text-text-default opacity-70 hover:opacity-100 transition-all";
      if (investmentLabel) investmentLabel.innerText = "Total investment";
      calculateSIP();
    });

    // Inputs & Sliders Sync
    monthlyInput?.addEventListener("input", () => {
      if (monthlySlider) monthlySlider.value = monthlyInput.value;
      calculateSIP();
    });
    monthlySlider?.addEventListener("input", () => {
      if (monthlyInput) monthlyInput.value = monthlySlider.value;
      calculateSIP();
    });

    rateInput?.addEventListener("input", () => {
      if (rateSlider) rateSlider.value = rateInput.value;
      calculateSIP();
    });
    rateSlider?.addEventListener("input", () => {
      if (rateInput) rateInput.value = rateSlider.value;
      calculateSIP();
    });

    timeInput?.addEventListener("input", () => {
      if (timeSlider) timeSlider.value = timeInput.value;
      calculateSIP();
    });
    timeSlider?.addEventListener("input", () => {
      if (timeInput) timeInput.value = timeSlider.value;
      calculateSIP();
    });
  }

  function initCalculator() {
    setupEventListeners();
    calculateSIP();
  }

  if (document.readyState !== "loading") {
    initCalculator();
  } else {
    document.addEventListener("DOMContentLoaded", initCalculator);
  }
</script>
