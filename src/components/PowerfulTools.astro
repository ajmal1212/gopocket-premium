---

---

<section>
  <div class="container space-y-10 md:space-y-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="has-italic-text capitalize">
        <div
          class="animated-text is-ready is-animated"
          data-duration="0.6"
          data-delay="0.2"
          data-stagger="0.09"
          style="font-weight: 600; --animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
        >
          <span class="word" style="--word-index:0">Powerful</span>
          <span class="word" style="--word-index:1">Tools</span>
          <span class="word" style="--word-index:2">To</span>
          <span class="word" style="--word-index:3">Grow</span>
          <span class="word" style="--word-index:4"><strong>Your</strong></span><strong>
            <span class="word" style="--word-index:5">Portfolio</span></strong
          >
        </div>
      </h2>
    </div>
    <div class="grid gap-12 md:grid-cols-6">
      <div
        data-aos="fade-up-sm"
        data-aos-delay="300"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 aos-init aos-animate"
      >
        <img
          src="/assets/images/realtime-report-4.webp"
          srcset="/assets/images/realtime-report-6.webp 640w, /assets/images/realtime-report-2.webp 750w, /assets/images/realtime-report-4.webp 805w, /assets/images/realtime-report-3.webp 828w, /assets/images/realtime-report-1.webp 1080w, /assets/images/realtime-report-5.webp 1280w"
          alt="Live Market Data"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          sizes="(min-width: 805px) 805px, 100vw"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="805"
          height="400"
          class="mx-auto block pb-6 lg:pb-12"
        />
        <div class="space-y-4 pb-6 lg:pb-12 px-6 lg:px-12">
          <h3 class="h4">Live Market Data</h3>
          <p>Real-time price feeds, charts and market depth to help you decide instantly.</p>
        </div>
      </div>
      <div
        data-aos="fade-up-sm"
        data-aos-delay="450"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 aos-init aos-animate"
      >
        <img
          src="/assets/images/collaboration-3.webp"
          srcset="/assets/images/collaboration-3.webp 559w, /assets/images/collaboration-6.webp 640w, /assets/images/collaboration-4.webp 750w, /assets/images/collaboration-5.webp 828w, /assets/images/collaboration-1.webp 1080w, /assets/images/collaboration-2.webp 1118w"
          alt="3-in-1 Account"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          sizes="(min-width: 559px) 559px, 100vw"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="559"
          height="326"
          class="mx-auto block order-2 pt-6 lg:pt-12"
        />
        <div class="space-y-4 order-1 py-6 lg:pt-12 px-6 lg:px-12">
          <h3 class="h4">3-in-1 Account</h3>
          <p>One account links your trading, demat and bank — funds move in seconds.</p>
        </div>
      </div>
      <div
        data-aos="fade-left-sm"
        data-aos-delay="400"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 lg:col-span-2 aos-init aos-animate"
      >
        <img
          src="/assets/images/metrics-2.webp"
          srcset="/assets/images/metrics-2.webp 407w, /assets/images/metrics-4.webp 640w, /assets/images/metrics-3.webp 750w, /assets/images/metrics-1.webp 814w"
          alt="Trusted by Thousands"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          sizes="(min-width: 407px) 407px, 100vw"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="407"
          height="242"
          class="mx-auto block pb-6 lg:pb-12"
        />
        <div class="space-y-4 pb-6 lg:pb-12 px-6 lg:px-9">
          <h3 class="h5">Trusted by Thousands</h3>
          <p>Thousands of investors trust GoPocket for honest pricing and reliable execution.</p>
        </div>
      </div>
      <div
        data-aos="fade-left-sm"
        data-aos-delay="200"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 lg:col-span-2 aos-init aos-animate"
      >
        <img
          src="/assets/images/ai-automation-2.webp"
          srcset="/assets/images/ai-automation-2.webp 407w, /assets/images/ai-automation-3.webp 640w, /assets/images/ai-automation-1.webp 750w, /assets/images/ai-automation-4.webp 814w"
          alt="Multi-Asset Trading"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          sizes="(min-width: 407px) 407px, 100vw"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="407"
          height="235"
          class="mx-auto block order-2 pt-6 lg:pt-12"
        />
        <div class="space-y-4 order-1 py-6 lg:pt-12 px-6 lg:px-9">
          <h3 class="h5">Multi-Asset Trading</h3>
          <p>Trade equity, F&amp;O, currency, commodities, mutual funds and IPOs — all in one app.</p>
        </div>
      </div>
      <div
        data-aos="fade-left-sm"
        data-aos-delay="300"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 lg:col-span-2 aos-init aos-animate"
      >
        <img
          src="/assets/images/security-3.webp"
          srcset="/assets/images/security-3.webp 408w, /assets/images/security-2.webp 640w, /assets/images/security-1.webp 750w, /assets/images/security-4.webp 816w"
          alt="Safe & Secure"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          sizes="(min-width: 408px) 408px, 100vw"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="408"
          height="237"
          class="mx-auto block pb-6 lg:pb-12"
        />
        <div class="space-y-4 pb-6 lg:pb-12 px-6 lg:px-9">
          <h3 class="h5">Safe &amp; Secure</h3>
          <p>Bank-grade security and SEBI-regulated safety keep your money and data protected.</p>
        </div>
      </div>
    </div>
  </div>
</section>
