---

---

<section>
  <div class="container space-y-10 md:space-y-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="has-italic-text capitalize">
        <div
          class="animated-text is-ready"
          data-duration="0.6"
          data-delay="0.2"
          data-stagger="0.09"
          style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
        >
          <span class="word" style="--word-index:0">We</span>
          <span class="word" style="--word-index:1">Provide</span>
          <span class="word" style="--word-index:2">
            <strong>Special</strong>
          </span>
          <strong>
            <span class="word" style="--word-index:3">Benefits</span>
          </strong>
          <span class="word" style="--word-index:4">For</span>
          <span class="word" style="--word-index:5">You</span>
        </div>
      </h2>
    </div>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div
        data-aos="fade-up-sm"
        data-aos-delay="50"
        data-aos-duration="900"
        class="flex flex-col gap-4 border p-5 md:p-8 aos-init"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-lucide="Users"
          class="text-3xl"
        >
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"> </path>
          <path d="M16 3.128a4 4 0 0 1 0 7.744"> </path>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"> </path>
          <circle cx="9" cy="7" r="4"> </circle>
        </svg>
        <div class="mt-4 space-y-3">
          <h3 class="text-h5-sm md:text-h5">Customers First</h3>
          <p class="opacity-80">
            Our founding principle. A friendly community of traders, and a support team that answers when you need it.
          </p>
        </div>
      </div>
      <div
        data-aos="fade-up-sm"
        data-aos-delay="100"
        data-aos-duration="900"
        class="flex flex-col gap-4 border p-5 md:p-8 aos-init"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-lucide="Smartphone"
          class="text-3xl"
        >
          <rect width="14" height="20" x="5" y="2" rx="2" ry="2"> </rect>
          <path d="M12 18h.01"> </path>
        </svg>
        <div class="mt-4 space-y-3">
          <h3 class="text-h5-sm md:text-h5">Trade On Any Device</h3>
          <p class="opacity-80">
            GoPocket App, Web and our APIs. Pick the platform that fits the way you trade, and switch any time.
          </p>
        </div>
      </div>
      <div
        data-aos="fade-up-sm"
        data-aos-delay="150"
        data-aos-duration="900"
        class="flex flex-col gap-4 border p-5 md:p-8 aos-init"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-lucide="IndianRupee"
          class="text-3xl"
        >
          <path d="M6 3h12"> </path>
          <path d="M6 8h12"> </path>
          <path d="m6 13 8.5 8"> </path>
          <path d="M6 13h3"> </path>
          <path d="M9 13c6.667 0 6.667-10 0-10"> </path>
        </svg>
        <div class="mt-4 space-y-3">
          <h3 class="text-h5-sm md:text-h5">Flat &#8377;20 Per Order</h3>
          <p class="opacity-80">
            Trade on your own at a flat &#8377;20 per order, or move to Pocket Prime for brokerage tailored to you.
          </p>
        </div>
      </div>
      <div
        data-aos="fade-up-sm"
        data-aos-delay="200"
        data-aos-duration="900"
        class="flex flex-col gap-4 border p-5 md:p-8 aos-init"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-lucide="Earth"
          class="text-3xl"
        >
          <path d="M21.54 15H17a2 2 0 0 0-2 2v4.54"> </path>
          <path d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17"> </path>
          <path d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05"> </path>
          <circle cx="12" cy="12" r="10"> </circle>
        </svg>
        <div class="mt-4 space-y-3">
          <h3 class="text-h5-sm md:text-h5">Infinite Investment Options</h3>
          <p class="opacity-80">
            Equity, mutual funds, IPOs, futures, options, currencies and commodities, all from a single account.
          </p>
        </div>
      </div>
      <div
        data-aos="fade-up-sm"
        data-aos-delay="250"
        data-aos-duration="900"
        class="flex flex-col gap-4 border p-5 md:p-8 aos-init"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-lucide="Gift"
          class="text-3xl"
        >
          <rect x="3" y="8" width="18" height="4" rx="1"> </rect>
          <path d="M12 8v13"> </path>
          <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"> </path>
          <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"> </path>
        </svg>
        <div class="mt-4 space-y-3">
          <h3 class="text-h5-sm md:text-h5">Invite A Friend, Earn Back</h3>
          <p class="opacity-80">Refer a friend to GoPocket and earn 50% of the brokerage from every successful referral.</p>
        </div>
      </div>
      <div
        data-aos="fade-up-sm"
        data-aos-delay="300"
        data-aos-duration="900"
        class="flex flex-col gap-4 border p-5 md:p-8 aos-init"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-lucide="Sprout"
          class="text-3xl"
        >
          <path
            d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3"
          >
          </path>
          <path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4"> </path>
          <path d="M5 21h14"> </path>
        </svg>
        <div class="mt-4 space-y-3">
          <h3 class="text-h5-sm md:text-h5">Learn And Earn</h3>
          <p class="opacity-80">
            Easy-to-understand modules to start with the basics, and financial experts only a call away.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
