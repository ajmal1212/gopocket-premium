                  <th class="px-6 py-4.5 w-48">Scheme</th>
                  <th class="px-6 py-4.5 min-w-[200px]">Lock-in</th>
                  <th class="px-6 py-4.5 text-center min-w-[200px]">Returns</th>
                  <th class="px-6 py-4.5 min-w-[180px]">Risk</th>
                  <th class="px-6 py-4.5 min-w-[200px]">Tax on Returns</th>
