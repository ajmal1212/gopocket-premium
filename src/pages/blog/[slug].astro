---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import { getBlogPostBySlugOrId } from "../../lib/frappe";

const { slug } = Astro.params;

// Fetch individual blog post from Frappe with fields=["*"]
const post = slug ? await getBlogPostBySlugOrId(slug) : null;

if (!post) {
  return Astro.redirect("/blog/");
}
---

<Layout title={`${post.title} - GoPocket Blog`} description={post.description || post.summary}>
  <Header currentPath="/blog/" />

  <main class="has-section-spacing-lg pt-8 md:pt-16">
    <!-- Article Header -->
    <section class="relative z-10 py-8 md:py-14">
      <div class="container max-w-7xl">
        <div class="max-w-4xl mx-auto text-center space-y-5">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-semibold tracking-wide uppercase"
          >
            <span>{post.category}</span>
            <span class="opacity-40">•</span>
            <span>{post.formattedDate}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-dark tracking-tight leading-tight">
            {post.title}
          </h1>

          {
            post.description && (
              <p class="text-lg md:text-xl text-text-default opacity-80 max-w-3xl mx-auto leading-relaxed">
                {post.description}
              </p>
            )
          }
        </div>

        <!-- Main Featured Image -->
        {
          post.mainImage && (
            <div class="max-w-7xl mx-auto mt-8 md:mt-12 rounded-3xl overflow-hidden border border-border-light shadow-lg aspect-[1150/500] w-full bg-white">
              <img
                src={post.mainImage}
                alt={post.title}
                class="w-full h-full object-cover rounded-3xl"
                loading="eager"
              />
            </div>
          )
        }
      </div>
    </section>

    <!-- Article Content & Always Sticky Right Sidebar CTA -->
    <section class="py-6 md:py-10">
      <div class="container max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          <!-- LEFT COLUMN: Expanded Post Content Body (9 Columns) -->
          <article
            class="lg:col-span-9 bg-theme-light p-6 sm:p-10 md:p-12 rounded-3xl border border-border-light shadow-xs w-full overflow-hidden"
          >
            {
              post.postBody ? (
                <div class="ql-editor read-mode w-full" set:html={post.postBody} />
              ) : (
                <div class="text-center py-12 text-gray-500">
                  <p>No content available for this article.</p>
                </div>
              )
            }

            <!-- Back to Blog Button -->
            <div class="pt-8 mt-10 border-t border-border-light/80 flex items-center justify-between">
              <a href="/blog/" class="btn btn-outline text-flip-hover-anim btn-sm cursor-pointer">
                <span class="text-flip-inner" data-content="← Back to All Articles">← Back to All Articles</span>
                <span
                  class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                >
                  <svg
                    class="gradient-shape"
                    width="150"
                    height="28"
                    viewBox="0 0 147 11"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                      stroke="currentColor"
                      stroke-width="8"></path>
                  </svg>
                </span>
              </a>
            </div>
          </article>

          <!-- RIGHT COLUMN: Compact Sticky Sidebar CTA (3 Columns) -->
          <aside class="lg:col-span-3 lg:sticky lg:top-28 space-y-6 w-full max-w-[340px] mx-auto lg:mx-0">
            <div class="bg-theme-light rounded-3xl p-5 sm:p-6 border border-border-light shadow-md space-y-5">
              <div class="space-y-3">
                <div
                  class="inline-flex items-center gap-1.5 bg-primary/10 text-primary text-xs font-semibold px-3 py-1 rounded-full uppercase"
                >
                  <span>GoPocket Trading</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-dark leading-snug">Open Free Account</h3>
                <p class="text-text-default opacity-80 text-sm leading-relaxed">
                  Trade Stocks, F&amp;O, Commodities &amp; IPOs at flat ₹20 per order with institutional-grade tools.
                </p>
              </div>

              <!-- Form with Mobile Input & Signup Now Button -->
              <form class="space-y-3" onsubmit="event.preventDefault()">
                <div class="relative w-full">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <input
                    type="tel"
                    placeholder="Enter mobile number"
                    class="w-full pl-10 pr-4 py-3 bg-white border border-border-light rounded-xl text-dark placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all shadow-2xs"
                    required
                  />
                </div>
                <button
                  type="submit"
                  class="btn btn-primary text-flip-hover-anim btn-md w-full justify-center text-sm font-semibold cursor-pointer shadow-sm"
                >
                  <span class="text-flip-inner" data-content="SIGNUP NOW">SIGNUP NOW</span>
                  <span
                    class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                  >
                    <svg
                      class="gradient-shape"
                      width="150"
                      height="28"
                      viewBox="0 0 147 11"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                        stroke="currentColor"
                        stroke-width="8"></path>
                    </svg>
                  </span>
                </button>
              </form>

              <!-- Feature Bullets -->
              <div class="space-y-2.5 pt-4 border-t border-border-light/80 text-xs text-text-default font-medium">
                <div class="flex items-center gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-emerald-600 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Zero Account Opening &amp; AMC Charges</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-emerald-600 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>100% Digital 5-Minute Onboarding</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-emerald-600 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Advanced Option Chain &amp; Charts</span>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <FinalCTA />
  </main>

  <Footer />
</Layout>

<script>
  function formatProseImagesInDOM() {
    const editor = document.querySelector<HTMLElement>(".ql-editor");
    if (!editor) return;

    // Replace any raw /files/ or /private/files/ text paths in the DOM with <img>
    const fileRegex = /(?<!src=["'])\b(\/(?:private\/)?files\/[^\s<>"']+\.(?:jpg|jpeg|png|webp|gif|svg)(?:\?[^\s<>"']*)?)/gi;

    if (fileRegex.test(editor.innerHTML)) {
      editor.innerHTML = editor.innerHTML.replace(
        fileRegex,
        (match) => `<img src="https://hrms.gopocket.in${match.startsWith("/") ? "" : "/"}${match}" class="w-full h-auto object-cover rounded-3xl my-6 border border-border-light shadow-lg" loading="lazy" alt="Blog Image" />`
      );
    }

    // Ensure all <img> tags have full domain URL and proper styles
    editor.querySelectorAll<HTMLImageElement>("img").forEach((img) => {
      const src = img.getAttribute("src");
      if (src && (src.startsWith("/files/") || src.startsWith("/private/files/"))) {
        img.src = `https://hrms.gopocket.in${src}`;
      }
      img.classList.add("w-full", "h-auto", "object-cover", "rounded-3xl", "my-6", "border", "border-border-light", "shadow-lg");
    });
  }

  if (document.readyState !== "loading") {
    formatProseImagesInDOM();
  } else {
    document.addEventListener("DOMContentLoaded", formatProseImagesInDOM);
  }
</script>
