      <script>
        const heroSec = document.querySelector<HTMLElement>(".home-hero");
        const bannerImg = document.querySelector<HTMLElement>(".banner-image");

        if (heroSec && bannerImg) {
          const updateHeroTilt = () => {
            if (window.innerWidth < 1024) {
              bannerImg.style.transform = "none";
              return;
            }

            const scrollY = window.scrollY || window.pageYOffset;
            const threshold = 350; // Image becomes 100% straight after scrolling 350px
            const progress = Math.max(0, Math.min(1, scrollY / threshold));

            // 3D perspective rotation tilt from 20deg down to 0deg (straight)
            const rotateX = 20 * (1 - progress);
            const scale = 0.88 + 0.12 * progress;

            if (progress >= 1) {
              bannerImg.style.transform = "perspective(75em) rotateX(0deg) scale(1)";
            } else {
              bannerImg.style.transform = `perspective(75em) rotateX(${rotateX.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
            }
            bannerImg.style.transformOrigin = "center top";
            bannerImg.style.willChange = "transform";
          };

          window.addEventListener("scroll", updateHeroTilt, { passive: true });
          window.addEventListener("resize", updateHeroTilt, { passive: true });
          updateHeroTilt();
        }
      </script>
      <script type="module" is:inline={true}>
        function r() {
          document.querySelectorAll(".marquee-element-width-auto").forEach((o) => {
            o.querySelectorAll("img").forEach((e) => {
              e.complete ? s(e) : e.addEventListener("load", () => s(e));
            });
            const a = o.scrollWidth;
            o.style.setProperty("--total-width", `${a / 2}px`);
          });
        }
        function s(t) {
          const o = getComputedStyle(t),
            i = parseFloat(o.height),
            a = t.naturalWidth / t.naturalHeight,
            e = i * a;
          (t.setAttribute("height", i.toString()), t.setAttribute("width", e.toString()));
        }
        let n;
        window.addEventListener("resize", () => {
          (clearTimeout(n), (n = window.setTimeout(r, 100)));
        });
        r();
