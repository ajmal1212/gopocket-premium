---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PartnerHero from "../components/partner/PartnerHero.astro";
import ReferLink from "../components/refer/ReferLink.astro";
import ReferABC from "../components/refer/ReferABC.astro";
import ReferDirect from "../components/refer/ReferDirect.astro";
import ReferEarnings from "../components/refer/ReferEarnings.astro";
import FAQSection from "../components/FAQSection.astro";
import CallToAction2 from "../components/CallToAction2.astro";

// The hero is PartnerHero itself rather than a third copy of the research-learn
// layout: every piece of its copy, both stat cards and both images are props,
// so this page only has to pass its own. Its two stat icons (rupee, calendar)
// happen to fit this page's stats as well.

// Every answer below restates the Refer & Earn T&C (/refer-and-earn-t-c); keep
// the two in step if the scheme changes.
const referFaqs = [
  {
    id: "refer-faq-1",
    category: "Earnings",
    question: "How much can I earn by referring?",
    answer:
      "You earn up to 50% of the brokerage generated by every friend you refer. Taxes, transaction charges, SEBI and exchange charges are not included in the share.",
  },
  {
    id: "refer-faq-2",
    category: "Payouts",
    question: "When is my referral income paid?",
    answer:
      "Commission is posted to your ledger daily. Commission generated from the 26th of the previous month to the 25th of the current month is credited by the 10th of the following month, subject to a minimum of ₹1,000.",
  },
  {
    id: "refer-faq-3",
    category: "Payouts",
    question: "Is tax deducted from my referral income?",
    answer:
      "Yes. Payouts are made after TDS at 2%, or as per applicable income-tax law. If PAN and Aadhaar are not linked, or you are not compliant with Sections 206AB and 206CCA, TDS is applied at 10%.",
  },
  {
    id: "refer-faq-4",
    category: "Getting Started",
    question: "Where do I find my referral link?",
    answer:
      "Enter your GoPocket client code or AP code in the generator on this page and click Generate Link. You can copy it or share it straight to WhatsApp, Facebook or X.",
  },
  {
    id: "refer-faq-5",
    category: "Rules",
    question: "Can a referred client be moved to a different referral ID?",
    answer: "No. Clients referred under one referral ID cannot be transferred to another referral ID.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: referFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  title="Refer & Earn | Earn 50% Brokerage by Referring Friends | GoPocket"
  description="Refer friends to GoPocket and earn 50% of the brokerage on every trade they make. Generate your referral link, share it, and get paid on the 10th of every month."
  keywords="gopocket refer and earn, referral program, earn brokerage, refer a friend, stock broker referral india, 50% brokerage sharing"
  canonical="/refer-and-earn"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <Header currentPath="/refer-and-earn" />

  <main class="has-section-spacing-lg">
    <PartnerHero
      ratingText="Earn on every friend who trades"
      title={"Be your own boss.\nRefer and earn 50%."}
      description="Earn 50% of the brokerage on every trade your friends make. Generate your link, share it with friends and family, and get paid on the 10th of every month."
      ctaText="Generate Your Link"
      ctaHref="#refer-link"
      leftStat="50%"
      leftStatLabel="Of Referral Brokerage"
      leftImage="/assets/images/career-gallery-1.webp"
      leftImageAlt="The GoPocket office floor"
      rightStat="10th"
      rightStatLabel="Credited Every Month"
      rightImage="/assets/images/career-gallery-4.webp"
      rightImageAlt="A GoPocket office workspace"
    />
    <ReferLink />
    <ReferABC />
    <ReferDirect />
    <ReferEarnings />
    <FAQSection
      faqs={referFaqs}
      eyebrow="Referral Questions"
      title="Frequently Asked Questions"
      description="What most people ask before sharing their GoPocket referral link."
    />
    <CallToAction2 />
  </main>

  <Footer />
</Layout>
