---
/**
 * Client-side clean-up for Quill-authored article bodies, shared by the blog
 * and news article pages: absolute-ises image URLs, applies the prose image
 * styling, and turns bare Quill tables into scrollable tables with a real
 * header row. Rendering it once per page is enough - Astro bundles the script
 * for the whole page, not per instance.
 */
---

<script>
  function formatProseImagesInDOM() {
    const editor = document.querySelector<HTMLElement>(".ql-editor");
    if (!editor) return;

    let html = editor.innerHTML;

    // 1. Mask existing <img> tag src attributes so they don't contain '/files/'
    html = html.replace(/src=["']([^"']+)["']/gi, (match, srcVal) => {
      if (srcVal.includes("/files/") || srcVal.includes("/private/files/")) {
        const fullUrl = srcVal.startsWith("http")
          ? srcVal
          : `https://hrms.gopocket.in${srcVal.startsWith("/") ? "" : "/"}${srcVal}`;
        const masked = fullUrl
          .replace("/files/", "/__MASKED_FILES__/")
          .replace("/private/files/", "/__MASKED_PRIVATE_FILES__/");
        return `src="${masked}"`;
      }
      return match;
    });

    // 2. Convert unmasked raw /files/ text paths into responsive <img> elements,
    //    consuming any zero-width character stuck to the path (see formatPostBody
    //    in src/lib/frappe.ts for why).
    html = html.replace(
      /[\u200B-\u200D\uFEFF]*(\/(?:private\/)?files\/[^\s<>"']+\.(?:jpg|jpeg|png|webp|gif|svg)(?:\?[^\s<>"']*)?)[\u200B-\u200D\uFEFF]*/gi,
      (_match, path) => {
        const fullUrl = path.startsWith("http")
          ? path
          : `https://hrms.gopocket.in${path.startsWith("/") ? "" : "/"}${path}`;
        return `<img src="${fullUrl}" alt="Blog Image" class="w-full h-auto object-cover my-6 border border-border-light shadow-lg" loading="lazy" />`;
      },
    );

    // 3. Unmask existing <img> src attributes
    html = html.replace(/__MASKED_FILES__/g, "files").replace(/__MASKED_PRIVATE_FILES__/g, "private/files");

    editor.innerHTML = html;

    // Ensure all <img> tags have full domain URL and proper styles
    editor.querySelectorAll<HTMLImageElement>("img").forEach((img) => {
      const src = img.getAttribute("src");
      if (src && (src.startsWith("/files/") || src.startsWith("/private/files/"))) {
        img.src = `https://hrms.gopocket.in${src}`;
      }
      img.classList.add("w-full", "h-auto", "object-cover", "my-6", "border", "border-border-light", "shadow-lg");
    });
  }

  /**
   * Quill emits bare `<table class="table table-bordered"><tbody>…` with no
   * <thead>. Promote the bold first row to a real header, label every body cell
   * for the mobile card layout, and wrap the table in a scroll region with an
   * edge-fade affordance. Styling lives in src/styles/global.css.
   */
  function enhanceProseTablesInDOM() {
    const editor = document.querySelector<HTMLElement>(".ql-editor");
    if (!editor) return;

    editor.querySelectorAll<HTMLTableElement>("table").forEach((table) => {
      promoteHeaderRow(table);
      labelBodyCells(table);
      wrapInScrollRegion(table);
    });
  }

  function looksLikeHeaderRow(row: HTMLTableRowElement) {
    const cells = Array.from(row.children) as HTMLTableCellElement[];
    if (!cells.length) return false;

    return cells.every((cell) => {
      if (cell.tagName === "TH") return true;
      const text = (cell.textContent || "").trim();
      const emphasis = cell.querySelector("strong, b");
      // Every cell must be entirely bold for the row to read as a header.
      return text.length > 0 && !!emphasis && (emphasis.textContent || "").trim().length >= text.length;
    });
  }

  function promoteHeaderRow(table: HTMLTableElement) {
    if (table.tHead) return;

    const firstRow = table.querySelector<HTMLTableRowElement>("tr");
    if (!firstRow || !looksLikeHeaderRow(firstRow)) return;

    const thead = document.createElement("thead");
    const headRow = document.createElement("tr");

    Array.from(firstRow.children).forEach((cell) => {
      const th = document.createElement("th");
      th.innerHTML = cell.innerHTML;
      th.scope = "col";
      ["colspan", "rowspan", "style"].forEach((attr) => {
        const value = cell.getAttribute(attr);
        if (value) th.setAttribute(attr, value);
      });
      headRow.appendChild(th);
    });

    thead.appendChild(headRow);
    firstRow.remove();
    table.insertBefore(thead, table.firstChild);
  }

  function labelBodyCells(table: HTMLTableElement) {
    const labels = Array.from(table.querySelectorAll("thead th, thead td")).map((cell) =>
      (cell.textContent || "").trim(),
    );
    if (!labels.length) return;

    table.querySelectorAll<HTMLTableRowElement>("tbody tr").forEach((row) => {
      Array.from(row.children).forEach((cell, index) => {
        const label = labels[index];
        if (label) cell.setAttribute("data-label", label);
      });
    });
  }

  function wrapInScrollRegion(table: HTMLTableElement) {
    const parent = table.parentElement;
    if (!parent || parent.classList.contains("blog-table-scroll")) return;

    const wrap = document.createElement("div");
    wrap.className = "blog-table-wrap";

    const scroller = document.createElement("div");
    scroller.className = "blog-table-scroll";
    scroller.setAttribute("role", "region");
    scroller.setAttribute("aria-label", "Table");
    scroller.tabIndex = 0;

    parent.insertBefore(wrap, table);
    wrap.appendChild(scroller);
    scroller.appendChild(table);

    const syncScrollState = () => {
      const overflow = scroller.scrollWidth - scroller.clientWidth;
      wrap.classList.toggle("is-scrollable", overflow > 4);
      wrap.classList.toggle("is-scrolled-end", scroller.scrollLeft >= overflow - 4);
    };

    scroller.addEventListener("scroll", syncScrollState, { passive: true });
    window.addEventListener("resize", syncScrollState);
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(syncScrollState).observe(scroller);
    }
    syncScrollState();
  }

  function enhanceProseContent() {
    formatProseImagesInDOM();
    enhanceProseTablesInDOM();
  }

  if (document.readyState !== "loading") {
    enhanceProseContent();
  } else {
    document.addEventListener("DOMContentLoaded", enhanceProseContent);
  }
</script>
