---
// KeyInsights2 Component
---

<section>
  <div class="bg-theme-light py-20 md:py-32">
    <div class="container">
      <div class="grid-cols-1 space-y-10 md:grid lg:grid-cols-2 xl:grid-cols-3 xl:space-y-0">
        <div
          class="mx-auto flex justify-center text-center max-md:flex-wrap md:gap-x-20 md:text-start lg:mt-10 lg:block"
        >
          <h2 class="has-italic-text mb-4 capitalize">
            <div
              data-duration="0.6"
              data-delay="0.2"
              data-stagger="0.09"
              class="animated-text is-ready"
              style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
            >
              <span class="word" style="--word-index:0">Open</span>
              <span class="word" style="--word-index:1">An</span>
              <span class="word" style="--word-index:2">Account</span>
              <br />
              <span class="word" style="--word-index:3">In</span>
              <strong
                ><span class="word" style="--word-index:4">Five</span>
                <span class="word" style="--word-index:5">Minutes</span></strong
              >
            </div>
          </h2>
          <div>
            <p
              data-duration="0.7"
              data-delay="0.5"
              data-stagger="0.0009"
              class="mb-11 lg:mb-11 animated-text is-ready"
              style="--animated-text-duration:0.7s;--animated-text-delay:0.5s;--animated-text-stagger:0.0009s;"
            >
              <span class="word" style="--word-index:0">Zero</span>
              <span class="word" style="--word-index:1">account</span>
              <span class="word" style="--word-index:2">opening</span>
              <span class="word" style="--word-index:3">charges</span>
              <span class="word" style="--word-index:4">and</span>
              <span class="word" style="--word-index:5">a</span>
              <span class="word" style="--word-index:6">100%</span>
              <span class="word" style="--word-index:7">online</span>
              <span class="word" style="--word-index:8">process.</span>
              <span class="word" style="--word-index:9">Bring</span>
              <span class="word" style="--word-index:10">a</span>
              <span class="word" style="--word-index:11">friend</span>
              <span class="word" style="--word-index:12">along</span>
              <span class="word" style="--word-index:13">and</span>
              <span class="word" style="--word-index:14">earn</span>
              <span class="word" style="--word-index:15">from</span>
              <span class="word" style="--word-index:16">every</span>
              <span class="word" style="--word-index:17">successful</span>
              <span class="word" style="--word-index:18">referral.</span>
            </p>
            <div data-aos="fade-up-sm" data-aos-delay="300" class="aos-init">
              <a class="btn btn-primary text-flip-hover-anim" href="/open-account-call-back?src=Website&tag=Products"
                ><span class="text-flip-inner" data-content="OPEN AN ACCOUNT">OPEN AN ACCOUNT</span></a
              >
            </div>
          </div>
        </div>
        <div class="space-y-10 gap-x-8 md:grid md:grid-cols-2 *:even:md:mt-12 xl:col-span-2 xl:ps-48">
          <div
            data-aos-delay="400"
            data-aos="reveal-anim-down"
            class="flex flex-col space-y-4 rounded-t-4xl bg-linear-to-b from-white to-transparent px-8 pt-12 aos-init"
          >
            <div class="mb-10 flex items-center gap-3">
              <div class="bg-secondary/10 flex h-14 w-14 items-center justify-center rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  data-lucide="CircleDashed"
                  class="text-secondary mx-auto block h-6 w-6"
                  ><path d="M10.1 2.182a10 10 0 0 1 3.8 0"></path><path d="M13.9 21.818a10 10 0 0 1-3.8 0"></path><path
                    d="M17.609 3.721a10 10 0 0 1 2.69 2.7"></path><path d="M2.182 13.9a10 10 0 0 1 0-3.8"></path><path
                    d="M20.279 17.609a10 10 0 0 1-2.7 2.69"></path><path d="M21.818 10.1a10 10 0 0 1 0 3.8"></path><path
                    d="M3.721 6.391a10 10 0 0 1 2.7-2.69"></path><path d="M6.391 20.279a10 10 0 0 1-2.69-2.7"
                  ></path></svg
                >
              </div>
              <span>Onboarding</span>
            </div>
            <h3 class="mb-4">
              <div class="inline-flex place-items-stretch leading-none has-animated-number text-dark h2">
                <span data-count="5" style="" class="odometer odometer-auto-theme"
                  ><div class="odometer-inside">
                    <span class="odometer-digit"
                      ><span class="odometer-digit-spacer">8</span><span class="odometer-digit-inner"
                        ><span class="odometer-ribbon"
                          ><span class="odometer-ribbon-inner"><span class="odometer-value">0</span></span></span
                        ></span
                      ></span
                    >
                  </div></span
                >
                <span class="append"> min</span>
              </div>
              <span class="h4 text-text-default">start to finish</span>
            </h3>
            <p>Open your GoPocket account online, in about five minutes.</p>
          </div><div
            data-aos-delay="400"
            data-aos="reveal-anim-up"
            class="flex flex-col space-y-4 rounded-t-4xl bg-linear-to-b from-white to-transparent px-8 pt-12 aos-init"
          >
            <div class="mb-10 flex items-center gap-3">
              <div class="bg-secondary/10 flex h-14 w-14 items-center justify-center rounded-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  data-lucide="MessagesSquare"
                  class="text-secondary mx-auto block h-6 w-6"
                  ><path
                    d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"
                  ></path><path
                    d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1"
                  ></path></svg
                >
              </div>
              <span>Refer &amp; Earn</span>
            </div>
            <h3 class="mb-4">
              <div class="inline-flex place-items-stretch leading-none has-animated-number text-dark h2">
                <span data-count="50" style="" class="odometer odometer-auto-theme"
                  ><div class="odometer-inside">
                    <span class="odometer-digit"
                      ><span class="odometer-digit-spacer">8</span><span class="odometer-digit-inner"
                        ><span class="odometer-ribbon"
                          ><span class="odometer-ribbon-inner"><span class="odometer-value">0</span></span></span
                        ></span
                      ></span
                    >
                  </div></span
                >
                <span class="append">%</span>
              </div>
              <span class="h4 text-text-default">brokerage share</span>
            </h3>
            <p>Invite a friend and earn 50% of the brokerage from every successful referral.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
