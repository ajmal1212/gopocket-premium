---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQSection2 from "../components/FAQSection2.astro";
import CalculatorSidebar from "../components/calculators/CalculatorSidebar.astro";

/*
 * PPF calculator. Same layout as the SIP, SWP and EMI calculator pages: boxed
 * calculator with sliders and a doughnut chart, the shared sidebar, then the
 * explainer, schedule table, formula, comparison table and FAQs.
 *
 * Deposits are modelled at the start of each financial year and interest is
 * compounded yearly. That matches a deposit made by 5 April, which is when a
 * PPF deposit earns interest for the whole year (interest is worked out on
 * the lowest balance between the 5th and the end of each month).
 *
 * The rate is an input because the government resets it every quarter; 7.1%
 * is only the starting value.
 */

const inputs = {
  deposit: { min: 500, max: 150000, step: 500, value: 100000 },
  rate: { min: 1, max: 15, step: 0.1, value: 7.1 },
  // The account runs 15 years and can then be extended in blocks of 5.
  tenure: { min: 15, max: 50, step: 5, value: 15 },
};

const faqItems = [
  {
    question: "What is the Public Provident Fund (PPF)?",
    answer:
      "PPF is a long-term savings scheme backed by the Government of India. You deposit between ₹500 and ₹1,50,000 each financial year for 15 years, and earn a government-set interest rate that compounds every year.",
  },
  {
    question: "How does the GoPocket PPF Calculator work?",
    answer:
      "Enter your yearly deposit, the interest rate and the number of years. The calculator compounds your balance year by year and shows the total you invested, the interest earned and your maturity value.",
  },
  {
    question: "Is PPF interest tax-free?",
    answer:
      "Yes. PPF has EEE status: deposits qualify for a deduction under Section 80C (up to ₹1.5 lakh a year, under the old tax regime), and both the interest earned and the maturity amount are tax-free.",
  },
  {
    question: "Can I withdraw from my PPF account before 15 years?",
    answer:
      "Partial withdrawals are allowed from the 7th financial year, subject to limits, and you can take a loan against the balance between the 3rd and 6th years. Premature closure is permitted only in specific cases such as serious illness or higher education.",
  },
  {
    question: "What happens after my PPF account matures?",
    answer:
      "You can withdraw the full balance, or extend the account in blocks of 5 years - with or without fresh deposits. The balance keeps earning interest during an extension, which is why this calculator lets you go beyond 15 years.",
  },
];

const faqCategories = [{ id: "ppf-faqs", label: "PPF FAQs", items: faqItems }];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const savingsOptions = [
  {
    name: "PPF",
    lockIn: "15 years (partial withdrawal from year 7)",
    returns: "Set by the government, reviewed quarterly",
    risk: "Very low - government-backed",
    tax: "Tax-free (EEE)",
  },
  {
    name: "ELSS Mutual Funds",
    lockIn: "3 years",
    returns: "Market-linked",
    risk: "High - equity exposure",
    tax: "Gains above the yearly exemption are taxed",
  },
  {
    name: "National Savings Certificate (NSC)",
    lockIn: "5 years",
    returns: "Fixed at purchase, set by the government",
    risk: "Very low - government-backed",
    tax: "Interest is taxable",
  },
  {
    name: "Tax-Saver Fixed Deposit",
    lockIn: "5 years",
    returns: "Fixed by the bank",
    risk: "Low",
    tax: "Interest is taxable",
  },
  {
    name: "Sukanya Samriddhi Yojana",
    lockIn: "Until the girl turns 21",
    returns: "Set by the government, reviewed quarterly",
    risk: "Very low - government-backed",
    tax: "Tax-free (EEE)",
  },
];
---

<Layout
  title="PPF Calculator Online | Calculate Public Provident Fund Returns | GoPocket"
  description="Calculate your PPF maturity amount with GoPocket's free PPF Calculator. See total investment, interest earned and year-by-year growth of your Public Provident Fund account."
  canonical="/ppf-calculator"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header currentPath="/ppf-calculator" />

  <main class="pt-8 md:pt-14 pb-16">
    <div class="container max-w-[1400px] px-4 sm:px-6 space-y-12">
      <div class="mb-8">
        <h1 class="h3 font-bold text-dark tracking-tight">PPF Calculator</h1>
      </div>

      <!-- Main Grid Container (8 Cols Left + 4 Cols Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- LEFT COLUMN: Calculator Card (8 Cols) -->
        <div class="lg:col-span-8 space-y-8">
          <div
            class="bg-white dark:bg-[#14161f] border border-gray-200 dark:border-[#262938] rounded-2xl p-6 sm:p-8 md:p-10 space-y-8"
          >
            <!-- TOP GRID: Sliders (7 Cols) & Chart (5 Cols) -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
              <div class="md:col-span-7 space-y-8">
                <!-- 1. Yearly investment -->
                <div class="space-y-4">
                  <div class="flex items-center justify-between gap-4">
                    <label for="deposit-input" class="text-sm sm:text-base font-semibold text-dark">
                      Yearly investment
                    </label>
                    <div
                      class="flex items-center bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl px-4 py-1.5"
                    >
                      <span class="text-sm sm:text-base font-bold text-primary mr-1">₹</span>
                      <input
                        type="number"
                        id="deposit-input"
                        value={inputs.deposit.value}
                        min={inputs.deposit.min}
                        max={inputs.deposit.max}
                        step={inputs.deposit.step}
                        class="w-28 text-right font-extrabold text-primary text-base sm:text-lg bg-transparent focus:outline-none"
                      />
                    </div>
                  </div>
                  <input
                    type="range"
                    id="deposit-slider"
                    aria-label="Yearly investment"
                    min={inputs.deposit.min}
                    max={inputs.deposit.max}
                    step={inputs.deposit.step}
                    value={inputs.deposit.value}
                    class="ppf-minimal-slider"
                  />
                </div>

                <!-- 2. Interest rate -->
                <div class="space-y-4">
                  <div class="flex items-center justify-between gap-4">
                    <label for="interest-rate-input" class="text-sm sm:text-base font-semibold text-dark">
                      Rate of interest (p.a)
                    </label>
                    <div
                      class="flex items-center bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl px-4 py-1.5"
                    >
                      <input
                        type="number"
                        id="interest-rate-input"
                        value={inputs.rate.value}
                        min={inputs.rate.min}
                        max={inputs.rate.max}
                        step={inputs.rate.step}
                        class="w-20 text-right font-extrabold text-primary text-base sm:text-lg bg-transparent focus:outline-none"
                      />
                      <span class="text-sm sm:text-base font-bold text-primary ml-1">%</span>
                    </div>
                  </div>
                  <input
                    type="range"
                    id="interest-rate-slider"
                    aria-label="Rate of interest per annum"
                    min={inputs.rate.min}
                    max={inputs.rate.max}
                    step={inputs.rate.step}
                    value={inputs.rate.value}
                    class="ppf-minimal-slider"
                  />
                </div>

                <!-- 3. Time period -->
                <div class="space-y-4">
                  <div class="flex items-center justify-between gap-4">
                    <label for="time-period-input" class="text-sm sm:text-base font-semibold text-dark">
                      Time period
                    </label>
                    <div
                      class="flex items-center bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl px-4 py-1.5"
                    >
                      <input
                        type="number"
                        id="time-period-input"
                        value={inputs.tenure.value}
                        min={inputs.tenure.min}
                        max={inputs.tenure.max}
                        step={inputs.tenure.step}
                        class="w-20 text-right font-extrabold text-primary text-base sm:text-lg bg-transparent focus:outline-none"
                      />
                      <span class="text-sm sm:text-base font-bold text-primary ml-1">Yr</span>
                    </div>
                  </div>
                  <input
                    type="range"
                    id="time-period-slider"
                    aria-label="Time period in years"
                    min={inputs.tenure.min}
                    max={inputs.tenure.max}
                    step={inputs.tenure.step}
                    value={inputs.tenure.value}
                    class="ppf-minimal-slider"
                  />
                  <p class="text-xs sm:text-sm text-text-default opacity-70">
                    15-year lock-in, extendable in blocks of 5 years.
                  </p>
                </div>
              </div>

              <!-- CHART & LEGEND (5 Cols) -->
              <div class="md:col-span-5 flex flex-col items-center justify-center space-y-4">
                <div class="flex items-center justify-center gap-6 text-xs sm:text-sm text-text-default font-semibold">
                  <div class="flex items-center gap-2">
                    <span class="w-3.5 h-2 rounded-full bg-primary/20 inline-block"></span>
                    <span class="opacity-80">Total investment</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-3.5 h-2 rounded-full bg-primary inline-block"></span>
                    <span class="opacity-80">Total interest</span>
                  </div>
                </div>

                <div class="relative w-52 h-52 sm:w-64 sm:h-64 flex items-center justify-center">
                  <canvas
                    id="ppf-chart"
                    width="240"
                    height="240"
                    aria-label="Total investment versus total interest"
                    role="img"></canvas>
                </div>
              </div>
            </div>

            <!-- BOTTOM ROW: Summary Stats (7 Cols, aligned under the sliders) -->
            <div
              class="pt-8 border-t border-gray-100 dark:border-[#262938] grid grid-cols-1 md:grid-cols-12 gap-6 items-end"
            >
              <div class="md:col-span-7 space-y-3.5 text-sm sm:text-base">
                <div class="flex items-center justify-between gap-4">
                  <span class="text-text-default opacity-70 font-semibold">Total investment</span>
                  <span id="output-invested" class="font-extrabold text-dark text-base sm:text-lg text-right"
                    >₹15,00,000</span
                  >
                </div>
                <div class="flex items-center justify-between gap-4">
                  <span class="text-text-default opacity-70 font-semibold">Total interest</span>
                  <span id="output-interest" class="font-extrabold text-primary text-base sm:text-lg text-right"
                    >₹12,12,139</span
                  >
                </div>
                <div class="flex items-center justify-between gap-4 pt-1">
                  <span class="text-text-default opacity-70 font-semibold">Maturity value</span>
                  <span id="output-maturity" class="font-black text-dark text-lg sm:text-xl text-right">₹27,12,139</span
                  >
