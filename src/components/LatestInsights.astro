---
import { getBlogPosts } from "../lib/frappe";

// Latest three published blogs (limit_page_length = 3, newest first)
const posts = await getBlogPosts(3);
---

{
  posts.length > 0 && (
    <section>
      <div class="container space-y-10 md:space-y-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="has-italic-text capitalize">
            <div
              class="animated-text is-ready"
              data-duration="0.6"
              data-delay="0.2"
              data-stagger="0.09"
              style="--animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
            >
              {/* Inside a JSX expression Astro collapses the newlines between
                  these spans, so the word gaps must be explicit. */}
              <span class="word" style="--word-index:0">Latest</span>{" "}
              <span class="word" style="--word-index:1">Insights</span>{" "}
              <span class="word" style="--word-index:2">From</span>{" "}
              <span class="word" style="--word-index:3">
                <strong>Our</strong>
              </span>{" "}
              <strong>
                <span class="word" style="--word-index:4">Expert</span>
              </strong>
            </div>
          </h2>
        </div>
        <div class="grid gap-x-6 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
          {posts.map((post, index) => (
            <article
              class="bg-theme-light rounded-2xl p-6 aos-init"
              data-aos-delay={`${(index + 1) * 100}`}
              data-aos="fade-right-sm"
            >
              <div class="group after:from-theme-light relative flex items-center justify-center overflow-hidden rounded-xl via-20% after:pointer-events-none after:absolute after:inset-0 after:z-10 after:hidden after:bg-linear-to-t after:to-transparent after:transition-opacity after:duration-500 after:md:block after:md:opacity-0 hover:md:after:opacity-100">
                <span class="text-dark pointer-events-none absolute z-20 hidden h-16 w-16 items-center justify-center rounded-full bg-white transition duration-500 md:flex md:opacity-0 group-hover:md:opacity-100">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    data-lucide="ArrowUpRight"
                    class="text-2xl"
                  >
                    <path d="M7 7h10v10" />
                    <path d="M7 17 17 7" />
                  </svg>
                </span>
                <div class="w-full overflow-hidden rounded-2xl border-4 border-white">
                  <img
                    src={post.thumbnailImage || post.mainImage}
                    alt={post.title}
                    loading="lazy"
                    decoding="async"
                    width="640"
                    height="550"
                    class="min-w-full aspect-[640/550] object-cover transition duration-500 group-hover:scale-105"
                  />
                </div>
                <a class="absolute inset-0 z-30" href={`/blog/${post.slug}`}>
                  <span class="sr-only">Learn more about {post.title}</span>
                </a>
              </div>
              <div class="space-y-3 mt-4">
                <div class="font-primary text-text-default flex flex-wrap items-center gap-x-2.5 gap-y-px text-xs font-medium opacity-80">
                  <span>{post.formattedDate}</span>
                  <span class="bg-dark inline-block h-1 w-1 rounded-full" />
                  <span class="text-inherit">{post.category}</span>
                </div>
                <h3 class="text-base md:text-lg font-semibold leading-snug mb-3 text-gray-900 dark:text-white">{post.title}</h3>
                <a
                  class="btn btn-outline text-flip-hover-anim btn-sm btn-outline-white mt-3 capitalize"
                  href={`/blog/${post.slug}`}
                >
                  <span class="text-flip-inner" data-content="Read More">
                    Read More
                  </span>
                  <span class="sr-only">Read more about {post.title}</span>
                  <span class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]">
                    <svg
                      class="gradient-shape"
                      width="150"
                      height="28"
                      viewBox="0 0 147 11"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                        stroke="currentColor"
                        stroke-width="8"
                      />
                    </svg>
                  </span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
