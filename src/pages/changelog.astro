---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Changelog - Multipurpose Saas & Startup Astro Js Theme" description="This is a example description">
  <Header currentPath="/changelog/" />
  <main class="has-section-spacing-lg">
    <div
      class="page-loader pointer-events-none fixed bottom-0 left-0 z-50 size-full bg-white transition duration-300 [.inactive]:opacity-0 inactive"
    >
      <script type="module" is:inline>
        const e = document.querySelector(".page-loader");
        document.addEventListener("DOMContentLoaded", () => {
          e &&
            setTimeout(() => {
              e.classList.add("inactive");
            }, 100);
        });
      </script>
    </div>
    <main class="has-section-spacing-lg">
      <section class="relative z-10 mt-0 py-14 md:pt-32 md:pb-24">
