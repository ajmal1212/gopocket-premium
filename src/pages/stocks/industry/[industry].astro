---
/** /stocks/industry/<slug> - see StockCategoryPage for what these landing pages are for. */
import StockCategoryPage from "@/components/stocks/StockCategoryPage.astro";
import { findCategory } from "@/components/stocks/stock-categories";

const category = findCategory("industry", Astro.params.industry ?? "");
if (!category) {
  return new Response(null, { status: 404, statusText: "Not found" });
}
---

<StockCategoryPage category={category} />
