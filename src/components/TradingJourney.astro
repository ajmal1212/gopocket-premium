---

<section>
  <div class="bg-theme-light py-20 md:py-32">
    <div class="container space-y-10 md:space-y-16">
      <div class="mx-auto max-w-lg text-center">
        <h2 class="has-italic-text capitalize">
          <div
            class="animated-text is-ready is-animated"
            data-duration="0.6"
            data-delay="0.2"
            data-stagger="0.09"
            style="font-weight: 600; --animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
          >
            <span class="word" style="--word-index:0">Simplify</span>
            <span class="word" style="--word-index:1">Your</span>
            <span class="word" style="--word-index:2">
              <strong>Workflow</strong>
            </span>
          </div>
        </h2>
      </div>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div
          data-aos="fade-right-sm"
          data-aos-delay="250"
          class="space-y-16 rounded-4xl bg-white p-8 md:space-y-32 aos-init aos-animate"
        >
          <div
            class="prose-em:not-italic prose-em:text-dark/80 flex flex-wrap items-center justify-between gap-y-4 font-medium text-black"
          >
            <div class="md:text-h3 text-h3-sm">Step <em>01</em></div>
            <a
              class="text-text-default rounded-full border px-9 py-1.5 text-sm! capitalize transition-colors duration-300 hover:border-black/50"
              href="/features">Explore</a
            >
          </div>
          <div class="space-y-4">
            <h3 class="md:text-h5 text-h5-sm text-black">Open Your Account</h3>
            <p class="border-t pt-4 text-gray-600">Invite your team and start projects instantly.</p>
          </div>
        </div>
        <div
          data-aos="fade-right-sm"
          data-aos-delay="350"
          class="space-y-16 rounded-4xl bg-white p-8 md:space-y-32 aos-init aos-animate"
        >
          <div
            class="prose-em:not-italic prose-em:text-dark/80 flex flex-wrap items-center justify-between gap-y-4 font-medium text-black"
          >
            <div class="md:text-h3 text-h3-sm">Step <em>02</em></div>
            <a
              class="text-text-default rounded-full border px-9 py-1.5 text-sm! capitalize transition-colors duration-300 hover:border-black/50"
              href="/features">Explore</a
            >
          </div>
          <div class="space-y-4">
            <h3 class="md:text-h5 text-h5-sm text-black">Monitor &amp; Analyze</h3>
            <p class="border-t pt-4 text-gray-600">Real-time track progress and satisfaction.</p>
          </div>
        </div>
        <div
          data-aos="fade-right-sm"
          data-aos-delay="450"
          class="space-y-16 rounded-4xl bg-white p-8 md:space-y-32 aos-init aos-animate"
        >
          <div
            class="prose-em:not-italic prose-em:text-dark/80 flex flex-wrap items-center justify-between gap-y-4 font-medium text-black"
          >
            <div class="md:text-h3 text-h3-sm">Step <em>03</em></div>
            <a
              class="text-text-default rounded-full border px-9 py-1.5 text-sm! capitalize transition-colors duration-300 hover:border-black/50"
              href="/features">Explore</a
            >
          </div>
          <div class="space-y-4">
            <h3 class="md:text-h5 text-h5-sm text-black">Automate &amp; Protect</h3>
            <p class="border-t pt-4 text-gray-600">Use smart automation and instant alerts.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
