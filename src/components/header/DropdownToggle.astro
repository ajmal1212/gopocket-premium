---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = "" } = Astro.props;
---

<span class={`nav-dropdown-toggle hs-dropdown-toggle flex items-center nav-link ${className}`.trim()}>
  {label}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    data-icon=""
    class="hs-dropdown-open:rotate-180 ml-2 h-4 w-4 transition duration-300"
  >
    <path d="m6 9 6 6 6-6"></path>
  </svg>
</span>
