---
/**
 * Horizontal, scroll-snapping row of link cards to the rest of the site. Native
 * overflow scrolling keeps it swipeable on touch and needs no carousel script.
 */
import Button from "@/components/Button.astro";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { exploreCards } from "./webapp-data";
---

<section class="webapp-explore">
  <div class="container">
    <div class="mb-10 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <h2
        data-aos="fade-up-sm"
        class="has-italic-text text-dark text-h4 max-w-xl font-medium tracking-tight md:text-h3 lg:text-h2"
      >
        Growing stronger with <strong>GoPocket</strong>
      </h2>
      <Button label="View all products" href="/products" variant="outline" glow={false} />
    </div>

    <ul
      class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:thin] md:-mx-0 md:px-0"
    >
      {
        exploreCards.map((card) => (
          <li class="w-[85%] shrink-0 snap-start sm:w-[22rem]">
            <a
              href={card.href}
              class="group bg-theme-light border-border-light flex h-full flex-col gap-6 rounded-3xl border p-6 transition-shadow hover:shadow-lg"
            >
              <div class="flex items-center justify-between">
                <span class="text-primary flex h-11 w-11 items-center justify-center rounded-2xl bg-white">
                  <card.icon class="h-5 w-5" stroke-width={1.8} aria-hidden="true" />
                </span>
                <span class="bg-dark flex h-10 w-10 items-center justify-center rounded-full text-white transition-transform group-hover:rotate-45">
                  <ArrowUpRight class="h-5 w-5" stroke-width={1.8} aria-hidden="true" />
                </span>
              </div>
              <h3 class="text-dark text-h6 font-medium">{card.title}</h3>
              <div class="mt-auto overflow-hidden rounded-2xl bg-white">
                <img
                  src={card.image}
                  alt={card.imageAlt}
                  aria-hidden="true"
                  width="900"
                  height="400"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
