<span class="line"></span>
<span class="line"><span style="color:#800000">&lt;</span><span style="color:#267F99">CustomButton</span><span style="color:#E50000"> hoverEffect</span><span style="color:#000000">=</span><span style="color:#A31515">"magnetic"</span><span style="color:#E50000"> label</span><span style="color:#000000">=</span><span style="color:#A31515">"Magnetic"</span><span style="color:#E50000"> url</span><span style="color:#000000">=</span><span style="color:#A31515">"/"</span><span style="color:#800000"> /&gt;</span></span>
<span class="line"></span>
<span class="line"><span style="color:#001080">This</span><span style="color:#001080"> button</span><span style="color:#001080"> has</span><span style="color:#001080"> text</span><span style="color:#000000">-</span><span style="color:#001080">flip</span><span style="color:#001080"> hover</span><span style="color:#001080"> animation</span></span>
<span class="line"></span>
<span class="line"><span style="color:#800000">&lt;</span><span style="color:#267F99">CustomButton</span><span style="color:#E50000"> hoverEffect</span><span style="color:#000000">=</span><span style="color:#A31515">"text-flip"</span><span style="color:#E50000"> label</span><span style="color:#000000">=</span><span style="color:#A31515">"Text Flip"</span><span style="color:#E50000"> url</span><span style="color:#000000">=</span><span style="color:#A31515">"/"</span><span style="color:#800000"> /&gt;</span></span>
<span class="line"></span>
<span class="line"><span style="color:#001080">This</span><span style="color:#001080"> button</span><span style="color:#001080"> has</span><span style="color:#001080"> magnetic</span><span style="color:#001080"> and</span><span style="color:#001080"> text</span><span style="color:#000000">-</span><span style="color:#001080">flip</span><span style="color:#001080"> together</span><span style="color:#001080"> hover</span><span style="color:#001080"> animation</span></span>
<span class="line"></span>
<span class="line"><span style="color:#800000">&lt;</span><span style="color:#267F99">CustomButton</span></span>
<span class="line"><span style="color:#E50000">  hoverEffect</span><span style="color:#000000">=</span><span style="color:#A31515">"magnetic-text-flip"</span></span>
