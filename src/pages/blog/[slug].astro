---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import FAQSection2 from "../../components/FAQSection2.astro";
import { getBlogPostBySlugOrId } from "../../lib/frappe";

const { slug } = Astro.params;

// Fetch individual blog post from Frappe with fields=["*"]
const post = slug ? await getBlogPostBySlugOrId(slug) : null;

if (!post) {
  return Astro.redirect("/blog");
}

// FAQSection2 renders its FAQs grouped under category tabs, but a post's FAQ
// rows are a flat list, so present them as one group labelled with the post's
// primary category. The tab bar hides itself when there is only one group.
const faqCategories = post.faqs.length
  ? [
      {
        id: "article",
        label: post.categories[0] || "General",
        items: post.faqs.map(({ question, answer }) => ({ question, answer }))
      }
    ]
  : [];

const SITE = "https://gopocket.in";
const postUrl = `${SITE}/blog/${post.slug}`;

// Both images point at the same file when a post only sets one of them, so
// de-duplicate before handing the list to schema.org.
const schemaImages = [...new Set([post.mainImage, post.thumbnailImage].filter(Boolean))];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description || post.summary,
  image: schemaImages,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  datePublished: post.publishedISO,
  dateModified: post.modifiedISO || post.publishedISO,
  articleSection: post.categories,
  keywords: post.categories.join(", "),
  inLanguage: "en",
  author: { "@type": "Organization", name: "GoPocket", url: `${SITE}/` },
  publisher: {
    "@type": "Organization",
    name: "GoPocket",
    url: `${SITE}/`,
    logo: { "@type": "ImageObject", url: `${SITE}/gopocket-logo.svg` }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog` },
    { "@type": "ListItem", position: 3, name: post.title, item: postUrl }
  ]
};

// Only emit FAQPage when the post actually carries FAQ rows - an empty
// mainEntity is invalid and Google flags it.
const faqSchema = post.faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: post.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    }
  : null;
---

<Layout
  title={`${post.title} - GoPocket Blog`}
  description={post.description || post.summary}
  canonical={postUrl}
  ogImage={post.thumbnailImage}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.publishedISO} />
    <meta property="article:modified_time" content={post.modifiedISO || post.publishedISO} />
    <meta property="article:publisher" content="https://gopocket.in/" />
    {post.categories[0] && <meta property="article:section" content={post.categories[0]} />}
    {post.categories.map((category) => <meta property="article:tag" content={category} />)}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>
  <Header currentPath="/blog" />

  <main class="has-section-spacing-lg pt-8 md:pt-16">
    <!-- Article Header -->
    <section class="relative z-10 py-8 md:py-14">
      <div class="container max-w-7xl">
        <div class="max-w-4xl mx-auto text-center space-y-5">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-semibold tracking-wide uppercase"
          >
            {
              post.categories.map((category) => (
                <>
                  <span>{category}</span>
                  <span class="opacity-40">•</span>
                </>
              ))
            }
            <span>{post.formattedDate}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-dark tracking-tight leading-tight">
            {post.title}
          </h1>

          {
            post.description && (
              <p class="text-lg md:text-xl text-text-default opacity-80 max-w-3xl mx-auto leading-relaxed">
                {post.description}
              </p>
            )
          }
        </div>

        <!-- Main Featured Image -->
        {
          post.mainImage && (
            <div class="max-w-7xl mx-auto mt-8 md:mt-12 rounded-3xl overflow-hidden border border-border-light shadow-lg aspect-[1150/500] w-full bg-white">
              <img
                src={post.mainImage}
                alt={post.title}
                class="w-full h-full object-cover rounded-3xl"
                loading="eager"
              />
            </div>
          )
        }
      </div>
    </section>

    <!-- Article Content & Always Sticky Right Sidebar CTA -->
    <section class="py-6 md:py-10">
      <div class="container max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          <!-- LEFT COLUMN: Expanded Post Content Body (9 Columns) -->
          <article
            class="lg:col-span-9 bg-theme-light px-3 py-6 sm:px-5 sm:py-10 md:px-7 md:py-12 rounded-3xl border border-border-light shadow-xs w-full overflow-hidden"
          >
            {
              post.postBody ? (
                <div class="ql-editor read-mode w-full" set:html={post.postBody} />
              ) : (
                <div class="text-center py-12 text-gray-500">
                  <p>No content available for this article.</p>
                </div>
              )
            }

            <!-- Back to Blog Button -->
            <div class="pt-8 mt-10 border-t border-border-light/80 flex items-center justify-between">
              <a href="/blog" class="btn btn-outline text-flip-hover-anim btn-sm cursor-pointer">
                <span class="text-flip-inner" data-content="← Back to All Articles">← Back to All Articles</span>
                <span
                  class="translate-x-centered absolute -bottom-2 block h-7 w-36 transform-[matrix(1,0,0,1,0,0)] blur-[10px]"
                >
                  <svg
                    class="gradient-shape"
                    width="150"
                    height="28"
                    viewBox="0 0 147 11"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M1.34766 30.8857L49.449 3.11433L97.5504 30.8857L145.652 3.11433"
                      stroke="currentColor"
                      stroke-width="8"></path>
                  </svg>
                </span>
              </a>
            </div>
          </article>

          <!-- RIGHT COLUMN: Compact Sticky Sidebar CTA (3 Columns) -->
          <aside class="lg:col-span-3 lg:sticky lg:top-28 space-y-6 w-full max-w-[340px] mx-auto lg:mx-0">
            <div
              class="relative overflow-hidden rounded-3xl bg-primary p-6 sm:p-7 shadow-lg shadow-primary/30 space-y-6"
            >
              <!-- Texture: fine dot grid over two soft colour blooms -->
              <div
                class="pointer-events-none absolute inset-0 opacity-20"
                style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 14px 14px;"
                aria-hidden="true"
              >
              </div>
              <div
                class="pointer-events-none absolute -top-20 -right-16 h-56 w-56 rounded-full bg-white/25 blur-3xl"
                aria-hidden="true"
              >
              </div>
              <div
                class="pointer-events-none absolute -bottom-24 -left-16 h-52 w-52 rounded-full bg-fuchsia-400/30 blur-3xl"
                aria-hidden="true"
              >
              </div>

              <div class="relative space-y-3">
                <div
                  class="inline-flex items-center gap-1.5 bg-white/15 ring-1 ring-white/25 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase"
                >
                  <span>GoPocket Trading</span>
                </div>
                <h3 class="blog-cta-title font-bold">Open Free Account</h3>
                <p class="text-white/80 text-sm leading-relaxed">
                  Trade Stocks, F&amp;O, Commodities &amp; IPOs at flat ₹20 per order with institutional-grade tools.
                </p>
              </div>

              <!-- Primary action -->
              <a
                href="/open-account-call-back?src=Website&tag=Blog"
                class="relative flex w-full items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-bold uppercase tracking-wider text-primary shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl"
              >
                Open Account
                <svg
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </a>

              <!-- Feature Bullets -->
              <div class="relative space-y-2.5 pt-5 border-t border-white/20 text-xs text-white/90 font-medium">
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Zero Account Opening &amp; AMC Charges</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>100% Digital 5-Minute Onboarding</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Advanced Option Chain &amp; Charts</span>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    {
      post.faqs.length > 0 && (
        <FAQSection2
          titleBold="Frequently"
          title="asked questions"
          description="Quick answers to the most common questions about this topic."
          categories={faqCategories}
        />
      )
    }

    <FinalCTA />
  </main>

  <Footer />
</Layout>

<style>
  /* global.css styles bare h1-h6 unlayered (both colour and font-size), and
     unlayered CSS outranks every @layer -- Tailwind utilities included -- so
     `text-white` / `text-2xl` on this heading would silently lose. Set it here,
     where Astro's scoped [data-astro-cid] selector wins on specificity. */
  .blog-cta-title {
    color: #fff;
    font-size: 1.5rem;
    line-height: 1.25;
  }

  @media (min-width: 640px) {
    .blog-cta-title {
      font-size: 1.75rem;
    }
  }
</style>

<script>
  function formatProseImagesInDOM() {
    const editor = document.querySelector<HTMLElement>(".ql-editor");
    if (!editor) return;

    let html = editor.innerHTML;

    // 1. Mask existing <img> tag src attributes so they don't contain '/files/'
    html = html.replace(/src=["']([^"']+)["']/gi, (match, srcVal) => {
      if (srcVal.includes("/files/") || srcVal.includes("/private/files/")) {
        const fullUrl = srcVal.startsWith("http")
          ? srcVal
          : `https://hrms.gopocket.in${srcVal.startsWith("/") ? "" : "/"}${srcVal}`;
        const masked = fullUrl
          .replace("/files/", "/__MASKED_FILES__/")
          .replace("/private/files/", "/__MASKED_PRIVATE_FILES__/");
        return `src="${masked}"`;
      }
      return match;
    });

    // 2. Convert unmasked raw /files/ text paths into responsive <img> elements
    html = html.replace(
      /(\/(?:private\/)?files\/[^\s<>"']+\.(?:jpg|jpeg|png|webp|gif|svg)(?:\?[^\s<>"']*)?)/gi,
      (match) => {
        const fullUrl = match.startsWith("http")
          ? match
          : `https://hrms.gopocket.in${match.startsWith("/") ? "" : "/"}${match}`;
        return `<img src="${fullUrl}" alt="Blog Image" class="w-full h-auto object-cover rounded-3xl my-6 border border-border-light shadow-lg" loading="lazy" />`;
      },
    );

    // 3. Unmask existing <img> src attributes
    html = html.replace(/__MASKED_FILES__/g, "files").replace(/__MASKED_PRIVATE_FILES__/g, "private/files");

    editor.innerHTML = html;

    // Ensure all <img> tags have full domain URL and proper styles
    editor.querySelectorAll<HTMLImageElement>("img").forEach((img) => {
      const src = img.getAttribute("src");
      if (src && (src.startsWith("/files/") || src.startsWith("/private/files/"))) {
        img.src = `https://hrms.gopocket.in${src}`;
      }
      img.classList.add(
        "w-full",
        "h-auto",
        "object-cover",
        "rounded-3xl",
        "my-6",
        "border",
        "border-border-light",
        "shadow-lg",
      );
    });
  }

  /**
   * Quill emits bare `<table class="table table-bordered"><tbody>…` with no
   * <thead>. Promote the bold first row to a real header, label every body cell
   * for the mobile card layout, and wrap the table in a scroll region with an
   * edge-fade affordance. Styling lives in src/styles/global.css.
   */
  function enhanceProseTablesInDOM() {
    const editor = document.querySelector<HTMLElement>(".ql-editor");
    if (!editor) return;

    editor.querySelectorAll<HTMLTableElement>("table").forEach((table) => {
      promoteHeaderRow(table);
      labelBodyCells(table);
      wrapInScrollRegion(table);
    });
  }

  function looksLikeHeaderRow(row: HTMLTableRowElement) {
    const cells = Array.from(row.children) as HTMLTableCellElement[];
    if (!cells.length) return false;

    return cells.every((cell) => {
      if (cell.tagName === "TH") return true;
      const text = (cell.textContent || "").trim();
      const emphasis = cell.querySelector("strong, b");
      // Every cell must be entirely bold for the row to read as a header.
      return text.length > 0 && !!emphasis && (emphasis.textContent || "").trim().length >= text.length;
    });
  }

  function promoteHeaderRow(table: HTMLTableElement) {
    if (table.tHead) return;

    const firstRow = table.querySelector<HTMLTableRowElement>("tr");
    if (!firstRow || !looksLikeHeaderRow(firstRow)) return;

    const thead = document.createElement("thead");
    const headRow = document.createElement("tr");

    Array.from(firstRow.children).forEach((cell) => {
      const th = document.createElement("th");
      th.innerHTML = cell.innerHTML;
      th.scope = "col";
      ["colspan", "rowspan", "style"].forEach((attr) => {
        const value = cell.getAttribute(attr);
        if (value) th.setAttribute(attr, value);
      });
      headRow.appendChild(th);
    });

    thead.appendChild(headRow);
    firstRow.remove();
    table.insertBefore(thead, table.firstChild);
  }

  function labelBodyCells(table: HTMLTableElement) {
    const labels = Array.from(table.querySelectorAll("thead th, thead td")).map((cell) =>
      (cell.textContent || "").trim(),
    );
    if (!labels.length) return;

    table.querySelectorAll<HTMLTableRowElement>("tbody tr").forEach((row) => {
      Array.from(row.children).forEach((cell, index) => {
        const label = labels[index];
        if (label) cell.setAttribute("data-label", label);
      });
    });
  }

  function wrapInScrollRegion(table: HTMLTableElement) {
    const parent = table.parentElement;
    if (!parent || parent.classList.contains("blog-table-scroll")) return;

    const wrap = document.createElement("div");
    wrap.className = "blog-table-wrap";

    const scroller = document.createElement("div");
    scroller.className = "blog-table-scroll";
    scroller.setAttribute("role", "region");
    scroller.setAttribute("aria-label", "Table");
    scroller.tabIndex = 0;

    parent.insertBefore(wrap, table);
    wrap.appendChild(scroller);
    scroller.appendChild(table);

    const syncScrollState = () => {
      const overflow = scroller.scrollWidth - scroller.clientWidth;
      wrap.classList.toggle("is-scrollable", overflow > 4);
      wrap.classList.toggle("is-scrolled-end", scroller.scrollLeft >= overflow - 4);
    };

    scroller.addEventListener("scroll", syncScrollState, { passive: true });
    window.addEventListener("resize", syncScrollState);
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(syncScrollState).observe(scroller);
    }
    syncScrollState();
  }

  function enhanceProseContent() {
    formatProseImagesInDOM();
    enhanceProseTablesInDOM();
  }

  if (document.readyState !== "loading") {
    enhanceProseContent();
  } else {
    document.addEventListener("DOMContentLoaded", enhanceProseContent);
  }
</script>
