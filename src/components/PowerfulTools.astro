---

<section>
  <div class="container space-y-10 md:space-y-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="has-italic-text capitalize">
        <div
          class="animated-text is-ready is-animated"
          data-duration="0.6"
          data-delay="0.2"
          data-stagger="0.09"
          style="font-weight: 600; --animated-text-duration:0.6s;--animated-text-delay:0.2s;--animated-text-stagger:0.09s;"
        >
          <span class="word" style="--word-index:0">Powerful</span>
          <span class="word" style="--word-index:1">Tools</span>
          <span class="word" style="--word-index:2">To</span>
          <span class="word" style="--word-index:3">Grow</span>
          <span class="word" style="--word-index:4"><strong>Your</strong></span><strong>
            <span class="word" style="--word-index:5">Portfolio</span></strong
          >
        </div>
      </h2>
    </div>
    <div class="grid gap-12 md:grid-cols-6">
      <div
        data-aos="fade-up-sm"
        data-aos-delay="300"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 aos-init aos-animate"
      >
        {
          /* One file, no srcset. The six `realtime-report-*` variants were not
            one picture at six sizes: only -4 was the GoPocket market-data
            artwork, and the other five were still the template's payments
            graphic — so every width but exactly 805w served the wrong image.
            The five have been deleted rather than regenerated. */
        }
        <img
          src="/assets/images/realtime-report-4.webp"
          alt="Live Market Data"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="805"
          height="400"
          class="mx-auto block pb-6 lg:pb-12"
        />
        <div class="space-y-4 pb-6 lg:pb-12 px-6 lg:px-12">
          <h3 class="h4">Predefined Watchlist</h3>
          <p>Real-time price feeds, charts and market depth to help you decide instantly.</p>
        </div>
      </div>
      <div
        data-aos="fade-up-sm"
        data-aos-delay="450"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 aos-init aos-animate"
      >
        <!--
          Phone mock-up. Same artwork and the same measured geometry as
          OrderPlacement's `.ofh-mock`: phone-frame.webp (500x1017) has a
          transparent screen, so it goes OVER the video and masks it to the
          rounded aperture while drawing the bezel and the status bar on top.
          The video runs at full aperture width, flush with the top of the
          screen so it carries under the status bar, which at 1080x1920 makes it
          800 tall; the card crops the frame well above that, so the phone runs
          off the card and only the top of the clip is on screen.
        -->
        <div class="order-2 pt-6 lg:pt-12">
          <div class="tfc-mock">
            <div class="tfc-frame">
              <div class="tfc-screen">
                <video autoplay loop muted playsinline preload="metadata" width="1080" height="1920">
                  <source src="/assets/images/trade-from-chart.webm" type="video/webm" />
                </video>
              </div>
              <img
                class="tfc-bezel"
                src="/assets/images/order-flow/phone-frame.webp"
                alt="Trade from Chart"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="500"
                height="1017"
              />
            </div>
          </div>
        </div>
        <div class="space-y-4 order-1 py-6 lg:pt-12 px-6 lg:px-12">
          <h3 class="h4">Trade from Chart</h3>
          <p>Analyze, decide, and place trades directly from the chart — all in one seamless experience.</p>
        </div>
      </div>
      <div
        data-aos="fade-left-sm"
        data-aos-delay="400"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 lg:col-span-2 aos-init aos-animate"
      >
        <img
          src="/assets/images/metrics-1.webp"
          alt="Trusted by Thousands"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="407"
          height="242"
          class="mx-auto block pb-6 lg:pb-12"
        />
        <div class="space-y-4 pb-6 lg:pb-12 px-6 lg:px-9">
          <h3 class="h5">Trusted by Thousands</h3>
          <p>Thousands of investors trust GoPocket for honest pricing and reliable execution.</p>
        </div>
      </div>
      <div
        data-aos="fade-left-sm"
        data-aos-delay="200"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 lg:col-span-2 aos-init aos-animate"
      >
        <img
          src="/assets/images/ai-automation-4.webp"
          alt="Multi-Asset Trading"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="407"
          height="235"
          class="mx-auto block order-2 pt-6 lg:pt-12"
        />
        <div class="space-y-4 order-1 py-6 lg:pt-12 px-6 lg:px-9">
          <h3 class="h5">Multi-Asset Trading</h3>
          <p>Trade equity, F&amp;O, currency, commodities, mutual funds and IPOs — all in one app.</p>
        </div>
      </div>
      <div
        data-aos="fade-left-sm"
        data-aos-delay="300"
        class="bg-theme-light flex flex-col justify-between rounded-4xl sm:col-span-3 lg:col-span-2 aos-init aos-animate"
      >
        <img
          src="/assets/images/security-4.webp"
          alt="Safe & Secure"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          data-astro-image="constrained"
          data-astro-image-fit="cover"
          data-astro-image-pos="center"
          width="408"
          height="237"
          class="mx-auto block pb-6 lg:pb-12"
        />
        <div class="space-y-4 pb-6 lg:pb-12 px-6 lg:px-9">
          <h3 class="h5">Safe &amp; Secure</h3>
          <p>Bank-grade security and SEBI-regulated safety keep your money and data protected.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Trade from Chart mock-up. Aperture geometry is measured off
     phone-frame.webp and matches OrderPlacement's `.ofh-screen`: the screen is
     450x975 at (26, 23) in the artwork's 500x1017 space, and its status-bar
     glyphs end at y=78. */

  .tfc-mock {
    width: 100%;
    max-width: 20rem;
    margin-inline: auto;
    overflow: hidden;
    /* Cuts the frame off at y=508, so the phone runs off the bottom of the card
       and the clip — 800 tall at this width — shows only its top ~430px. */
    aspect-ratio: 500 / 508;
  }

  .tfc-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 500 / 1017;
  }

  /* Over the video, not under it: the mockup's screen is transparent, so the
     bezel is what masks the clip to the rounded screen and draws the buttons,
     the status bar and the home indicator on top of it. */
  .tfc-bezel {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  /* White under the whole aperture, so the status bar glyphs sit on
     app-coloured ground rather than on the card. */
  .tfc-screen {
    position: absolute;
    left: 5.2%;
    top: 2.2615%;
    width: 90%;
    height: 95.8702%;
    z-index: 1;
    overflow: hidden;
    /* Set a little tighter than the artwork's squircle: erring inwards hides
       the difference under the opaque bezel. 12% of 450 and 5.5% of 975 are
       both about 54px, so it tracks the mockup at any size. */
    border-radius: 12% / 5.5%;
    background-color: #ffffff;
  }

  .tfc-screen video {
    position: absolute;
    left: 0;
    top: 0; /* flush with the top of the aperture, under the status bar */
    display: block;
    width: 100%;
    height: auto;
  }
</style>
