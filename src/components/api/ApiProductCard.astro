---
/** One API product card. Shared by both rows of the ApiProducts grid. */

interface Props {
  name: string;
  description: string;
  /** Endpoint or channel shown as a monospace chip on the card. */
  endpoint: string;
  icon: string;
  delay: number;
}

const { name, description, endpoint, icon, delay } = Astro.props;
---

<div
  data-aos="fade-up-sm"
  data-aos-delay={delay}
  class="bg-theme-light flex flex-col justify-between gap-8 rounded-4xl p-6 lg:p-10 aos-init"
>
  <div class="flex items-start justify-between gap-4">
    <span class="text-primary bg-white inline-flex h-12 w-12 items-center justify-center rounded-2xl">
      {
        icon === "orders" && (
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v16a2 2 0 0 0 2 2h16" />
            <path d="m19 9-5 5-4-4-3 3" />
          </svg>
        )
      }
      {
        icon === "feed" && (
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9" />
            <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5" />
            <circle cx="12" cy="12" r="2" />
            <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5" />
            <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19" />
          </svg>
        )
      }
      {
        icon === "portfolio" && (
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="14" x="2" y="7" rx="2" ry="2" />
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
          </svg>
        )
      }
      {
        icon === "history" && (
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v18h18" />
            <rect width="4" height="7" x="7" y="10" rx="1" />
            <rect width="4" height="12" x="15" y="5" rx="1" />
          </svg>
        )
      }
      {
        icon === "statements" && (
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
            <path d="M14 2v4a2 2 0 0 0 2 2h4" />
            <path d="M8 13h8" />
            <path d="M8 17h5" />
          </svg>
        )
      }
    </span>
    <code class="api-endpoint-chip rounded-full px-3 py-1.5 text-xs font-medium">{endpoint}</code>
  </div>
  <div class="space-y-3">
    <h3 class="h4">{name}</h3>
    <p class="opacity-80">{description}</p>
  </div>
</div>

<style>
  .api-endpoint-chip {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    color: var(--fg-muted, #6b7280);
    background: var(--surface-1, #fff);
    border: 1px solid var(--line, #eceef1);
    white-space: nowrap;
  }
</style>
